// 用户 / 登录态（轻量单例，零依赖）
// 与文档 01 商业模式（free / single / member）对齐
// 登录策略：App 端完整认证流程；小程序端静默登录（决策记录 D1）

import { PositionId, ExperienceLevel, InterviewMode } from '../types/interview.uts'

export type UserPlan = 'free' | 'single' | 'member'

export type UserProfile = {
  uid: string
  nickname: string
  plan: UserPlan
  positionId: PositionId
  experienceLevel: ExperienceLevel
  defaultMode: InterviewMode // 面试偏好：默认模式（快练/标准/深度）
  onboarded: boolean // 是否已完成首启画像引导（显式跳过一次也算完成，避免每次启动重复弹）
  token: string // 会话凭证；空串表示未登录
  phone: string // 绑定手机号；空串表示匿名身份（静默登录）——面试入口门控依据
}

// 便捷展示文本
export function positionDisplay(p: UserProfile): string {
  const map: Record<string, string> = {
    frontend: '前端',
    backend: '后端',
    devops: '运维',
    ai: 'AI 工程'
  }
  return map[p.positionId] != null ? map[p.positionId] : '后端'
}

export function experienceDisplay(p: UserProfile): string {
  const map: Record<string, string> = {
    fresh: '应届',
    junior: '1-3年',
    mid: '3-5年',
    senior: '5年+'
  }
  return map[p.experienceLevel] != null ? map[p.experienceLevel] : '1-3年'
}

// UTS 不支持 undefined，可选字段用 null 表达
export type UserProfilePatch = {
  uid: string | null
  nickname: string | null
  plan: UserPlan | null
  positionId: PositionId | null
  experienceLevel: ExperienceLevel | null
  defaultMode: InterviewMode | null
  onboarded: boolean | null
  token: string | null
  phone: string | null
}

const STORAGE_KEY = 'ml_user_profile'

class UserStore {
  profile: UserProfile = {
    uid: '',
    nickname: '访客',
    plan: 'free',
    positionId: 'backend',
    experienceLevel: 'junior',
    defaultMode: 'standard',
    onboarded: false,
    token: '',
    phone: ''
  } as UserProfile

  isLoggedIn(): boolean {
    return this.profile.token.length > 0
  }

  // 面试入口门控：仅有手机号绑定身份（验证码登录）才可进入面试
  hasPhoneIdentity(): boolean {
    return this.profile.phone.length > 0
  }

  // mock 时代遗留的本地会话（真 JWT 不可能含 'mock-token-' 子串）
  isMockSession(): boolean {
    return this.profile.token.indexOf('mock-token-') >= 0
  }

  setProfile(p: UserProfilePatch) {
    if (p.uid != null) this.profile.uid = p.uid
    if (p.nickname != null) this.profile.nickname = p.nickname
    if (p.plan != null) this.profile.plan = p.plan
    if (p.positionId != null) this.profile.positionId = p.positionId
    if (p.experienceLevel != null) this.profile.experienceLevel = p.experienceLevel
    if (p.defaultMode != null) this.profile.defaultMode = p.defaultMode
    if (p.onboarded != null) this.profile.onboarded = p.onboarded
    if (p.token != null) this.profile.token = p.token
    if (p.phone != null) this.profile.phone = p.phone
  }

  isMember(): boolean {
    return this.profile.plan === 'member'
  }

  // 登录成功后持久化，供下次启动恢复会话
  persist() {
    try {
      uni.setStorageSync(STORAGE_KEY, JSON.stringify(this.profile))
    } catch (e: any) {
      console.warn('[user-profile] persist failed', e)
    }
  }

  // 启动时恢复会话与画像；无缓存返回 false
  // 注意：token 为空只代表「未登录」，不代表「无画像」——匿名用户的方向/年限同样要恢复，
  // 否则首启选择的画像每次启动都会丢失（与首启引导的 onboarded 标记同因）。
  restore(): boolean {
    try {
      const raw = uni.getStorageSync(STORAGE_KEY) as string
      if (raw == null || raw.length === 0) return false
      const p = JSON.parse(raw) as UserProfile
      // 兼容旧版缓存（升级前无对应字段）
      if (p.defaultMode == null) p.defaultMode = 'standard'
      if (p.phone == null) p.phone = ''
      if (p.token == null) p.token = ''
      if (p.onboarded == null) p.onboarded = false
      // 方向体系 v2 迁移：旧缓存值（java-backend/golang-backend/pm）归一化为 backend
      if (p.positionId == null) p.positionId = 'backend'
      const legacyPos: Record<string, PositionId> = {
        'java-backend': 'backend',
        'golang-backend': 'backend',
        pm: 'backend'
      } as Record<string, PositionId>
      if (legacyPos[p.positionId] != null) p.positionId = legacyPos[p.positionId]
      // 兼容旧版（仅有 currentPosition 字符串）的快照
      this.profile = p
      return true
    } catch (e: any) {
      console.warn('[user-profile] restore failed', e)
      return false
    }
  }

  logout() {
    // 画像（方向/年限）与首启引导标记属设备级偏好，不随登录态清除——否则退出登录后会重复弹引导
    const positionId = this.profile.positionId
    const experienceLevel = this.profile.experienceLevel
    const onboarded = this.profile.onboarded
    this.profile = {
      uid: '',
      nickname: '访客',
      plan: 'free',
      positionId: positionId,
      experienceLevel: experienceLevel,
      defaultMode: 'standard',
      onboarded: onboarded,
      token: '',
      phone: ''
    } as UserProfile
    try {
      // 保留画像与引导标记：清空会导致下次启动重新弹首启引导（且匿名画像丢失）
      uni.setStorageSync(STORAGE_KEY, JSON.stringify(this.profile))
    } catch (e: any) {
      console.warn('[user-profile] clear storage failed', e)
    }
  }
}

export const userStore = new UserStore()
