{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.uvue",
      "options": { "parser": "vue" }
    },
    {
      "files": "*.uts",
      "options": { "parser": "typescript" }
    }
  ]
}
