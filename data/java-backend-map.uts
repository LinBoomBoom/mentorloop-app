// Java 后端岗位能力图谱 v1（文档 02 §3.1）
// 每个岗位由能力域、子能力、可观测行为、题目簇、评分锚点组成。
// 本文件为 M0 产物，供题目选择器与评分引擎引用；变更须经产品与内容审核确认（文档 05 §3）。

export type SubAbility = {
  id: string
  name: string
  observableBehavior: string // 可观测行为：面试官能直接观察到的表现
  scoringAnchor: string // 评分锚点：达到门槛等级的判断依据
  questionCluster: string // 题目簇标签（题库按此归类）
}

export type AbilityDomain = {
  id: string
  name: string
  weight: number // 与评分量表权重对齐（文档 02 §3.4）
  subAbilities: SubAbility[]
}

export const JAVA_BACKEND_MAP: AbilityDomain[] = [
  {
    id: 'knowledge',
    name: '基础知识',
    weight: 0.25,
    subAbilities: [
      {
        id: 'knowledge.concurrency-jvm',
        name: '并发与JVM',
        observableBehavior: '能否说明指标、假设、验证和结果',
        scoringAnchor: '能准确描述并发问题定位的完整链路（现象→指标→假设→验证→结论）',
        questionCluster: 'concurrency-jvm'
      } as SubAbility,
      {
        id: 'knowledge.java-core',
        name: 'Java核心',
        observableBehavior: '能否说明集合、IO、泛型等核心机制的适用边界',
        scoringAnchor: '能结合场景说明选型理由，而非背诵定义',
        questionCluster: 'java-core'
      } as SubAbility,
      {
        id: 'knowledge.middleware',
        name: '中间件',
        observableBehavior: '能否说明 Redis/消息队列的使用场景与失效模式',
        scoringAnchor: '能指出缓存与消息队列的典型故障模式及应对',
