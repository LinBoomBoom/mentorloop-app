  } as AbilityDomain,
  {
    id: 'communication',
    name: '沟通表达',
    weight: 0.15,
    subAbilities: [
      {
        id: 'communication.star',
        name: 'STAR/结构化叙述',
        observableBehavior: '是否先结论、再证据、后反思',
        scoringAnchor: '回答结构清晰：结论先行，证据支撑，有反思',
        questionCluster: 'structured-narrative'
      } as SubAbility
    ]
  } as AbilityDomain,
  {
    id: 'learning',
    name: '学习与复盘',
    weight: 0.1,
    subAbilities: [
      {
        id: 'learning.retrospective',
        name: '失败复盘与成长',
        observableBehavior: '能否描述失败经验、纠偏动作与成长路径',
