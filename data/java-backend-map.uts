        name: '项目个人贡献',
        observableBehavior: '能否区分团队成果与个人决策',
        scoringAnchor: '能明确说出个人负责的部分、决策依据与量化结果',
        questionCluster: 'project-contribution'
      } as SubAbility,
      {
        id: 'engineering.code-quality',
        name: '代码质量与工程实践',
        observableBehavior: '能否说明测试、评审、发布流程中的个人实践',
        scoringAnchor: '能举出具体工程实践案例并说明收益',
        questionCluster: 'code-quality'
      } as SubAbility
    ]
  } as AbilityDomain,
  {
    id: 'analysis',
    name: '系统设计',
    weight: 0.2,
    subAbilities: [
      {
        id: 'analysis.capacity-tradeoff',
        name: '容量与权衡',
        observableBehavior: '能否说明约束、备选方案与取舍',
        scoringAnchor: '能先澄清约束，再给出至少一个备选方案并说明取舍',
        questionCluster: 'system-design'
      } as SubAbility,
      {
        id: 'analysis.problem-analysis',
        name: '问题分析',
        observableBehavior: '能否给出假设、验证路径与风险控制',
        scoringAnchor: '面对开放问题能拆解为可验证的小问题',
        questionCluster: 'problem-analysis'
      } as SubAbility
