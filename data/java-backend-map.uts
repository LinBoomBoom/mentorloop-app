  } as AbilityDomain
]

// 能力域名称速查（报告与摘要页使用）
export type DomainLabelMap = { [key: string]: string }

export const DOMAIN_LABEL: DomainLabelMap = {
  knowledge: '基础知识',
  engineering: '工程能力',
  analysis: '系统设计',
  communication: '沟通表达',
  learning: '学习与复盘',
  motivation: '职业动机'
}

// 图谱覆盖的能力域列表（选择器用于覆盖率判断）
export function getDomainIds(): string[] {
  const ids: string[] = []
  for (let i = 0; i < JAVA_BACKEND_MAP.length; i++) {
    ids.push(JAVA_BACKEND_MAP[i].id)
  }
  return ids
}
