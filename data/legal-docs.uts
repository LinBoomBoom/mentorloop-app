// 按 doc 键取文本；未知键回退用户协议（页面入口参数错误时仍有可读内容）
export function getLegalDoc(key: string): LegalDoc {
  if (key === 'privacy') return PRIVACY_DOC
  if (key === 'membership') return MEMBERSHIP_DOC
  return AGREEMENT_DOC
}
