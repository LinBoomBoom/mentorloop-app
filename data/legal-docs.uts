// 应用内法律文本（2026-10-23）：用户协议 / 隐私政策 / 会员服务协议
// 落因：仓库无已备案域名，外部协议 URL 暂不可用（见 docs/sop/compliance-sop.md §5）。
// 本文件承载可离线阅读的全文，供 pages/legal/legal.uvue 渲染；AGREEMENT_URL /
// PRIVACY_URL 回填后，外链优先，本文件仍作为应用内兜底与审核可访问文本。
// 口径纪律：只陈述代码与产品事实（30/365 天、不自动续费、录音不落库、注销删除等），
// 不写未实现的承诺；正式提审前由 LC / 法务审定。

export type LegalSection = {
  title: string
  paragraphs: string[]
}

export type LegalDoc = {
  key: string
  title: string
  updatedAt: string
  effectiveAt: string
  intro: string
  sections: LegalSection[]
}

const UPDATED_AT: string = '2026-10-23'

export const AGREEMENT_DOC: LegalDoc = {
  key: 'agreement',
  title: '用户协议',
  updatedAt: UPDATED_AT,
  effectiveAt: UPDATED_AT,
  intro:
    '欢迎使用智面研学（以下简称「本小程序」）。本协议是你与本小程序运营者（以下简称「我们」）之间关于使用本小程序服务的约定。请在使用前完整阅读；你勾选同意、完成登录或实际使用服务，即表示你已阅读并同意本协议。如你不同意，请停止使用。',
  sections: [
    {
      title: '一、服务内容',
      paragraphs: [
        '本小程序提供岗位化 AI 模拟面试、专项训练、证据化评分报告、简历优化建议与成长档案等功能，当前开放前端、后端、运维与 AI 工程四个方向。',
        '面试官语音、题目追问、评分说明与简历建议可能由人工智能技术生成，相关界面会标注「AI 面试官 · 系统生成」「建议稿」等标识。',
        '我们可能根据产品规划调整、增加或下线部分功能，调整前会以页面公告等方式提示。'
      ]
    },
    {
      title: '二、账号注册与使用',
      paragraphs: [
        '你可以通过微信授权登录或手机号加短信验证码登录。你应保证提供的手机号等信息真实、有效，并对账号下的行为负责。',
        '账号仅限你本人使用，不得出借、出租、转让或售卖。',
        '你可以随时在「我的 → 账号与安全 → 注销账号」中申请注销。注销后账号数据将按《隐私政策》删除且不可恢复。'
      ]
    },
    {
      title: '三、使用规范',
      paragraphs: [
        '不得利用本服务从事违法违规、侵犯他人合法权益、危害网络安全或破坏服务正常运行的行为，包括但不限于：批量注册、恶意刷量、爬取题库、攻击接口、绕过额度或付费限制、转售会员权益。',
        '不得上传含有违法、暴力、淫秽、歧视、诽谤或侵犯他人隐私的内容。你上传的简历与作答内容应真实、合法，并已获得必要授权。',
        '如你违反本协议，我们有权视情节采取警告、限制功能、中止或终止服务等措施；涉嫌违法的，依法向有关部门报告。'
      ]
    },
    {
      title: '四、AI 生成内容说明',
      paragraphs: [
        'AI 评分、追问、报告与简历建议仅用于面试练习与学习参考，不构成录用承诺、职业咨询意见或对你能力的最终评价。',
        '评分基于你提交的作答文本与证据，低置信度会明确标注；请勿将 AI 结果作为唯一决策依据。',
        'AI 不会冒充真人面试官；如发现内容错误，你可以通过反馈渠道告知我们。'
      ]
    },
    {
      title: '五、付费服务',
      paragraphs: [
        '本小程序提供会员（月卡 / 年卡）、面试单次包与简历深度评审单次包等付费服务，具体商品、价格与权益以支付页展示为准。',
        '付费服务通过微信支付完成，支付成功后即时生效；会员为一次性购买，不自动续费。',
        '会员与单次包的具体规则见《会员服务协议》。'
      ]
    },
    {
      title: '六、知识产权',
      paragraphs: [
        '本小程序的界面、题库、评分规则、报告模板、文字与图形等内容的知识产权归我们或相关权利人所有。未经许可，不得复制、改编、传播或用于商业用途。',
        '你上传的简历、作答与训练记录归你所有。为向你提供服务（如生成报告、跨设备同步），你授权我们在必要范围内处理这些内容；我们不会将其用于训练第三方模型。'
