    {
      title: '十二、联系我们',
      paragraphs: [
        '如对本协议有疑问、意见或投诉，可通过微信小程序右上角「···」→「反馈与投诉」提交。我们将在 15 个工作日内答复。'
      ]
    }
  ]
} as LegalDoc

export const PRIVACY_DOC: LegalDoc = {
  key: 'privacy',
  title: '隐私政策',
  updatedAt: UPDATED_AT,
  effectiveAt: UPDATED_AT,
  intro:
    '智面研学（以下简称「本小程序」）由本小程序运营者（以下简称「我们」）运营。我们重视你的个人信息保护，并依据《中华人民共和国个人信息保护法》等法律法规处理你的个人信息。本政策说明我们收集哪些信息、为何收集、如何保存与共享，以及你可以行使的权利。请在使用服务前阅读。',
  sections: [
    {
      title: '一、我们收集的信息',
      paragraphs: [
        '账号信息：你使用微信授权登录时，我们获取微信提供的 openid 与会话标识；你使用手机号登录时，我们收集手机号及短信验证码（验证码仅用于校验，短时保存后失效）。你设置的昵称、岗位方向、经验等级与面试偏好会随账号保存。',
        '面试与训练信息：你选择的岗位方向、经验等级、作答文本、追问记录、评分与报告。使用语音作答时，录音会临时上传用于转写；转写完成后临时音频即被删除，我们不保存录音原文或音频文件。',
        '简历信息：你主动上传的简历文件、解析出的文本、目标岗位与评审记录。简历仅用于本次分析与评审，不用于训练第三方模型；送入大模型前，我们会对手机号、邮箱等联系方式做脱敏处理，且不将简历正文写入日志。',
        '交易信息：订单号、商品类型、金额、支付状态与微信支付单号。我们不收集你的银行卡号、支付密码或微信支付账户密码。',
        '设备与使用信息：运行平台（如微信小程序 / App）、页面会话标识、事件名称、时间戳与必要的业务属性。我们不会收集通讯录、精确位置、相册或剪贴板内容。'
      ]
    },
    {
      title: '二、我们如何使用信息',
      paragraphs: [
        '提供、维护与改进服务：生成面试题目与追问、完成语音转写、生成评分报告与成长档案、发放会员与单次包权益、同步跨设备报告。',
        '保障安全与合规：识别异常请求、防止刷量与作弊、处理投诉与纠纷、履行法律义务。',
        '我们当前不向你推送商业广告，也不会基于你的个人信息进行广告定向投放。'
      ]
    },
    {
      title: '三、第三方服务与委托处理',
      paragraphs: [
        '为实现功能，我们可能将必要信息提供给以下第三方，并要求其按约定与法律要求处理：',
        '微信（腾讯）：微信登录、微信支付 / 小程序虚拟支付、云托管与云存储服务。',
        '语音服务提供方：语音合成使用腾讯云语音合成；语音识别使用微信语音识别或阿里云智能语音交互（依实际部署配置）。',
        '大模型服务提供方（当前为 DeepSeek）：用于简历评审建议与报告解释。我们仅提供完成该功能所必需的内容，并在发送前脱敏联系方式。',
        '上述第三方有其独立的隐私政策，我们建议你一并阅读。除上述情形及法律法规要求外，我们不会向第三方出售或共享你的个人信息。'
      ]
    },
    {
      title: '四、信息的存储',
      paragraphs: [
        '你的个人信息存储在中华人民共和国境内的服务器。我们采取访问控制、传输加密（HTTPS / 微信私有链路）等措施保护数据安全。',
        '存储期限：账号信息、面试记录、报告与简历信息在账号存续期间保存；你注销账号后，我们将删除或匿名化相关数据（法律法规另有要求的除外）。短信验证码在有效期届满或使用后失效。',
        '本机保存的报告、训练记录、简历草稿与额度账本，可在「我的 → 隐私与数据」中随时清除。'
      ]
    },
    {
      title: '五、你的权利',
      paragraphs: [
        '查阅与更正：你可以在「我的」相关页面查看昵称、偏好与报告，并更正可编辑的信息。',
        '删除：你可以清除本机数据，或在「我的 → 账号与安全 → 注销账号」中删除服务端账号数据。注销后数据不可恢复。',
        '撤回同意：你可以通过注销账号或停止使用服务撤回授权；撤回不影响此前基于同意已进行的处理。',
        '响应时限：我们将在收到你的请求后 15 个工作日内答复。'
      ]
