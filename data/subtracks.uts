export const PRACTICE_DIFFICULTIES: PracticeDifficultyOption[] = [
  { id: 'junior', label: '初级', desc: '基础概念与常见题' } as PracticeDifficultyOption,
  { id: 'mid', label: '中级', desc: '原理与项目实践' } as PracticeDifficultyOption,
  { id: 'senior', label: '高级', desc: '架构取舍与深度问题' } as PracticeDifficultyOption
]

export function subtracksOf(positionId: PositionId): SubtrackOption[] {
  const out: SubtrackOption[] = []
  for (let i = 0; i < SUBTRACKS.length; i++) {
    if (SUBTRACKS[i].positionId === positionId) out.push(SUBTRACKS[i])
  }
  return out
}

export function subtrackName(id: string): string {
  for (let i = 0; i < SUBTRACKS.length; i++) {
    if (SUBTRACKS[i].id === id) return SUBTRACKS[i].name
  }
  return id
}

export function difficultyLabel(id: Difficulty): string {
  for (let i = 0; i < PRACTICE_DIFFICULTIES.length; i++) {
    if (PRACTICE_DIFFICULTIES[i].id === id) return PRACTICE_DIFFICULTIES[i].label
  }
  return '中级'
}

// 经验档位 → 默认难度（做题页初始选中）
export function defaultDifficultyFor(level: string): Difficulty {
  if (level === 'fresh') return 'junior'
  if (level === 'mid') return 'mid'
  if (level === 'senior') return 'senior'
  return 'junior'
}
