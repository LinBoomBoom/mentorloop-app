// communication/learning/motivation），保持报告与评分体系不变。
// 规则：关键词命中打分（多者取胜，同分按本表顺序＝优先级）→ subtrack 兜底 → knowledge。

export type DimensionRule = {
  domain: string
  keywords: string[]
}

