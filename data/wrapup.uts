// AI 工程岗位收束题（2026-10-22：解除方向置灰，补齐岗位化收束）
export const AI_WRAPUP_QUESTION: QuestionItem = {
  id: 'q-wrapup-ai',
  abilityDomain: 'learning',
  subAbility: 'learning.retrospective',
  knowledgePoint: '开放复盘',
