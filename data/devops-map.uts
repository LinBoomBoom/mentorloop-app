// 运维（devops）方向能力图谱 v1（2026-10-18 批次 A，任务卡 question-bank-expansion）
// 人工审核通过：docs/drafts/2026-10-18-devops-content-draft.md（审核人：用户，2026-10-18）
// 每个岗位由能力域、子能力、可观测行为、题目簇、评分锚点组成；权重对齐评分量表 25/25/20/15/10/5。
// 变更须经产品与内容审核确认（文档 05 §3）。

export type SubAbility = {
  id: string
  name: string
  observableBehavior: string // 可观测行为：面试官能直接观察到的表现
  scoringAnchor: string // 评分锚点：达到门槛等级的判断依据
  questionCluster: string // 题目簇标签（题库按此归类）
}

export type AbilityDomain = {
  id: string
  name: string
  weight: number // 与评分量表权重对齐（文档 02 §3.4）
  subAbilities: SubAbility[]
}

