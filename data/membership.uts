// 价格格式化：分 → 元字符串
export function formatPrice(cent: number): string {
  if (cent % 100 === 0) return String(cent / 100)
  const yuan = Math.floor(cent / 100)
  const fen = cent % 100
  return String(yuan) + '.' + (fen < 10 ? '0' + String(fen) : String(fen))
}
