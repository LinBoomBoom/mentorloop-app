      <ml-button text="开始面试" type="primary" @click="startInterview"></ml-button>
    </view>

    <text class="text-base font-semibold text-ink mt-5 mb-2.5">快速入口</text>

    <view class="mb-2.5" @click="goTab('/pages/training/training')">
      <ml-card><text class="text-base text-ink">专项训练</text></ml-card>
