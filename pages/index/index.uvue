<template>
  <view class="flex-col w-full h-full bg-bg-light overflow-hidden">
    <!-- 深色任务舱：唯一主行动 -->
    <view class="shrink-0 px-5 pb-8" :style="deckStyle">
      <!-- 顶部：日期 + 问候 + 周次数 / 登录 + 头像 -->
      <view class="flex-row items-start justify-between" :style="{ paddingRight: rightPad + 'px' }">
        <view class="flex-col flex-1 mr-3">
          <text class="text-xs" :style="{ color: 'rgba(255,255,255,0.52)' }">{{ dateText }}</text>
          <text class="text-[18px] font-bold text-white mt-1 truncate block">{{
            greetingLine
          }}</text>
        </view>
        <view class="flex-row items-center">
          <view
            v-if="!loggedIn"
            class="login-pill"
            hover-class="pressed-chip"
            :hover-start-time="0"
            @click="goLogin"
          >
            <text class="text-xs" :style="{ color: SURFACE }">登录</text>
          </view>
          <view v-else-if="rightPad === 0" class="week-pill">
            <view
              class="w-1.5 h-1.5 rounded-full mr-1.5"
              :style="{ backgroundColor: WARN_LIGHT }"
            ></view>
            <text class="text-xs font-mono" :style="{ color: WARN_LIGHT }">{{ weekLabel }}</text>
          </view>
          <view
            class="w-9 h-9 rounded-full flex-row items-center justify-center ml-2"
            :style="{ backgroundColor: SURFACE }"
            hover-class="pressed-chip"
            :hover-start-time="0"
            @click="openMine"
          >
            <text class="text-sm font-bold" :style="{ color: NAVY }">{{ avatarLetter }}</text>
          </view>
        </view>
      </view>

      <!-- 主任务：唯一主 CTA -->
      <view id="home-profile-card" class="mt-6">
        <view class="flex-row items-center">
          <view
            class="w-1.5 h-1.5 rounded-full mr-1.5"
            :style="{ backgroundColor: WARN_LIGHT }"
          ></view>
          <text class="text-xs font-mono" :style="{ color: WARN_LIGHT, letterSpacing: '1px' }">{{
            deckEyebrow
          }}</text>
        </view>
        <text
          class="block font-bold text-white mt-2.5"
          :class="compact ? 'text-[22px] leading-8' : 'text-[28px] leading-9'"
          >{{ headlineLine1 }}</text
        >
        <text
          class="block font-bold text-white"
          :class="compact ? 'text-[22px] leading-8' : 'text-[28px] leading-9'"
          >{{ headlineLine2 }}</text
        >
        <text
          v-if="!compact"
          class="text-xs mt-2 leading-5"
          :style="{ color: 'rgba(255,255,255,0.58)' }"
          >{{ deckSub }}</text
        >

        <!-- 画像入口：点击修改岗位 / 年限 -->
        <view
          id="home-profile-edit"
          class="flex-row items-center mt-3"
          hover-class="pressed-row"
          :hover-start-time="0"
          @click="goOnboarding"
        >
          <text class="text-xs" :style="{ color: 'rgba(255,255,255,0.62)' }">{{
            profileLine
          }}</text>
          <text v-if="!profileReady" class="text-xs ml-1.5" :style="{ color: WARN_LIGHT }"
            >待完善画像</text
          >
          <ml-icon class="ml-1" name="chevron-right" :size="11" :color="MIST"></ml-icon>
        </view>

        <!-- 面试 → 报告 → 训练闭环 -->
        <view class="flex-row items-center mt-4">
          <view class="flex-row items-center">
            <view class="w-2.5 h-2.5 rounded-full" :style="{ backgroundColor: WARN_LIGHT }"></view>
            <text class="text-xs text-white ml-1.5">面试</text>
          </view>
          <view
            class="flex-1 ml-2 mr-2"
            :style="{ height: '1px', backgroundColor: 'rgba(245,201,123,0.55)' }"
          ></view>
          <view class="flex-row items-center">
            <view
              class="w-2.5 h-2.5 rounded-full border"
              :style="{
                borderColor: 'rgba(255,255,255,0.22)',
                backgroundColor: 'transparent'
              }"
            ></view>
            <text class="text-xs ml-1.5" :style="{ color: 'rgba(255,255,255,0.42)' }">报告</text>
          </view>
          <view
            class="flex-1 ml-2 mr-2"
            :style="{ height: '1px', backgroundColor: 'rgba(255,255,255,0.14)' }"
          ></view>
          <view class="flex-row items-center">
            <view
              class="w-2.5 h-2.5 rounded-full border"
              :style="{
                borderColor: 'rgba(255,255,255,0.22)',
                backgroundColor: 'transparent'
              }"
            ></view>
            <text class="text-xs ml-1.5" :style="{ color: 'rgba(255,255,255,0.42)' }">训练</text>
          </view>
        </view>

        <view
          class="mt-4 h-12 flex-row items-center justify-between bg-surface px-4"
          :style="{ borderRadius: '16px' }"
          hover-class="pressed-card"
          :hover-start-time="0"
          @click="onPrimaryTap"
        >
          <text class="text-base font-bold" :style="{ color: NAVY_DEEP }">{{ primaryText }}</text>
          <view
            class="flex-row items-center justify-center"
            :style="{
              width: '26px',
              height: '26px',
              borderRadius: '999px',
              backgroundColor: NAVY_DEEP
            }"
          >
            <ml-icon name="arrow-right" :size="13" :color="SURFACE"></ml-icon>
          </view>
        </view>

        <text v-if="!compact" class="text-xs mt-2.5" :style="{ color: 'rgba(255,255,255,0.55)' }">{{
          deckFoot
        }}</text>
      </view>
    </view>

    <!-- 浅色训练纸：今日任务 + 两个成长入口 + 成长轨 -->
    <view class="flex-1 overflow-hidden bg-bg-light rounded-t-2xl" :style="sheetStyle">
      <view class="flex-row justify-center pt-2.5 pb-2">
        <view
          class="bg-line"
          :style="{ width: '36px', height: '4px', borderRadius: '99px' }"
        ></view>
      </view>
      <scroll-view class="flex-1" scroll-y="true">
        <view class="px-5 pb-2">
          <view class="flex-row items-center justify-between">
            <text class="text-base font-bold text-ink">今日任务</text>
            <view
              class="flex-row items-center"
              hover-class="pressed-row"
              :hover-start-time="0"
              @click="goGrowth"
            >
              <text class="text-xs text-smart">查看成长</text>
              <ml-icon class="ml-0.5" name="chevron-right" :size="11" :color="SMART"></ml-icon>
            </view>
          </view>

          <!-- 今日任务：无报告=摸底；有报告=今日做题（#stat-todo 直达训练页） -->
          <view id="stat-todo" class="mt-2.5" @click="goTraining">
            <ml-card :padded="false">
              <view class="p-3 flex-row items-center">
                <view class="icon-box-sm" :style="{ backgroundColor: CHIP_WARN }">
                  <ml-icon name="target" :size="15" :color="WARN"></ml-icon>
                </view>
                <view class="flex-col flex-1 ml-2.5">
                  <text class="text-sm font-bold text-ink truncate block">{{ todayTitle }}</text>
                  <text class="text-xs text-ink-soft mt-1 truncate block">{{ todaySubtitle }}</text>
                </view>
                <view class="go-pill" :style="{ backgroundColor: CHIP_TEAL }">
                  <text class="text-xs font-bold" :style="{ color: RELIABLE }">{{ todayCta }}</text>
                </view>
              </view>
            </ml-card>
          </view>

          <!-- 专项训练 / 简历优化：常驻两列入口 -->
          <view class="flex-row mt-3">
            <view id="home-training" class="flex-1 mr-2.5" @click="goTraining">
              <view
                class="module-card"
                :style="{
                  minHeight: compact ? '88px' : '104px',
                  backgroundColor: CHIP_SMART,
                  borderColor: 'rgba(88,86,214,0.12)'
                }"
                hover-class="pressed-card"
                :hover-start-time="0"
              >
                <view class="flex-row items-center justify-between">
                  <view
                    class="flex-row items-center justify-center"
                    :style="{
                      width: '30px',
                      height: '30px',
                      borderRadius: '10px',
                      backgroundColor: 'rgba(255,255,255,0.72)'
                    }"
                  >
                    <ml-icon name="target" :size="15" :color="SMART"></ml-icon>
                  </view>
                  <text class="text-base" :style="{ color: MIST }">›</text>
                </view>
                <view class="flex-col">
                  <text class="text-sm font-bold text-ink">专项训练</text>
                  <text v-if="!compact" class="text-xs text-ink-soft mt-1 truncate block"
                    >自选方向 · 5 题一组</text
                  >
                </view>
              </view>
            </view>
            <view id="home-resume" class="flex-1" @click="goResume">
              <view
                class="module-card"
                :style="{
                  minHeight: compact ? '88px' : '104px',
                  backgroundColor: CHIP_TEAL,
                  borderColor: 'rgba(31,182,166,0.14)'
                }"
                hover-class="pressed-card"
                :hover-start-time="0"
              >
                <view class="flex-row items-center justify-between">
                  <view
                    class="flex-row items-center justify-center"
                    :style="{
                      width: '30px',
                      height: '30px',
                      borderRadius: '10px',
                      backgroundColor: 'rgba(255,255,255,0.72)'
                    }"
                  >
                    <ml-icon name="file-text" :size="15" :color="RELIABLE"></ml-icon>
                  </view>
                  <text class="text-base" :style="{ color: MIST }">›</text>
                </view>
                <view class="flex-col">
                  <text class="text-sm font-bold text-ink">简历优化</text>
                  <text v-if="!compact" class="text-xs text-ink-soft mt-1 truncate block"
                    >AI 逐条批注</text
                  >
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 成长轨：保留 E2E 锚点语义 -->
      <view class="px-5 py-2.5 border-t border-line flex-row items-center">
        <view id="stat-total" class="flex-row items-baseline" @click="goReport">
          <text class="text-xs text-ink-soft">面试</text>
          <text class="text-sm font-bold font-mono text-ink ml-1">{{ totalCount }}</text>
          <text class="text-xs text-ink-soft ml-1">场</text>
        </view>
        <view
          class="ml-3 mr-3"
          :style="{ width: '1px', height: '10px', backgroundColor: LINE_STRONG }"
        ></view>
        <view id="stat-avg" class="flex-row items-center" @click="goGrowth">
          <template v-if="hasReport">
            <text class="text-xs text-ink-soft">最近</text>
            <text class="text-sm font-bold font-mono text-ink ml-1">{{ latestLevel }}</text>
          </template>
          <text v-else class="text-xs text-ink-soft">报告待生成</text>
          <ml-icon class="ml-0.5" name="chevron-right" :size="11" :color="MIST"></ml-icon>
        </view>
        <view class="flex-1"></view>
        <view id="home-recent-report" class="flex-row items-center" @click="goReport">
          <text class="text-xs text-smart">{{ hasReport ? '最近报告' : '成长报告' }}</text>
          <ml-icon class="ml-0.5" name="chevron-right" :size="11" :color="SMART"></ml-icon>
        </view>
      </view>
    </view>

    <!-- 登录半屏层：小程序端手机号+验证码（APP 端仍走 /pages/login/login） -->
    <ml-login-sheet v-if="showLogin" @success="onLoginSuccess" @exit="onLoginExit"></ml-login-sheet>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow, onReady } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlLoginSheet from '../../components/ml-login-sheet.uvue'
import { userStore, positionDisplay, experienceDisplay } from '../../store/user-profile.uts'
import { loginByWechat, applyAuth } from '../../api/auth.uts'
import { reportHistory, ReportRecord } from '../../store/report-history.uts'
import { quotaStore } from '../../store/quota.uts'
import { fetchQuota } from '../../api/membership.uts'
import { reportSegmentIntent } from '../../store/report-segment.uts'
import { useMock } from '../../api/env.uts'
import { trackEvent } from '../../api/tracking.uts'
import { themeValue } from '../../styles/theme.uts'
import { averageLevel } from '../../styles/score-display.uts'

const SMART = themeValue('smart', '#5856D6')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const WARN = themeValue('warn', '#E08A00')
const WARN_LIGHT = themeValue('warnLight', '#F5C97B')
const MIST = themeValue('mist', '#AEAEB2')
const NAVY = themeValue('navy', '#0F2C4C')
const NAVY_DEEP = themeValue('navyDeep', '#0B2138')
const CHIP_SMART = themeValue('chipSmart', '#EFEEFC')
const CHIP_TEAL = themeValue('chipReliable', '#E8F7F4')
const CHIP_WARN = themeValue('chipWarn', '#FFF4E5')
const SURFACE = themeValue('surface', '#FFFFFF')
const LINE_STRONG = themeValue('lineStrong', '#D1D1D6')

// 安全区内边距（onShow 从窗口信息读取）
const topPad = ref(36)
// 小屏紧凑模式：隐藏次要说明行，保证核心入口首屏可见（2026-10-24 首页重排）
const compact = ref(false)
// MP 端右上角让出微信胶囊（避免头像被遮挡）；其余端保持内容边距
const rightPad = ref(0)
// #ifdef MP-WEIXIN
rightPad.value = 88
// #endif

// 问候与画像
const nickname = ref(userStore.profile.nickname)
const avatarLetter = computed((): string =>
  nickname.value.length > 0 ? nickname.value.substring(0, 1) : '访'
)
const positionLabel = ref(positionDisplay(userStore.profile))
const experienceLabel = ref(experienceDisplay(userStore.profile))
const profileReady = ref(userStore.profile.onboarded === true)
const onboardingPrompted = ref(false)
const loggedIn = ref(userStore.isLoggedIn())
const showLogin = ref(false)

// 最近报告数据
const records = ref<ReportRecord[]>([])
const hasReport = computed((): boolean => records.value.length > 0)
const totalCount = computed((): number => records.value.length)
const latest = computed((): ReportRecord | null =>
  records.value.length > 0 ? records.value[0] : null
)

const latestAt = computed((): string => {
  const r = latest.value
  if (r == null) return ''
  const d = new Date(r.at)
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return pad(d.getMonth() + 1) + '-' + pad(d.getDate())
})

const latestLevel = computed((): string => {
  const r = latest.value
  if (r == null) return '--'
  const levels: string[] = []
  for (let i = 0; i < r.report.dimensions.length; i++) levels.push(r.report.dimensions[i].level)
  return averageLevel(levels)
})

// 本周面试次数（用报告时间近似；无报告时显示「今天开始」）
const weekCount = computed((): number => {
  const cutoff = Date.now() - 7 * 24 * 3600 * 1000
  let n = 0
  for (let i = 0; i < records.value.length; i++) {
    if (records.value[i].at >= cutoff) n += 1
  }
  return n
})

const topTask = computed((): { title: string; durationMin: number } => {
  const r = latest.value
  if (r != null && r.report.trainingPlan.length > 0) {
    const t = r.report.trainingPlan[0]
    return { title: t.title, durationMin: t.durationMin }
  }
  return { title: '暂无做题任务', durationMin: 0 }
})

const todoCount = computed((): number => {
  const r = latest.value
  return r != null ? r.report.trainingPlan.length : 0
})

// 今日任务三态：无报告=摸底；有报告无任务=自选练习；有报告有任务=今日做题
const todayTitle = computed((): string => {
  if (!hasReport.value) return '先做 5 题摸底'
  if (todoCount.value === 0) return '今日做题 · 自选练习'
  return '今日做题 · ' + String(todoCount.value) + ' 个待完成'
})

const todaySubtitle = computed((): string => {
  if (!hasReport.value) return '生成能力画像与训练计划'
  if (todoCount.value === 0) return '按方向 / 难度自选 5 题一组'
  return topTask.value.title + ' · 约 ' + String(topTask.value.durationMin) + ' 分钟'
})

const todayCta = computed((): string => (hasReport.value ? '去做题' : '开始摸底'))

const greeting = computed((): string => {
  const h = new Date().getHours()
  if (h < 6) return '夜深了，注意休息'
  if (h < 12) return '早上好'
  if (h < 14) return '中午好'
  if (h < 18) return '下午好'
  return '晚上好'
})

const dateText = computed((): string => {
  const d = new Date()
  const week = ['日', '一', '二', '三', '四', '五', '六'][d.getDay()]
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return pad(d.getMonth() + 1) + '月' + pad(d.getDate()) + '日 周' + week
})

// 深色任务舱：只用 navy token 生成渐变，避免引入新色值
const deckGradient = 'linear-gradient(155deg, ' + NAVY + ' 0%, ' + NAVY_DEEP + ' 100%)'
const deckStyle = computed((): { [key: string]: string } => ({
  backgroundColor: NAVY_DEEP,
  backgroundImage: deckGradient,
  paddingTop: topPad.value + 'px'
}))
// 浅色训练纸与任务舱重叠 28px，形成层次
const sheetStyle = { marginTop: '-28px' }

const greetingLine = computed((): string => {
  const n = nickname.value
  if (n.length === 0 || n === '访客') return greeting.value
  return greeting.value + '，' + n
})

const weekLabel = computed((): string =>
  weekCount.value > 0 ? '本周 ' + String(weekCount.value) + ' 次' : '今天开始'
)

const deckEyebrow = computed((): string =>
  hasReport.value ? 'TODAY · 模拟面试' : 'TODAY · 摸底训练'
)
const headlineLine1 = computed((): string => (hasReport.value ? '把下一场面试，' : '先做 5 题，'))
const headlineLine2 = computed((): string => (hasReport.value ? '练成你的主场。' : '找到你的起点。'))
const deckSub = computed((): string =>
  hasReport.value
    ? '按岗位与年限抽题，20 分钟一场；答完即出六维报告与训练计划。'
    : '不用先选方向：系统按你的画像抽 5 题，约 6 分钟，结束后生成六维能力画像。'
)
const deckFoot = computed((): string => {
  if (!hasReport.value) return '完成后生成六维报告与训练计划'
  return (
    '上次 ' +
    latestAt.value +
    ' · 综合 ' +
    latestLevel.value +
    ' · 已完成 ' +
    String(totalCount.value) +
    ' 场'
  )
})
const primaryText = computed((): string => (hasReport.value ? '开始模拟面试' : '开始摸底'))
const profileLine = computed((): string =>
  positionLabel.value + ' · ' + experienceLabel.value + ' · 6 维能力'
)

// 窗口尺寸在 onShow 时可能尚未就绪（DevTools/冷启动），onReady 再校准一次
function applyWindowLayout() {
  try {
    const win = uni.getWindowInfo()
    const sb = win.statusBarHeight
    topPad.value = sb > 0 ? sb + 8 : 36
    // <620 进入紧凑模式：合并后的核心入口在 640 高度安卓机也能首屏放下
    compact.value = win.windowHeight > 0 && win.windowHeight < 620
  } catch {
    topPad.value = 36
    compact.value = false
  }
}

onReady(() => {
  applyWindowLayout()
})

onShow(() => {
  applyWindowLayout()

  loggedIn.value = userStore.isLoggedIn()
  nickname.value = userStore.profile.nickname
  positionLabel.value = positionDisplay(userStore.profile)
  experienceLabel.value = experienceDisplay(userStore.profile)
  profileReady.value = userStore.profile.onboarded === true
  if (!profileReady.value && !onboardingPrompted.value) {
    onboardingPrompted.value = true
    trackEvent('onboarding_prompt')
    setTimeout(() => {
      uni.navigateTo({ url: '/pages/onboarding/onboarding?from=first' })
    }, 350)
  }

  reportHistory.load()
  records.value = reportHistory.all()
  if (loggedIn.value) {
    fetchQuota().catch(() => {})
  }
  if (!useMock()) {
    reportHistory.fetchFromServer().then(() => {
      reportHistory.load()
      records.value = reportHistory.all()
    })
  }
})

function goOnboarding() {
  uni.navigateTo({ url: '/pages/onboarding/onboarding?from=edit' })
}

function startInterview() {
  quotaStore.restore()
  if (!quotaStore.canStartInterview()) {
    trackEvent('quota_exceeded', { scene: 'interview' })
    uni.showModal({
      title: '免费面试额度已用完',
      content: '开通会员可无限次模拟面试，或购买单次包继续练习',
      confirmText: '去开通',
      cancelText: '暂不需要',
      success: (r: any) => {
        if (r.confirm) {
          uni.navigateTo({ url: '/pages/membership/paywall?from=gating' })
        }
      }
    })
    return
  }
  uni.navigateTo({ url: '/pages/interview/prep' })
}

function goTraining() {
  // 专项训练已从 tabBar 移出，作为成长页的二级页面
  uni.navigateTo({ url: '/pages/training/training' })
}

// 唯一主 CTA：有报告先面试；新用户先做 5 题摸底
function onPrimaryTap() {
  if (!hasReport.value) {
    goTraining()
    return
  }
  startInterview()
}

function goGrowth() {
  reportSegmentIntent.set('growth')
  uni.switchTab({ url: '/pages/report/report' })
}

function goResume() {
  uni.navigateTo({ url: '/pages/resume/resume' })
}

function goReport() {
  reportSegmentIntent.set('report')
  uni.switchTab({ url: '/pages/report/report' })
}

function openMine() {
  uni.switchTab({ url: '/pages/mine/mine' })
}

function goLogin() {
  // #ifdef APP
  uni.navigateTo({ url: '/pages/login/login' })
  // #endif
  // #ifndef APP
  uni.login({
    provider: 'weixin',
    success: (res: any) => {
      const code = res.code as string
      if (code == null || code.length === 0) {
        showLogin.value = true
        return
      }
      loginByWechat(code)
        .then((r) => {
          applyAuth(r, '')
          onLoginSuccess()
        })
        .catch(() => {
          showLogin.value = true
        })
    },
    fail: () => {
      showLogin.value = true
    }
  })
  // #endif
}

function onLoginSuccess() {
  showLogin.value = false
  loggedIn.value = userStore.isLoggedIn()
  nickname.value = userStore.profile.nickname
  positionLabel.value = positionDisplay(userStore.profile)
  experienceLabel.value = experienceDisplay(userStore.profile)
  uni.showToast({ title: '登录成功', icon: 'none' })
}

function onLoginExit() {
  showLogin.value = false
}
</script>

