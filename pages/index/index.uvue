<template>
  <view class="flex-col w-full h-full bg-bg-light overflow-hidden">
    <scroll-view class="flex-1" scroll-y="true">
      <view class="px-5 pb-8" :style="{ paddingTop: topPad + 'px' }">
        <!-- 顶部：日期 + 大标题 + 头像 -->
        <view
          class="flex-row items-start justify-between"
          :style="{ paddingRight: rightPad + 'px' }"
        >
          <view class="flex-col flex-1 mr-3">
            <text class="text-xs text-ink-soft">{{ dateText }}</text>
            <text class="text-[28px] font-bold text-ink mt-1 leading-8">{{ greeting }}</text>
          </view>
          <view
            class="w-9 h-9 rounded-full flex-row items-center justify-center"
            :style="{ backgroundColor: SMART }"
            hover-class="pressed-chip"
            :hover-start-time="0"
            @click="openMine"
          >
            <text class="text-sm font-bold text-white">{{ avatarLetter }}</text>
          </view>
        </view>

        <!-- 主任务卡：唯一主 CTA -->
        <view id="home-profile-card" class="mt-4 rounded-card p-5" :style="heroStyle">
          <view class="flex-row items-center">
            <view
              class="w-1.5 h-1.5 rounded-full mr-1.5"
              :style="{ backgroundColor: RELIABLE }"
            ></view>
            <text class="text-xs" :style="{ color: 'rgba(255,255,255,0.82)' }"
              >AI 面试官 · 就绪</text
            >
          </view>
          <text class="text-[22px] font-bold text-white mt-3 leading-7"
            >用 20 分钟，练一场真实的面试</text
          >
          <text class="text-xs mt-2 leading-5" :style="{ color: 'rgba(255,255,255,0.62)' }"
            >按岗位与年限抽题，答完立即生成六维报告与训练计划。</text
          >

          <!-- 面试参数（点击进入修改） -->
          <view
            id="home-profile-edit"
            class="flex-row items-center mt-3"
            hover-class="pressed-row"
            :hover-start-time="0"
            @click="goOnboarding"
          >
            <view class="param-chip">
              <text class="text-xs text-white">{{ positionLabel }}</text>
            </view>
            <view class="param-chip ml-1.5">
              <text class="text-xs text-white">{{ experienceLabel }}</text>
            </view>
            <view class="param-chip ml-1.5">
              <text class="text-xs text-white">6 维能力</text>
            </view>
            <text v-if="!profileReady" class="text-xs ml-2" :style="{ color: WARN_LIGHT }"
              >待完善画像</text
            >
          </view>

          <view
            class="mt-4 h-12 rounded-control flex-row items-center justify-center bg-surface"
            hover-class="pressed-card"
            :hover-start-time="0"
            @click="startInterview"
          >
            <text class="text-base font-bold" :style="{ color: NAVY_DEEP }">开始模拟面试</text>
            <ml-icon class="ml-1.5" name="chevron-right" :size="15" :color="NAVY_DEEP"></ml-icon>
          </view>

          <text
            v-if="hasReport"
            class="text-xs mt-2 text-center"
            :style="{ color: 'rgba(255,255,255,0.5)' }"
            >上次 {{ latestAt }} · 综合 {{ latestLevel }} · 已完成 {{ totalCount }} 场</text
          >
          <text v-else class="text-xs mt-2 text-center" :style="{ color: 'rgba(255,255,255,0.5)' }"
            >首场结束后生成六维报告与训练计划</text
          >
        </view>

        <!-- 登录提示（匿名态才出现） -->
        <view v-if="!loggedIn" class="mt-3">
          <ml-card pressable @tap="goLogin">
            <view class="flex-row items-center">
              <ml-icon name="sparkles" :size="15" :color="WARN"></ml-icon>
              <view class="flex-col flex-1 ml-2">
                <text class="text-sm font-semibold text-ink">登录后同步报告与训练记录</text>
                <text class="text-xs text-ink-soft mt-0.5">换设备也能接着练</text>
              </view>
              <ml-icon name="chevron-right" :size="15" :color="MIST"></ml-icon>
            </view>
          </ml-card>
        </view>

        <!-- 今日闭环 -->
        <view class="flex-row items-center justify-between mt-5 mb-2">
          <text class="text-base font-bold text-ink">今日闭环</text>
          <text class="text-xs text-smart" @click="goGrowth">查看成长</text>
        </view>
        <view class="flex-row">
          <view id="stat-total" class="flex-1 mr-2" @click="goReport">
            <ml-card :padded="false">
              <view class="p-3">
                <view class="step-dot" :style="{ backgroundColor: SMART }">
                  <text class="text-xs font-bold text-white">1</text>
                </view>
                <text class="text-sm font-semibold text-ink mt-2">面试</text>
                <text class="text-xs text-ink-soft mt-0.5">{{ totalCount }} 场已完成</text>
              </view>
            </ml-card>
          </view>
          <view id="stat-avg" class="flex-1 mr-2" @click="goGrowth">
            <ml-card :padded="false">
              <view class="p-3">
                <view class="step-dot" :style="{ backgroundColor: CHIP_TEAL }">
                  <text class="text-xs font-bold" :style="{ color: RELIABLE }">2</text>
                </view>
                <text class="text-sm font-semibold text-ink mt-2">报告</text>
                <text class="text-xs text-ink-soft mt-0.5">{{ reportHint }}</text>
              </view>
            </ml-card>
          </view>
          <view id="stat-todo" class="flex-1" @click="goTraining">
            <ml-card :padded="false">
              <view class="p-3">
                <view class="step-dot" :style="{ backgroundColor: CHIP_WARN }">
                  <text class="text-xs font-bold" :style="{ color: WARN }">3</text>
                </view>
                <text class="text-sm font-semibold text-ink mt-2">训练</text>
                <text class="text-xs text-ink-soft mt-0.5">{{ todoCount }} 个待完成</text>
              </view>
            </ml-card>
          </view>
        </view>

        <!-- 最近报告 -->
        <view v-if="hasReport" id="home-recent-report" class="mt-3">
          <ml-card pressable @tap="goReport">
            <view class="flex-row items-center">
              <view class="grade-badge">
                <text class="text-lg font-bold font-mono" :style="{ color: RELIABLE }">{{
                  latestLevel
                }}</text>
              </view>
              <view class="flex-col flex-1 ml-3">
                <text class="text-sm font-semibold text-ink">最近报告 · {{ positionLabel }}</text>
                <text class="text-xs text-ink-soft mt-1 leading-4"
                  >优先改进：{{ topPriority }}</text
                >
                <view class="flex-row items-center mt-1.5">
                  <view class="tiny-pill">
                    <text class="text-xs" :style="{ color: RELIABLE }"
                      >置信度 {{ confidenceText }}</text
                    >
                  </view>
                </view>
              </view>
              <ml-icon name="chevron-right" :size="16" :color="MIST"></ml-icon>
            </view>
          </ml-card>
        </view>

        <!-- 空态：还没有报告 -->
        <view v-else class="mt-3">
          <ml-card>
            <view class="flex-row items-center">
              <view class="grade-badge">
                <ml-icon name="file-check" :size="18" :color="MIST"></ml-icon>
              </view>
              <view class="flex-col flex-1 ml-3">
                <text class="text-sm font-semibold text-ink">还没有面试报告</text>
                <text class="text-xs text-ink-soft mt-1 leading-4"
                  >完成一场模拟面试，这里会生成六维能力与优先改进项。</text
                >
              </view>
            </view>
          </ml-card>
        </view>

        <!-- 今日做题 -->
        <view v-if="hasReport" class="mt-3">
          <ml-card pressable @tap="goTraining">
            <view class="flex-row items-center">
              <view class="icon-box" :style="{ backgroundColor: CHIP_WARN }">
                <ml-icon name="zap" :size="16" :color="WARN"></ml-icon>
              </view>
              <view class="flex-col flex-1 ml-3">
                <text class="text-sm font-semibold text-ink"
                  >今日做题 · {{ todoCount }} 个待完成</text
                >
                <text class="text-xs text-ink-soft mt-1"
                  >{{ topTask.title }} · 约 {{ topTask.durationMin }} 分钟</text
                >
              </view>
              <view class="go-pill" :style="{ backgroundColor: CHIP_TEAL }">
                <text class="text-xs font-semibold" :style="{ color: RELIABLE }">去做题</text>
              </view>
            </view>
          </ml-card>
        </view>

        <!-- 简历优化 -->
        <view id="home-resume" class="mt-3">
          <ml-card pressable @tap="goResume">
            <view class="flex-row items-center">
              <view class="icon-box" :style="{ backgroundColor: CHIP_SMART }">
                <ml-icon name="file-text" :size="16" :color="SMART"></ml-icon>
              </view>
              <view class="flex-col flex-1 ml-3">
                <text class="text-sm font-semibold text-ink">简历优化</text>
                <text class="text-xs text-ink-soft mt-1">AI 解析 · 逐条批注 · 投递版本</text>
              </view>
              <ml-icon name="chevron-right" :size="16" :color="MIST"></ml-icon>
            </view>
          </ml-card>
        </view>
      </view>
    </scroll-view>

    <!-- 登录半屏层：小程序端手机号+验证码（APP 端仍走 /pages/login/login） -->
    <ml-login-sheet v-if="showLogin" @success="onLoginSuccess" @exit="onLoginExit"></ml-login-sheet>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlLoginSheet from '../../components/ml-login-sheet.uvue'
import { userStore, positionDisplay, experienceDisplay } from '../../store/user-profile.uts'
import { loginByWechat, applyAuth } from '../../api/auth.uts'
import { reportHistory, ReportRecord } from '../../store/report-history.uts'
import { quotaStore } from '../../store/quota.uts'
import { fetchQuota } from '../../api/membership.uts'
import { reportSegmentIntent } from '../../store/report-segment.uts'
import { useMock } from '../../api/env.uts'
import { trackEvent } from '../../api/tracking.uts'
import { themeValue } from '../../styles/theme.uts'
import { averageLevel } from '../../styles/score-display.uts'
import { confidenceBand } from '../../engine/rubric.uts'

const SMART = themeValue('smart', '#5856D6')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const WARN = themeValue('warn', '#E08A00')
const WARN_LIGHT = themeValue('warnLight', '#F5C97B')
const MIST = themeValue('mist', '#AEAEB2')
const NAVY = themeValue('navy', '#0F2C4C')
const NAVY_DEEP = themeValue('navyDeep', '#0B2138')
const CHIP_SMART = themeValue('chipSmart', '#EFEEFC')
const CHIP_TEAL = themeValue('chipReliable', '#E8F7F4')
const CHIP_WARN = themeValue('chipWarn', '#FFF4E5')

// 安全区内边距（onShow 从窗口信息读取）
const topPad = ref(36)
// MP 端右上角让出微信胶囊（避免头像被遮挡）；其余端保持内容边距
const rightPad = ref(0)
// #ifdef MP-WEIXIN
rightPad.value = 88
// #endif

// 问候与画像
const nickname = ref(userStore.profile.nickname)
const avatarLetter = computed((): string =>
  nickname.value.length > 0 ? nickname.value.substring(0, 1) : '访'
)
const positionLabel = ref(positionDisplay(userStore.profile))
const experienceLabel = ref(experienceDisplay(userStore.profile))
const profileReady = ref(userStore.profile.onboarded === true)
const onboardingPrompted = ref(false)
const loggedIn = ref(userStore.isLoggedIn())
const showLogin = ref(false)

// 最近报告数据
const records = ref<ReportRecord[]>([])
const hasReport = computed((): boolean => records.value.length > 0)
const totalCount = computed((): number => records.value.length)
const latest = computed((): ReportRecord | null =>
  records.value.length > 0 ? records.value[0] : null
)

const latestAt = computed((): string => {
  const r = latest.value
  if (r == null) return ''
  const d = new Date(r.at)
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return pad(d.getMonth() + 1) + '-' + pad(d.getDate())
})

const latestLevel = computed((): string => {
  const r = latest.value
  if (r == null) return '--'
  const levels: string[] = []
  for (let i = 0; i < r.report.dimensions.length; i++) levels.push(r.report.dimensions[i].level)
  return averageLevel(levels)
})

const topPriority = computed((): string => {
  const r = latest.value
  return r != null && r.report.topPriority.length > 0 ? r.report.topPriority : '暂无'
})

const confidenceText = computed((): string => {
  const r = latest.value
  if (r == null) return '--'
  const dims = r.report.dimensions
  if (dims.length === 0) return '--'
  let total = 0
  for (let i = 0; i < dims.length; i++) total += dims[i].confidence
  const band = confidenceBand(total / dims.length)
  if (band === 'high') return '高'
  if (band === 'medium') return '中'
  return '低'
})

const reportHint = computed((): string => {
  if (totalCount.value === 0) return '待生成'
  return latestLevel.value + ' · 6 维'
})

const topTask = computed((): { title: string; durationMin: number } => {
  const r = latest.value
  if (r != null && r.report.trainingPlan.length > 0) {
    const t = r.report.trainingPlan[0]
    return { title: t.title, durationMin: t.durationMin }
  }
  return { title: '暂无做题任务', durationMin: 0 }
})

const todoCount = computed((): number => {
  const r = latest.value
  return r != null ? r.report.trainingPlan.length : 0
})

const greeting = computed((): string => {
  const h = new Date().getHours()
  if (h < 6) return '夜深了，注意休息'
  if (h < 12) return '早上好'
  if (h < 14) return '中午好'
  if (h < 18) return '下午好'
  return '晚上好'
})

const dateText = computed((): string => {
  const d = new Date()
  const week = ['日', '一', '二', '三', '四', '五', '六'][d.getDay()]
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return pad(d.getMonth() + 1) + '月' + pad(d.getDate()) + '日 周' + week
})

// 深色主卡：只用 navy token 生成渐变，避免引入新色值
const heroStyle = {
  backgroundColor: NAVY_DEEP,
  backgroundImage: 'linear-gradient(155deg, ' + NAVY + ' 0%, ' + NAVY_DEEP + ' 100%)'
}

onShow(() => {
  try {
    const win = uni.getWindowInfo()
    const sb = win.statusBarHeight
    topPad.value = sb > 0 ? sb + 8 : 36
  } catch {
    topPad.value = 36
  }

  loggedIn.value = userStore.isLoggedIn()
  nickname.value = userStore.profile.nickname
  positionLabel.value = positionDisplay(userStore.profile)
  experienceLabel.value = experienceDisplay(userStore.profile)
  profileReady.value = userStore.profile.onboarded === true
  if (!profileReady.value && !onboardingPrompted.value) {
    onboardingPrompted.value = true
    trackEvent('onboarding_prompt')
    setTimeout(() => {
      uni.navigateTo({ url: '/pages/onboarding/onboarding?from=first' })
    }, 350)
  }

  reportHistory.load()
  records.value = reportHistory.all()
  if (loggedIn.value) {
    fetchQuota().catch(() => {})
  }
  if (!useMock()) {
    reportHistory.fetchFromServer().then(() => {
      reportHistory.load()
      records.value = reportHistory.all()
    })
  }
})

function goOnboarding() {
  uni.navigateTo({ url: '/pages/onboarding/onboarding?from=edit' })
}

function startInterview() {
  quotaStore.restore()
  if (!quotaStore.canStartInterview()) {
    trackEvent('quota_exceeded', { scene: 'interview' })
    uni.showModal({
      title: '免费面试额度已用完',
      content: '开通会员可无限次模拟面试，或购买单次包继续练习',
      confirmText: '去开通',
      cancelText: '暂不需要',
      success: (r: any) => {
        if (r.confirm) {
          uni.navigateTo({ url: '/pages/membership/paywall?from=gating' })
        }
      }
    })
    return
  }
  uni.navigateTo({ url: '/pages/interview/prep' })
}

function goTraining() {
  // 专项训练已从 tabBar 移出，作为成长页的二级页面
  uni.navigateTo({ url: '/pages/training/training' })
}

function goGrowth() {
  reportSegmentIntent.set('growth')
  uni.switchTab({ url: '/pages/report/report' })
}

function goResume() {
  uni.navigateTo({ url: '/pages/resume/resume' })
}

function goReport() {
  reportSegmentIntent.set('report')
  uni.switchTab({ url: '/pages/report/report' })
}

function openMine() {
  uni.switchTab({ url: '/pages/mine/mine' })
}

function goLogin() {
  // #ifdef APP
  uni.navigateTo({ url: '/pages/login/login' })
  // #endif
  // #ifndef APP
  uni.login({
    provider: 'weixin',
    success: (res: any) => {
      const code = res.code as string
      if (code == null || code.length === 0) {
        showLogin.value = true
        return
      }
      loginByWechat(code)
        .then((r) => {
          applyAuth(r, '')
          onLoginSuccess()
        })
        .catch(() => {
          showLogin.value = true
        })
    },
    fail: () => {
      showLogin.value = true
    }
  })
  // #endif
}

function onLoginSuccess() {
  showLogin.value = false
  loggedIn.value = userStore.isLoggedIn()
  nickname.value = userStore.profile.nickname
  positionLabel.value = positionDisplay(userStore.profile)
  experienceLabel.value = experienceDisplay(userStore.profile)
  uni.showToast({ title: '登录成功', icon: 'none' })
}

function onLoginExit() {
  showLogin.value = false
}
</script>

<style>
.step-dot {
  width: 20px;
  height: 20px;
  border-radius: 999px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.grade-badge {
  width: 46px;
  height: 46px;
  border-radius: 12px;
  background-color: #e8f7f4;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.icon-box {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.param-chip {
  height: 26px;
  padding-left: 9px;
  padding-right: 9px;
  border-radius: 8px;
  background-color: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.16);
  display: flex;
  flex-direction: row;
  align-items: center;
}
.go-pill {
  height: 30px;
  padding-left: 11px;
  padding-right: 11px;
  border-radius: 999px;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.tiny-pill {
  height: 20px;
  padding-left: 7px;
  padding-right: 7px;
  border-radius: 999px;
  background-color: #e8f7f4;
  display: flex;
  flex-direction: row;
  align-items: center;
}
</style>
