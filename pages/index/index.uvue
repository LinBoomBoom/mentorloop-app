<template>
  <view class="flex-col w-full h-full bg-navy overflow-hidden">
    <!-- 顶栏：品牌 + 问候 + 设置 -->
    <view
      class="flex-row items-center justify-between px-5"
      :style="{
        paddingTop: topPad + 'px',
        height: topPad + 44 + 'px',
        paddingRight: rightPad + 'px'
      }"
    >
      <view class="flex-col flex-1 mr-2">
        <text class="text-[22px] font-bold text-white">{{ greeting }}</text>
        <text class="text-xs text-mist mt-1">{{ dateText }}</text>
      </view>
      <view
        class="w-11 h-11 rounded-control flex-row items-center justify-center"
        :style="{ backgroundColor: 'rgba(255,255,255,0.08)' }"
        hover-class="pressed-chip"
        :hover-start-time="0"
        @click="openMine"
      >
        <ml-icon name="user" :size="19" :color="SURFACE"></ml-icon>
      </view>
    </view>

    <scroll-view class="flex-1" scroll-y="true">
      <view class="px-5 pt-3 pb-5">
        <!-- 本次模拟面试：首屏主任务（参数可读，去装饰） -->
        <view class="rounded-card border p-4" :style="cardStyle">
          <view class="flex-row items-center">
            <ml-voice-visual state="idle" :show-label="false" :ring="88"></ml-voice-visual>
            <view class="flex-col flex-1 ml-4">
              <view class="flex-row items-center">
                <view class="w-1.5 h-1.5 rounded-full bg-reliable mr-1.5 pulse-dot"></view>
                <text class="text-xs text-mist">AI 面试官 · 就绪</text>
              </view>
              <text class="text-base font-semibold text-white mt-2">本次模拟面试</text>
              <text class="text-xs text-mist mt-1">按岗位与经验抽题，答完可随时结束</text>
            </view>
          </view>
          <view class="flex-row mt-3 pt-3" :style="dividerTop">
            <view class="flex-col flex-1">
              <text class="text-xs text-mist">岗位方向</text>
              <text class="text-sm text-white mt-1">{{ positionLabel }}</text>
            </view>
            <view class="flex-col flex-1">
              <text class="text-xs text-mist">经验年限</text>
              <text class="text-sm text-white mt-1">{{ experienceLabel }}</text>
            </view>
            <view class="flex-col flex-1">
              <text class="text-xs text-mist">能力域</text>
              <text class="text-sm font-mono text-white mt-1">6 维</text>
            </view>
          </view>
        </view>

        <!-- 简历优化入口（IA-1 P2：准备环节前移，免费层钩子不再只藏「我的」） -->
        <view
          class="mt-3 rounded-card border p-3.5 flex-row items-center"
          :style="cardStyle"
          hover-class="pressed-card"
          :hover-start-time="0"
          @click="goResume"
        >
          <view
            class="w-8 h-8 rounded-control flex-row items-center justify-center"
            :style="{ backgroundColor: 'rgba(91,108,255,0.18)' }"
          >
            <ml-icon name="file-text" :size="15" :color="SMART_LIGHT"></ml-icon>
          </view>
          <view class="flex-col flex-1 ml-2.5">
            <text class="text-sm font-semibold text-white">简历优化</text>
            <text class="text-xs text-mist mt-0.5">AI 解析 · 改写建议 · 投递版本</text>
          </view>
          <ml-icon name="chevron-right" :size="15" :color="MIST"></ml-icon>
        </view>

        <!-- 数据条（等宽数字） -->
        <view class="flex-row rounded-card border px-2 py-3 mt-3" :style="stripStyle">
          <view class="flex-1 flex-col items-center" @click="goResults">
            <ml-icon name="target" :size="16" :color="WARN_LIGHT"></ml-icon>
            <text class="text-lg font-bold font-mono text-white mt-1">{{ totalCount }}</text>
            <text class="text-xs text-mist mt-0.5">累计面试</text>
          </view>
          <view class="w-px h-9" :style="dividerV"></view>
          <view class="flex-1 flex-col items-center" @click="goResults">
            <ml-icon name="award" :size="16" :color="RELIABLE_LIGHT"></ml-icon>
            <text class="text-lg font-bold font-mono text-white mt-1">{{ avgLevel }}</text>
            <text class="text-xs text-mist mt-0.5">平均等级</text>
          </view>
          <view class="w-px h-9" :style="dividerV"></view>
          <view class="flex-1 flex-col items-center" @click="goTraining">
            <ml-icon name="flame" :size="16" :color="MOTIVATION_LIGHT"></ml-icon>
            <text class="text-lg font-bold font-mono text-white mt-1">{{ todoCount }}</text>
            <text class="text-xs text-mist mt-0.5">待训练</text>
          </view>
        </view>

        <!-- 有报告：今日任务 + 最近报告 -->
        <template v-if="hasReport">
          <!-- 今日任务 -->
          <view
            class="mt-3 rounded-card border p-4"
            :style="cardStyle"
            hover-class="pressed-card"
            :hover-start-time="0"
            @click="goTraining"
          >
            <view class="flex-row items-center justify-between">
              <view class="flex-row items-center">
                <view
                  class="w-8 h-8 rounded-control flex-row items-center justify-center"
                  :style="{ backgroundColor: 'rgba(224,138,0,0.18)' }"
                >
                  <ml-icon name="zap" :size="15" :color="WARN_LIGHT"></ml-icon>
                </view>
                <text class="text-sm font-semibold text-white ml-2">今日训练任务</text>
              </view>
              <view class="flex-row items-center h-11 pl-2">
                <text class="text-xs text-mist">全部</text>
                <ml-icon name="chevron-right" :size="13" :color="MIST"></ml-icon>
              </view>
            </view>
            <view class="flex-row items-center mt-3">
              <view class="flex-col flex-1">
                <text class="text-base text-white font-medium">{{ topTask.title }}</text>
                <text class="text-xs text-mist mt-1">
                  出自最近报告 · {{ topTask.durationMin }} 分钟
                </text>
              </view>
              <view
                class="h-8 px-3 flex-row items-center rounded-control"
                :style="{ backgroundColor: 'rgba(91,108,255,0.25)' }"
              >
                <text class="text-xs font-semibold text-white">去训练</text>
              </view>
            </view>
          </view>

          <!-- 最近报告 -->
          <view
            class="mt-3 rounded-card border p-4"
            :style="cardStyle"
            hover-class="pressed-card"
            :hover-start-time="0"
            @click="goReport"
          >
            <view class="flex-row items-center justify-between">
              <view class="flex-row items-center">
                <view
                  class="w-8 h-8 rounded-control flex-row items-center justify-center"
                  :style="{ backgroundColor: 'rgba(31,182,166,0.18)' }"
                >
                  <ml-icon name="file-check" :size="15" :color="RELIABLE_LIGHT"></ml-icon>
                </view>
                <text class="text-sm font-semibold text-white ml-2">最近报告</text>
              </view>
              <text class="text-xs font-mono text-mist">{{ latestAt }}</text>
            </view>
            <view class="flex-row items-center mt-3">
              <view
                class="w-12 h-12 rounded-control flex-col items-center justify-center level-badge"
              >
                <text class="text-lg font-bold font-mono" :style="{ color: levelColor }">
                  {{ latestLevel }}
                </text>
              </view>
              <view class="flex-col flex-1 ml-3">
                <text class="text-sm text-white leading-5">
                  {{ latestOverall }}
                </text>
                <text class="text-xs text-warn mt-1">优先改进：{{ topPriority }}</text>
                <text v-if="latestConfidence.length > 0" class="text-xs text-mist mt-1">
                  {{ latestConfidence }}
                </text>
              </view>
            </view>
          </view>
        </template>

        <!-- 无报告：引导卡 -->
        <view v-else class="mt-3 rounded-card border p-5 flex-col items-center" :style="cardStyle">
          <view
            class="w-12 h-12 rounded-control flex-row items-center justify-center"
            :style="{ backgroundColor: 'rgba(91,108,255,0.18)' }"
          >
            <ml-icon name="sparkles" :size="22" :color="SMART_LIGHT"></ml-icon>
          </view>
          <text class="text-base font-semibold text-white mt-3">完成第一场模拟面试</text>
          <text class="text-xs text-mist mt-1.5 text-center leading-5">
            生成能力评估报告后，这里会给出{'\n'}针对性的训练任务与成长追踪
          </text>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作区（主 CTA 留拇指热区） -->
    <view
      class="px-5 pt-3"
      :style="{ paddingBottom: bottomPad + 'px', backgroundColor: 'rgba(11,33,56,0.9)' }"
    >
      <view class="mt-3">
        <ml-button text="开始模拟面试" type="primary" block @tap="startInterview"></ml-button>
      </view>
      <view
        v-if="!loggedIn"
        class="flex-row items-center justify-center mt-2.5 h-11"
        hover-class="pressed-row"
        :hover-start-time="0"
        @click="goLogin"
      >
        <ml-icon name="sparkles" :size="12" :color="WARN"></ml-icon>
        <text class="text-xs text-warn ml-1">登录后同步训练记录与报告</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import mlButton from '../../components/ml-button.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlVoiceVisual from '../../components/ml-voice-visual.uvue'
import { userStore, positionDisplay, experienceDisplay } from '../../store/user-profile.uts'
import { reportHistory, ReportRecord } from '../../store/report-history.uts'
import { quotaStore } from '../../store/quota.uts'
import { useMock } from '../../api/env.uts'
import { trackEvent } from '../../api/tracking.uts'
import { InterviewReport } from '../../types/scoring.uts'
import { themeValue } from '../../styles/theme.uts'
import { averageLevel, levelColorOnDark } from '../../styles/score-display.uts'
import { confidenceBand } from '../../engine/rubric.uts'

const SURFACE = themeValue('surface', '#FFFFFF')
const WARN_LIGHT = themeValue('warnLight', '#F5C97B')
const RELIABLE_LIGHT = themeValue('reliableLight', '#5CE8D8')
const MOTIVATION_LIGHT = themeValue('motivationLight', '#FF9E6D')
const MIST = themeValue('mist', '#AEB9CC')
const SMART_LIGHT = themeValue('smartLight', '#8FA0FF')
const WARN = themeValue('warn', '#E08A00')
const NAVY_DEEP = themeValue('navyDeep', '#0B2138')

// 安全区内边距（onShow 从窗口信息读取）
const topPad = ref(36)
const bottomPad = ref(24)

// C6：MP 端顶栏右侧让出微信胶囊宽度（胶囊≈87px+右边距，几何稳定），
// 避免设置按钮被胶囊遮挡；APP/H5 无胶囊保持 20px。
// 注：uni-app x 未暴露 getMenuButtonBoundingClientRect（框架零引用），故用固定避让值
const rightPad = ref(20)
// #ifdef MP-WEIXIN
rightPad.value = 100
// #endif

const positionLabel = ref(positionDisplay(userStore.profile))
const experienceLabel = ref(experienceDisplay(userStore.profile))
const loggedIn = ref(userStore.isLoggedIn())

// 最近报告数据
const records = ref<ReportRecord[]>([])

const hasReport = computed((): boolean => records.value.length > 0)

const totalCount = computed((): number => records.value.length)

const latest = computed((): ReportRecord | null =>
  records.value.length > 0 ? records.value[0] : null
)

// 平均等级（U7：等级映射与刻度单一来源 styles/score-display.uts）
const avgLevel = computed((): string => {
  const levels: string[] = []
  const all = records.value
  for (let i = 0; i < all.length; i++) {
    const dims = all[i].report.dimensions
    for (let j = 0; j < dims.length; j++) levels.push(dims[j].level)
  }
  return averageLevel(levels)
})

const topTask = computed((): { title: string; durationMin: number } => {
  const r = latest.value
  if (r != null && r.report.trainingPlan.length > 0) {
    const t = r.report.trainingPlan[0]
    return { title: t.title, durationMin: t.durationMin }
  }
  return { title: '', durationMin: 0 }
})

const todoCount = computed((): number => {
  const r = latest.value
  return r != null ? r.report.trainingPlan.length : 0
})

const latestAt = computed((): string => {
  const r = latest.value
  if (r == null) return ''
  const d = new Date(r.at)
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return pad(d.getMonth() + 1) + '-' + pad(d.getDate())
})

const latestOverall = computed((): string => {
  const r = latest.value
  return r != null && r.report.overall.length > 0 ? r.report.overall : '已完成一场模拟面试'
})

const topPriority = computed((): string => {
  const r = latest.value
  return r != null && r.report.topPriority.length > 0 ? r.report.topPriority : '暂无'
})

const latestLevel = computed((): string => {
  const r = latest.value
  if (r == null) return '--'
  return averageLevel(reportLevels(r.report))
})

// 置信度档位（D-i3：消费模型既有 confidence，不伪装精确）
const latestConfidence = computed((): string => {
  const r = latest.value
  if (r == null) return ''
  const dims = r.report.dimensions
  if (dims.length === 0) return ''
  let total = 0
  for (let i = 0; i < dims.length; i++) total += dims[i].confidence
  const band = confidenceBand(total / dims.length)
  if (band === 'high') return '置信度 高'
  if (band === 'medium') return '置信度 中'
  return '置信度 低 · 证据不足，仅供参考'
})

const levelColor = computed((): string => levelColorOnDark(latestLevel.value))

// 报告各维度等级 → 等级序列（供 averageLevel 消费）
function reportLevels(r: InterviewReport): string[] {
  const out: string[] = []
  for (let i = 0; i < r.dimensions.length; i++) out.push(r.dimensions[i].level)
  return out
}

// 问候语
const greeting = computed((): string => {
  const h = new Date().getHours()
  if (h < 6) return '夜深了，注意休息'
  if (h < 12) return '早上好'
  if (h < 14) return '中午好'
  if (h < 18) return '下午好'
  return '晚上好'
})

const dateText = computed((): string => {
  const d = new Date()
  const week = ['日', '一', '二', '三', '四', '五', '六'][d.getDay()]
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return pad(d.getMonth() + 1) + '月' + pad(d.getDate()) + '日 周' + week
})

// 深色卡样式（实色 + 细描边，避免滚动区 blur 开销）
const cardStyle = {
  backgroundColor: NAVY_DEEP,
  borderColor: 'rgba(255,255,255,0.08)'
}
const stripStyle = {
  backgroundColor: 'rgba(255,255,255,0.06)',
  borderColor: 'rgba(255,255,255,0.1)'
}
const dividerTop = {
  borderTopWidth: '1px',
  borderTopStyle: 'solid',
  borderTopColor: 'rgba(255,255,255,0.08)'
}
const dividerV = {
  backgroundColor: 'rgba(255,255,255,0.1)'
}

onShow(() => {
  try {
    const win = uni.getWindowInfo()
    const sb = win.statusBarHeight
    topPad.value = sb > 0 ? sb + 4 : 36
    const insets = win.safeAreaInsets
    const bottom = insets != null ? insets.bottom : 0
    bottomPad.value = bottom > 0 ? bottom + 10 : 24
  } catch {
    topPad.value = 36
    bottomPad.value = 24
  }

  loggedIn.value = userStore.isLoggedIn()
  positionLabel.value = positionDisplay(userStore.profile)
  experienceLabel.value = experienceDisplay(userStore.profile)

  reportHistory.load()
  records.value = reportHistory.all()
  // 真后端：异步同步云端报告历史（跨设备），先展示本地再刷新
  if (!useMock()) {
    reportHistory.fetchFromServer().then(() => {
      reportHistory.load()
      records.value = reportHistory.all()
    })
  }
})

function startInterview() {
  // 权益门控：免费层额度用尽 → 引导购买（额度在完成面试时扣减）
  quotaStore.restore()
  if (!quotaStore.canStartInterview()) {
    trackEvent('quota_exceeded', { scene: 'interview' })
    uni.showModal({
      title: '免费额度已用完',
      content: '开通会员可无限次模拟面试，或购买单次包继续练习',
      confirmText: '去开通',
      cancelText: '暂不需要',
      success: (r: any) => {
        if (r.confirm) {
          uni.navigateTo({ url: '/pages/membership/paywall?from=gating' })
        }
      }
    })
    return
  }
  uni.navigateTo({ url: '/pages/interview/prep' })
}

function goTraining() {
  uni.switchTab({ url: '/pages/training/training' })
}

function goResults() {
  // IA-1：原成长二级页已并入「结果」tab 的成长趋势分段，这里只做 tab 跳转
  uni.switchTab({ url: '/pages/report/report' })
}

function goResume() {
  uni.navigateTo({ url: '/pages/resume/resume' })
}

function goReport() {
  uni.switchTab({ url: '/pages/report/report' })
}

function openMine() {
  uni.switchTab({ url: '/pages/mine/mine' })
}

function goLogin() {
  // #ifdef APP
  uni.navigateTo({ url: '/pages/login/login' })
  // #endif
  // #ifndef APP
  uni.showToast({ title: '微信授权登录中，请稍候', icon: 'none' })
  // #endif
}
</script>

<style>
/* 呼吸状态点 */
@keyframes pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
}

.pulse-dot {
  animation: pulse 2s ease-in-out infinite;
}
.level-badge {
  background-color: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.14);
}
</style>
