<template>
  <scroll-view class="h-screen bg-bg-light" scroll-y="true">
    <view class="px-4 pt-4 pb-8">
      <!-- 头部品牌面 -->
      <view class="bg-navy rounded-card p-5">
        <view class="flex-row items-center">
          <view
            class="w-11 h-11 rounded-full flex-row items-center justify-center"
            :style="{ backgroundColor: 'rgba(245,201,123,0.2)' }"
          >
            <ml-icon name="crown" :size="22" :color="WARN_LIGHT"></ml-icon>
          </view>
          <view class="flex-col flex-1 ml-3">
            <text class="text-lg font-bold text-white">{{
              from === 'resume' ? '简历深度评审' : APP_NAME + ' 会员'
            }}</text>
            <text class="text-xs text-mist mt-0.5">{{
              from === 'resume' ? 'AI 逐条批注 · 单次包' : '按月 / 年开通 · 不自动续费'
            }}</text>
          </view>
        </view>
        <text class="text-sm text-mist leading-5 mt-3">
          {{
            from === 'resume'
              ? '解锁简历逐条 AI 批注、改写建议与历史记录；每包 3 次深度评审'
              : '会员解锁无限次模拟面试、深度证据报告与完整训练计划'
          }}
        </text>
      </view>

      <!-- SKU 选择（会员套餐与加量包分区，避免「加量包是否需会员」的歧义） -->
      <view class="mt-4">
        <view class="mt-2.5">
          <view v-for="(s, idx) in skus" :key="s.id" class="mb-2.5">
            <view v-if="isSectionStart(idx)" class="flex-col mb-2" :class="idx > 0 ? 'mt-3' : ''">
              <text class="text-sm font-semibold text-ink">{{ sectionTitle(idx) }}</text>
              <text class="text-xs text-ink-soft mt-0.5">{{ sectionCaption(idx) }}</text>
            </view>
            <ml-card :selected="selected === s.id" pressable @tap="selected = s.id">
              <view v-if="s.badge.length > 0" class="absolute right-3 top-3">
                <ml-tag
                  :label="s.badge"
                  :bg="s.highlight ? SMART : CHIP_RELIABLE"
                  :color="s.highlight ? SURFACE : RELIABLE"
                ></ml-tag>
              </view>
              <view class="flex-row items-center">
                <view
                  class="w-5 h-5 rounded-full flex-row items-center justify-center mr-3"
                  :style="{
                    backgroundColor: selected === s.id ? SMART : 'transparent',
                    border: selected === s.id ? '1px solid ' + SMART : '1.5px solid ' + LINE_STRONG
                  }"
                >
                  <ml-icon
                    v-if="selected === s.id"
                    name="check"
                    :size="12"
                    :color="SURFACE"
                  ></ml-icon>
                </view>
                <view class="flex-col flex-1">
                  <text class="text-base font-semibold text-ink">{{ s.name }}</text>
                  <text class="text-xs text-ink-soft mt-0.5">{{ s.desc }}</text>
                </view>
                <view class="flex-col items-end ml-2">
                  <view class="flex-row items-baseline">
                    <text class="text-xs text-ink">¥</text>
                    <text class="text-[22px] font-bold font-mono text-ink">{{
                      formatPrice(s.priceCent)
                    }}</text>
                    <text class="text-xs text-ink-soft ml-0.5">/{{ s.unit }}</text>
                  </view>
                  <text
                    v-if="s.originPriceCent > 0"
                    class="text-xs font-mono text-ink-soft line-through mt-0.5"
                  >
                    ¥{{ formatPrice(s.originPriceCent) }}
                  </text>
                </view>
              </view>
            </ml-card>
          </view>
        </view>
      </view>

      <!-- 会员权益（简历入口不展示，避免信息干扰） -->
      <view v-if="from !== 'resume'" class="mt-4">
        <ml-card :padded="false">
          <view class="p-4">
            <text class="text-sm font-semibold text-ink">{{ benefitsTitle }}</text>
            <view v-for="(b, i) in benefits" :key="b.label" class="flex-col mt-3">
              <view class="flex-row items-start" :class="i > 0 ? 'mt-0' : ''">
                <view
                  class="w-5 h-5 rounded-full flex-row items-center justify-center mr-2 mt-0.5"
                  :style="{ backgroundColor: CHIP_RELIABLE }"
                >
                  <ml-icon name="check" :size="11" :color="RELIABLE"></ml-icon>
                </view>
                <view class="flex-col flex-1">
                  <text class="text-sm font-medium text-ink">{{ b.label }}</text>
                  <text class="text-xs text-ink-soft mt-0.5 leading-4">{{ b.desc }}</text>
                </view>
              </view>
            </view>
            <!-- 单次包的能力边界：明写不含项，避免与会员权益混淆 -->
            <view v-if="limits.length > 0" class="mt-3 rounded-control p-3 bg-bg-muted">
              <text class="text-xs font-semibold text-ink-soft">本套餐不含</text>
              <text
                v-for="(l, i) in limits"
                :key="'l' + i"
                class="text-xs text-ink-soft mt-1 leading-4"
                >· {{ l }}</text
              >
            </view>
          </view>
        </ml-card>
      </view>

      <!-- 支付按钮 -->
      <view class="mt-5">
        <ml-button
          :text="paying ? '支付中…' : payButtonText"
          type="primary"
          block
          :disabled="paying"
          @tap="doPay"
        ></ml-button>
      </view>

      <!-- 小额支付联调入口：仅开发版/体验版可见，正式版不渲染 -->
      <view v-if="showTestPay" class="mt-3">
        <ml-button
          :text="'支付联调 · ¥' + formatPrice(testPack.priceCent) + '（1 场）'"
          block
          :disabled="testPaying"
          @tap="doTestPay"
        ></ml-button>
        <view class="flex-row items-center justify-center mt-1">
          <text class="text-xs text-ink-soft">仅开发版/体验版可见，正式版不展示</text>
        </view>
      </view>

      <!-- 协议与说明 -->
      <view class="flex-row items-center justify-center mt-3">
        <text class="text-xs text-ink-soft">支付即同意</text>
        <text class="text-xs text-smart ml-0.5" @click="showAgreement">《会员服务协议》</text>
        <text class="text-xs text-ink-soft"
          >·
          {{
            from === 'resume' ? '单次包购买后立即生效' : '月卡 30 天 / 年卡 365 天，不自动续费'
          }}</text
        >
      </view>
      <view v-if="isMock" class="flex-col items-center mt-2">
        <text class="text-xs text-ink-soft">Mock 环境：支付为模拟流程，权益即时发放</text>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import {
  SKUS,
  RESUME_PACK,
  TEST_PACK,
  TEST_PACK_IOS,
  benefitsForSku,
  limitsForSku,
  Sku,
  SkuId,
  PlanBenefit,
  formatPrice
} from '../../data/membership.uts'
import { purchase } from '../../api/membership.uts'
import { PAY_CANCELLED } from '../../api/virtual-pay.uts'
import { trackEvent } from '../../api/tracking.uts'
import { useMock } from '../../api/env.uts'
import { APP_NAME } from '../../data/app-meta.uts'
import { themeValue } from '../../styles/theme.uts'

const SMART = themeValue('smart', '#5B6CFF')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const SURFACE = themeValue('surface', '#FFFFFF')
const LINE_STRONG = themeValue('lineStrong', '#C9D2E3')
const CHIP_RELIABLE = themeValue('chipReliable', '#E6F7F4')
const WARN_LIGHT = themeValue('warnLight', '#F5C97B')

// 入口来源（mine=我的页 / gating=权益拦截 / index=首页 / resume=简历页）
const from = ref('mine')
const selected = ref<SkuId>('member_monthly')
const paying = ref(false)
// 联调支付独立 loading：不得驱动「立即开通」按钮的禁用/支付中态（2026-10-22 真机反馈串扰）
const testPaying = ref(false)
// 简历页入口只展示简历评审单次包，避免把会员主套餐混入
const skus = computed((): Sku[] => (from.value === 'resume' ? [RESUME_PACK] : SKUS))
// Mock 说明仅演示环境展示，真实环境不出现
const isMock = useMock()
// 小额联调入口：仅开发版/体验版可见（正式版恒为 false）
const showTestPay = ref(false)
// 联调道具：默认 0.1 元（Android）；iOS 端 Apple 支付最低 1 元，分流至 1 元道具 test_pay_1
const testSkuId = ref<SkuId>('test_pay_01')
const testPack = computed((): Sku => (testSkuId.value === 'test_pay_1' ? TEST_PACK_IOS : TEST_PACK))
// #ifdef MP-WEIXIN
const wxApiForEnv = (globalThis as any).wx
if (wxApiForEnv != null && wxApiForEnv.getAccountInfoSync != null) {
  const accountInfo: any = wxApiForEnv.getAccountInfoSync()
  const envVersion: string =
    accountInfo != null && accountInfo.miniProgram != null
      ? String(accountInfo.miniProgram.envVersion)
      : ''
  showTestPay.value = envVersion === 'develop' || envVersion === 'trial'
}
if (wxApiForEnv != null && wxApiForEnv.getSystemInfoSync != null) {
  const sys = wxApiForEnv.getSystemInfoSync()
  if (sys != null && sys.platform === 'ios') {
    testSkuId.value = 'test_pay_1'
  }
}
// #endif

onLoad((opts: any) => {
  if (opts != null && opts['from'] != null) {
    from.value = String(opts['from'])
  }
  if (from.value === 'resume') {
    selected.value = 'resume_pack_3'
    uni.setNavigationBarTitle({ title: '简历深度评审' })
  }
  trackEvent('paywall_view', { from: from.value })
})

const selectedSku = computed((): Sku => {
  const list = skus.value
  for (let i = 0; i < list.length; i++) {
    if (list[i].id === selected.value) return list[i]
  }
  return list[0]
})

const payButtonText = computed((): string => {
  const s = selectedSku.value
  // 会员是「开通」，单次包/加量包是「购买」（语义不同，避免被误认为必须开会员）
  return (s.kind === 'member' ? '立即开通 · ¥' : '立即购买 · ¥') + formatPrice(s.priceCent)
})

// 权益随选中的套餐变化（切换套餐即时刷新，不再所有档位同一份文案）
const benefits = computed((): PlanBenefit[] => benefitsForSku(selectedSku.value))
const limits = computed((): string[] => limitsForSku(selectedSku.value))
const benefitsTitle = computed((): string =>
  selectedSku.value.kind === 'member' ? '会员权益' : '本套餐包含'
)

// 分区标题：会员套餐 / 加量包（简历入口仅一个 SKU，不分区）
function isSectionStart(idx: number): boolean {
  if (from.value === 'resume') return false
  const list = skus.value
  if (idx === 0) return true
  return list[idx].kind !== list[idx - 1].kind
}

function sectionTitle(idx: number): string {
  return skus.value[idx].kind === 'member' ? '会员套餐' : '加量包 · 单次购买'
}

function sectionCaption(idx: number): string {
  return skus.value[idx].kind === 'member'
    ? '按时间开通，有效期内模拟面试不限次'
    : '无需开通会员，按场次购买，用完为止'
}

async function doPay() {
  if (paying.value) return
  const s = selectedSku.value
  trackEvent('paywall_click', { sku: s.id, from: from.value })
  paying.value = true
  try {
    await purchase(s.id, s.kind)
    uni.showToast({ title: '开通成功', icon: 'success' })
    setTimeout(() => {
      uni.navigateBack()
    }, 1200)
  } catch (e: any) {
    const msg = e != null && e.message != null ? String(e.message) : '支付未完成'
    // 用户主动取消：契约约定静默返回，不提示失败
    if (msg === PAY_CANCELLED) return
    uni.showToast({ title: msg, icon: 'none' })
  } finally {
    paying.value = false
  }
}

// 会员协议全文内置在应用内（pages/legal/legal），不依赖备案域名与外链
function showAgreement() {
  uni.navigateTo({ url: '/pages/legal/legal?doc=membership' })
}

// 小额联调：走同一条真实支付链路（下单 → 拉起 → 推送发货），支付后停留本页便于复测
async function doTestPay() {
  if (testPaying.value) return
  testPaying.value = true
  try {
    await purchase(testSkuId.value, 'single')
    uni.showToast({ title: '联调支付成功', icon: 'success' })
  } catch (e: any) {
    const msg = e != null && e.message != null ? String(e.message) : '支付未完成'
    if (msg === PAY_CANCELLED) return
    uni.showToast({ title: msg, icon: 'none' })
  } finally {
    testPaying.value = false
  }
}
</script>
