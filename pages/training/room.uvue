<template>
  <view class="flex-col h-screen bg-bg-light">
    <!-- 顶栏 -->
    <view class="bg-surface border-b border-line" :style="{ paddingTop: topPad }">
      <view class="h-14 flex-row items-center px-4">
        <view
          class="w-9 h-9 rounded-full bg-bg-muted flex-row items-center justify-center"
          hover-class="pressed-chip"
          :hover-start-time="0"
          @click="goBack"
        >
          <ml-icon name="arrow-left" :size="17" :color="INK"></ml-icon>
        </view>
        <view class="flex-col flex-1 items-center">
          <text class="text-sm font-semibold text-ink">{{
            wrongMode ? '错题复习' : dueMode ? '今日复习' : '做题'
          }}</text>
          <text class="text-xs text-ink-soft mt-0.5">{{ progressText }}</text>
        </view>
        <view class="w-9 h-9"></view>
      </view>
      <!-- 进度条 -->
      <view class="h-1 bg-line">
        <view class="h-1" :style="{ width: progressPercent + '%', backgroundColor: SMART }"></view>
      </view>
    </view>

    <scroll-view class="flex-1" scroll-y="true" :scroll-into-view="scrollInto">
      <view id="practice-top" class="px-4 pt-4 pb-8">
        <!-- 加载 -->
        <view v-if="loading">
          <ml-card>
            <view class="flex-row items-center">
              <ml-icon name="refresh-cw" :size="16" :color="SMART"></ml-icon>
              <text class="text-sm text-ink-soft ml-2">正在取题…</text>
            </view>
          </ml-card>
        </view>

        <!-- 错误 -->
        <view v-else-if="errorText.length > 0">
          <ml-card>
            <text class="text-sm font-semibold text-ink">题目加载失败</text>
            <text class="text-xs text-ink-soft mt-1 leading-5">{{ errorText }}</text>
            <view class="mt-3">
              <ml-button text="重试" type="primary" block @tap="load"></ml-button>
            </view>
          </ml-card>
        </view>

        <!-- 空态 -->
        <view v-else-if="questions.length === 0">
          <ml-card>
            <view class="flex-col items-center py-4">
              <view
                class="w-12 h-12 rounded-full flex-row items-center justify-center"
                :style="{ backgroundColor: CHIP_SMART }"
              >
                <ml-icon name="book-marked" :size="22" :color="SMART"></ml-icon>
              </view>
              <text class="text-base font-semibold text-ink mt-3">{{
                wrongMode ? '错题本是空的' : dueMode ? '今天没有到期题目' : '该领域暂无可用题目'
              }}</text>
              <text class="text-xs text-ink-soft mt-1 text-center leading-5">{{
                wrongMode
                  ? '做一组题并标记「不会」后，会自动进入错题本'
                  : dueMode
                    ? '按记忆曲线，明天再来复习这几题'
                    : '换一个细分领域或难度再试'
              }}</text>
              <view class="mt-4 w-full">
                <ml-button text="返回做题" type="primary" block @tap="goBack"></ml-button>
              </view>
            </view>
          </ml-card>
        </view>

        <!-- 做题中 -->
        <template v-else-if="!done">
          <view class="flex-row items-center justify-between">
            <view class="flex-row items-center">
              <view class="meta-chip">
                <text class="text-xs" :style="{ color: SMART }">{{ subtrackLabel }}</text>
              </view>
              <view class="meta-chip ml-1.5">
                <text class="text-xs text-ink-soft">{{ difficultyText }}</text>
              </view>
            </view>
          </view>

          <!-- 题目 -->
          <view class="mt-2.5">
            <ml-card>
              <view class="flex-row items-center">
                <ml-icon name="circle-help" :size="13" :color="MIST"></ml-icon>
                <text class="text-xs text-ink-soft ml-1.5">{{ knowledgePoint }}</text>
              </view>
              <text class="text-base font-semibold text-ink mt-2 leading-6">{{
                currentContent
              }}</text>
              <text class="text-xs text-ink-soft mt-2">{{ questionHint }}</text>
            </ml-card>
          </view>

          <!-- 未看解析 -->
          <view v-if="!revealed" class="mt-3">
            <view class="rounded-card bg-bg-muted p-3">
              <text class="text-xs text-ink-soft leading-5"
                >先在心里组织答案：结论 → 依据 → 具体做法 → 代价或边界。想好后查看解析。</text
              >
            </view>
            <view
              id="practice-reveal"
              class="mt-3 h-12 rounded-control flex-row items-center justify-center"
              :style="{ backgroundColor: SMART }"
              hover-class="pressed-card"
              :hover-start-time="0"
              @click="reveal"
            >
              <text class="text-base font-semibold text-white">查看参考解析</text>
            </view>
          </view>

          <!-- 解析 + 自评 -->
          <view v-else class="mt-3">
            <ml-card>
              <view class="flex-row items-center justify-between">
                <text class="text-sm font-semibold text-ink">参考解析 · 节选</text>
                <text class="text-xs text-ink-soft">非完整标准答案</text>
              </view>
              <text class="text-sm text-ink mt-2 leading-6">{{ currentAnswer }}</text>
              <view class="flex-row flex-wrap mt-3">
                <view class="meta-chip mr-1.5 mb-1.5">
                  <text class="text-xs text-ink-soft">{{ knowledgePoint }}</text>
                </view>
                <view v-if="techStack.length > 0" class="meta-chip mb-1.5">
                  <text class="text-xs text-ink-soft">{{ techStack }}</text>
                </view>
              </view>
            </ml-card>

            <text class="text-xs text-ink-soft mt-3">这道题你掌握得怎么样？</text>
            <view class="flex-row mt-2">
              <view
                id="assess-unknown"
                class="flex-1 h-11 rounded-control flex-row items-center justify-center"
                :style="{ backgroundColor: CHIP_DANGER }"
                hover-class="pressed-card"
                :hover-start-time="0"
                @click="assess('unknown')"
              >
                <text class="text-sm font-semibold" :style="{ color: DANGER }">不会</text>
              </view>
              <view class="w-2"></view>
              <view
                id="assess-fuzzy"
                class="flex-1 h-11 rounded-control flex-row items-center justify-center"
                :style="{ backgroundColor: CHIP_WARN }"
                hover-class="pressed-card"
                :hover-start-time="0"
                @click="assess('fuzzy')"
              >
                <text class="text-sm font-semibold" :style="{ color: WARN }">模糊</text>
              </view>
              <view class="w-2"></view>
              <view
                id="assess-known"
                class="flex-1 h-11 rounded-control flex-row items-center justify-center"
                :style="{ backgroundColor: CHIP_RELIABLE }"
                hover-class="pressed-card"
                :hover-start-time="0"
                @click="assess('known')"
              >
                <text class="text-sm font-semibold" :style="{ color: RELIABLE }">会</text>
              </view>
            </view>
          </view>
        </template>

        <!-- 小组小结：先给结论，再给下一步，最后给待巩固题 -->
        <template v-else>
          <view id="practice-summary">
            <ml-card>
              <view class="flex-row items-center">
                <view class="meta-chip">
                  <text class="text-xs" :style="{ color: SMART }">{{ subtrackLabel }}</text>
                </view>
                <view class="meta-chip ml-1.5">
                  <text class="text-xs text-ink-soft">{{ difficultyText }}</text>
                </view>
                <view class="meta-chip ml-1.5">
                  <text class="text-xs text-ink-soft">{{ questions.length }} 题</text>
                </view>
              </view>
              <text class="text-[22px] font-bold text-ink mt-3">{{ summaryHeadline }}</text>
              <text class="text-sm text-ink-soft mt-1 leading-5">{{ summarySubline }}</text>
              <view class="flex-row h-2 rounded-full overflow-hidden mt-3 bg-bg-muted">
                <view
                  v-if="knownPercent > 0"
                  :style="{ width: knownPercent + '%', backgroundColor: RELIABLE }"
                ></view>
                <view
                  v-if="fuzzyPercent > 0"
                  :style="{ width: fuzzyPercent + '%', backgroundColor: WARN }"
                ></view>
                <view
                  v-if="unknownPercent > 0"
                  :style="{ width: unknownPercent + '%', backgroundColor: DANGER }"
                ></view>
              </view>
              <view class="flex-row mt-2">
                <view class="flex-1 flex-row items-center justify-between pr-2">
                  <view class="flex-row items-center">
                    <view
                      class="w-1.5 h-1.5 rounded-full mr-1"
                      :style="{ backgroundColor: RELIABLE }"
                    ></view>
                    <text class="text-xs text-ink-soft">会</text>
                  </view>
                  <text class="text-sm font-semibold font-mono text-ink">{{ knownCount }}</text>
                </view>
                <view class="flex-1 flex-row items-center justify-between pr-2">
                  <view class="flex-row items-center">
                    <view
                      class="w-1.5 h-1.5 rounded-full mr-1"
                      :style="{ backgroundColor: WARN }"
                    ></view>
                    <text class="text-xs text-ink-soft">模糊</text>
                  </view>
                  <text class="text-sm font-semibold font-mono text-ink">{{ fuzzyCount }}</text>
                </view>
                <view class="flex-1 flex-row items-center justify-between">
                  <view class="flex-row items-center">
                    <view
                      class="w-1.5 h-1.5 rounded-full mr-1"
                      :style="{ backgroundColor: DANGER }"
                    ></view>
                    <text class="text-xs text-ink-soft">不会</text>
                  </view>
                  <text class="text-sm font-semibold font-mono text-ink">{{ unknownCount }}</text>
                </view>
              </view>
              <view class="mt-3 pt-2 border-t border-line">
                <text class="text-xs text-ink-soft">本组掌握度已记录，只用于安排下次复习。</text>
              </view>
            </ml-card>
          </view>

          <view class="rounded-card p-4 mt-3" :style="{ backgroundColor: CHIP_SMART }">
            <view class="flex-row items-center">
              <view
                class="w-1.5 h-1.5 rounded-full mr-1.5"
                :style="{ backgroundColor: SMART }"
              ></view>
              <text class="text-xs font-semibold" :style="{ color: SMART }">下一步建议</text>
            </view>
            <text class="text-base font-semibold text-ink mt-2 leading-6">{{ primaryTitle }}</text>
            <text class="text-xs text-ink-soft mt-1 leading-5">{{ nextDesc }}</text>
            <view class="mt-3">
              <ml-button
                :text="primaryText"
                type="primary"
                block
                @tap="onPrimaryAction"
              ></ml-button>
            </view>
            <view v-if="secondaryText.length > 0" class="mt-2">
              <ml-button
                :text="secondaryText"
                type="secondary"
                block
                @tap="onSecondaryAction"
              ></ml-button>
            </view>
          </view>

          <view class="mt-4">
            <view class="flex-row items-center justify-between">
              <text class="text-sm font-semibold text-ink"
                >本组待巩固 · {{ sessionWrong.length }}</text
              >
              <text
                v-if="sessionWrong.length > 0"
                class="text-xs text-ink-soft"
                @click="reviewSessionWrong"
                >全部复习 ›</text
              >
            </view>
            <view v-if="sessionWrong.length > 0" class="mt-2">
              <ml-card :padded="false">
                <view
                  v-for="w in sessionWrong"
                  :key="'w' + w.id"
                  class="p-3.5 border-b border-line"
                >
                  <view class="flex-row items-center">
                    <view class="meta-chip">
                      <text class="text-xs" :style="{ color: SMART }">{{ subtrackLabel }}</text>
                    </view>
                    <view class="meta-chip ml-1.5">
                      <text class="text-xs text-warn">明天复习</text>
                    </view>
                  </view>
                  <text class="text-sm text-ink mt-1 leading-5">{{ w.content }}</text>
                </view>
              </ml-card>
            </view>
            <view v-else class="mt-2">
              <ml-card>
                <text class="text-sm font-semibold text-ink">本组没有待巩固的题</text>
                <text class="text-xs text-ink-soft mt-1 leading-5"
                  >继续保持；到期复习会在「今日复习」里出现。</text
                >
              </ml-card>
            </view>
            <text class="text-xs text-ink-soft mt-2 text-center"
              >「不会」的题已加入错题本；模糊和不会的题明天进入今日复习。</text
            >
          </view>
        </template>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import { QuestionItem, Difficulty } from '../../types/interview.uts'
import { fetchTrainingQuestions } from '../../api/training.uts'
import { fetchPracticeDue } from '../../api/practice.uts'
import { practiceProgress, PracticeResult } from '../../store/practice-progress.uts'
import { subtrackName, difficultyLabel } from '../../data/subtracks.uts'
import { themeValue } from '../../styles/theme.uts'

const SMART = themeValue('smart', '#5856D6')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const WARN = themeValue('warn', '#E08A00')
const DANGER = themeValue('danger', '#DC2626')
const INK = themeValue('ink', '#1C1C1E')
const MIST = themeValue('mist', '#AEAEB2')
const CHIP_SMART = themeValue('chipSmart', '#EFEEFC')
const CHIP_WARN = themeValue('chipWarn', '#FFF4E5')
const CHIP_DANGER = themeValue('chipDanger', '#FFEBEA')
const CHIP_RELIABLE = themeValue('chipReliable', '#E8F7F4')

const loading = ref(true)
const errorText = ref('')
const questions = ref<QuestionItem[]>([])
const idx = ref(0)
const revealed = ref(false)
const done = ref(false)
const results = ref<string[]>([])
const wrongMode = ref(false)
const dueMode = ref(false)
const scrollInto = ref('')
// 自定义导航：顶栏避让状态栏；存 px 字符串，避免小程序端数值被当作无单位值丢弃
const topPad = ref('52px')

let positionId = 'backend'
let subtrack = ''
let difficulty: Difficulty = 'junior'
let count = 5

// 内容库解析常带 Markdown 标记；做题卡片按纯文本呈现，去掉围栏与强调符
function plainText(src: string): string {
  if (src.length === 0) return ''
  let s = src.replace(new RegExp('```[a-zA-Z]*', 'g'), '')
  s = s.replace(/\*\*/g, '')
  s = s.replace(/`/g, '')
  s = s.replace(new RegExp('^[\\t ]*[-*][\\t ]+', 'gm'), '· ')
  return s
}

const currentQuestion = computed((): QuestionItem | null =>
  questions.value.length > 0 ? questions.value[idx.value] : null
)
const currentContent = computed((): string => {
  const q = currentQuestion.value
  return q != null ? plainText(q.content) : ''
})
const currentAnswer = computed((): string => {
  const q = currentQuestion.value
  if (q == null) return ''
  return q.expectedEvidence.length > 0 ? plainText(q.expectedEvidence) : '暂无解析，可换一题或稍后重试。'
})
const knowledgePoint = computed((): string => {
  const q = currentQuestion.value
  if (q == null) return ''
  return q.knowledgePoint.length > 0 ? q.knowledgePoint : '综合应用'
})
const techStack = computed((): string => {
  const q = currentQuestion.value
  return q != null ? q.techStack : ''
})
const subtrackLabel = computed((): string => {
  const q = currentQuestion.value
  if (q != null && q.subAbility.length > 0) return subtrackName(q.subAbility)
  return subtrack.length > 0 ? subtrackName(subtrack) : '综合'
})
const difficultyText = computed((): string => {
  const q = currentQuestion.value
  return difficultyLabel(q != null ? q.difficulty : difficulty)
})
const questionHint = computed((): string => {
  const q = currentQuestion.value
  if (q == null) return ''
  return q.type === 'design' ? '系统设计题 · 关注取舍与边界' : '先想清楚，再看解析'
})
const progressText = computed((): string => {
  if (done.value) return '本组完成'
  return questions.value.length > 0 ? String(idx.value + 1) + ' / ' + String(questions.value.length) : ''
})
const progressPercent = computed((): number => {
  if (questions.value.length === 0) return 0
  if (done.value) return 100
  return Math.round(((idx.value + 1) / questions.value.length) * 100)
})
const knownCount = computed((): number => countResult('known'))
const fuzzyCount = computed((): number => countResult('fuzzy'))
const unknownCount = computed((): number => countResult('unknown'))
// 待巩固 = 模糊 + 不会；不会的题同时进入错题本，模糊题进入 SRS 到期队列
const sessionWrong = computed((): QuestionItem[] => {
  const out: QuestionItem[] = []
  for (let i = 0; i < results.value.length; i++) {
    const r = results.value[i]
    if ((r === 'unknown' || r === 'fuzzy') && i < questions.value.length) out.push(questions.value[i])
  }
  return out
})
const totalCount = computed((): number => questions.value.length)
const knownPercent = computed((): number =>
  totalCount.value > 0 ? Math.round((knownCount.value * 100) / totalCount.value) : 0
)
const fuzzyPercent = computed((): number =>
  totalCount.value > 0 ? Math.round((fuzzyCount.value * 100) / totalCount.value) : 0
)
const unknownPercent = computed((): number => {
  if (totalCount.value === 0) return 0
  const n = 100 - knownPercent.value - fuzzyPercent.value
  return n > 0 ? n : 0
})
const summaryHeadline = computed((): string => {
  if (totalCount.value > 0 && knownCount.value === totalCount.value) return '这组全部答对'
  return '这组答对 ' + knownCount.value + ' 题'
})
const summarySubline = computed((): string => {
  if (totalCount.value > 0 && knownCount.value === totalCount.value) {
    return String(totalCount.value) + ' 题都选了「会」，本次没有新增错题。'
  }
  if (fuzzyCount.value === 0 && unknownCount.value === 0) return '本组结果已记录。'
  let s = '还有 '
  if (fuzzyCount.value > 0) s += String(fuzzyCount.value) + ' 题模糊'
  if (unknownCount.value > 0) {
    if (fuzzyCount.value > 0) s += '、'
    s += String(unknownCount.value) + ' 题不会'
  }
  return s + '；模糊和不会的题会进入复习队列。'
})
const isNormalSet = computed((): boolean => !wrongMode.value && !dueMode.value)
const primaryTitle = computed((): string => {
  if (sessionWrong.value.length > 0) {
    return (
      '先复习 ' +
      sessionWrong.value.length +
      ' 道待巩固题' +
      (isNormalSet.value ? '，再做一组新题' : '')
    )
  }
  return isNormalSet.value ? '状态不错，再来一组保持手感' : '本组复习完成'
})
const primaryText = computed((): string => {
  if (sessionWrong.value.length > 0) return '复习待巩固题'
  return isNormalSet.value ? '再来 5 题' : '返回做题页'
})
const secondaryText = computed((): string => {
  if (sessionWrong.value.length > 0) return isNormalSet.value ? '再来 5 题' : '返回做题页'
  return isNormalSet.value ? '换一组' : ''
})
const nextDesc = computed((): string => {
  if (sessionWrong.value.length > 0) {
    return '模糊和不会的题明天进入「今日复习」；现在过一遍，记忆会更稳。'
  }
  return '换一组同方向、不同细分领域的题，检验迁移能力。'
})

function countResult(r: string): number {
  let n = 0
  for (let i = 0; i < results.value.length; i++) {
    if (results.value[i] === r) n++
  }
  return n
}

onLoad((options: any) => {
  try {
    const win = uni.getWindowInfo()
    const sb = win.statusBarHeight
    topPad.value = (sb > 0 ? sb : 44) + 'px'
  } catch {
    topPad.value = '52px'
  }
  wrongMode.value = options != null && options.mode != null && String(options.mode) === 'wrong'
  dueMode.value = options != null && options.mode != null && String(options.mode) === 'due'
  if (wrongMode.value) {
    questions.value = practiceProgress.wrongQuestions()
    loading.value = false
    return
  }
  if (dueMode.value) {
    loadDue()
    return
  }
  if (options != null) {
    if (options.positionId != null) positionId = String(options.positionId)
    if (options.subtrack != null) subtrack = String(options.subtrack)
    if (options.difficulty != null) difficulty = String(options.difficulty) as Difficulty
    if (options.count != null) count = Number(options.count)
  }
  load()
})

async function load() {
  loading.value = true
  errorText.value = ''
  try {
    const list = await fetchTrainingQuestions(positionId, 'senior', '', count, subtrack, difficulty)
    questions.value = list
    idx.value = 0
    revealed.value = false
    done.value = false
    results.value = []
    if (list.length === 0) {
      errorText.value = ''
    }
  } catch (e: any) {
    const msg = e != null && e.message != null ? String(e.message) : '网络异常，请稍后重试'
    errorText.value = msg
  } finally {
    loading.value = false
  }
}

// 今日复习：拉服务端到期队列（SRS）
async function loadDue() {
  loading.value = true
  errorText.value = ''
  try {
    const r = await fetchPracticeDue('', 10)
    questions.value = r != null ? r.questions : []
    idx.value = 0
    revealed.value = false
    done.value = false
    results.value = []
  } catch (e: any) {
    const msg = e != null && e.message != null ? String(e.message) : '网络异常，请稍后重试'
    errorText.value = msg
  } finally {
    loading.value = false
  }
}

function reveal() {
  revealed.value = true
}

function assess(result: string) {
  const q = currentQuestion.value
  if (q == null) return
  practiceProgress.mark(q, result as PracticeResult)
  results.value.push(result)
  if (idx.value >= questions.value.length - 1) {
    done.value = true
    return
  }
  idx.value = idx.value + 1
  revealed.value = false
  toTop()
}

function toTop() {
  scrollInto.value = ''
  setTimeout(() => {
    scrollInto.value = 'practice-top'
  }, 30)
}

function reviewSessionWrong() {
  const wrongList = sessionWrong.value
  if (wrongList.length === 0) return
  questions.value = wrongList
  idx.value = 0
  revealed.value = false
  done.value = false
  results.value = []
  wrongMode.value = false
  toTop()
}

// 小结主行动：有待巩固题先复习；全对则按场景续组或返回
function onPrimaryAction() {
  if (sessionWrong.value.length > 0) {
    reviewSessionWrong()
    return
  }
  if (isNormalSet.value) {
    againFive()
    return
  }
  goBack()
}

function onSecondaryAction() {
  if (sessionWrong.value.length > 0) {
    if (isNormalSet.value) againFive()
    else goBack()
    return
  }
  if (isNormalSet.value) goBack()
}

// 小结页原地续组：沿用方向/细分/难度直接开 5 题，不退回配置页
function againFive() {
  const url =
    '/pages/training/room?positionId=' +
    positionId +
    '&subtrack=' +
    subtrack +
    '&difficulty=' +
    difficulty +
    '&count=5'
  uni.redirectTo({ url: url })
}

function goBack() {
  uni.navigateBack()
}
</script>

