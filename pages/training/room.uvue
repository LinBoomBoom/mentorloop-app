<template>
  <view class="flex-col h-screen bg-navy relative overflow-hidden">
    <!-- 顶部状态条 -->
    <view
      class="flex-row items-center justify-between px-4"
      :style="{ paddingTop: topPad + 'px', paddingRight: rightPad + 'px' }"
    >
      <view class="flex-row items-center h-11" @click="confirmExit">
        <ml-icon name="arrow-left" :size="16" :color="MIST"></ml-icon>
        <text class="text-sm text-mist ml-1.5">退出</text>
      </view>
      <view class="flex-row items-center h-11">
        <view class="w-1.5 h-1.5 rounded-full bg-reliable mr-1.5"></view>
        <text class="text-xs text-mist">专项训练</text>
      </view>
      <view class="flex-row items-center h-11">
        <ml-icon name="timer" :size="14" :color="SURFACE"></ml-icon>
        <text class="text-sm text-white ml-1">{{ remainText }}</text>
      </view>
    </view>

    <!-- 训练舞台：当前任务卡 -->
    <view class="flex-1 flex-col justify-center px-6">
      <view class="flex-row items-center justify-center">
        <ml-tag
          icon="dumbbell"
          :label="taskTitle"
          bg="rgba(31,182,166,0.18)"
          :icon-color="RELIABLE_LIGHT"
          :color="SURFACE"
        ></ml-tag>
      </view>

      <!-- 当前题目 -->
      <view class="mt-6 rounded-card p-5" :style="{ backgroundColor: 'rgba(255,255,255,0.06)' }">
        <view class="flex-row items-center">
          <view class="w-1.5 h-1.5 rounded-full bg-reliable mr-2"></view>
          <text class="text-xs text-mist">第 {{ doneCount + 1 }} 题</text>
        </view>
        <text class="text-base font-semibold text-white mt-2 leading-6">
          {{
            currentQuestion.content.length > 0
              ? currentQuestion.content
              : loadingQuestions
                ? '正在加载题库…'
                : '准备开始…'
          }}
        </text>
        <text v-if="hint.length > 0" class="text-xs text-mist mt-2">{{ hint }}</text>
      </view>

      <!-- 进度点 -->
      <view class="flex-row justify-center mt-4">
        <view
          v-for="i in totalQuestions"
          :key="i"
          class="w-1.5 h-1.5 rounded-full mx-1"
          :class="i <= doneCount ? 'bg-reliable' : i === doneCount + 1 ? 'bg-white' : ''"
          :style="i > doneCount + 1 ? { backgroundColor: 'rgba(255,255,255,0.2)' } : {}"
        ></view>
      </view>
    </view>

    <!-- 控制条 -->
    <view
      class="flex-row items-center justify-center px-6 pt-4"
      :style="{ paddingBottom: bottomPad + 'px' }"
    >
      <!-- 文字作答 -->
      <view class="flex-col items-center w-16" @click="textMode">
        <view
          class="w-11 h-11 rounded-full flex-row items-center justify-center"
          :style="{ backgroundColor: 'rgba(255,255,255,0.08)' }"
        >
          <ml-icon name="keyboard" :size="18" :color="SURFACE"></ml-icon>
        </view>
        <text class="text-xs text-mist mt-1.5">文字答</text>
      </view>

      <!-- 完成本题 / 停止录音 -->
      <view class="flex-col items-center mx-6" @click="submitDone">
        <view
          class="w-16 h-16 rounded-full flex-row items-center justify-center"
          :class="finished ? 'bg-warn' : recording ? 'bg-danger' : 'bg-reliable'"
        >
          <ml-icon
            :name="finished ? 'check' : recording ? 'square' : 'mic'"
            :size="24"
            :color="SURFACE"
          ></ml-icon>
        </view>
        <text class="text-xs text-white mt-2">{{
          finished ? '查看小结' : recording ? '停止并转写' : '语音作答'
        }}</text>
      </view>

      <!-- 跳过 -->
      <view class="flex-col items-center w-16" @click="skipQuestion">
        <view
          class="w-11 h-11 rounded-full flex-row items-center justify-center"
          :style="{ backgroundColor: 'rgba(255,255,255,0.08)' }"
        >
          <ml-icon name="flag" :size="18" :color="SURFACE"></ml-icon>
        </view>
        <text class="text-xs text-mist mt-1.5">跳过</text>
      </view>
    </view>

    <!-- 文字输入弹窗 -->
    <view
      v-if="textModalVisible"
      class="absolute inset-0 flex-col items-center justify-center"
      :style="{ backgroundColor: 'rgba(3,12,24,0.6)' }"
      @click="cancelText"
    >
      <view class="w-11/12 rounded-card p-4 bg-navy-deep" @click.stop>
        <text class="text-base font-semibold text-white">文字作答</text>
        <text class="text-xs text-mist mt-1 mb-3">写下你的思路，长度建议 ≥ 20 字</text>
        <textarea
          class="w-full h-32 rounded-control p-3 text-sm text-ink bg-surface"
          v-model="textDraft"
          placeholder="在这里输入你的回答…"
          placeholder-class="text-ink-soft"
          :maxlength="1000"
          :auto-focus="true"
        />
        <view class="flex-row justify-end mt-3">
          <ml-button text="取消" type="secondary" @tap="cancelText"></ml-button>
          <view class="ml-2"></view>
          <ml-button
            text="提交"
            type="primary"
            :disabled="textDraft.length === 0"
            @tap="submitText"
          ></ml-button>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad, onUnload } from '@dcloudio/uni-app'
import mlButton from '../../components/ml-button.uvue'
import mlTag from '../../components/ml-tag.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import { userStore } from '../../store/user-profile.uts'
import { quotaStore, FREE_QUOTA } from '../../store/quota.uts'
import {
  trainingHistory,
  TrainingItem,
  reasonForAnswer,
  SKIP_REASON
} from '../../store/training-history.uts'
import { trackEvent } from '../../api/tracking.uts'
import { fetchTrainingQuestions } from '../../api/training.uts'
import { analyzeAnswer } from '../../engine/answer-signal.uts'
import { uploadAsrCloud, AsrResponse } from '../../api/asr.uts'
import { QuestionItem, PositionBlueprint } from '../../types/interview.uts'
import { getPositionName, getExperienceRange } from '../../data/position-options.uts'
import {
  SpeechRecorder,
  RecordResult,
  startRealtimeAsr,
  RealtimeAsrSession,
  transcribe,
  AsrResult,
  speechCapability
} from '../../api/speech.uts'
import { themeValue } from '../../styles/theme.uts'

const MIST = themeValue('mist', '#AEB9CC')
const SURFACE = themeValue('surface', '#FFFFFF')
const RELIABLE_LIGHT = themeValue('reliableLight', '#5CE8D8')

// 训练任务参数（training 页传入）
const taskId = ref('')
const taskTitle = ref('专项训练')
const durationMin = ref(3)
const source = ref('direct') // report（报告薄弱项）| direct（主动）
const domain = ref('') // 定向能力域（'' = 通用训练不限维度）

// 本次训练的过程记录（完成后写入 trainingHistory 供成长页追溯）
const sessionReasons: string[] = []
let skippedCount = 0

// 训练用岗位蓝图（取用户档案默认方向）
const blueprint = ref<PositionBlueprint>({
  positionId: 'backend',
  position: '后端',
  experienceLevel: 'junior',
  experienceRange: '1-3年',
  companyType: '互联网',
  language: '中文',
  target: '求职'
} as PositionBlueprint)

// 训练状态
const totalQuestions = ref(3)
const doneCount = ref(0)
const remain = ref(180)
const finished = ref(false)
const hint = ref('')
// 本场题目（服务端内容库下发，进入房间时一次拉取）
const questions = ref<QuestionItem[]>([])
const questionIndex = ref(0)
const loadingQuestions = ref(true)
let quotaCharged = false
let loadInFlight = false

// 语音作答状态
const recording = ref(false)
const liveTranscript = ref('')
const cap = speechCapability()
const speech = new SpeechRecorder()
let asrSession: RealtimeAsrSession | null = null

// 文字输入弹窗
const textModalVisible = ref(false)
const textDraft = ref('')

const emptyQuestion: QuestionItem = {
  id: '',
  positionId: 'backend',
  abilityDomain: '',
  subAbility: '',
  knowledgePoint: '',
  content: '',
  purpose: '',
  difficulty: 'junior',
  type: 'concept',
  misconceptions: [],
  expectedEvidence: '',
  followupPrompts: [],
  resumeRisk: false
} as QuestionItem
const currentQuestion = ref(emptyQuestion)

// 安全区
const topPad = ref(28)
const bottomPad = ref(16)
// MP 端顶栏右侧让出微信胶囊宽度，避免计时器被胶囊遮挡（同首页 C6）
const rightPad = ref(20)
// #ifdef MP-WEIXIN
rightPad.value = 100
// #endif

let timer = 0

const remainText = computed((): string => {
  const m = Math.floor(remain.value / 60)
  const s = remain.value % 60
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return m + ':' + pad(s)
})

onLoad((options: any) => {
  // 安全区
  try {
    const win = uni.getWindowInfo()
    const sb = win.statusBarHeight
    topPad.value = sb > 0 ? sb + 6 : 28
    const insets = win.safeAreaInsets
    const bottom = insets != null ? insets.bottom : 0
    bottomPad.value = bottom > 0 ? bottom + 10 : 16
  } catch {
    topPad.value = 28
    bottomPad.value = 16
  }

  // 接收训练任务参数
  if (options != null) {
    taskId.value = options.taskId != null ? (options.taskId as string) : 't_custom'
    // title 由训练页/报告页以 encodeURIComponent 传入，这里必须解码，否则中文会显示成 %E4%B8%93...
    taskTitle.value =
      options.title != null ? decodeURIComponent(options.title as string) : '专项训练'
    durationMin.value = options.durationMin != null ? parseInt(options.durationMin as string) : 3
    source.value = options.source != null ? (options.source as string) : 'direct'
    domain.value = options.domain != null ? (options.domain as string) : ''
  }

  // 统一权益门控（额度在题库拉取成功后扣减，避免加载失败损耗次数）
  quotaStore.restore()
  if (!quotaStore.canStartTraining()) {
    uni.showModal({
      title: '今日训练次数已用完',
      content: '免费版每日 ' + String(FREE_QUOTA.trainingsPerDay) + ' 次训练，开通会员不限次数',
      confirmText: '去开通',
      cancelText: '返回',
      success: (r: any) => {
        if (r.confirm) {
          uni.navigateTo({ url: '/pages/membership/paywall?from=gating' })
        } else {
          uni.navigateBack()
        }
      },
      fail: () => {
        uni.navigateBack()
      }
    })
    return
  }
  remain.value = durationMin.value * 60
  // 训练题量按时长估算：约 1 题/分钟，上限 5 题
  totalQuestions.value = durationMin.value < 5 ? 3 : durationMin.value < 10 ? 4 : 5

  // 蓝图取用户档案
  const posId = userStore.profile.positionId
  const expLv = userStore.profile.experienceLevel
  blueprint.value = {
    positionId: posId,
    position: getPositionName(posId),
    experienceLevel: expLv,
    experienceRange: getExperienceRange(expLv),
    companyType: '互联网',
    language: '中文',
    target: '求职'
  } as PositionBlueprint

  initSpeech()
  loadQuestions()
})

// 从服务端内容库拉取本场题目（失败不扣训练额度，弹窗可重试）
function loadQuestions() {
  if (loadInFlight) return
  loadInFlight = true
  loadingQuestions.value = true
  hint.value = ''
  currentQuestion.value = emptyQuestion
  questions.value = []
  questionIndex.value = 0
  doneCount.value = 0
  fetchTrainingQuestions(
    blueprint.value.positionId,
    blueprint.value.experienceLevel,
    domain.value,
    totalQuestions.value
  )
    .then((list: QuestionItem[]) => {
      loadInFlight = false
      loadingQuestions.value = false
      if (list.length === 0) {
        showLoadFailed('当前岗位暂无可训练题目，请稍后重试')
        return
      }
      // 服务端可能因内容库不足返回少于请求的题量：进度点按实收题量展示
      if (list.length < totalQuestions.value) totalQuestions.value = list.length
      questions.value = list
      if (!quotaCharged) {
        quotaStore.consumeTraining()
        quotaCharged = true
      }
      startTimer()
      nextQuestion()
    })
    .catch((e: any) => {
      loadInFlight = false
      loadingQuestions.value = false
      const msg = e != null && e.message != null ? String(e.message) : '题库加载失败'
      showLoadFailed(msg)
    })
}

function showLoadFailed(msg: string) {
  uni.showModal({
    title: '题库加载失败',
    content: msg,
    confirmText: '重试',
    cancelText: '退出',
    success: (r: any) => {
      if (r.confirm) {
        loadQuestions()
      } else {
        uni.navigateBack()
      }
    },
    fail: () => {
      uni.navigateBack()
    }
  })
}

function startTimer() {
  if (timer > 0) return
  timer = setInterval(() => {
    if (remain.value > 0) remain.value = remain.value - 1
    if (remain.value === 0) {
      finishTraining()
    }
  }, 1000)
}

onUnload(() => {
  if (timer > 0) clearInterval(timer)
  // 释放感知层资源
  try {
    if (speech.isRecording()) speech.stop()
    if (asrSession != null) {
      asrSession.stop()
      asrSession = null
    }
  } catch {
    // 忽略卸载阶段错误
  }
})

// 初始化录音器（语音作答）
function initSpeech() {
  speech.init({
    onStart: () => {},
    onStop: (result: RecordResult) => {
      // 平台到点自动停止与手动停止共用收口：复位录音态
      recording.value = false
      handleRecordingStopped(result)
    },
    onError: (_errMsg: string) => {
      recording.value = false
      hint.value = '录音失败，请改用文字作答'
    }
  })
}

// 按服务端下发的题目顺序出下一题；题目用尽即收尾
function nextQuestion() {
  hint.value = ''
  if (questionIndex.value >= questions.value.length) {
    finishTraining()
    return
  }
  currentQuestion.value = questions.value[questionIndex.value]
  questionIndex.value = questionIndex.value + 1
}

// 即时反馈：基于答案信号给出提示（训练核心：单维突破 · 即时反馈）
function feedbackFor(answerText: string): string {
  const signal = analyzeAnswer(answerText, currentQuestion.value.id)
  const tips: string[] = []
  if (signal.isVague) tips.push('回答偏模糊，试着给出明确的结论与依据')
  if (!signal.hasMetrics) tips.push('缺少量化指标，补上数字（如 QPS、耗时、占比）')
  if (signal.isAbsolute) tips.push('有绝对化表述，注意边界条件与反例')
  if (tips.length === 0) return '回答结构清晰，继续保持：结论 → 依据 → 指标'
  return tips.join('；')
}

function submitDone() {
  if (finished.value) {
    finishTraining()
    return
  }
  if (recording.value) {
    // 正在录音：停止并转写
    stopVoice()
    return
  }
  startVoice()
}

// 开始语音作答（微信端同步开启实时识别）
function startVoice() {
  recording.value = true
  liveTranscript.value = ''
  hint.value = ''
  if (cap.platform === 'mp-weixin') {
    asrSession = startRealtimeAsr((text: string, stable: boolean) => {
      if (stable) {
        if (text.length > 0) liveTranscript.value = liveTranscript.value + text
      } else if (text.length > 0) {
        hint.value = text
      }
    })
  }
  hint.value = asrSession != null ? '正在聆听，请开始作答…' : '正在聆听…'
  if (speech.isReady()) {
    speech.start()
  } else {
    recording.value = false
    hint.value = '当前设备不支持录音，请切换文字作答'
  }
}

// 停止录音并转写
function stopVoice() {
  recording.value = false
  hint.value = '转写中…'
  if (asrSession != null) {
    asrSession.stop()
    asrSession = null
  }
  if (speech.isReady() && speech.isRecording()) {
    speech.stop()
  } else {
    finishTranscribe(liveTranscript.value)
  }
}

// 录音结束：按平台路由转写
// MP：优先用实时识别文本；实时识别不可用时走云存储中转 + 服务端 ASR（与面试房间同一条兜底链路）
function handleRecordingStopped(result: RecordResult) {
  if (cap.platform === 'mp-weixin') {
    const live = liveTranscript.value.trim()
    if (live.length > 0) {
      finishTranscribe(live)
      return
    }
    if (!result.ok || result.audioPath.length === 0) {
      finishTranscribe('')
      return
    }
    uploadAsrCloud(result.audioPath)
      .then((r: AsrResponse) => {
        finishTranscribe(r.text)
      })
      .catch(() => {
        finishTranscribe('')
      })
    return
  }
  if (!result.ok || result.audioPath.length === 0) {
    finishTranscribe('')
    return
  }
  transcribe(result.audioPath)
    .then((r: AsrResult) => {
      finishTranscribe(r.ok ? r.text : '')
    })
    .catch(() => {
      finishTranscribe('')
    })
}

// 转写收口：有文本给即时反馈，无文本提示降级
function finishTranscribe(text: string) {
  const t = text.trim()
  if (t.length === 0) {
    hint.value = '没有听清你的回答，请重试或切换文字作答'
    return
  }
  applyFeedback(t, 'voice')
}

// 即时反馈 + 推进（语音/文字共用）
function applyFeedback(answerText: string, inputMode: string) {
  hint.value = feedbackFor(answerText)
  // 记录错因（文档 02 §2.3：不会/说不清/项目证据不足/推理不完整/表达结构差）
  const sig = analyzeAnswer(answerText, currentQuestion.value.id)
  const reason = reasonForAnswer(sig.isVague, sig.hasMetrics, sig.isAbsolute)
  if (reason != null && !sessionReasons.includes(reason)) {
    sessionReasons.push(reason)
  }
  doneCount.value = doneCount.value + 1
  trackEvent('training_task_complete', {
    taskId: taskId.value,
    source: source.value,
    questionIndex: doneCount.value,
    inputMode: inputMode
  })
  if (doneCount.value >= totalQuestions.value) {
    finishTraining()
    return
  }
  setTimeout(() => {
    nextQuestion()
  }, 1200)
}

function skipQuestion() {
  if (finished.value) return
  skippedCount += 1
  if (!sessionReasons.includes(SKIP_REASON)) {
    sessionReasons.push(SKIP_REASON)
  }
  doneCount.value = doneCount.value + 1
  if (doneCount.value >= totalQuestions.value) {
    finishTraining()
    return
  }
  nextQuestion()
}

function finishTraining() {
  if (finished.value) return
  finished.value = true
  if (timer > 0) {
    clearInterval(timer)
    timer = 0
  }
  // 北极星：完成专项训练任务（source=report 表示来自报告薄弱项）
  trackEvent('training_task_complete', {
    taskId: taskId.value,
    source: source.value,
    completed: true,
    durationMin: durationMin.value
  })
  // 回写训练记录（成长页追溯 + 与面试报告对照）
  trainingHistory.load()
  trainingHistory.push({
    id: taskId.value,
    title: taskTitle.value,
    durationMin: durationMin.value,
    source: source.value === 'report' ? 'report' : 'direct',
    domain: domain.value,
    questions: doneCount.value - skippedCount,
    skipped: skippedCount,
    reasons: sessionReasons.slice(),
    completedAt: Date.now()
  } as TrainingItem)
  uni.showToast({ title: '训练完成，已记录本次表现', icon: 'none' })
  setTimeout(() => {
    uni.navigateBack()
  }, 1200)
}

function textMode() {
  if (finished.value) return
  textDraft.value = ''
  textModalVisible.value = true
}

function cancelText() {
  textModalVisible.value = false
  textDraft.value = ''
}

function submitText() {
  const t = textDraft.value.trim()
  if (t.length === 0) return
  textModalVisible.value = false
  applyFeedback(t, 'text')
  textDraft.value = ''
}

function confirmExit() {
  uni.showModal({
    title: '结束训练',
    content: '当前进度不会保存，确认退出？',
    success: (r: any) => {
      if (r.confirm) {
        if (timer > 0) clearInterval(timer)
        uni.navigateBack()
      }
    }
  })
}
</script>
