<template>
  <scroll-view class="h-screen bg-bg-light" scroll-y="true">
    <!-- 品牌头部带（MASTER.md §A1 品牌锚点，静态无 blur） -->
    <view class="ml-brand-band px-5 pt-4 pb-9 flex-row items-center justify-between">
      <view class="flex-col">
        <text class="text-[22px] font-bold text-white">专项训练</text>
        <text class="text-xs text-mist mt-1">报告驱动的定向训练 · 即时反馈</text>
      </view>
      <ml-icon name="dumbbell" :size="22" :color="RELIABLE_LIGHT"></ml-icon>
    </view>
    <view class="px-4 pb-6 pt-4">
      <template v-if="recommended.length > 0">
        <!-- 报告推荐任务 -->
        <view class="mt-5">
          <ml-section-header
            title="为你推荐"
            :caption="'基于 ' + reportDate + ' 的评估报告'"
            action-text="查看报告"
            @action="goReport"
          ></ml-section-header>
          <view class="mb-2.5" v-for="t in recommended" :key="'r_' + t.id">
            <ml-card pressable @tap="startTaskEntry(t.id, t.title, t.durationMin)">
              <view class="flex-row items-center">
                <view
                  class="w-11 h-11 rounded-control flex-col items-center justify-center mr-3"
                  :style="{ backgroundColor: t.priority === 1 ? CHIP_WARN : CHIP_SMART }"
                >
                  <ml-icon
                    name="target"
                    :size="18"
                    :color="t.priority === 1 ? WARN : SMART"
                  ></ml-icon>
                </view>
                <view class="flex-col flex-1">
                  <view class="flex-row items-center">
                    <text class="text-base font-medium text-ink flex-1">{{ t.title }}</text>
                    <ml-tag
                      :label="t.priority === 1 ? '最高优先' : 'P' + t.priority"
                      :bg="t.priority === 1 ? CHIP_WARN : BG_MUTED"
                      :color="t.priority === 1 ? WARN : INK_SOFT"
                    ></ml-tag>
                  </view>
                  <view class="flex-row items-center mt-1.5">
                    <ml-icon name="clock" :size="11" :color="MIST"></ml-icon>
                    <text class="text-xs text-ink-soft ml-1">{{ t.durationMin }} 分钟</text>
                    <view class="w-1 h-1 rounded-full bg-line mx-2"></view>
                    <text class="text-xs text-ink-soft">单维突破 · 即时反馈</text>
                  </view>
                </view>
                <ml-icon name="chevron-right" :size="17" :color="MIST"></ml-icon>
              </view>
            </ml-card>
          </view>
        </view>
      </template>

      <!-- 分维度突破 -->
      <view class="mt-5">
        <ml-section-header
          title="分维度突破"
          caption="六大能力维度 · 对照最近报告等级"
        ></ml-section-header>
        <view class="flex-row flex-wrap">
          <view
            v-for="(d, i) in dimensions"
            :key="d.key"
            class="bg-surface rounded-card border border-line p-3 mb-2.5 pressable"
            :class="i % 2 === 0 ? 'w-[calc(50%-5px)] mr-2.5' : 'w-[calc(50%-5px)]'"
            hover-class="pressed-card"
            :hover-start-time="0"
            @click="startTaskEntry('dim_' + d.key, d.label + '突破', 5)"
          >
            <view class="flex-row items-center justify-between">
              <view
                class="w-9 h-9 rounded-control flex-row items-center justify-center"
                :style="{ backgroundColor: d.tint }"
              >
                <ml-icon :name="d.icon" :size="17" :color="d.color"></ml-icon>
              </view>
              <ml-tag
                :label="d.level.length > 0 ? d.level : '待评估'"
                :bg="d.levelBg.length > 0 ? d.levelBg : BG_MUTED"
                :color="d.levelColor.length > 0 ? d.levelColor : MIST"
              ></ml-tag>
            </view>
            <text class="text-sm font-medium text-ink mt-2.5">{{ d.label }}</text>
            <text class="text-xs text-ink-soft mt-0.5">权重 {{ d.weight }}%</text>
          </view>
        </view>
      </view>

      <!-- 通用快练 -->
      <view class="mt-4">
        <ml-section-header title="通用快练" caption="不限维度 · 利用碎片时间"></ml-section-header>
        <ml-card :padded="false">
          <view
            v-for="(t, i) in genericTasks"
            :key="'g_' + t.id"
            class="flex-row items-center px-4 h-[60px]"
            :class="i < genericTasks.length - 1 ? 'border-b border-line' : ''"
            hover-class="pressed-row"
            :hover-start-time="0"
            @click="startTaskEntry(t.id, t.title, t.durationMin)"
          >
            <view
              class="w-9 h-9 rounded-control bg-chip-reliable flex-row items-center justify-center mr-3"
            >
              <ml-icon name="play" :size="15" :color="RELIABLE"></ml-icon>
            </view>
            <view class="flex-col flex-1">
              <text class="text-sm text-ink">{{ t.title }}</text>
              <text class="text-xs text-ink-soft mt-0.5">
                {{ t.durationMin }} 分钟 · 单维突破
              </text>
            </view>
            <view class="h-7 px-3 rounded-chip border border-line flex-row items-center">
              <text class="text-xs text-smart">开始</text>
            </view>
          </view>
        </ml-card>
      </view>

      <!-- 空状态引导 -->
      <view v-if="recommended.length === 0" class="mt-5">
        <ml-card>
          <ml-empty
            icon="dumbbell"
            :icon-color="SMART"
            :icon-bg="CHIP_SMART"
            title="还没有个性化推荐"
            desc="完成一次模拟面试后，这里会根据你的薄弱维度生成训练计划"
          >
            <ml-button
              text="去完成一次面试"
              type="primary"
              block
              @click="startInterview"
            ></ml-button>
          </ml-empty>
        </ml-card>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlTag from '../../components/ml-tag.uvue'
import mlSectionHeader from '../../components/ml-section-header.uvue'
import mlEmpty from '../../components/ml-empty.uvue'
import { DIM_COLOR, DIM_TINT, themeValue } from '../../styles/theme.uts'
import { dimIcon, levelColor, levelTint } from '../../styles/score-display.uts'
import { reportHistory, ReportRecord } from '../../store/report-history.uts'
import { quotaStore } from '../../store/quota.uts'
import { domainOfTaskId } from '../../store/training-history.uts'
import { trackEvent } from '../../api/tracking.uts'
import { TrainingTask, ScoreLevel, DIMENSION_WEIGHT, DIMENSION_LABEL } from '../../types/scoring.uts'

const SMART = themeValue('smart', '#5B6CFF')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const WARN = themeValue('warn', '#E08A00')
const BG_MUTED = themeValue('bgMuted', '#F1F5F9')
const INK_SOFT = themeValue('inkSoft', '#5B6472')
const MIST = themeValue('mist', '#AEB9CC')
const CHIP_SMART = themeValue('chipSmart', '#EEF1FF')
const CHIP_WARN = themeValue('chipWarn', '#FFF3E0')
const RELIABLE_LIGHT = themeValue('reliableLight', '#5CE8D8')

type TrainingEntry = {
  id: string
  title: string
  durationMin: number
}

type DimCard = {
  key: string
  label: string
  icon: string
  color: string
  tint: string
  weight: number
  level: string
  levelBg: string
  levelColor: string
}

const genericTasks: TrainingEntry[] = [
  { id: 'gt1', title: '并发基础快练', durationMin: 3 } as TrainingEntry,
  { id: 'gt2', title: '系统设计快练', durationMin: 5 } as TrainingEntry,
  { id: 'gt3', title: '项目经历表达', durationMin: 10 } as TrainingEntry
]

const recommended = ref<TrainingTask[]>([])
const latest = ref<ReportRecord | null>(null)

// 六维图标单一来源：styles/score-display.uts（dimIcon）；色板单源 styles/theme.uts（DIM_COLOR / DIM_TINT）
const dimensions = computed((): DimCard[] => {
  const keys = ['knowledge', 'engineering', 'analysis', 'communication', 'learning', 'motivation']
  const out: DimCard[] = []
  const levelMap: { [key: string]: ScoreLevel } = {}
  if (latest.value != null) {
    const dims = latest.value.report.dimensions
    for (let i = 0; i < dims.length; i++) {
      levelMap[dims[i].dimension] = dims[i].level
    }
  }
  for (let i = 0; i < keys.length; i++) {
    const k = keys[i]
    const lv = levelMap[k]
    const hasLevel = lv != null
    out.push({
      key: k,
      label: DIMENSION_LABEL[k],
      icon: dimIcon(k),
      color: DIM_COLOR[k] != null ? DIM_COLOR[k] : SMART,
      tint: DIM_TINT[k] != null ? DIM_TINT[k] : CHIP_SMART,
      weight: Math.round((DIMENSION_WEIGHT[k] != null ? DIMENSION_WEIGHT[k] : 0) * 100),
      level: hasLevel ? lv : '',
      levelBg: hasLevel ? levelTint(lv) : '',
      levelColor: hasLevel ? levelColor(lv) : ''
    } as DimCard)
  }
  return out
})

const reportDate = computed((): string => {
  const r = latest.value
  if (r == null) return ''
  const d = new Date(r.at)
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return pad(d.getMonth() + 1) + '-' + pad(d.getDate())
})

onShow(() => {
  reportHistory.load()
  const rec = reportHistory.latest()
  latest.value = rec
  if (rec != null) {
    recommended.value = rec.report.trainingPlan
  } else {
    recommended.value = []
  }
})

// 模板入口：把任务参数转成 TrainingEntry 再进训练房间
function startTaskEntry(id: string, title: string, durationMin: number) {
  startTask({ id: id, title: title, durationMin: durationMin } as TrainingEntry)
}

// 进入训练房间（3/5/10 分钟碎片化训练；推荐任务标记来源=报告薄弱项）
function startTask(task: TrainingEntry | null = null) {
  // 权益门控：免费层每日训练额度（会员不限）；额度扣减在训练房间 onLoad 统一执行
  quotaStore.restore()
  if (!quotaStore.canStartTraining()) {
    trackEvent('quota_exceeded', { scene: 'training' })
    uni.showModal({
      title: '今日训练次数已用完',
      content: '免费版每日 3 次训练，开通会员不限次数',
      confirmText: '去开通',
      cancelText: '明天再练',
      success: (r: any) => {
        if (r.confirm) {
          uni.navigateTo({ url: '/pages/membership/paywall?from=gating' })
        }
      }
    })
    return
  }
  const id = task != null ? task.id : 't_custom'
  const title = task != null ? task.title : '专项训练'
  const dur = task != null ? task.durationMin : 5
  const src = task != null && task.id.indexOf('gt') !== 0 ? 'report' : 'direct'
  const domain = domainOfTaskId(id)
  const url =
    '/pages/training/room?taskId=' +
    encodeURIComponent(id) +
    '&title=' +
    encodeURIComponent(title) +
    '&durationMin=' +
    dur +
    '&source=' +
    src +
    '&domain=' +
    domain
  uni.navigateTo({ url: url })
}

function startInterview() {
  uni.switchTab({ url: '/pages/index/index' })
}

function goReport() {
  uni.switchTab({ url: '/pages/report/report' })
}
</script>
