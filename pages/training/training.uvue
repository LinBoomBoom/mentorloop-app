<template>
  <view class="h-screen bg-bg-light">
    <scroll-view class="h-screen" scroll-y="true">
      <view class="px-5 pt-4 pb-28">
        <text class="text-xs text-ink-soft">按细分领域与难度刷题 · 先想后看解析</text>

        <!-- 本机进度 -->
        <view class="mt-4 rounded-card p-4" :style="statsStyle">
          <view class="flex-row items-center justify-between">
            <view class="flex-col">
              <text class="text-xs" :style="{ color: 'rgba(255,255,255,0.6)' }">累计做题</text>
              <text class="text-[22px] font-bold font-mono text-white mt-1">{{ stats.total }}</text>
            </view>
            <view class="flex-col items-center">
              <text class="text-xs" :style="{ color: 'rgba(255,255,255,0.6)' }">会</text>
              <text class="text-base font-bold font-mono mt-1" :style="{ color: RELIABLE_LIGHT }">{{
                stats.known
              }}</text>
            </view>
            <view class="flex-col items-center">
              <text class="text-xs" :style="{ color: 'rgba(255,255,255,0.6)' }">模糊</text>
              <text class="text-base font-bold font-mono mt-1" :style="{ color: WARN_LIGHT }">{{
                stats.fuzzy
              }}</text>
            </view>
            <view class="flex-col items-end">
              <text class="text-xs" :style="{ color: 'rgba(255,255,255,0.6)' }">错题</text>
              <text class="text-base font-bold font-mono text-white mt-1">{{
                stats.wrongCount
              }}</text>
            </view>
          </view>
        </view>

        <!-- 方向 -->
        <view class="flex-row items-center justify-between mt-5 mb-2">
          <text class="text-base font-bold text-ink">方向</text>
          <text class="text-xs text-ink-soft">共 {{ subtracks.length }} 个细分领域</text>
        </view>
        <view class="flex-row flex-wrap">
          <view
            v-for="p in positions"
            :id="'pos-' + p.id"
            :key="p.id"
            class="h-9 px-3.5 rounded-control mr-2 mb-2 flex-row items-center border"
            :class="positionId === p.id ? 'bg-smart border-smart' : 'bg-surface border-line'"
            hover-class="pressed-chip"
            :hover-start-time="0"
            @click="selectPosition(p.id)"
          >
            <ml-icon
              :name="p.icon"
              :size="14"
              :color="positionId === p.id ? SURFACE : INK_SOFT"
            ></ml-icon>
            <text
              class="text-sm ml-1.5"
              :class="positionId === p.id ? 'text-white font-semibold' : 'text-ink'"
              >{{ p.name }}</text
            >
          </view>
        </view>

        <!-- 细分领域 -->
        <view class="flex-row items-center justify-between mt-4 mb-2">
          <text class="text-base font-bold text-ink">细分领域</text>
          <text class="text-xs text-ink-soft">选一个方向集中练</text>
        </view>
        <view class="flex-col">
          <view v-for="s in subtracks" :id="'sub-' + s.id" :key="s.id" class="mb-2">
            <ml-card :selected="selectedSub === s.id" pressable @tap="selectedSub = s.id">
              <view class="flex-row items-center">
                <view
                  class="w-9 h-9 rounded-control flex-row items-center justify-center"
                  :style="{ backgroundColor: selectedSub === s.id ? CHIP_SMART : BG_MUTED }"
                >
                  <ml-icon
                    :name="s.icon"
                    :size="17"
                    :color="selectedSub === s.id ? SMART : INK_SOFT"
                  ></ml-icon>
                </view>
                <view class="flex-col flex-1 ml-3">
                  <view class="flex-row items-center justify-between">
                    <text class="text-sm font-semibold text-ink">{{ s.name }}</text>
                    <text class="text-xs text-ink-soft ml-2">{{ statText(s.id) }}</text>
                  </view>
                  <text class="text-xs text-ink-soft mt-0.5">{{ s.desc }}</text>
                </view>
              </view>
            </ml-card>
          </view>
        </view>

        <!-- 难度 -->
        <text class="text-base font-bold text-ink mt-3">难度</text>
        <view class="flex-row p-1 rounded-control bg-bg-muted mt-2">
          <view
            v-for="d in difficulties"
            :key="d.id"
            class="flex-1 h-9 rounded-control flex-col items-center justify-center"
            :class="difficulty === d.id ? 'bg-surface' : ''"
            hover-class="pressed-row"
            :hover-start-time="0"
            @click="difficulty = d.id"
          >
            <text
              class="text-sm"
              :class="difficulty === d.id ? 'font-semibold text-ink' : 'text-ink-soft'"
              >{{ d.label }}</text
            >
          </view>
        </view>
        <text class="text-xs text-ink-soft mt-1.5">{{ difficultyDesc }}</text>

        <!-- 题量 -->
        <view class="flex-row items-center justify-between mt-4">
          <text class="text-base font-bold text-ink">题量</text>
          <text class="text-xs text-ink-soft">一组约 5–10 分钟</text>
        </view>
        <view class="flex-row mt-2">
          <view
            v-for="n in COUNT_OPTIONS"
            :key="'c' + n"
            class="h-9 px-4 rounded-control mr-2 flex-row items-center border"
            :class="count === n ? 'bg-smart border-smart' : 'bg-surface border-line'"
            hover-class="pressed-chip"
            :hover-start-time="0"
            @click="count = n"
          >
            <text class="text-sm" :class="count === n ? 'text-white font-semibold' : 'text-ink'"
              >{{ n }} 题</text
            >
          </view>
        </view>

        <!-- 错题本 -->
        <view v-if="stats.wrongCount > 0" class="mt-4">
          <ml-card pressable @tap="startWrongReview">
            <view class="flex-row items-center">
              <view
                class="w-9 h-9 rounded-control flex-row items-center justify-center"
                :style="{ backgroundColor: CHIP_WARN }"
              >
                <ml-icon name="book-marked" :size="17" :color="WARN"></ml-icon>
              </view>
              <view class="flex-col flex-1 ml-3">
                <text class="text-sm font-semibold text-ink"
                  >错题本 · {{ stats.wrongCount }} 题</text
                >
                <text class="text-xs text-ink-soft mt-0.5">复习时选「会」会自动移出</text>
              </view>
              <ml-icon name="chevron-right" :size="16" :color="MIST"></ml-icon>
            </view>
          </ml-card>
        </view>

        <text class="text-xs text-ink-soft mt-4 text-center"
          >题目来自内容库；参考解析为答案节选，非完整标准答案</text
        >
      </view>
    </scroll-view>

    <!-- 固定开始栏（拇指热区；滚动内容已留出底部空间） -->
    <view
      class="absolute left-0 right-0 bottom-0 bg-surface border-t border-line px-5 pt-3"
      :style="{ paddingBottom: bottomPad }"
    >
      <view
        id="practice-start"
        class="h-12 rounded-control flex-row items-center justify-center"
        :style="{ backgroundColor: SMART, opacity: selectedSub.length === 0 ? 0.4 : 1 }"
        hover-class="pressed-card"
        :hover-start-time="0"
        @click="startPractice"
      >
        <text class="text-base font-semibold text-white">开始做题 · {{ count }} 题</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import { userStore } from '../../store/user-profile.uts'
import { POSITION_OPTIONS } from '../../data/position-options.uts'
import {
  PRACTICE_DIFFICULTIES,
  subtracksOf,
  defaultDifficultyFor,
  PracticeDifficultyOption
} from '../../data/subtracks.uts'
import { PositionId, Difficulty } from '../../types/interview.uts'
import { practiceProgress, PracticeStats } from '../../store/practice-progress.uts'
import { themeValue } from '../../styles/theme.uts'

const SMART = themeValue('smart', '#5856D6')
const RELIABLE_LIGHT = themeValue('reliableLight', '#5CE8D8')
const WARN = themeValue('warn', '#E08A00')
const WARN_LIGHT = themeValue('warnLight', '#F5C97B')
const INK_SOFT = themeValue('inkSoft', '#6E6E73')
const MIST = themeValue('mist', '#AEAEB2')
const BG_MUTED = themeValue('bgMuted', '#E9E9EF')
const CHIP_SMART = themeValue('chipSmart', '#EFEEFC')
const CHIP_WARN = themeValue('chipWarn', '#FFF4E5')
const NAVY = themeValue('navy', '#0F2C4C')
const NAVY_DEEP = themeValue('navyDeep', '#0B2138')

const COUNT_OPTIONS: number[] = [5, 10]
const difficulties: PracticeDifficultyOption[] = PRACTICE_DIFFICULTIES

type PositionChip = { id: PositionId; name: string; icon: string }
const POSITION_ICON: Record<string, string> = {
  frontend: 'layout-grid',
  backend: 'server',
  devops: 'shield',
  ai: 'brain'
}
const positions: PositionChip[] = []
for (let i = 0; i < POSITION_OPTIONS.length; i++) {
  const p = POSITION_OPTIONS[i]
  const icon = POSITION_ICON[p.id] != null ? POSITION_ICON[p.id] : 'target'
  positions.push({ id: p.id, name: p.name, icon: icon } as PositionChip)
}

const positionId = ref<PositionId>(userStore.profile.positionId)
const subtracks = computed(() => subtracksOf(positionId.value))
const selectedSub = ref(subtracks.value.length > 0 ? subtracks.value[0].id : '')
const difficulty = ref<Difficulty>(defaultDifficultyFor(userStore.profile.experienceLevel))
const count = ref(5)
// 底部固定开始栏避让 home indicator（px 字符串，避免小程序端丢单位）
const bottomPad = ref('24px')
const stats = ref<PracticeStats>({
  total: 0,
  known: 0,
  fuzzy: 0,
  unknown: 0,
  wrongCount: 0
} as PracticeStats)

const statsStyle = {
  backgroundColor: NAVY_DEEP,
  backgroundImage: 'linear-gradient(155deg, ' + NAVY + ' 0%, ' + NAVY_DEEP + ' 100%)'
}

const difficultyDesc = computed((): string => {
  for (let i = 0; i < difficulties.length; i++) {
    if (difficulties[i].id === difficulty.value) return difficulties[i].desc
  }
  return ''
})

function statText(subtrack: string): string {
  const s = practiceProgress.statsOf(subtrack)
  if (s == null || s.total === 0) return '未做'
  return s.total + ' 题 · 会 ' + s.known
}

function selectPosition(id: PositionId) {
  positionId.value = id
  const list = subtracksOf(id)
  selectedSub.value = list.length > 0 ? list[0].id : ''
}

function startPractice() {
  if (selectedSub.value.length === 0) return
  uni.navigateTo({
    url:
      '/pages/training/room?positionId=' +
      positionId.value +
      '&subtrack=' +
      selectedSub.value +
      '&difficulty=' +
      difficulty.value +
      '&count=' +
      String(count.value)
  })
}

function startWrongReview() {
  uni.navigateTo({ url: '/pages/training/room?mode=wrong' })
}

onShow(() => {
  try {
    const win = uni.getWindowInfo()
    const insets = win.safeAreaInsets
    const bottom = insets != null ? insets.bottom : 0
    bottomPad.value = (bottom > 0 ? bottom + 14 : 24) + 'px'
  } catch {
    bottomPad.value = '24px'
  }
  stats.value = practiceProgress.summary()
  // 画像变化后保证选中项仍然有效
  const list = subtracksOf(positionId.value)
  let valid = false
  for (let i = 0; i < list.length; i++) {
    if (list[i].id === selectedSub.value) valid = true
  }
  if (!valid) selectedSub.value = list.length > 0 ? list[0].id : ''
})
</script>
