<template>
  <scroll-view class="h-screen bg-bg-light" scroll-y="true">
    <view class="px-4 pt-3 pb-6">
      <!-- 资料卡（深色品牌面） -->
      <view class="bg-navy rounded-2xl p-4 relative overflow-hidden">
        <view class="absolute -right-8 -top-10 w-32 h-32 rounded-full bg-smart opacity-20"></view>
        <view
          class="absolute right-16 -bottom-12 w-24 h-24 rounded-full bg-reliable opacity-15"
        ></view>
        <view class="flex-row items-center">
          <view
            class="w-14 h-14 rounded-full flex-row items-center justify-center mr-3"
            :style="{
              backgroundColor: 'rgba(255,255,255,0.14)',
              border: '1px solid rgba(255,255,255,0.2)'
            }"
          >
            <ml-icon name="user" :size="26" color="#FFFFFF"></ml-icon>
          </view>
          <view class="flex-col flex-1">
            <text class="text-lg font-semibold text-white">{{ nickname }}</text>
            <view class="flex-row items-center mt-1">
              <view
                class="h-5 px-2 rounded-full flex-row items-center"
                :style="{ backgroundColor: planBadgeBg }"
              >
                <ml-icon :name="planBadgeIcon" :size="10" :color="planBadgeColor"></ml-icon>
                <text class="text-[10px] ml-0.5" :style="{ color: planBadgeColor }">
                  {{ planLabel }}
                </text>
              </view>
              <text class="text-[11px] text-mist ml-2">
                {{ positionLabel }} · {{ experienceLabel }}
              </text>
            </view>
          </view>
          <view
            class="w-8 h-8 rounded-full flex-row items-center justify-center"
            hover-class="row-pressed"
            :hover-start-time="0"
            @click="editProfile"
          >
            <ml-icon name="chevron-right" :size="18" color="#AEB9CC"></ml-icon>
          </view>
        </view>

        <!-- 未登录：登录入口 -->
        <view v-if="!loggedIn" class="mt-4">
          <ml-button text="登录 / 注册" block @click="goLogin"></ml-button>
        </view>
      </view>

      <!-- 数据行 -->
      <view class="bg-surface rounded-2xl border border-line shadow-card px-2 py-3.5 flex-row mt-3">
        <view class="flex-1 flex-col items-center" @click="goGrowth">
          <text class="text-lg font-bold text-ink">{{ statInterviews }}</text>
          <text class="text-[11px] text-ink-soft mt-0.5">模拟面试</text>
        </view>
        <view class="w-px h-9 bg-line"></view>
        <view class="flex-1 flex-col items-center" @click="goReport">
          <text class="text-lg font-bold text-ink">{{ statReports }}</text>
          <text class="text-[11px] text-ink-soft mt-0.5">评估报告</text>
        </view>
        <view class="w-px h-9 bg-line"></view>
        <view class="flex-1 flex-col items-center" @click="goTraining">
          <text class="text-lg font-bold text-smart">{{ statTodos }}</text>
          <text class="text-[11px] text-ink-soft mt-0.5">待训练</text>
        </view>
      </view>

      <!-- 会员卡（权益状态 + 购买入口） -->
      <view
        class="bg-navy rounded-2xl p-4 mt-3 flex-row items-center relative overflow-hidden"
        hover-class="row-pressed"
        :hover-start-time="0"
        @click="goPaywall"
      >
        <view class="absolute -right-6 -top-8 w-24 h-24 rounded-full bg-warn opacity-15"></view>
        <view
          class="w-10 h-10 rounded-full flex-row items-center justify-center mr-3"
          :style="{ backgroundColor: 'rgba(245,201,123,0.2)' }"
        >
          <ml-icon name="crown" :size="20" color="#F5C97B"></ml-icon>
        </view>
        <view class="flex-col flex-1">
          <text class="text-sm font-semibold text-white">{{ planLabel }}权益</text>
          <text class="text-[11px] text-mist mt-0.5">{{ quotaText }}</text>
        </view>
        <view
          class="h-8 px-3 rounded-full flex-row items-center"
          :style="{
            backgroundColor: plan.value === 'member' ? 'rgba(255,255,255,0.14)' : '#F5C97B'
          }"
        >
          <text
            class="text-xs font-semibold"
            :style="{ color: plan.value === 'member' ? '#FFFFFF' : '#0B2138' }"
          >
            {{ plan.value === 'member' ? '查看权益' : '立即开通' }}
          </text>
        </view>
      </view>

      <!-- 功能宫格 -->
      <view class="mt-3">
        <ml-card :padded="false">
          <view class="flex-row py-3">
            <view
              v-for="f in features"
              :key="f.text"
              class="flex-1 flex-col items-center pressable"
              hover-class="row-pressed"
              :hover-start-time="0"
              @click="f.onTap"
            >
              <view
                class="w-11 h-11 rounded-xl flex-row items-center justify-center"
                :style="{ backgroundColor: f.tint }"
              >
                <ml-icon :name="f.icon" :size="19" :color="f.color"></ml-icon>
              </view>
              <text class="text-xs text-ink mt-1.5">{{ f.text }}</text>
            </view>
          </view>
        </ml-card>
      </view>

      <!-- 设置分组 -->
      <view class="mt-3">
        <ml-card :padded="false">
          <view
            v-for="(s, i) in settings"
            :key="s.text"
            class="flex-row items-center px-4 h-[56px]"
            :class="i < settings.length - 1 ? 'border-b border-line' : ''"
            hover-class="row-pressed"
            :hover-start-time="0"
            @click="s.onTap"
          >
            <view
              class="w-8 h-8 rounded-lg flex-row items-center justify-center mr-3"
              :style="{ backgroundColor: s.tint }"
            >
              <ml-icon :name="s.icon" :size="16" :color="s.color"></ml-icon>
            </view>
            <view class="flex-col flex-1">
              <text class="text-sm text-ink">{{ s.text }}</text>
              <text class="text-[11px] text-ink-soft mt-0.5">{{ s.desc }}</text>
            </view>
            <ml-icon name="chevron-right" :size="16" color="#AEB9CC"></ml-icon>
          </view>
        </ml-card>
      </view>

      <!-- 退出登录 -->
      <view v-if="loggedIn" class="mt-3">
        <ml-card pressable @tap="confirmLogout">
          <view class="flex-row items-center justify-center">
            <ml-icon name="log-out" :size="16" color="#DC2626"></ml-icon>
            <text class="text-sm text-danger ml-1.5">退出登录</text>
          </view>
        </ml-card>
      </view>

      <!-- 版本信息 -->
      <view class="flex-col items-center mt-6">
        <text class="text-[11px] text-mist">MentorLoop · 学面一体智能导师</text>
        <text class="text-[10px] text-mist mt-1">v0.9.0 · 内测版</text>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import { userStore, positionDisplay, experienceDisplay } from '../../store/user-profile.uts'
import { reportHistory } from '../../store/report-history.uts'
import { quotaStore } from '../../store/quota.uts'
import { trackEvent } from '../../api/tracking.uts'

const nickname = ref(userStore.profile.nickname)
const plan = ref(userStore.profile.plan)
const loggedIn = ref(userStore.isLoggedIn())

// 会员余量信息（免费额度/单次包余量/会员有效期）
const quotaText = ref('')

function refreshQuota() {
  quotaStore.restore()
  if (quotaStore.isMember()) {
    const until = new Date(quotaStore.state.memberUntil)
    const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
    quotaText.value =
      '有效期至 ' + pad(until.getMonth() + 1) + '-' + pad(until.getDate()) + ' · 权益无限'
  } else if (quotaStore.state.singleCreditsLeft > 0) {
    quotaText.value = '单次包余量 ' + String(quotaStore.state.singleCreditsLeft) + ' 场'
  } else {
    quotaText.value = '免费额度 ' + String(quotaStore.state.freeInterviewsLeft) + ' 场面试'
  }
}

const planLabel = computed((): string => {
  if (plan.value === 'member') return '会员'
  if (plan.value === 'single') return '单次包'
  return '免费版'
})

const planBadgeBg = computed((): string => {
  if (plan.value === 'member') return 'rgba(245,201,123,0.2)'
  if (plan.value === 'single') return 'rgba(92,232,216,0.18)'
  return 'rgba(255,255,255,0.12)'
})

const planBadgeColor = computed((): string => {
  if (plan.value === 'member') return '#F5C97B'
  if (plan.value === 'single') return '#5CE8D8'
  return '#AEB9CC'
})

const planBadgeIcon = computed((): string => {
  if (plan.value === 'member') return 'crown'
  if (plan.value === 'single') return 'gem'
  return 'user'
})

const positionLabel = ref(positionDisplay(userStore.profile))
const experienceLabel = ref(experienceDisplay(userStore.profile))

const statInterviews = ref(0)
const statReports = ref(0)
const statTodos = ref(0)

type Feature = { icon: string; color: string; tint: string; text: string; onTap: () => void }
const features: Feature[] = [
  { icon: 'file-check', color: '#5B6CFF', tint: '#EEF1FF', text: '我的报告', onTap: goReport },
  { icon: 'dumbbell', color: '#1FB6A6', tint: '#E6F7F4', text: '训练计划', onTap: goTraining },
  { icon: 'cloud-upload', color: '#E08A00', tint: '#FFF3E0', text: '简历优化', onTap: goResume },
  { icon: 'bell', color: '#7C5CFF', tint: '#F0EBFF', text: '消息通知', onTap: notify }
]

type SettingRow = {
  icon: string
  color: string
  tint: string
  text: string
  desc: string
  onTap: () => void
}
const settings: SettingRow[] = [
  {
    icon: 'lock',
    color: '#5B6CFF',
    tint: '#EEF1FF',
    text: '账号与安全',
    desc: '登录方式、设备管理',
    onTap: security
  },
  {
    icon: 'sliders-horizontal',
    color: '#1FB6A6',
    tint: '#E6F7F4',
    text: '面试偏好设置',
    desc: '难度、时长、提醒',
    onTap: prefs
  },
  {
    icon: 'shield',
    color: '#E08A00',
    tint: '#FFF3E0',
    text: '隐私与数据',
    desc: '录音、简历与账户删除',
    onTap: privacy
  },
  {
    icon: 'info',
    color: '#7C5CFF',
    tint: '#F0EBFF',
    text: '关于 MentorLoop',
    desc: '版本、协议、反馈',
    onTap: about
  }
]

onShow(() => {
  nickname.value = userStore.profile.nickname
  plan.value = userStore.profile.plan
  loggedIn.value = userStore.isLoggedIn()
  positionLabel.value = positionDisplay(userStore.profile)
  experienceLabel.value = experienceDisplay(userStore.profile)
  refreshQuota()

  reportHistory.load()
  const all = reportHistory.all()
  statInterviews.value = all.length
  statReports.value = all.length
  const latest = reportHistory.latest()
  statTodos.value = latest != null ? latest.report.trainingPlan.length : 0
})

function goPaywall() {
  trackEvent('paywall_view', { from: 'mine' })
  uni.navigateTo({ url: '/pages/membership/paywall?from=mine' })
}

function editProfile() {
  uni.navigateTo({ url: '/pages/mine/prefs' })
}

function goReport() {
  uni.navigateTo({ url: '/pages/report/report' })
}

function goTraining() {
  uni.switchTab({ url: '/pages/training/training' })
}

function goResume() {
  uni.switchTab({ url: '/pages/resume/resume' })
}

function goGrowth() {
  uni.switchTab({ url: '/pages/growth/growth' })
}

function goLogin() {
  // #ifdef APP
  uni.navigateTo({ url: '/pages/login/login' })
  // #endif
  // #ifndef APP
  uni.showToast({ title: '微信授权登录中，请稍候', icon: 'none' })
  // #endif
}

function confirmLogout() {
  uni.showModal({
    title: '退出登录',
    content: '退出后训练记录仍保留在本机，确认退出？',
    confirmColor: '#DC2626',
    success: (r: any) => {
      if (r.confirm) logout()
    }
  })
}

function logout() {
  userStore.logout()
  nickname.value = userStore.profile.nickname
  loggedIn.value = false
  uni.showToast({ title: '已退出登录', icon: 'none' })
}

function notify() {
  uni.showToast({ title: '消息通知即将上线', icon: 'none' })
}

function security() {
  uni.navigateTo({ url: '/pages/mine/security' })
}

function prefs() {
  uni.navigateTo({ url: '/pages/mine/prefs' })
}

function privacy() {
  uni.navigateTo({ url: '/pages/mine/privacy' })
}

function about() {
  uni.navigateTo({ url: '/pages/mine/about' })
}
</script>

<style>
.row-pressed {
  opacity: 0.7;
}
.pressable {
  /* 按压态由 hover-class 控制 */
}
</style>
