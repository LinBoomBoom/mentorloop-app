<template>
  <view class="h-screen bg-bg-light">
    <scroll-view class="h-screen" scroll-y="true">
      <view class="px-4 pt-3 pb-6">
        <!-- 资料卡（深色品牌面） -->
        <view class="bg-navy rounded-card p-4">
          <view class="flex-row items-center">
            <view
              class="w-14 h-14 rounded-full flex-row items-center justify-center mr-3"
              :style="{
                backgroundColor: 'rgba(255,255,255,0.14)',
                border: '1px solid rgba(255,255,255,0.2)'
              }"
            >
              <ml-icon name="user" :size="26" :color="SURFACE"></ml-icon>
            </view>
            <view class="flex-col flex-1 overflow-hidden">
              <text class="text-lg font-semibold text-white truncate block">{{ nickname }}</text>
              <view class="flex-row items-center mt-1 overflow-hidden">
                <ml-tag
                  :icon="planBadgeIcon"
                  :label="planLabel"
                  :bg="planBadgeBg"
                  :color="planBadgeColor"
                ></ml-tag>
                <text class="text-xs text-mist ml-2 truncate block">
                  {{ positionLabel }} · {{ experienceLabel }}
                </text>
              </view>
            </view>
            <view
              class="w-11 h-11 rounded-full flex-row items-center justify-center"
              hover-class="pressed-row"
              :hover-start-time="0"
              @click="security"
            >
              <ml-icon name="chevron-right" :size="18" :color="MIST"></ml-icon>
            </view>
          </view>

          <!-- 未登录：登录入口 -->
          <view v-if="!loggedIn" class="mt-4">
            <ml-button text="登录 / 注册" block @tap="goLogin"></ml-button>
          </view>
        </view>

        <!-- 会员卡（权益状态 + 购买入口） -->
        <view
          class="bg-navy rounded-card p-4 mt-3 flex-row items-center"
          hover-class="pressed-row"
          :hover-start-time="0"
          @click="goPaywall"
        >
          <view
            class="w-10 h-10 rounded-full flex-row items-center justify-center mr-3"
            :style="{ backgroundColor: 'rgba(245,201,123,0.2)' }"
          >
            <ml-icon name="crown" :size="20" :color="WARN_LIGHT"></ml-icon>
          </view>
          <view class="flex-col flex-1">
            <text class="text-sm font-semibold text-white">{{ planLabel }}权益</text>
            <text class="text-xs text-mist mt-0.5">{{ quotaText }}</text>
          </view>
          <!-- 深色面会员卡行动点：半透明底/琥珀底随状态切换，形态唯一（设计系统白名单） -->
          <view
            class="h-8 px-3 rounded-chip flex-row items-center"
            :style="{
              backgroundColor: plan.value === 'member' ? 'rgba(255,255,255,0.14)' : WARN_LIGHT
            }"
          >
            <text
              class="text-xs font-semibold"
              :style="{ color: plan.value === 'member' ? SURFACE : NAVY_DEEP }"
            >
              {{ plan.value === 'member' ? '查看权益' : '立即开通' }}
            </text>
          </view>
        </view>

        <!-- 设置分组 -->
        <view class="mt-3">
          <ml-card :padded="false">
            <view
              v-for="(s, i) in settings"
              :key="s.text"
              class="flex-row items-center px-4 h-[56px]"
              :class="i < settings.length - 1 ? 'border-b border-line' : ''"
              hover-class="pressed-row"
              :hover-start-time="0"
              @click="s.onTap"
            >
              <view
                class="w-8 h-8 rounded-control flex-row items-center justify-center mr-3"
                :style="{ backgroundColor: s.tint }"
              >
                <ml-icon :name="s.icon" :size="16" :color="s.color"></ml-icon>
              </view>
              <view class="flex-col flex-1">
                <text class="text-sm text-ink">{{ s.text }}</text>
                <text class="text-xs text-ink-soft mt-0.5">{{ s.desc }}</text>
              </view>
              <ml-icon name="chevron-right" :size="16" :color="MIST"></ml-icon>
            </view>
          </ml-card>
        </view>

        <!-- 退出登录 -->
        <view v-if="loggedIn" class="mt-3">
          <ml-card pressable @tap="confirmLogout">
            <view class="flex-row items-center justify-center">
              <ml-icon name="log-out" :size="16" :color="DANGER"></ml-icon>
              <text class="text-sm text-danger ml-1.5">退出登录</text>
            </view>
          </ml-card>
        </view>

        <!-- 版本信息：名称与版本跟随 manifest / 小程序运行环境，避免硬编码漂移 -->
        <view class="flex-col items-center mt-6">
          <text class="text-xs text-ink-soft">{{ APP_NAME }} · 学面一体智能导师</text>
          <text v-if="versionText.length > 0" class="text-xs text-ink-soft mt-1">{{
            versionText
          }}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 登录半屏层：小程序端手机号+验证码（APP 端仍走 /pages/login/login） -->
    <ml-login-sheet v-if="showLogin" @success="onLoginSuccess" @exit="onLoginExit"></ml-login-sheet>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlTag from '../../components/ml-tag.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlLoginSheet from '../../components/ml-login-sheet.uvue'
import { userStore, positionDisplay, experienceDisplay } from '../../store/user-profile.uts'
import { loginByWechat, applyAuth } from '../../api/auth.uts'
import { quotaStore, FREE_QUOTA } from '../../store/quota.uts'
import { fetchQuota } from '../../api/membership.uts'
import { trackEvent } from '../../api/tracking.uts'
import { APP_NAME, appVersionText } from '../../data/app-meta.uts'
import { DIM_COLOR, DIM_TINT, themeValue } from '../../styles/theme.uts'

const SMART = themeValue('smart', '#5B6CFF')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const WARN = themeValue('warn', '#E08A00')
const DANGER = themeValue('danger', '#DC2626')
const SURFACE = themeValue('surface', '#FFFFFF')
const MIST = themeValue('mist', '#AEB9CC')
const NAVY_DEEP = themeValue('navyDeep', '#0B2138')
const CHIP_SMART = themeValue('chipSmart', '#EEF1FF')
const CHIP_RELIABLE = themeValue('chipReliable', '#E6F7F4')
const CHIP_WARN = themeValue('chipWarn', '#FFF3E0')
const RELIABLE_LIGHT = themeValue('reliableLight', '#5CE8D8')
const WARN_LIGHT = themeValue('warnLight', '#F5C97B')
const DIM_COMMUNICATION = DIM_COLOR['communication'] != null ? DIM_COLOR['communication'] : '#7C5CFF'
const DIM_COMMUNICATION_TINT = DIM_TINT['communication'] != null ? DIM_TINT['communication'] : '#F0EBFF'

const nickname = ref(userStore.profile.nickname)
const plan = ref(userStore.profile.plan)
const loggedIn = ref(userStore.isLoggedIn())
const versionText = appVersionText()
// 登录半屏层（小程序端手机号+验证码；APP 端走登录页）
const showLogin = ref(false)

// 会员余量信息（免费额度/单次包余量/会员有效期）
const quotaText = ref('')

function refreshQuota() {
  quotaStore.restore()
  if (quotaStore.isMember()) {
    const until = new Date(quotaStore.state.memberUntil)
    const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
    quotaText.value =
      '有效期至 ' + pad(until.getMonth() + 1) + '-' + pad(until.getDate()) + ' · 权益无限'
  } else if (quotaStore.state.singleCreditsLeft > 0) {
    quotaText.value = '单次包余量 ' + String(quotaStore.state.singleCreditsLeft) + ' 场'
  } else {
    // 面试额度与每日训练额度是两个独立计数器，文案里分别标明，避免被当成同一个额度
    quotaText.value =
      '免费面试额度 ' +
      String(quotaStore.state.freeInterviewsLeft) +
      ' 场 · 每日训练 ' +
      String(FREE_QUOTA.trainingsPerDay) +
      ' 次'
  }
}

const planLabel = computed((): string => {
  if (plan.value === 'member') return '会员'
  if (plan.value === 'single') return '单次包'
  return '免费版'
})

const planBadgeBg = computed((): string => {
  if (plan.value === 'member') return 'rgba(245,201,123,0.2)'
  if (plan.value === 'single') return 'rgba(92,232,216,0.18)'
  return 'rgba(255,255,255,0.12)'
})

const planBadgeColor = computed((): string => {
  if (plan.value === 'member') return WARN_LIGHT
  if (plan.value === 'single') return RELIABLE_LIGHT
  return MIST
})

const planBadgeIcon = computed((): string => {
  if (plan.value === 'member') return 'crown'
  if (plan.value === 'single') return 'gem'
  return 'user'
})

const positionLabel = ref(positionDisplay(userStore.profile))
const experienceLabel = ref(experienceDisplay(userStore.profile))

type SettingRow = {
  icon: string
  color: string
  tint: string
  text: string
  desc: string
  onTap: () => void
}
const settings: SettingRow[] = [
  {
    icon: 'lock',
    color: SMART,
    tint: CHIP_SMART,
    text: '账号与安全',
    desc: '登录方式、设备管理',
    onTap: security
  },
  {
    icon: 'sliders-horizontal',
    color: RELIABLE,
    tint: CHIP_RELIABLE,
    text: '面试偏好设置',
    desc: '默认方向、经验年限、昵称',
    onTap: prefs
  },
  {
    icon: 'cloud-upload',
    color: WARN,
    tint: CHIP_WARN,
    text: '简历优化',
    desc: 'AI 解析 · 改写建议 · 投递版本',
    onTap: goResume
  },
  {
    icon: 'shield',
    color: WARN,
    tint: CHIP_WARN,
    text: '隐私与数据',
    desc: '录音、简历与账户删除',
    onTap: privacy
  },
  {
    icon: 'info',
    color: DIM_COMMUNICATION,
    tint: DIM_COMMUNICATION_TINT,
    text: '关于 ' + APP_NAME,
    desc: '版本、协议、反馈',
    onTap: about
  }
]

onShow(() => {
  refreshProfile()
})

// 登录态/画像/余量统一刷新（onShow 与登录半屏层成功回调共用）
function refreshProfile() {
  nickname.value = userStore.profile.nickname
  plan.value = userStore.profile.plan
  loggedIn.value = userStore.isLoggedIn()
  positionLabel.value = positionDisplay(userStore.profile)
  experienceLabel.value = experienceDisplay(userStore.profile)
  refreshQuota()
  // 真后端以服务端账本为准（Mock 下 fetchQuota 直接返回），避免本地旧账本与真实额度不一致
  if (loggedIn.value) {
    fetchQuota().then(() => {
      refreshQuota()
    }).catch(() => {})
  }
}

function goPaywall() {
  trackEvent('paywall_view', { from: 'mine' })
  uni.navigateTo({ url: '/pages/membership/paywall?from=mine' })
}

function goResume() {
  uni.navigateTo({ url: '/pages/resume/resume' })
}

function goLogin() {
  // #ifdef APP
  uni.navigateTo({ url: '/pages/login/login' })
  // #endif
  // #ifndef APP
  // 小程序端：openid 静默登录即账号；只有静默登录失败才拉起手机号兜底层
  uni.login({
    provider: 'weixin',
    success: (res: any) => {
      const code = res.code as string
      if (code == null || code.length === 0) {
        showLogin.value = true
        return
      }
      loginByWechat(code)
        .then((r) => {
          applyAuth(r, '')
          onLoginSuccess()
        })
        .catch(() => {
          showLogin.value = true
        })
    },
    fail: () => {
      showLogin.value = true
    }
  })
  // #endif
}

function onLoginSuccess() {
  showLogin.value = false
  refreshProfile()
  uni.showToast({ title: '登录成功', icon: 'none' })
}

function onLoginExit() {
  showLogin.value = false
}

// 确认弹窗开着时忽略重复调用（小程序端 tap 事件可能重复送达，避免叠两个弹窗）
let logoutModalOpen = false

function confirmLogout() {
  if (logoutModalOpen) return
  logoutModalOpen = true
  uni.showModal({
    title: '退出登录',
    content: '退出后训练记录仍保留在本机，确认退出？',
    confirmColor: DANGER,
    success: (r: any) => {
      if (r.confirm) logout()
    },
    complete: () => {
      logoutModalOpen = false
    }
  })
}

function logout() {
  userStore.logout()
  nickname.value = userStore.profile.nickname
  loggedIn.value = false
  uni.showToast({ title: '已退出登录', icon: 'none' })
}

function security() {
  uni.navigateTo({ url: '/pages/mine/security' })
}

function prefs() {
  uni.navigateTo({ url: '/pages/mine/prefs' })
}

function privacy() {
  uni.navigateTo({ url: '/pages/mine/privacy' })
}

function about() {
  uni.navigateTo({ url: '/pages/mine/about' })
}
</script>
