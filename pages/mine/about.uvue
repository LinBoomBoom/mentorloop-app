<template>
  <scroll-view class="h-screen bg-bg-light" scroll-y="true">
    <view class="px-4 pt-4 pb-8">
      <!-- 品牌卡 -->
      <view class="bg-navy rounded-card p-5 flex-col items-center">
        <view
          class="w-16 h-16 rounded-full flex-row items-center justify-center"
          :style="{ backgroundColor: 'rgba(91,108,255,0.3)' }"
        >
          <ml-icon name="sparkles" :size="30" :color="SURFACE"></ml-icon>
        </view>
        <text class="text-[22px] font-bold text-white mt-3">{{ APP_NAME }}</text>
        <text class="text-xs text-mist mt-1.5">学面一体智能导师 · 让每次模拟都有证据</text>
        <view class="flex-row items-center mt-3">
          <ml-tag
            v-if="APP_VERSION.length > 0"
            :label="'v' + APP_VERSION"
            bg="rgba(255,255,255,0.14)"
            :color="SURFACE"
          ></ml-tag>
          <ml-tag
            v-if="APP_ENV_LABEL.length > 0"
            :label="APP_ENV_LABEL"
            bg="rgba(245,201,123,0.2)"
            :color="WARN_LIGHT"
          ></ml-tag>
        </view>
      </view>

      <!-- 说明 -->
      <view class="mt-3">
        <ml-card>
          <text class="text-xs text-ink-soft leading-5">
            {{ APP_NAME }} 面向 1–3
            年经验求职者，提供岗位化模拟面试、证据化评分报告与细分领域做题闭环。
            当前开放前端、后端、运维与 AI 工程四个方向，更多能力持续补齐。
          </text>
        </ml-card>
      </view>

      <!-- 协议与改进 -->
      <view class="mt-3">
        <ml-card :padded="false">
          <view
            v-for="(s, i) in rows"
            :key="s.text"
            class="flex-row items-center px-4 h-[56px]"
            :class="i < rows.length - 1 ? 'border-b border-line' : ''"
            @click="openRow(s)"
          >
            <view
              class="w-8 h-8 rounded-control flex-row items-center justify-center mr-3"
              :style="{ backgroundColor: s.tint }"
            >
              <ml-icon :name="s.icon" :size="16" :color="s.color"></ml-icon>
            </view>
            <view class="flex-col flex-1">
              <text class="text-sm text-ink">{{ s.text }}</text>
              <text class="text-xs text-ink-soft mt-0.5">{{ s.desc }}</text>
            </view>
            <ml-tag v-if="s.soon" label="即将上线" :bg="BG_MUTED" :color="MIST"></ml-tag>
          </view>
        </ml-card>
      </view>

      <text class="text-xs text-ink-soft mt-4 text-center">{{ APP_NAME }} · 学面一体智能导师</text>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import mlCard from '../../components/ml-card.uvue'
import mlTag from '../../components/ml-tag.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import { AGREEMENT_URL, PRIVACY_URL } from '../../api/env.uts'
import { APP_NAME, APP_VERSION, APP_ENV_LABEL } from '../../data/app-meta.uts'
import { DIM_COLOR, DIM_TINT, themeValue } from '../../styles/theme.uts'

const SMART = themeValue('smart', '#5856D6')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const WARN = themeValue('warn', '#E08A00')
const BG_MUTED = themeValue('bgMuted', '#E9E9EF')
const SURFACE = themeValue('surface', '#FFFFFF')
const MIST = themeValue('mist', '#AEAEB2')
const CHIP_SMART = themeValue('chipSmart', '#EFEEFC')
const CHIP_RELIABLE = themeValue('chipReliable', '#E6F7F4')
const CHIP_WARN = themeValue('chipWarn', '#FFF3E0')
const WARN_LIGHT = themeValue('warnLight', '#F5C97B')
const DIM_COMMUNICATION = DIM_COLOR['communication'] != null ? DIM_COLOR['communication'] : '#7C5CFF'
const DIM_COMMUNICATION_TINT = DIM_TINT['communication'] != null ? DIM_TINT['communication'] : '#F0EBFF'

type AboutRow = {
  icon: string
  color: string
  tint: string
  text: string
  desc: string
  soon: boolean
  url: string
  doc: string
}
const rows: AboutRow[] = [
  {
    icon: 'file-text',
    color: SMART,
    tint: CHIP_SMART,
    text: '用户协议',
    desc: '使用条款与服务约定',
    // 外链未回填时打开应用内全文；不再显示「即将上线」
    soon: false,
    url: AGREEMENT_URL,
    doc: 'agreement'
  } as AboutRow,
  {
    icon: 'shield',
    color: RELIABLE,
    tint: CHIP_RELIABLE,
    text: '隐私政策',
    desc: '数据收集、使用与删除说明',
    soon: false,
    url: PRIVACY_URL,
    doc: 'privacy'
  } as AboutRow,
  {
    icon: 'message-square',
    color: WARN,
    tint: CHIP_WARN,
    text: '意见反馈',
    desc: '告诉我们你的想法与问题',
    soon: true,
    url: '',
    doc: ''
  } as AboutRow,
  {
    icon: 'sparkles',
    color: DIM_COMMUNICATION,
    tint: DIM_COMMUNICATION_TINT,
    text: '更多岗位方向',
    desc: '测试 / 数据等方向陆续开放',
    soon: true,
    url: '',
    doc: ''
  } as AboutRow
]

function openRow(s: AboutRow) {
  if (s.soon) {
    uni.showToast({ title: '即将上线', icon: 'none' })
    return
  }
  if (s.url.length > 0) {
    uni.navigateTo({
      url:
        '/pages/mine/webview?url=' +
        encodeURIComponent(s.url) +
        '&title=' +
        encodeURIComponent(s.text)
    })
    return
  }
  if (s.doc.length > 0) {
    uni.navigateTo({ url: '/pages/legal/legal?doc=' + s.doc })
  }
}
</script>
