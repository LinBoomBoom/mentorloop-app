<template>
  <view class="h-screen bg-bg-light">
    <scroll-view class="h-screen" scroll-y="true">
      <view class="px-4 pt-4 pb-8">
        <!-- 账号卡 -->
        <view class="bg-navy rounded-card p-4">
          <view class="flex-row items-center">
            <view
              class="w-12 h-12 rounded-full flex-row items-center justify-center mr-3"
              :style="{ backgroundColor: 'rgba(255,255,255,0.14)' }"
            >
              <ml-icon name="user" :size="22" :color="SURFACE"></ml-icon>
            </view>
            <view class="flex-col">
              <text class="text-lg font-semibold text-white">{{ nickname }}</text>
              <text class="text-xs text-mist mt-1">
                {{ loggedIn ? 'UID ' + uid : '未登录（访客模式）' }} · {{ planLabel }}
              </text>
            </view>
          </view>
        </view>

        <!-- 引导登录 -->
        <view v-if="!loggedIn" class="mt-3">
          <ml-button text="登录 / 注册" type="primary" block @tap="goLogin"></ml-button>
        </view>

        <!-- 账号能力列表 -->
        <view class="mt-3">
          <ml-card :padded="false">
            <view
              v-for="(s, i) in securityRows"
              :key="s.text"
              class="flex-row items-center px-4 h-[56px]"
              :class="i < securityRows.length - 1 ? 'border-b border-line' : ''"
              @click="onSecurityRow(s)"
            >
              <view
                class="w-8 h-8 rounded-control flex-row items-center justify-center mr-3"
                :style="{ backgroundColor: s.tint }"
              >
                <ml-icon :name="s.icon" :size="16" :color="s.color"></ml-icon>
              </view>
              <view class="flex-col flex-1">
                <text class="text-sm text-ink">{{ s.text }}</text>
                <text class="text-xs text-ink-soft mt-0.5">{{ s.desc }}</text>
              </view>
              <ml-tag v-if="s.soon" label="即将上线" :bg="BG_MUTED" :color="MIST"></ml-tag>
            </view>
          </ml-card>
        </view>

        <!-- 退出登录 -->
        <view v-if="loggedIn" class="mt-3">
          <ml-card pressable @tap="confirmLogout">
            <view class="flex-row items-center justify-center">
              <ml-icon name="log-out" :size="16" :color="DANGER"></ml-icon>
              <text class="text-sm text-danger ml-1.5">退出登录</text>
            </view>
          </ml-card>
        </view>

        <text class="text-xs text-ink-soft mt-4 text-center leading-4">
          手机号换绑、第三方绑定与设备管理需要后端支持，将随服务端上线开放
        </text>
      </view>
    </scroll-view>

    <!-- 登录半屏层：小程序端手机号+验证码（APP 端仍走 /pages/login/login） -->
    <ml-login-sheet v-if="showLogin" @success="onLoginSuccess" @exit="onLoginExit"></ml-login-sheet>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlTag from '../../components/ml-tag.uvue'
import mlLoginSheet from '../../components/ml-login-sheet.uvue'
import { userStore } from '../../store/user-profile.uts'
import { trackEvent } from '../../api/tracking.uts'
import { deleteAccount } from '../../api/auth.uts'
import { themeValue } from '../../styles/theme.uts'

const SMART = themeValue('smart', '#5B6CFF')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const WARN = themeValue('warn', '#E08A00')
const DANGER = themeValue('danger', '#DC2626')
const BG_MUTED = themeValue('bgMuted', '#F1F5F9')
const SURFACE = themeValue('surface', '#FFFFFF')
const MIST = themeValue('mist', '#AEB9CC')
const CHIP_SMART = themeValue('chipSmart', '#EEF1FF')
const CHIP_RELIABLE = themeValue('chipReliable', '#E6F7F4')
const CHIP_WARN = themeValue('chipWarn', '#FFF3E0')
const CHIP_DANGER = themeValue('chipDanger', '#FEECEC')

const nickname = ref(userStore.profile.nickname)
const uid = ref(userStore.profile.uid)
const planLabel = ref(planText(userStore.profile.plan))
const loggedIn = ref(userStore.isLoggedIn())
const deleting = ref(false)
// 登录半屏层（小程序端手机号+验证码；APP 端走登录页）
const showLogin = ref(false)

function planText(p: string): string {
  if (p === 'member') return '会员'
  if (p === 'single') return '单次包'
  return '免费版'
}

type SecurityRow = { icon: string; color: string; tint: string; text: string; desc: string; soon: boolean }
const securityRows: SecurityRow[] = [
  {
    icon: 'smartphone',
    color: SMART,
    tint: CHIP_SMART,
    text: '修改手机号',
    desc: '更换登录手机号（需短信验证）',
    soon: true
  } as SecurityRow,
  {
    icon: 'repeat',
    color: RELIABLE,
    tint: CHIP_RELIABLE,
    text: '第三方绑定',
    desc: '微信 / 手机号绑定管理',
    soon: true
  } as SecurityRow,
  {
    icon: 'shield',
    color: WARN,
    tint: CHIP_WARN,
    text: '设备管理',
    desc: '查看与下线已登录设备',
    soon: true
  } as SecurityRow,
  {
    icon: 'trash-2',
    color: DANGER,
    tint: CHIP_DANGER,
    text: '注销账号',
    desc: '永久删除账号与服务端数据',
    soon: false
  } as SecurityRow
]

function goLogin() {
  // #ifdef APP
  uni.navigateTo({ url: '/pages/login/login' })
  // #endif
  // #ifndef APP
  // 小程序端：拉起手机号+验证码登录半屏层（此前的 toast 占位已移除）
  showLogin.value = true
  // #endif
}

// 登录态与账号信息刷新（登录半屏层成功回调用）
function refreshProfile() {
  nickname.value = userStore.profile.nickname
  uid.value = userStore.profile.uid
  planLabel.value = planText(userStore.profile.plan)
  loggedIn.value = userStore.isLoggedIn()
}

function onLoginSuccess() {
  showLogin.value = false
  refreshProfile()
  uni.showToast({ title: '登录成功', icon: 'none' })
}

function onLoginExit() {
  showLogin.value = false
}

function onSecurityRow(s: SecurityRow) {
  if (s.soon) {
    uni.showToast({ title: '即将上线', icon: 'none' })
    return
  }
  if (s.text === '注销账号') {
    if (!loggedIn.value) {
      uni.showToast({ title: '请先登录', icon: 'none' })
      return
    }
    confirmDeleteAccount()
  }
}

// 确认弹窗开着时忽略重复调用（小程序端 tap 事件可能重复送达，避免叠两个弹窗）
let logoutModalOpen = false

function confirmLogout() {
  if (logoutModalOpen) return
  logoutModalOpen = true
  uni.showModal({
    title: '退出登录',
    content: '退出后训练记录仍保留在本机，确认退出？',
    confirmColor: DANGER,
    success: (r: any) => {
      if (r.confirm) {
        userStore.logout()
        loggedIn.value = false
        nickname.value = userStore.profile.nickname
        planLabel.value = planText(userStore.profile.plan)
        trackEvent('auth_logout')
        uni.showToast({ title: '已退出登录', icon: 'none' })
      }
    },
    complete: () => {
      logoutModalOpen = false
    }
  })
}

// 注销账号：双重确认 → 删服务端数据 → 清本地 → 回登录页
function confirmDeleteAccount() {
  if (deleting.value) return
  uni.showModal({
    title: '注销账号',
    content: '将永久删除账号、面试记录、报告与简历等全部服务端数据，且不可恢复。确认继续？',
    confirmColor: DANGER,
    success: (r1: any) => {
      if (!r1.confirm) return
      uni.showModal({
        title: '再次确认',
        content: '删除不可恢复，确定要注销吗？',
        confirmColor: DANGER,
        success: (r2: any) => {
          if (r2.confirm) doDeleteAccount()
        }
      })
    }
  })
}

function doDeleteAccount() {
  deleting.value = true
  deleteAccount()
    .then((ok: boolean) => {
      if (!ok) {
        uni.showToast({ title: '注销失败，请稍后重试', icon: 'none' })
        return
      }
      trackEvent('account_deleted')
      userStore.logout()
      loggedIn.value = false
      nickname.value = userStore.profile.nickname
      planLabel.value = planText(userStore.profile.plan)
      uni.showToast({ title: '账号已注销', icon: 'none' })
      // #ifdef APP
      setTimeout(() => {
        uni.reLaunch({ url: '/pages/login/login' })
      }, 800)
      // #endif
    })
    .catch(() => {
      uni.showToast({ title: '注销失败，请稍后重试', icon: 'none' })
    })
    .finally(() => {
      deleting.value = false
    })
}
</script>
