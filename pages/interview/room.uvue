<template>
  <view class="flex-col h-screen bg-navy">
    <!-- 顶部状态条（安全区动态内边距） -->
    <view class="flex-row items-center justify-between px-4" :style="{ paddingTop: topPad + 'px' }">
      <!-- 左：退出（放弃，不生成报告） -->
      <view class="flex-row items-center h-11" @click="confirmExit">
        <ml-icon name="arrow-left" :size="16" :color="MIST"></ml-icon>
        <text class="text-sm text-mist ml-1.5">退出</text>
      </view>
      <!-- 右：网络状态 + 计时 + 结束并生成报告 -->
      <view class="flex-row items-center h-11">
        <view class="flex-row items-center mr-3">
          <view
            class="w-1.5 h-1.5 rounded-full mr-1.5"
            :style="{ backgroundColor: netOk ? RELIABLE : DANGER }"
          ></view>
          <text class="text-xs" :class="netOk ? 'text-mist' : 'text-danger'">{{ netText }}</text>
        </view>
        <view class="flex-row items-center mr-3">
          <ml-icon name="clock" :size="14" :color="SURFACE"></ml-icon>
          <text class="text-sm font-mono text-white ml-1">{{ elapsedText }}</text>
        </view>
        <view
          class="flex-row items-center h-11 px-3.5 rounded-control border"
          :style="{ borderColor: 'rgba(91,108,255,0.6)' }"
          hover-class="pressed-chip"
          :hover-start-time="0"
          @click="confirmFinish"
        >
          <ml-icon name="check-circle" :size="13" :color="SMART_LIGHT"></ml-icon>
          <text class="text-xs text-white ml-1">结束</text>
        </view>
      </view>
    </view>

    <!-- 主区：AI 身份标识 + 题目卡（题目为主视觉） -->
    <view class="flex-1 flex-col justify-center px-4">
      <!-- AI 身份标识（AI Interaction 规范：需让用户知道在与 AI 对话） -->
      <view class="flex-row items-center">
        <ml-tag
          icon="bot"
          label="AI 面试官 · 系统生成"
          bg="rgba(91,108,255,0.18)"
          :icon-color="SMART_LIGHT"
          :color="SURFACE"
        ></ml-tag>
      </view>

      <!-- 题目卡 -->
      <view class="mt-3 rounded-card p-4" :style="panelStyle">
        <view class="flex-row items-center justify-between">
          <text class="text-xs font-mono text-mist">{{ 'Q' + askedCount }}</text>
          <view class="flex-row items-center">
            <view class="w-1.5 h-1.5 rounded-full" :style="{ backgroundColor: stateColor }"></view>
            <text class="text-xs text-mist ml-1.5">{{ stateLabel }}</text>
          </view>
        </view>

        <text class="text-lg font-semibold text-white leading-6 mt-2">{{ displayQuestion }}</text>
        <text v-if="caption.length > 0" class="text-xs text-mist mt-2">{{ caption }}</text>

        <!-- 换一种说法：追加澄清行，原题保留在上一行 -->
        <view
          v-if="rephrasedText.length > 0"
          class="mt-2 rounded-control p-2.5"
          :style="{ backgroundColor: 'rgba(255,255,255,0.07)' }"
        >
          <text class="text-xs text-white leading-5">{{ rephrasedText }}</text>
        </view>

        <!-- 求助操作（暂停/录音时隐藏）：再说一遍 / 换一种说法 / 文字作答 -->
        <view v-if="!paused && !recording" class="flex-row items-center mt-2" :style="dividerTop">
          <view
            class="flex-row items-center h-11 pr-4"
            hover-class="pressed-row"
            :hover-start-time="0"
            @click="replayQuestion"
          >
            <ml-icon name="rotate-ccw" :size="13" :color="MIST"></ml-icon>
            <text class="text-xs text-mist ml-1.5">再说一遍</text>
          </view>
          <view
            class="flex-row items-center h-11 pr-4"
            hover-class="pressed-row"
            :hover-start-time="0"
            @click="onRephrase"
          >
            <ml-icon name="repeat" :size="13" :color="MIST"></ml-icon>
            <text class="text-xs text-mist ml-1.5">换一种说法</text>
          </view>
          <view
            class="flex-row items-center h-11 pr-2"
            hover-class="pressed-row"
            :hover-start-time="0"
            @click="textMode"
          >
            <ml-icon name="keyboard" :size="13" :color="MIST"></ml-icon>
            <text class="text-xs text-mist ml-1.5">文字作答</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 语音状态可视化（辅助：状态环 + 声波，D3 语义保留） -->
    <view class="flex-row items-end justify-center pt-2" style="height: 128px">
      <ml-voice-visual
        :state="avatarState"
        :speaking="ttsSpeaking"
        :show-label="false"
        :ring="96"
      ></ml-voice-visual>
    </view>

    <!-- 控制条：两侧辅助操作 + 中央录音主按钮（底部安全区） -->
    <view
      class="flex-row items-center justify-center px-6 pt-3"
      :style="{ paddingBottom: bottomPad + 'px' }"
    >
      <!-- 暂停/恢复 -->
      <view class="flex-col items-center w-16" @click="togglePause">
        <view
          class="w-11 h-11 rounded-full flex-row items-center justify-center"
          :style="{ backgroundColor: 'rgba(255,255,255,0.08)' }"
        >
          <ml-icon :name="paused ? 'play' : 'pause'" :size="18" :color="SURFACE"></ml-icon>
        </view>
        <text class="text-xs text-mist mt-1.5">{{ paused ? '继续' : '暂停' }}</text>
      </view>

      <!-- 录音主按钮 -->
      <view class="flex-col items-center mx-6" @click="toggleRecord">
        <view
          class="w-16 h-16 rounded-full flex-row items-center justify-center"
          :class="recording ? 'bg-danger' : 'bg-smart'"
        >
          <ml-icon :name="recording ? 'square' : 'mic'" :size="24" :color="SURFACE"></ml-icon>
        </view>
        <text class="text-xs text-white mt-2">{{ recordButtonText }}</text>
      </view>

      <!-- 跳过本题（跳过保留为证据） -->
      <view class="flex-col items-center w-16" @click="skipQuestion">
        <view
          class="w-11 h-11 rounded-full flex-row items-center justify-center"
          :style="{ backgroundColor: 'rgba(255,255,255,0.08)' }"
        >
          <ml-icon name="flag" :size="18" :color="SURFACE"></ml-icon>
        </view>
        <text class="text-xs text-mist mt-1.5">跳过</text>
      </view>
    </view>

    <!-- 文字辅助输入弹窗 -->
    <view
      v-if="textModalVisible"
      class="absolute inset-0 flex-col items-center justify-center"
      :style="{ backgroundColor: 'rgba(3,12,24,0.6)' }"
      @click="cancelText"
    >
      <view class="w-11/12 rounded-card p-4 bg-navy-deep" @click.stop>
        <text class="text-base font-semibold text-white">文字作答</text>
        <text class="text-xs text-mist mt-1 mb-3">录音不便时可直接输入，长度建议 ≥ 20 字</text>
        <textarea
          class="w-full h-32 rounded-control p-3 text-sm text-ink bg-surface"
          v-model="textDraft"
          placeholder="在这里输入你的回答…"
          placeholder-class="text-ink-soft"
          :maxlength="1000"
          :auto-focus="true"
        />
        <view class="flex-row justify-end mt-3">
          <ml-button text="取消" type="secondary" @tap="cancelText"></ml-button>
          <view class="ml-2"></view>
          <ml-button
            :text="submittingText ? '提交中…' : '提交回答'"
            type="primary"
            :disabled="submittingText || textDraft.length === 0"
            @tap="submitText"
          ></ml-button>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad, onUnload, onBackPress } from '@dcloudio/uni-app'
import mlVoiceVisual from '../../components/ml-voice-visual.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlTag from '../../components/ml-tag.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import { AVATAR_STATE_LABEL, StringMap, themeValue } from '../../styles/theme.uts'
import { interviewSession } from '../../store/interview-session.uts'
import { createSession, nextQuestion, submitAnswer } from '../../api/interview.uts'
import {
  QuestionItem,
  PositionBlueprint,
  InterviewMode,
  PositionId,
  ExperienceLevel
} from '../../types/interview.uts'
import { getPositionName, getExperienceRange } from '../../data/position-options.uts'
import { decideFollowup, FollowupDecision } from '../../engine/followup-engine.uts'
import { analyzeAnswer } from '../../engine/answer-signal.uts'
import { rephraseQuestion, RephraseInput } from '../../engine/rephrase.uts'
import { trackEvent } from '../../api/tracking.uts'
import {
  SpeechRecorder,
  RecordResult,
  speak,
  TtsHandle,
  onTtsState,
  startRealtimeAsr,
  RealtimeAsrSession,
  transcribe,
  AsrResult,
  speechCapability
} from '../../api/speech.uts'
import { uploadAsrCloud, AsrResponse } from '../../api/asr.uts'

const SMART_LIGHT = themeValue('smartLight', '#8FA0FF')
const SMART = themeValue('smart', '#5B6CFF')
const SURFACE = themeValue('surface', '#FFFFFF')
const MIST = themeValue('mist', '#AEB9CC')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const DANGER = themeValue('danger', '#DC2626')

const recording = ref(false)
// 单次录音上限（秒）：微信 ASR 硬限 60s / 1MB，留 5s 余量；到点自动停止并直接送转写
const RECORD_MAX_SECONDS = 55
const recordSeconds = ref(0)
const recordButtonText = computed((): string => {
  if (!recording.value) return '点击作答'
  const remain = RECORD_MAX_SECONDS - recordSeconds.value
  return remain > 0 ? '停止 · ' + remain + 's' : '转写中'
})
const elapsed = ref(0)
// 时长语义 v2：正计时展示（用户自主控制时长：题池封顶 + 随时手动退出），不再倒计时自动收束
const elapsedText = computed((): string => {
  const m = Math.floor(elapsed.value / 60)
  const s = elapsed.value % 60
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return pad(m) + ':' + pad(s)
})
const caption = ref('')
const sessionId = ref('')
// 当前已推进到第几题（工程化题号展示）
const askedCount = ref(0)
// 当前追问话术（非空时显示追问而非原题）
const followupPrompt = ref('')
// 换一种说法生成的澄清句（非空时在题面下方追加展示，原题保留）
const rephrasedText = ref('')
// 最近一次录音文件路径（供 ASR 上送与证据存档）
const lastAudioPath = ref('')
// ASR 实时识别的中间文本（仅稳定文本进入转写链）
const liveTranscript = ref('')
// 面试模式（由 prep 页传入）
const mode = ref<InterviewMode>('standard')
// 当前会话的岗位蓝图（由 prep 页传入的 positionId + experienceLevel 构造）
const blueprint = ref<PositionBlueprint>({
  positionId: 'backend',
  position: '后端',
  experienceLevel: 'junior',
  experienceRange: '1-3年',
  companyType: '互联网',
  language: '中文',
  target: '求职'
} as PositionBlueprint)

// 安全区内边距（onLoad 时从窗口信息读取）
const topPad = ref(28)
const bottomPad = ref(16)

// 文字辅助输入弹窗状态
const textModalVisible = ref(false)
const textDraft = ref('')
const submittingText = ref(false)

// 暂停状态（暂停时冻结计时与录音入口）
const paused = ref(false)

// 网络状态（M6：真实探测，替代表头硬编码）
const netOk = ref(true)
const netText = computed((): string => (netOk.value ? '网络良好' : '网络已断开'))
let netHandler: ((r: any) => void) | null = null

// 感知层：录音器 + TTS 句柄 + 实时识别会话 + 平台能力
const speech = new SpeechRecorder()
let ttsHandle: TtsHandle | null = null
let asrSession: RealtimeAsrSession | null = null
const cap = speechCapability()
// TTS 播放状态（驱动语音状态切换）
const ttsSpeaking = ref(false)

const initialState: string = 'idle'
const avatarState = ref(initialState)

// 状态文案 / 状态色（单一来源 styles/theme.uts 的 AvatarState 语义）
const STATE_LABELS: StringMap = AVATAR_STATE_LABEL
const stateLabel = computed((): string => {
  const v = STATE_LABELS[avatarState.value]
  return v != null && v.length > 0 ? v : '待机'
})
const stateColor = computed((): string => {
  const s = avatarState.value
  if (s === 'listening' || s === 'summary') return RELIABLE
  if (s === 'thinking') return MIST
  return SMART
})

const emptyQuestion: QuestionItem = {
  id: '',
  positionId: 'backend',
  abilityDomain: '',
  subAbility: '',
  knowledgePoint: '',
  content: '',
  purpose: '',
  difficulty: 'junior',
  type: 'concept',
  misconceptions: [],
  expectedEvidence: '',
  followupPrompts: [],
  resumeRisk: false
} as QuestionItem
const currentQuestion = ref(emptyQuestion)

let timer: number = 0
// 录音计时器（与面试总计时分离：到 55s 自动停止并转写）
let recordTimer: number = 0

function clearRecordTimer() {
  if (recordTimer > 0) {
    clearInterval(recordTimer)
    recordTimer = 0
  }
}

function startRecordTimer() {
  clearRecordTimer()
  recordSeconds.value = 0
  recordTimer = setInterval(() => {
    if (!recording.value) {
      clearRecordTimer()
      return
    }
    recordSeconds.value = recordSeconds.value + 1
    if (recordSeconds.value >= RECORD_MAX_SECONDS) {
      clearRecordTimer()
      stopRecord(true)
      uni.showToast({ title: '已达单次录音上限，自动转写', icon: 'none' })
    }
  }, 1000)
}

// 展示文本：追问时显示追问话术，否则显示原题
const displayQuestion = computed((): string => {
  if (followupPrompt.value.length > 0) return followupPrompt.value
  if (currentQuestion.value.content.length > 0) return currentQuestion.value.content
  return '准备开始…'
})

// 深色面卡片样式（实色 + 细描边，避免 blur 开销）
const panelStyle = {
  backgroundColor: 'rgba(255,255,255,0.06)',
  borderWidth: '1px',
  borderStyle: 'solid',
  borderColor: 'rgba(255,255,255,0.1)'
}
const dividerTop = {
  borderTopWidth: '1px',
  borderTopStyle: 'solid',
  borderTopColor: 'rgba(255,255,255,0.07)'
}

onLoad((options: any) => {
  // 读取安全区：顶部状态栏 + 底部 home indicator
  try {
    const win = uni.getWindowInfo()
    const sb = win.statusBarHeight
    topPad.value = sb > 0 ? sb + 6 : 28
    const insets = win.safeAreaInsets
    const bottom = insets != null ? insets.bottom : 0
    bottomPad.value = bottom > 0 ? bottom + 10 : 16
  } catch {
    topPad.value = 28
    bottomPad.value = 16
  }

  // 接收 prep 页传入的模式、岗位方向、经验等级
  if (options != null) {
    if (options.mode != null) {
      const m = options.mode as string
      if (m === 'quick') {
        mode.value = 'quick'
      } else if (m === 'deep') {
        mode.value = 'deep'
      } else {
        mode.value = 'standard'
      }
    }
    const posId = options.positionId != null ? (options.positionId as string) : 'backend'
    const expLv = options.experienceLevel != null ? (options.experienceLevel as string) : 'junior'
    // 简单校验枚举值（方向体系 v2：frontend/backend/devops/ai）
    const validPos: string[] = ['frontend', 'backend', 'devops', 'ai']
    const validExp: string[] = ['fresh', 'junior', 'mid', 'senior']
    const finalPos: PositionId = validPos.includes(posId) ? (posId as PositionId) : 'backend'
    const finalExp: ExperienceLevel = validExp.includes(expLv)
      ? (expLv as ExperienceLevel)
      : 'junior'
    blueprint.value = {
      positionId: finalPos,
      position: getPositionName(finalPos),
      experienceLevel: finalExp,
      experienceRange: getExperienceRange(finalExp),
      companyType: '互联网',
      language: '中文',
      target: '求职'
    } as PositionBlueprint
  }
  initNetwork()
  initRecorder()
  init()
  timer = setInterval(() => {
    if (paused.value) return // 暂停时冻结计时
    elapsed.value = elapsed.value + 1
  }, 1000)
})

onUnload(() => {
  if (timer > 0) clearInterval(timer)
  clearRecordTimer()
  // 页面卸载时释放感知层资源（单活跃实例，退出即释放）
  try {
    if (speech.isRecording()) speech.stop()
    if (asrSession != null) {
      asrSession.stop()
      asrSession = null
    }
    if (ttsHandle != null) {
      ttsHandle.stop()
      ttsHandle = null
    }
  } catch {
    // 忽略卸载阶段错误
  }
  // 移除网络状态监听，避免页面销毁后残留回调
  if (netHandler != null) {
    try {
      uni.offNetworkStatusChange(netHandler)
    } catch {
      // 忽略
    }
    netHandler = null
  }
})

// 系统返回（App 手势 / 安卓返回键）必须走确认，不能绕过二次确认（文档 03 硬交互规则）
onBackPress(() => {
  if (textModalVisible.value) {
    cancelText()
    return true
  }
  confirmExit()
  return true
})

// 初始化网络状态真实探测（M6）：进入即探测 + 监听变化，断开即时提示
function initNetwork() {
  try {
    uni.getNetworkType({
      success: (r: any) => {
        netOk.value = (r.networkType as string) !== 'none'
      }
    })
    netHandler = (r: any) => {
      const ok = r.isConnected as boolean
      if (netOk.value && !ok) {
        uni.showToast({ title: '网络已断开，请检查网络连接', icon: 'none' })
      }
      netOk.value = ok
    }
    uni.onNetworkStatusChange(netHandler)
  } catch {
    // 平台不支持时保持默认（不阻塞面试）
  }
}

// 初始化录音器（回调统一走感知层；H5 降级为文字作答）
function initRecorder() {
  speech.init({
    onStart: () => {},
    onStop: (result: RecordResult) => {
      // 平台到点自动停止（duration）与手动停止共用收口：录音态与计时器一并复位
      recording.value = false
      clearRecordTimer()
      lastAudioPath.value = result.audioPath
      handleRecordingStopped(result)
    },
    onError: (errMsg: string) => {
      console.warn('[room] recorder error', errMsg)
      caption.value = '录音失败，请改用文字作答'
      recording.value = false
      clearRecordTimer()
      avatarState.value = 'listening'
    }
  })
  // TTS 播放状态 → 语音状态切换
  onTtsState((state: 'start' | 'end') => {
    if (state === 'start') {
      ttsSpeaking.value = true
      avatarState.value = 'asking'
    } else {
      ttsSpeaking.value = false
      // 播报结束进入倾听（仅当仍处于提问/追问状态）
      if (avatarState.value === 'asking' || avatarState.value === 'followup') {
        avatarState.value = 'listening'
      }
    }
  })
}

async function init() {
  const s = await createSession(blueprint.value)
  sessionId.value = s.sessionId
  interviewSession.reset(s.sessionId)
  interviewSession.transition('DEVICE_CHECK')
  interviewSession.transition('READY')
  // 北极星：进入面试房间
  trackEvent('interview_start', {
    mode: mode.value,
    positionId: blueprint.value.positionId,
    experienceLevel: blueprint.value.experienceLevel
  })
  ask()
}

// 问新题（重置追问深度、清空追问话术、切到 ASKING）
async function ask() {
  interviewSession.resetDepth()
  followupPrompt.value = ''
  rephrasedText.value = ''
  interviewSession.transition('ASKING')
  avatarState.value = 'asking'
  caption.value = ''
  try {
    const q = await nextQuestion(sessionId.value, mode.value, blueprint.value)
    currentQuestion.value = q
    interviewSession.pushQuestion(q)
    askedCount.value = interviewSession.getQuestions().length
    trackEvent('interview_question_asked', {
      questionId: q.id,
      abilityDomain: q.abilityDomain,
      difficulty: q.difficulty
    })
    // 记录面试官念题
    interviewSession.appendTranscript({
      questionId: q.id,
      speaker: 'interviewer',
      text: q.content,
      timestamp: Date.now()
    })
  } catch (e: any) {
    // 题目已收束（选择器返回 null）→ 进入总结
    console.warn('[room] no more questions, wrap up', e)
    goSummary()
    return
  }
  // 面试官语音 TTS 播报题目（真实感知层），播报结束进入倾听
  interviewSession.transition('LISTENING')
  avatarState.value = 'asking'
  if (ttsHandle != null) {
    ttsHandle.stop()
  }
  ttsHandle = speak(currentQuestion.value.content)
}

// 发起追问（不切题，depth+1，展示追问话术）
function askFollowup(decision: FollowupDecision) {
  interviewSession.incrementDepth()
  followupPrompt.value = decision.prompt
  rephrasedText.value = ''
  caption.value = ''
  trackEvent('interview_followup_asked', {
    questionId: currentQuestion.value.id,
    intent: decision.intent,
    depth: decision.depth
  })
  // 状态回到 ASKING → LISTENING
  avatarState.value = 'followup'
  interviewSession.appendTranscript({
    questionId: currentQuestion.value.id,
    speaker: 'interviewer',
    text: decision.prompt,
    timestamp: Date.now()
  })
  // TTS 播报追问话术
  if (ttsHandle != null) {
    ttsHandle.stop()
  }
  ttsHandle = speak(decision.prompt)
}

function toggleRecord() {
  if (paused.value) {
    uni.showToast({ title: '已暂停，请先恢复', icon: 'none' })
    return
  }
  if (recording.value) {
    stopRecord(false)
  } else {
    startRecord()
  }
}

function startRecord() {
  recording.value = true
  startRecordTimer()
  avatarState.value = 'listening'
  lastAudioPath.value = ''
  liveTranscript.value = ''
  // 微信端：同步开启实时语音识别（边录边转，稳定文本进入字幕）
  if (cap.platform === 'mp-weixin') {
    asrSession = startRealtimeAsr((text: string, stable: boolean) => {
      if (stable) {
        // 稳定文本累积到 liveTranscript（仅稳定文本进入转写链）
        if (text.length > 0) {
          liveTranscript.value = liveTranscript.value + text
        }
      } else if (text.length > 0) {
        caption.value = text
      }
    })
  }
  caption.value = asrSession != null ? '正在聆听，请开始作答…' : '正在聆听…'
  if (speech.isReady()) {
    speech.start()
  } else {
    // 平台不支持录音：提示文字作答
    caption.value = '当前设备不支持录音，请切换文字作答'
  }
}

function stopRecord(_auto: boolean) {
  if (!recording.value) return
  recording.value = false
  clearRecordTimer()
  caption.value = '转写中…'
  // 先停实时识别（微信端），再停录音
  if (asrSession != null) {
    asrSession.stop()
    asrSession = null
  }
  if (speech.isReady()) {
    if (speech.isRecording()) {
      speech.stop()
    }
    // 已停止（平台 duration 到点先触发 onStop）：由 onStop 回调统一收口，避免空文本覆盖转写
  } else {
    // 无录音能力：用已积累的实时文本或提示降级
    finishTranscribe('')
  }
}

// 录音结束：按平台路由转写
// - MP-WEIXIN：优先用实时识别文本（若插件可用）；为空则走「云存储中转 → 服务端 ASR」
// - App：云端 multipart 上传转写
function handleRecordingStopped(result: RecordResult) {
  if (cap.platform === 'mp-weixin') {
    const live = liveTranscript.value.trim()
    if (live.length > 0) {
      finishTranscribe(live)
      return
    }
    // 实时识别不可用（个人主体无 wechatSI 插件）：录音落盘后走云存储中转转写
    if (!result.ok || result.audioPath.length === 0) {
      finishTranscribe('')
      return
    }
    uploadAsrCloud(result.audioPath)
      .then((r: AsrResponse) => {
        finishTranscribe(r.text)
      })
      .catch((e: any) => {
        const msg = e != null && e.message != null ? String(e.message) : 'unknown'
        console.warn('[room] asr-cloud failed', msg)
        finishTranscribe('')
      })
    return
  }
  if (!result.ok || result.audioPath.length === 0) {
    finishTranscribe('')
    return
  }
  // App 端：云端 ASR
  transcribe(result.audioPath).then((r: AsrResult) => {
    finishTranscribe(r.ok ? r.text : '')
  }).catch(() => {
    finishTranscribe('')
  })
}

// 转写收口：有文本走作答链，无文本提示文字降级（不静默丢答案）
function finishTranscribe(text: string) {
  const t = text.trim()
  if (t.length === 0) {
    caption.value = '没有听清你的回答，请重试或切换文字作答'
    avatarState.value = 'listening'
    trackEvent('interview_asr_fallback', { questionId: currentQuestion.value.id })
    return
  }
  handleAnswer(t, 'voice')
}

// 录音结束 / 文字提交后的统一处理：写转写、决策追问/下一题
function handleAnswer(answerText: string, inputMode: string = 'voice') {
  caption.value = '已记录你的回答'
  interviewSession.appendTranscript({
    questionId: currentQuestion.value.id,
    speaker: 'user',
    text: answerText,
    timestamp: Date.now()
  })
  interviewSession.saveDraft(currentQuestion.value.id, answerText)
  interviewSession.transition('TRANSCRIBING')
  interviewSession.transition('FOLLOW_UP_DECISION')
  trackEvent('interview_answer_submitted', {
    questionId: currentQuestion.value.id,
    inputMode: inputMode,
    length: answerText.length
  })

  // 基于回答规则信号判定是否追问
  const signal = analyzeAnswer(answerText, currentQuestion.value.id)
  const depth = interviewSession.getDepth()
  const decision = decideFollowup(signal, currentQuestion.value, depth)

  // 服务端答案上报（2026-10-12 P0 接线；mock 由 api 层内部短路）：
  // 服务端报告/审计/配额结算依赖该链路。失败不阻塞本地流程 —— 答案已入
  // transcript 与快照草稿，补传机制见 interview-session pendingEvents。
  submitAnswer(sessionId.value, currentQuestion.value.id, answerText, depth > 0).catch(
    (e: any) => {
      console.warn('[room] answer upload failed', e)
      trackEvent('interview_answer_upload_failed', { questionId: currentQuestion.value.id })
    }
  )

  if (decision.shouldFollowup) {
    setTimeout(() => {
      askFollowup(decision)
    }, 600)
  } else {
    setTimeout(() => {
      const ev = interviewSession.transition('NEXT_QUESTION')
      if (ev != null) ask()
    }, 800)
  }
}

function goSummary() {
  interviewSession.saveSnapshot()
  uni.navigateTo({ url: '/pages/interview/summary' })
}

// 再说一遍：重播当前展示文本（已换说法则重播澄清句，否则重播题面/追问）
function replayQuestion() {
  const text = rephrasedText.value.length > 0 ? rephrasedText.value : displayQuestion.value
  if (text.length === 0 || text === '准备开始…') {
    uni.showToast({ title: '还没有题目可重听', icon: 'none' })
    return
  }
  trackEvent('interview_replay_question', { questionId: currentQuestion.value.id })
  if (ttsHandle != null) ttsHandle.stop()
  ttsHandle = speak(text)
}

// 换一种说法：用引擎确定性澄清句追加一行并播报，不替换原题、不改难度与知识点
function onRephrase() {
  const q = currentQuestion.value
  if (q.content.length === 0) {
    uni.showToast({ title: '还没有题目可换说法', icon: 'none' })
    return
  }
  const text = rephraseQuestion({
    knowledgePoint: q.knowledgePoint,
    purpose: q.purpose
  } as RephraseInput)
  rephrasedText.value = text
  avatarState.value = 'asking'
  trackEvent('interview_rephrase_question', { questionId: q.id })
  if (ttsHandle != null) ttsHandle.stop()
  ttsHandle = speak(text)
}

function textMode() {
  if (recording.value) {
    uni.showToast({ title: '请先停止录音', icon: 'none' })
    return
  }
  textDraft.value = ''
  submittingText.value = false
  textModalVisible.value = true
}

function cancelText() {
  if (submittingText.value) return
  textModalVisible.value = false
  textDraft.value = ''
}

function submitText() {
  const t = textDraft.value.trim()
  if (t.length === 0) return
  if (t.length < 5) {
    uni.showToast({ title: '回答太短，至少 5 个字', icon: 'none' })
    return
  }
  submittingText.value = true
  textModalVisible.value = false
  caption.value = '已接收文字回答，分析中…'
  avatarState.value = 'thinking'
  setTimeout(() => {
    handleAnswer(t, 'text')
    submittingText.value = false
    textDraft.value = ''
  }, 300)
}

// 跳过本题：跳过保留为证据（文档 02 §2.2），写 transcript 标记后进下一题
function skipQuestion() {
  if (recording.value) {
    uni.showToast({ title: '请先停止录音', icon: 'none' })
    return
  }
  if (paused.value) {
    uni.showToast({ title: '已暂停，请先恢复', icon: 'none' })
    return
  }
  trackEvent('interview_skip', { questionId: currentQuestion.value.id })
  interviewSession.appendTranscript({
    questionId: currentQuestion.value.id,
    speaker: 'user',
    text: '（用户跳过本题）',
    timestamp: Date.now()
  })
  caption.value = '已跳过，进入下一题'
  avatarState.value = 'thinking'
  setTimeout(() => {
    const ev = interviewSession.transition('NEXT_QUESTION')
    if (ev != null) ask()
  }, 500)
}

// 暂停/恢复：冻结倒计时与录音入口，异常恢复语义（文档 02 §2.2）
function togglePause() {
  if (paused.value) {
    paused.value = false
    caption.value = '继续面试'
    avatarState.value = 'listening'
    return
  }
  if (recording.value) {
    uni.showToast({ title: '请先停止录音', icon: 'none' })
    return
  }
  paused.value = true
  avatarState.value = 'idle'
  caption.value = '已暂停，点击继续'
}

// 退出（放弃）：返回上一页，不生成报告；已作答内容保留为草稿（与「结束」语义区分）
function confirmExit() {
  const answered = interviewSession.getQuestions().length
  uni.showModal({
    title: '退出面试',
    content:
      answered > 0
        ? '退出将不生成报告，已作答内容会保留为草稿。想拿到报告请点右上角「结束」。确认退出？'
        : '将返回上一页，确认退出？',
    confirmText: '退出',
    cancelText: '继续作答',
    confirmColor: DANGER,
    success: (r: any) => {
      if (r.confirm) {
        trackEvent('interview_abandon', { reason: 'user_exit', answeredCount: answered })
        interviewSession.saveSnapshot()
        uni.navigateBack()
      }
    }
  })
}

// 结束（收口）：按已作答内容生成报告——用户答够即可主动收尾，不必等题池耗尽
function confirmFinish() {
  const answered = interviewSession.getQuestions().length
  if (answered === 0) {
    uni.showToast({ title: '还没有作答，先完成至少一道题', icon: 'none' })
    return
  }
  if (recording.value) {
    uni.showToast({ title: '请先停止录音', icon: 'none' })
    return
  }
  uni.showModal({
    title: '结束面试',
    content: '将按已作答的 ' + answered + ' 道题生成报告，结束后不可继续作答。确认结束？',
    confirmText: '结束并生成报告',
    cancelText: '继续作答',
    success: (r: any) => {
      if (r.confirm) {
        trackEvent('interview_finish_early', { answeredCount: answered })
        goSummary()
      }
    }
  })
}
</script>
