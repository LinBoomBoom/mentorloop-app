<template>
  <view class="flex-col h-screen bg-bg-light">
    <!-- 顶栏：退出 / AI 身份与进度 / 结束 -->
    <view
      class="bg-surface border-b border-line"
      :style="{ paddingTop: topPad + 'px', paddingRight: rightPad + 'px' }"
    >
      <view class="h-14 flex-row items-center px-4">
        <view
          class="w-9 h-9 rounded-full bg-bg-muted flex-row items-center justify-center"
          hover-class="pressed-chip"
          :hover-start-time="0"
          @click="confirmExit"
        >
          <ml-icon name="arrow-left" :size="17" :color="INK"></ml-icon>
        </view>
        <view class="flex-col flex-1 items-center">
          <view class="flex-row items-center">
            <view
              class="w-1.5 h-1.5 rounded-full mr-1.5"
              :style="{ backgroundColor: netOk ? RELIABLE : DANGER }"
            ></view>
            <text class="text-sm font-semibold text-ink">AI 面试官</text>
          </view>
          <text class="text-xs text-ink-soft mt-0.5"
            >已覆盖 {{ coveredCount }}/6 维度 · {{ askedCount }}/{{ modeMax }} 题 ·
            {{ elapsedText }}</text
          >
        </view>
        <view
          id="room-finish"
          class="h-8 px-3 rounded-chip border border-line-strong flex-row items-center"
          hover-class="pressed-chip"
          :hover-start-time="0"
          @click="confirmFinish"
        >
          <text class="text-xs font-semibold text-ink">结束</text>
        </view>
      </view>
      <view v-if="!netOk" class="px-4 pb-2">
        <text class="text-xs text-danger">{{ netText }}</text>
      </view>
    </view>

    <!-- 消息流 -->
    <scroll-view
      class="flex-1"
      scroll-y="true"
      :scroll-into-view="scrollTarget"
      :scroll-with-animation="true"
    >
      <view class="px-4 pt-4 pb-3">
        <view class="flex-row items-center justify-center">
          <view class="day-chip">
            <text class="text-xs text-ink-soft"
              >{{ blueprint.position }} · {{ blueprint.experienceRange }} · 本次面试</text
            >
          </view>
        </view>

        <!-- 首题加载骨架 -->
        <view v-if="messages.length === 0" class="mt-4 flex-col items-start">
          <text class="text-xs text-ink-soft ml-1 mb-1">AI 面试官 · 系统生成</text>
          <view class="bubble-ai">
            <text class="text-sm text-ink">正在准备第一题…</text>
          </view>
        </view>

        <view v-for="(m, idx) in messages" :key="m.id" :id="m.id" class="mt-3">
          <!-- AI 消息 -->
          <view v-if="m.role === 'ai'" class="flex-col items-start">
            <text class="text-xs text-ink-soft ml-1 mb-1">AI 面试官 · 系统生成</text>
            <view class="bubble-ai">
              <text class="text-sm leading-6 text-ink">{{ m.display }}</text>
            </view>

            <!-- 播报状态（仅最后一条 AI 消息） -->
            <view
              v-if="idx === lastAiIndex && ttsHint.length > 0"
              class="flex-row items-center mt-1 ml-1"
            >
              <ml-icon
                :name="ttsHint === 'speaking' ? 'volume-2' : 'info'"
                :size="12"
                :color="ttsHint === 'speaking' ? SMART : MIST"
              ></ml-icon>
              <text class="text-xs text-ink-soft ml-1">{{
                ttsHint === 'speaking'
                  ? '正在播报 · 文字与语音同步'
                  : '语音播报暂不可用，请阅读题面'
              }}</text>
            </view>

            <!-- 快捷操作（未在录音 / 确认 / 暂停时） -->
            <view
              v-if="idx === lastAiIndex && !m.streaming && !recording && !reviewVisible && !paused"
              class="flex-row items-center mt-2 ml-1"
            >
              <view
                class="quick-chip"
                hover-class="pressed-chip"
                :hover-start-time="0"
                @click="replayQuestion"
              >
                <ml-icon name="rotate-ccw" :size="12" :color="INK_SOFT"></ml-icon>
                <text class="text-xs text-ink-soft ml-1">再说一遍</text>
              </view>
              <view
                class="quick-chip ml-2"
                hover-class="pressed-chip"
                :hover-start-time="0"
                @click="onRephrase"
              >
                <ml-icon name="repeat" :size="12" :color="INK_SOFT"></ml-icon>
                <text class="text-xs text-ink-soft ml-1">换一种说法</text>
              </view>
            </view>
          </view>

          <!-- 用户消息 -->
          <view v-else class="flex-col items-end">
            <view class="bubble-me">
              <text class="text-sm leading-6 text-white">{{ m.display }}</text>
            </view>
            <text v-if="m.inputMode.length > 0" class="text-xs text-ink-soft mt-1 mr-1">{{
              m.inputMode === 'voice'
                ? '语音转写 · 已确认'
                : m.inputMode === 'skip'
                  ? '已跳过'
                  : '文字回答'
            }}</text>
          </view>
        </view>

        <!-- 录音面板 -->
        <view v-if="recording" class="mt-3 rounded-card p-4" :style="recordPanelStyle">
          <view class="flex-row items-center justify-between">
            <view class="flex-row items-center">
              <view class="w-2 h-2 rounded-full bg-danger mr-2 pulse-dot"></view>
              <text class="text-xs text-white">正在录音 · 实时字幕</text>
            </view>
            <text class="text-sm font-mono text-white">{{ recordSeconds }}s</text>
          </view>
          <text class="text-sm text-white mt-2 leading-6">{{ caption }}</text>
          <view class="flex-row items-end mt-2 h-8">
            <view
              v-for="n in 14"
              :key="'bar' + n"
              class="rec-bar mr-1"
              :style="{ height: 6 + (n % 5) * 4 + 'px' }"
            ></view>
          </view>
          <view class="flex-row items-center justify-between mt-3">
            <text class="text-xs" :style="{ color: 'rgba(255,255,255,0.62)' }"
              >松开或点击结束，转成文字后确认</text
            >
            <view
              class="rec-stop"
              hover-class="pressed-chip"
              :hover-start-time="0"
              @click="toggleRecord"
            >
              <text class="text-xs font-semibold text-white">结束录音</text>
            </view>
          </view>
        </view>

        <!-- 转写确认 -->
        <view v-if="reviewVisible" class="mt-3">
          <ml-card>
            <view class="flex-row items-center justify-between">
              <text class="text-sm font-semibold text-ink">识别结果 · 请确认</text>
              <text class="text-xs text-ink-soft">{{ reviewText.length }} 字</text>
            </view>
            <textarea
              class="w-full h-28 rounded-control p-3 text-sm text-ink bg-bg-muted mt-2"
              :value="reviewText"
              placeholder="识别文本可在此修改…"
              placeholder-class="text-ink-soft"
              :maxlength="1000"
              @input="onReviewInput"
            />
            <view class="flex-row mt-3">
              <ml-button text="重新录制" type="secondary" @tap="retryRecord"></ml-button>
              <view class="w-2"></view>
              <ml-button
                text="确认提交"
                type="primary"
                :disabled="reviewText.length === 0"
                @tap="confirmReview"
              ></ml-button>
            </view>
          </ml-card>
        </view>

        <!-- 状态提示（转写中 / 已记录 / 降级说明） -->
        <view
          v-if="caption.length > 0 && !recording && !reviewVisible"
          class="mt-3 rounded-control bg-bg-muted p-3"
        >
          <text class="text-xs text-ink-soft">{{ caption }}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 输入条 -->
    <view class="bg-surface border-t border-line px-3 pt-2.5" :style="{ paddingBottom: bottomPad }">
      <!-- 第 7 题后：用户选择生成报告或续一题（不设固定时长，随时可结束） -->
      <view
        v-if="offerActive"
        id="room-continue-bar"
        class="mb-2 rounded-control border border-line bg-bg-muted p-3"
      >
        <text class="text-xs text-ink-soft"
          >已覆盖 {{ coveredCount }}/6 维度，可生成报告或再来一题</text
        >
        <view class="flex-row mt-2">
          <view
            id="room-continue-one"
            class="flex-1 h-9 rounded-control flex-row items-center justify-center"
            :style="{ backgroundColor: SMART }"
            hover-class="pressed-chip"
            :hover-start-time="0"
            @click="continueOne"
          >
            <text class="text-sm font-semibold text-white">再来一题</text>
          </view>
          <view class="w-2"></view>
          <view
            id="room-report-now"
            class="flex-1 h-9 rounded-control border border-line-strong bg-surface flex-row items-center justify-center"
            hover-class="pressed-chip"
            :hover-start-time="0"
            @click="confirmFinish"
          >
            <text class="text-sm font-semibold text-ink">生成报告</text>
          </view>
        </view>
      </view>
      <!-- 结束/续题选择期间隐藏作答入口，避免对已收尾的题重复作答 -->
      <view v-if="!offerActive" class="flex-row items-center">
        <view
          v-show="!textInputActive"
          id="room-text-toggle"
          class="w-10 h-10 rounded-full bg-bg-muted flex-row items-center justify-center"
          hover-class="pressed-chip"
          :hover-start-time="0"
          @click="textMode"
        >
          <ml-icon name="keyboard" :size="18" :color="INK_SOFT"></ml-icon>
        </view>

        <view
          v-show="!textInputActive"
          id="room-voice-toggle"
          class="flex-1 mx-2 h-10 rounded-full border border-line-strong flex-row items-center justify-center"
          :style="{ backgroundColor: recording ? 'rgba(220,38,38,0.08)' : SURFACE }"
          hover-class="pressed-chip"
          :hover-start-time="0"
          @click="toggleRecord"
        >
          <ml-icon
            :name="recording ? 'square' : 'mic'"
            :size="16"
            :color="recording ? DANGER : SMART"
          ></ml-icon>
          <text class="text-sm ml-1.5" :class="recording ? 'text-danger' : 'text-ink'">{{
            paused ? '已暂停 · 点此继续' : recordButtonText
          }}</text>
        </view>

        <view
          v-show="textInputActive"
          class="flex-1 mx-2 h-10 rounded-full border border-line-strong bg-bg-muted px-3 flex-row items-center"
        >
          <input
            id="room-text-input"
            class="flex-1 text-sm text-ink"
            :value="textDraft"
            placeholder="输入你的回答…"
            placeholder-class="text-ink-soft"
            :maxlength="1000"
            :focus="textInputActive"
            :disabled="submittingText"
            @input="onTextInput"
            @confirm="submitText"
          />
        </view>

        <view
          v-show="textInputActive"
          id="room-send"
          class="w-10 h-10 rounded-full flex-row items-center justify-center"
          :style="{ backgroundColor: DRAFT_OK ? SMART : BG_MUTED }"
          hover-class="pressed-chip"
          :hover-start-time="0"
          @click="submitText"
        >
          <ml-icon name="arrow-up-right" :size="18" :color="SURFACE"></ml-icon>
        </view>
        <view
          v-show="!textInputActive"
          class="w-10 h-10 rounded-full flex-row items-center justify-center"
          :style="{ backgroundColor: recording ? DANGER : SMART }"
          hover-class="pressed-chip"
          :hover-start-time="0"
          @click="toggleRecord"
        >
          <ml-icon :name="recording ? 'square' : 'mic'" :size="18" :color="SURFACE"></ml-icon>
        </view>
      </view>

      <view v-if="!offerActive" class="flex-row items-center justify-between mt-2 px-1">
        <text class="text-xs text-ink-soft" @click="togglePause">{{
          paused ? '继续面试' : '暂停'
        }}</text>
        <text id="room-skip" class="text-xs text-ink-soft" @click="skipQuestion"
          >跳过本题（保留为证据）</text
        >
        <text v-if="textInputActive" class="text-xs text-ink-soft" @click="cancelText"
          >切回语音</text
        >
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad, onShow, onUnload, onBackPress } from '@dcloudio/uni-app'
import mlButton from '../../components/ml-button.uvue'
import mlCard from '../../components/ml-card.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import { themeValue } from '../../styles/theme.uts'
import { interviewSession } from '../../store/interview-session.uts'
import { userStore } from '../../store/user-profile.uts'
import { createSession, nextQuestion, submitAnswer } from '../../api/interview.uts'
import {
  QuestionItem,
  PositionBlueprint,
  InterviewMode,
  PositionId,
  ExperienceLevel
} from '../../types/interview.uts'
import { getPositionName, getExperienceRange } from '../../data/position-options.uts'
import { decideFollowup, FollowupDecision } from '../../engine/followup-engine.uts'
import { analyzeAnswer } from '../../engine/answer-signal.uts'
import { rephraseQuestion, RephraseInput } from '../../engine/rephrase.uts'
import { trackEvent } from '../../api/tracking.uts'
import {
  SpeechRecorder,
  RecordResult,
  speak,
  TtsHandle,
  onTtsState,
  startRealtimeAsr,
  RealtimeAsrSession,
  transcribe,
  AsrResult,
  speechCapability
} from '../../api/speech.uts'
import { uploadAsrCloud, AsrResponse } from '../../api/asr.uts'
import { devicePlugin } from '../../utssdk/interviewer-device/index.uts'

const SMART = themeValue('smart', '#5856D6')
const SURFACE = themeValue('surface', '#FFFFFF')
const MIST = themeValue('mist', '#AEAEB2')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const DANGER = themeValue('danger', '#DC2626')
const INK = themeValue('ink', '#1C1C1E')
const INK_SOFT = themeValue('inkSoft', '#6E6E73')
const BG_MUTED = themeValue('bgMuted', '#E9E9EF')
const NAVY_DEEP = themeValue('navyDeep', '#0B2138')

// 对话消息（仅客户端视图模型；题目与答案仍走原接口）
type ChatMessage = {
  id: string
  role: string
  text: string
  display: string
  streaming: boolean
  inputMode: string
}
const messages = ref<ChatMessage[]>([])
let streamTimer: number = 0
let msgSeq: number = 0
const scrollTarget = ref('')
const lastAiIndex = computed((): number => {
  for (let i = messages.value.length - 1; i >= 0; i--) {
    if (messages.value[i].role === 'ai') return i
  }
  return -1
})
// 文字输入态：与录音互斥；发送后回到语音条
const textInputActive = ref(false)
// 续题上限：0 = 模式预算；用户点「再来一题」后置 12（契约 2026-10-24）
const extendedMax = ref(0)
// 当前模式题量上限（仅用于顶部进度展示）
const modeMax = computed((): number => {
  if (extendedMax.value > 0) return extendedMax.value
  if (mode.value === 'quick') return 3
  if (mode.value === 'deep') return 12
  return 7
})
const DRAFT_OK = computed((): boolean => textDraft.value.trim().length > 0)

const recording = ref(false)
// 单次录音上限（秒）：微信 ASR 硬限 60s / 1MB，留 5s 余量；到点自动停止并直接送转写
const RECORD_MAX_SECONDS = 55
const recordSeconds = ref(0)
const recordButtonText = computed((): string => {
  if (!recording.value) return '点击说话'
  const remain = RECORD_MAX_SECONDS - recordSeconds.value
  return remain > 0 ? '点击结束 · 剩 ' + remain + 's' : '转写中'
})
const elapsed = ref(0)
// 时长语义 v2：正计时展示（用户自主控制时长：题池封顶 + 随时手动退出），不再倒计时自动收束
const elapsedText = computed((): string => {
  const m = Math.floor(elapsed.value / 60)
  const s = elapsed.value % 60
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return pad(m) + ':' + pad(s)
})
const caption = ref('')
const sessionId = ref('')
// 当前已推进到第几题（工程化题号展示）
const askedCount = ref(0)
// 本场已触达的能力域（去重；用于覆盖度展示）
const coveredDomains = ref<string[]>([])
const coveredCount = computed((): number => {
  const n = coveredDomains.value.length
  return n > 6 ? 6 : n
})
// 已完成的主问题数（不含追问）；第 7 题后触发结束/续题选择
const mainDone = ref(0)
const continueOfferVisible = ref(false)
const offerActive = computed((): boolean => {
  return (
    continueOfferVisible.value && !recording.value && !reviewVisible.value && !paused.value
  )
})
// 当前追问话术（非空时显示追问而非原题）
const followupPrompt = ref('')
// 换一种说法生成的澄清句（非空时在题面下方追加展示，原题保留）
const rephrasedText = ref('')
// 最近一次录音文件路径（供 ASR 上送与证据存档）
const lastAudioPath = ref('')
// ASR 实时识别的中间文本（仅稳定文本进入转写链）
const liveTranscript = ref('')
// 面试模式（由 prep 页传入）
const mode = ref<InterviewMode>('standard')
// 当前会话的岗位蓝图（由 prep 页传入的 positionId + experienceLevel 构造）
const blueprint = ref<PositionBlueprint>({
  positionId: 'backend',
  position: '后端',
  experienceLevel: 'junior',
  experienceRange: '1-3年',
  companyType: '互联网',
  language: '中文',
  target: '求职'
} as PositionBlueprint)

// 安全区内边距（onLoad 时从窗口信息读取）
const topPad = ref(28)
// 存 px 字符串：小程序端数值型 style 绑定可能被当成无单位值丢弃
const bottomPad = ref('16px')
// MP 端顶栏右侧让出微信胶囊宽度，避免「结束」按钮被胶囊遮挡（同首页 C6）
const rightPad = ref(20)
// #ifdef MP-WEIXIN
rightPad.value = 100
// #endif

// 文字输入状态（底部输入条内联，不再是弹窗）
const textDraft = ref('')
const submittingText = ref(false)

// 暂停状态（暂停时冻结计时与录音入口）
const paused = ref(false)

// 续接标记（App 启动恢复快照时传入 resume=1，复用原会话而不是新建）
let wantResume = false
// 最后一条答案的上报 Promise（结束面试前必须等待落库，否则报告会漏最后一题）
let answerInFlight: Promise<boolean> | null = null
// 防止重复进入总结页
let summarizing = false
// 防止重复点击「跳过」叠加多个推进定时器
let skipping = false
// 会话失效提示只弹一次
let expiredShown = false

// 网络状态（M6：真实探测，替代表头硬编码）
const netOk = ref(true)
const netText = computed((): string => (netOk.value ? '网络良好' : '网络已断开'))
let netHandler: ((r: any) => void) | null = null

// 感知层：录音器 + TTS 句柄 + 实时识别会话 + 平台能力
const speech = new SpeechRecorder()
let ttsHandle: TtsHandle | null = null
let asrSession: RealtimeAsrSession | null = null
const cap = speechCapability()
// TTS 播放状态（驱动语音状态切换）
const ttsSpeaking = ref(false)
// TTS 可听性提示：'' 未播报 | speaking 播放中 | unavailable 无法出声（明示，不静默）
const ttsHint = ref('')
// 识别结果确认态：先让用户看清自己的回答，再决定提交或重录
const reviewVisible = ref(false)
const reviewText = ref('')

const initialState: string = 'idle'
const avatarState = ref(initialState)

// 语音状态仍由 avatarState 驱动（对话流的播报 / 倾听切换依赖它），状态文案不再单独展示

const emptyQuestion: QuestionItem = {
  id: '',
  positionId: 'backend',
  abilityDomain: '',
  subAbility: '',
  knowledgePoint: '',
  content: '',
  purpose: '',
  difficulty: 'junior',
  type: 'concept',
  misconceptions: [],
  expectedEvidence: '',
  followupPrompts: [],
  resumeRisk: false
} as QuestionItem
const currentQuestion = ref(emptyQuestion)

let timer: number = 0
// 录音计时器（与面试总计时分离：到 55s 自动停止并转写）
let recordTimer: number = 0

function clearRecordTimer() {
  if (recordTimer > 0) {
    clearInterval(recordTimer)
    recordTimer = 0
  }
}

function startRecordTimer() {
  clearRecordTimer()
  recordSeconds.value = 0
  recordTimer = setInterval(() => {
    if (!recording.value) {
      clearRecordTimer()
      return
    }
    recordSeconds.value = recordSeconds.value + 1
    if (recordSeconds.value >= RECORD_MAX_SECONDS) {
      clearRecordTimer()
      stopRecord(true)
      uni.showToast({ title: '已达单次录音上限，自动转写', icon: 'none' })
    }
  }, 1000)
}

// 展示文本：追问时显示追问话术，否则显示原题
const displayQuestion = computed((): string => {
  if (followupPrompt.value.length > 0) return followupPrompt.value
  if (currentQuestion.value.content.length > 0) return currentQuestion.value.content
  return '准备开始…'
})

// 录音面板深色底（实色，无 blur）
const recordPanelStyle = {
  backgroundColor: NAVY_DEEP
}

// 对话流：滚动 / 逐字上屏 / 追加消息
function scrollToLatest() {
  const n = messages.value.length
  if (n === 0) return
  const id = messages.value[n - 1].id
  scrollTarget.value = id
  setTimeout(() => {
    scrollTarget.value = id
  }, 60)
}

// 一次性收束所有未完成的逐字动画（新题到来 / 语音降级时）
function finishStreams() {
  if (streamTimer > 0) {
    clearInterval(streamTimer)
    streamTimer = 0
  }
  const list = messages.value
  for (let i = 0; i < list.length; i++) {
    if (list[i].streaming) {
      list[i].display = list[i].text
      list[i].streaming = false
    }
  }
}

// 逐字上屏：与语音播报形成「流式」观感；约 45ms/字
function startStream(m: ChatMessage) {
  if (streamTimer > 0) {
    clearInterval(streamTimer)
    streamTimer = 0
  }
  let i = 0
  m.display = ''
  m.streaming = true
  streamTimer = setInterval(() => {
    i = i + 1
    if (i >= m.text.length) {
      m.display = m.text
      m.streaming = false
      clearInterval(streamTimer)
      streamTimer = 0
      return
    }
    m.display = m.text.substring(0, i)
    if (i % 14 === 0) scrollToLatest()
  }, 45)
}

function pushAiMessage(text: string) {
  finishStreams()
  msgSeq = msgSeq + 1
  const m = {
    id: 'msg-' + msgSeq,
    role: 'ai',
    text: text,
    display: '',
    streaming: true,
    inputMode: ''
  } as ChatMessage
  messages.value.push(m)
  scrollToLatest()
  startStream(m)
}

function pushUserMessage(text: string, inputMode: string) {
  msgSeq = msgSeq + 1
  const m = {
    id: 'msg-' + msgSeq,
    role: 'user',
    text: text,
    display: text,
    streaming: false,
    inputMode: inputMode
  } as ChatMessage
  messages.value.push(m)
  scrollToLatest()
}

onLoad((options: any) => {
  // 读取安全区：顶部状态栏 + 底部 home indicator
  try {
    const win = uni.getWindowInfo()
    const sb = win.statusBarHeight
    topPad.value = sb > 0 ? sb + 6 : 28
    const insets = win.safeAreaInsets
    const bottom = insets != null ? insets.bottom : 0
    bottomPad.value = (bottom > 0 ? bottom + 10 : 16) + 'px'
  } catch {
    topPad.value = 28
    bottomPad.value = '16px'
  }

  // 接收 prep 页传入的模式、岗位方向、经验等级
  if (options != null) {
    wantResume = options.resume != null && String(options.resume) === '1'
    if (options.mode != null) {
      const m = options.mode as string
      if (m === 'quick') {
        mode.value = 'quick'
      } else if (m === 'deep') {
        mode.value = 'deep'
      } else {
        mode.value = 'standard'
      }
    }
    const posId = options.positionId != null ? (options.positionId as string) : 'backend'
    const expLv = options.experienceLevel != null ? (options.experienceLevel as string) : 'junior'
    // 简单校验枚举值（方向体系 v2：frontend/backend/devops/ai）
    const validPos: string[] = ['frontend', 'backend', 'devops', 'ai']
    const validExp: string[] = ['fresh', 'junior', 'mid', 'senior']
    const finalPos: PositionId = validPos.includes(posId) ? (posId as PositionId) : 'backend'
    const finalExp: ExperienceLevel = validExp.includes(expLv)
      ? (expLv as ExperienceLevel)
      : 'junior'
    blueprint.value = {
      positionId: finalPos,
      position: getPositionName(finalPos),
      experienceLevel: finalExp,
      experienceRange: getExperienceRange(finalExp),
      companyType: '互联网',
      language: '中文',
      target: '求职'
    } as PositionBlueprint
  }
  // prep 页麦克风授权被拒时以文字作答进入（text=1）
  if (options != null && options.text != null && String(options.text) === '1') {
    textInputActive.value = true
  }
  initNetwork()
  initRecorder()
  init()
  timer = setInterval(() => {
    if (paused.value) return // 暂停时冻结计时
    elapsed.value = elapsed.value + 1
  }, 1000)
})

onShow(() => {
  // 从总结页返回房间时恢复「结束」入口，避免 summarizing 卡死后续操作
  summarizing = false
})

onUnload(() => {
  if (timer > 0) clearInterval(timer)
  clearRecordTimer()
  if (streamTimer > 0) {
    clearInterval(streamTimer)
    streamTimer = 0
  }
  // 页面卸载时释放感知层资源（单活跃实例，退出即释放）
  try {
    if (speech.isRecording()) speech.stop()
    if (asrSession != null) {
      asrSession.stop()
      asrSession = null
    }
    if (ttsHandle != null) {
      ttsHandle.stop()
      ttsHandle = null
    }
  } catch {
    // 忽略卸载阶段错误
  }
  // 移除网络状态监听，避免页面销毁后残留回调
  if (netHandler != null) {
    try {
      uni.offNetworkStatusChange(netHandler)
    } catch {
      // 忽略
    }
    netHandler = null
  }
})

// 系统返回（App 手势 / 安卓返回键）必须走确认，不能绕过二次确认（文档 03 硬交互规则）
onBackPress(() => {
  if (textInputActive.value) {
    cancelText()
    return true
  }
  confirmExit()
  return true
})

// 初始化网络状态真实探测（M6）：进入即探测 + 监听变化，断开即时提示
function initNetwork() {
  try {
    uni.getNetworkType({
      success: (r: any) => {
        netOk.value = (r.networkType as string) !== 'none'
      }
    })
    netHandler = (r: any) => {
      const ok = r.isConnected as boolean
      if (netOk.value && !ok) {
        uni.showToast({ title: '网络已断开，请检查网络连接', icon: 'none' })
      }
      netOk.value = ok
    }
    uni.onNetworkStatusChange(netHandler)
  } catch {
    // 平台不支持时保持默认（不阻塞面试）
  }
}

// 初始化录音器（回调统一走感知层；H5 降级为文字作答）
function initRecorder() {
  speech.init({
    onStart: () => {},
    onStop: (result: RecordResult) => {
      // 平台到点自动停止（duration）与手动停止共用收口：录音态与计时器一并复位
      recording.value = false
      clearRecordTimer()
      lastAudioPath.value = result.audioPath
      handleRecordingStopped(result)
    },
    onError: (errMsg: string) => {
      console.warn('[room] recorder error', errMsg)
      // 停掉并行的实时识别，避免降级后仍有转写文本上屏
      if (asrSession != null) {
        asrSession.stop()
        asrSession = null
      }
      recording.value = false
      clearRecordTimer()
      // 麦克风拒绝 / 录音器不可用：自动切到文字作答，面试继续
      fallbackToText('录音不可用，已切换为文字作答')
    }
  })
  // TTS 播放状态 → 语音状态切换
  onTtsState((state: 'start' | 'end') => {
    if (state === 'start') {
      ttsSpeaking.value = true
      // 静默降级也会发 start（仅按文本长度占位）：不可用提示优先，不能被改回「正在播报」
      if (ttsHint.value !== 'unavailable') ttsHint.value = 'speaking'
      avatarState.value = 'asking'
    } else {
      ttsSpeaking.value = false
      // 播报自然结束：清掉播放中提示（不可用提示保留，直到下一题）
      if (ttsHint.value === 'speaking') ttsHint.value = ''
      // 播报结束进入倾听（仅当仍处于提问/追问状态）
      if (avatarState.value === 'asking' || avatarState.value === 'followup') {
        avatarState.value = 'listening'
      }
    }
  })
}

async function init() {
  // 续接上次未完成的面试：复用快照 sessionId 与已答记录，不新建会话
  if (wantResume && interviewSession.prepareResume()) {
    sessionId.value = interviewSession.sessionId
    askedCount.value = interviewSession.getQuestions().length
    mainDone.value = askedCount.value
    syncCoveredDomains()
    const posId = userStore.profile.positionId
    const expLv = userStore.profile.experienceLevel
    blueprint.value = {
      positionId: posId,
      position: getPositionName(posId),
      experienceLevel: expLv,
      experienceRange: getExperienceRange(expLv),
      companyType: '互联网',
      language: '中文',
      target: '求职'
    } as PositionBlueprint
    trackEvent('interview_resume', {
      mode: mode.value,
      positionId: posId,
      answeredCount: askedCount.value
    })
    ask()
    return
  }
  try {
    const s = await createSession(blueprint.value)
    sessionId.value = s.sessionId
    interviewSession.reset(s.sessionId)
    interviewSession.transition('DEVICE_CHECK')
    interviewSession.transition('READY')
    // 北极星：进入面试房间
    trackEvent('interview_start', {
      mode: mode.value,
      positionId: blueprint.value.positionId,
      experienceLevel: blueprint.value.experienceLevel
    })
    ask()
  } catch (e: any) {
    const msg = e != null && e.message != null ? String(e.message) : '网络异常'
    console.warn('[room] create session failed', msg)
    showInitFailed(msg)
  }
}

// 建会话失败：给出重试 / 退出两条路，不把页面停在「准备开始…」
function showInitFailed(msg: string) {
  uni.showModal({
    title: '无法开始面试',
    content: msg.length > 0 ? msg : '网络异常，请检查网络后重试',
    confirmText: '重试',
    cancelText: '退出',
    success: (r: any) => {
      if (r.confirm) {
        init()
      } else {
        uni.navigateBack()
      }
    }
  })
}

// 本场已触达能力域去重（覆盖度展示；不参与评分）
function syncCoveredDomains() {
  const qs = interviewSession.getQuestions()
  const list: string[] = []
  for (let i = 0; i < qs.length; i++) {
    const d = qs[i].abilityDomain
    if (d.length > 0 && list.indexOf(d) < 0) list.push(d)
  }
  coveredDomains.value = list
}

// 用户选择续一题：同一 session 继续，上限 12（契约 2026-10-24）
function continueOne() {
  if (extendedMax.value > 0) return
  extendedMax.value = 12
  continueOfferVisible.value = false
  const ev = interviewSession.transition('NEXT_QUESTION')
  if (ev != null) ask()
  else continueOfferVisible.value = true
}

// 问新题（重置追问深度、清空追问话术、切到 ASKING）
async function ask() {
  interviewSession.resetDepth()
  followupPrompt.value = ''
  rephrasedText.value = ''
  reviewVisible.value = false
  reviewText.value = ''
  ttsHint.value = ''
  if (interviewSession.getStatus() !== 'ASKING') interviewSession.transition('ASKING')
  avatarState.value = 'asking'
  caption.value = ''
  try {
    const q = await nextQuestion(
      sessionId.value,
      mode.value,
      blueprint.value,
      [],
      0,
      [],
      [],
      extendedMax.value
    )
    currentQuestion.value = q
    interviewSession.pushQuestion(q)
    askedCount.value = interviewSession.getQuestions().length
    syncCoveredDomains()
    trackEvent('interview_question_asked', {
      questionId: q.id,
      abilityDomain: q.abilityDomain,
      difficulty: q.difficulty
    })
    // 记录面试官念题
    interviewSession.appendTranscript({
      questionId: q.id,
      speaker: 'interviewer',
      text: q.content,
      timestamp: Date.now()
    })
  } catch (e: any) {
    const msg = e != null && e.message != null ? String(e.message) : '网络异常'
    // 只有「题目已收束」才进入总结；网络错误 / 服务端 500 必须可重试，不能把中途断网当面试结束
    if (msg.indexOf('已收束') >= 0 || msg.indexOf('NO_MORE_QUESTIONS') >= 0) {
      goSummary()
      return
    }
    if (msg.indexOf('会话不存在') >= 0 || msg.indexOf('404') >= 0) {
      showSessionExpired()
      return
    }
    console.warn('[room] next question failed', msg)
    showAskFailed(msg)
    return
  }
  // 先上屏（逐字），再播报：文字与语音同步
  pushAiMessage(currentQuestion.value.content)
  interviewSession.transition('LISTENING')
  avatarState.value = 'asking'
  if (ttsHandle != null) {
    ttsHandle.stop()
  }
  ttsHandle = speak(currentQuestion.value.content, onTtsUnavailable)
}

// TTS 未能真实出声：文字立即完整上屏，明示替代路径，不让用户以为「坏了」
function onTtsUnavailable() {
  ttsHint.value = 'unavailable'
  finishStreams()
}

// 发起追问（不切题，depth+1，展示追问话术）
function askFollowup(decision: FollowupDecision) {
  interviewSession.incrementDepth()
  followupPrompt.value = decision.prompt
  rephrasedText.value = ''
  caption.value = ''
  trackEvent('interview_followup_asked', {
    questionId: currentQuestion.value.id,
    intent: decision.intent,
    depth: decision.depth
  })
  // 状态回到 ASKING → LISTENING
  avatarState.value = 'followup'
  interviewSession.appendTranscript({
    questionId: currentQuestion.value.id,
    speaker: 'interviewer',
    text: decision.prompt,
    timestamp: Date.now()
  })
  // 追问同样以气泡入流后再播报
  pushAiMessage(decision.prompt)
  // TTS 播报追问话术
  if (ttsHandle != null) {
    ttsHandle.stop()
  }
  ttsHint.value = ''
  ttsHandle = speak(decision.prompt, onTtsUnavailable)
}

// 出题失败（非收束）：重试原流程；已答过题时可选择结束并生成报告
function showAskFailed(msg: string) {
  const answered = interviewSession.getQuestions().length > 0
  uni.showModal({
    title: '题目加载失败',
    content: msg.length > 0 ? msg : '网络异常，请检查网络后重试',
    confirmText: '重试',
    cancelText: answered ? '结束面试' : '退出',
    success: (r: any) => {
      if (r.confirm) {
        ask()
        return
      }
      if (answered) {
        goSummary()
      } else {
        interviewSession.saveSnapshot()
        uni.navigateBack()
      }
    }
  })
}

// 会话已失效（服务端清理 / 快照过期）：明确告知并退出，不伪造进度
function showSessionExpired() {
  if (expiredShown) return
  expiredShown = true
  interviewSession.clearSnapshot()
  uni.showModal({
    title: '面试会话已失效',
    content: '服务端已清理该会话，请退回后重新开始一场面试。',
    showCancel: false,
    confirmText: '返回',
    success: () => {
      uni.navigateBack()
    }
  })
}

function toggleRecord() {
  if (paused.value) {
    uni.showToast({ title: '已暂停，请先恢复', icon: 'none' })
    return
  }
  // 识别结果待确认时，录音主按钮只提示，不静默丢弃用户回答
  if (reviewVisible.value) {
    uni.showToast({ title: '请先确认提交或重新录制', icon: 'none' })
    return
  }
  if (recording.value) {
    stopRecord(false)
  } else {
    startRecord()
  }
}

function startRecord() {
  // 用户开始作答即打断播报（不盖过用户），文字立即完整上屏
  if (ttsHandle != null) {
    ttsHandle.stop()
    ttsHandle = null
  }
  ttsSpeaking.value = false
  if (ttsHint.value === 'speaking') ttsHint.value = ''
  finishStreams()
  recording.value = true
  startRecordTimer()
  avatarState.value = 'listening'
  lastAudioPath.value = ''
  liveTranscript.value = ''
  // 重新录制：丢弃上一次的识别结果
  reviewVisible.value = false
  reviewText.value = ''
  // 微信端：同步开启实时语音识别（边录边转，稳定文本进入字幕）
  if (cap.platform === 'mp-weixin') {
    asrSession = startRealtimeAsr((text: string, stable: boolean) => {
      if (stable) {
        // 稳定文本累积到 liveTranscript（仅稳定文本进入转写链），并同步上屏
        if (text.length > 0) {
          liveTranscript.value = liveTranscript.value + text
          caption.value = liveTranscript.value
        }
      } else if (text.length > 0) {
        // 中间结果实时上屏，让用户确认「系统听到的是我」
        caption.value = text
      }
    })
  }
  caption.value = asrSession != null ? '正在聆听，请开始作答…' : '正在聆听…'
  if (speech.isReady()) {
    speech.start()
  } else {
    // 平台不支持录音：复位录音态并提示文字作答，不能停在「停止录音」按钮上
    if (asrSession != null) {
      asrSession.stop()
      asrSession = null
    }
    recording.value = false
    clearRecordTimer()
    fallbackToText('当前设备不支持录音，已切换为文字作答')
  }
}

function stopRecord(_auto: boolean) {
  if (!recording.value) return
  recording.value = false
  clearRecordTimer()
  caption.value = '转写中…'
  // 先停实时识别（微信端），再停录音
  if (asrSession != null) {
    asrSession.stop()
    asrSession = null
  }
  if (speech.isReady()) {
    if (speech.isRecording()) {
      speech.stop()
    }
    // 已停止（平台 duration 到点先触发 onStop）：由 onStop 回调统一收口，避免空文本覆盖转写
  } else {
    // 无录音能力：用已积累的实时文本或提示降级
    finishTranscribe('')
  }
}

// 录音结束：先自检落盘，再按平台路由转写
// 「没录到音频」与「录到了但转写为空」是两种故障，提示必须分开
function handleRecordingStopped(result: RecordResult) {
  const path = result.audioPath
  if (!result.ok || path.length === 0) {
    reportRecordEmpty('录音未落盘')
    return
  }
  devicePlugin
    .audioFileSize(path)
    .then((size: number) => {
      console.log('[room] 录音结束，字节数=' + size + '，path=' + path)
      if (size === 0) {
        reportRecordEmpty('录音文件为空')
        return
      }
      routeTranscribe(path)
    })
    .catch(() => {
      routeTranscribe(path)
    })
}

// 采集失败：给出可执行的重试路径，不静默、不伪装成转写失败
function reportRecordEmpty(reason: string) {
  console.warn('[room] 没有录到音频：' + reason)
  caption.value = '没有录到音频，请检查麦克风权限后重试，或切换文字作答'
  avatarState.value = 'listening'
  trackEvent('interview_asr_fallback', {
    questionId: currentQuestion.value.id,
    reason: 'record_empty'
  })
}

// 音频有效：按平台路由转写
// - MP-WEIXIN：优先用实时识别文本（若插件可用）；为空则走「云存储中转 → 服务端 ASR」
// - App：云端 multipart 上传转写
function routeTranscribe(path: string) {
  if (cap.platform === 'mp-weixin') {
    const live = liveTranscript.value.trim()
    if (live.length > 0) {
      finishTranscribe(live)
      return
    }
    uploadAsrCloud(path)
      .then((r: AsrResponse) => {
        if (r.text.trim().length === 0) {
          // 服务端诚实降级会返回 200 + 空文本：云端 ASR_PROVIDER 未开或 WX 凭据失效
          console.warn('[room] asr-cloud 返回空文本，检查云端 ASR_PROVIDER / WX_APPID / WX_SECRET')
        }
        finishTranscribe(r.text)
      })
      .catch((e: any) => {
        const msg = e != null && e.message != null ? String(e.message) : 'unknown'
        console.warn('[room] asr-cloud failed', msg)
        finishTranscribe('')
      })
    return
  }
  // App 端：云端 ASR
  transcribe(path).then((r: AsrResult) => {
    finishTranscribe(r.ok ? r.text : '')
  }).catch(() => {
    finishTranscribe('')
  })
}

// 转写收口：有文本进入「识别结果确认」；无文本提示文字降级（不静默丢答案）
// 2026-10-23 真机反馈：直接提交会让人看不到自己说了什么，必须由用户确认
function finishTranscribe(text: string) {
  const t = text.trim()
  if (t.length === 0) {
    caption.value = '没有听清你的回答，请重试或切换文字作答'
    avatarState.value = 'listening'
    trackEvent('interview_asr_fallback', { questionId: currentQuestion.value.id })
    return
  }
  reviewText.value = t
  reviewVisible.value = true
  caption.value = '识别完成，请确认你的回答'
  avatarState.value = 'listening'
  trackEvent('interview_asr_review_shown', { questionId: currentQuestion.value.id, length: t.length })
}

// 确认识别结果：按用户最终文本提交（可先编辑）
function confirmReview() {
  const t = reviewText.value.trim()
  if (t.length === 0) {
    uni.showToast({ title: '回答为空，请重新录制或输入', icon: 'none' })
    return
  }
  reviewVisible.value = false
  handleAnswer(t, 'voice')
}

// 重新录制：丢弃本次识别，直接回到录音态
function retryRecord() {
  reviewVisible.value = false
  reviewText.value = ''
  liveTranscript.value = ''
  caption.value = ''
  startRecord()
}

// 答案上报：首次失败后 800ms 重试一次；返回是否最终成功。
// 不抛错（失败已记录事件），调用方通过返回值决定是否提示。
function submitAnswerReliably(
  sid: string,
  questionId: string,
  text: string,
  isFollowup: boolean
): Promise<boolean> {
  return submitAnswer(sid, questionId, text, isFollowup)
    .then(() => {
      return true
    })
    .catch(() => {
      return new Promise<boolean>((resolve) => {
        setTimeout(() => {
          submitAnswer(sid, questionId, text, isFollowup)
            .then(() => {
              resolve(true)
            })
            .catch((e: any) => {
              console.warn('[room] answer upload failed after retry', e)
              trackEvent('interview_answer_upload_failed', { questionId: questionId })
              resolve(false)
            })
        }, 800)
      })
    })
}

// 录音结束 / 文字提交后的统一处理：写转写、决策追问/下一题
function handleAnswer(answerText: string, inputMode: string = 'voice') {
  pushUserMessage(answerText, inputMode)
  caption.value = '已记录你的回答'
  interviewSession.appendTranscript({
    questionId: currentQuestion.value.id,
    speaker: 'user',
    text: answerText,
    timestamp: Date.now()
  })
  interviewSession.saveDraft(currentQuestion.value.id, answerText)
  interviewSession.transition('TRANSCRIBING')
  interviewSession.transition('FOLLOW_UP_DECISION')
  trackEvent('interview_answer_submitted', {
    questionId: currentQuestion.value.id,
    inputMode: inputMode,
    length: answerText.length
  })

  // 基于回答规则信号判定是否追问
  const signal = analyzeAnswer(answerText, currentQuestion.value.id)
  const depth = interviewSession.getDepth()
  const decision = decideFollowup(signal, currentQuestion.value, depth)

  // 服务端答案上报（2026-10-12 P0 接线；mock 由 api 层内部短路）：
  // 服务端报告/审计/配额结算依赖该链路。上报串行化并保留最后一个 Promise，
  // 结束面试前 await 它，避免「最后一题还没落库就生成报告」。
  const qid = currentQuestion.value.id
  const task = submitAnswerReliably(sessionId.value, qid, answerText, depth > 0)
  if (answerInFlight != null) {
    const prev = answerInFlight
    answerInFlight = prev.then((): Promise<boolean> => task)
  } else {
    answerInFlight = task
  }

  if (decision.shouldFollowup) {
    setTimeout(() => {
      askFollowup(decision)
    }, 600)
  } else {
    mainDone.value = mainDone.value + 1
    // 第 7 道主问题答完：不自动出题，给用户「生成报告 / 再来一题」的选择
    if (mainDone.value >= 7 && extendedMax.value === 0) {
      continueOfferVisible.value = true
      return
    }
    setTimeout(() => {
      const ev = interviewSession.transition('NEXT_QUESTION')
      if (ev != null) ask()
    }, 800)
  }
}

async function goSummary() {
  if (summarizing) return
  summarizing = true
  // 报告由服务端基于 answers 表生成：必须等最后一条答案落库后再进入总结页
  if (answerInFlight != null) {
    caption.value = '正在保存最后一条回答…'
    const ok = await answerInFlight
    answerInFlight = null
    if (!ok) uni.showToast({ title: '最后一条回答保存失败，报告可能缺少该题', icon: 'none' })
  }
  interviewSession.saveSnapshot()
  uni.navigateTo({
    url: '/pages/interview/summary',
    fail: () => {
      summarizing = false
    }
  })
}

// 再说一遍：重播当前展示文本（已换说法则重播澄清句，否则重播题面/追问）
function replayQuestion() {
  const text = rephrasedText.value.length > 0 ? rephrasedText.value : displayQuestion.value
  if (text.length === 0 || text === '准备开始…') {
    uni.showToast({ title: '还没有题目可重听', icon: 'none' })
    return
  }
  trackEvent('interview_replay_question', { questionId: currentQuestion.value.id })
  if (ttsHandle != null) ttsHandle.stop()
  ttsHint.value = ''
  ttsHandle = speak(text, onTtsUnavailable)
}

// 换一种说法：用引擎确定性澄清句追加一行并播报，不替换原题、不改难度与知识点
function onRephrase() {
  const q = currentQuestion.value
  if (q.content.length === 0) {
    uni.showToast({ title: '还没有题目可换说法', icon: 'none' })
    return
  }
  const text = rephraseQuestion({
    knowledgePoint: q.knowledgePoint,
    purpose: q.purpose
  } as RephraseInput)
  rephrasedText.value = text
  avatarState.value = 'asking'
  trackEvent('interview_rephrase_question', { questionId: q.id })
  pushAiMessage('换一种说法：' + text)
  if (ttsHandle != null) {
    ttsHandle.stop()
  }
  ttsHint.value = ''
  ttsHandle = speak(text, onTtsUnavailable)
}

function onTextInput(e: UniInputEvent) {
  textDraft.value = e.detail.value
}

function onReviewInput(e: UniInputEvent) {
  reviewText.value = e.detail.value
}

// 录音失败自动降级文字作答（麦克风拒绝 / 录音器不可用）：给用户可继续答题的出口
function fallbackToText(msg: string) {
  caption.value = msg
  avatarState.value = 'listening'
  if (reviewVisible.value || submittingText.value) return
  textDraft.value = ''
  textInputActive.value = true
}

function textMode() {
  if (recording.value) {
    uni.showToast({ title: '请先停止录音', icon: 'none' })
    return
  }
  if (reviewVisible.value) {
    uni.showToast({ title: '请先确认提交或重新录制', icon: 'none' })
    return
  }
  textDraft.value = ''
  submittingText.value = false
  textInputActive.value = true
}

function cancelText() {
  if (submittingText.value) return
  textInputActive.value = false
  textDraft.value = ''
}

function submitText() {
  const t = textDraft.value.trim()
  if (t.length === 0) return
  if (t.length < 5) {
    uni.showToast({ title: '回答太短，至少 5 个字', icon: 'none' })
    return
  }
  submittingText.value = true
  textInputActive.value = false
  caption.value = '已接收文字回答，分析中…'
  avatarState.value = 'thinking'
  setTimeout(() => {
    handleAnswer(t, 'text')
    submittingText.value = false
    textDraft.value = ''
  }, 300)
}

// 跳过本题：跳过保留为证据（文档 02 §2.2），写 transcript 标记后进下一题
function skipQuestion() {
  if (skipping) return
  if (recording.value) {
    uni.showToast({ title: '请先停止录音', icon: 'none' })
    return
  }
  if (paused.value) {
    uni.showToast({ title: '已暂停，请先恢复', icon: 'none' })
    return
  }
  skipping = true
  trackEvent('interview_skip', { questionId: currentQuestion.value.id })
  pushUserMessage('（跳过本题）', 'skip')
  interviewSession.appendTranscript({
    questionId: currentQuestion.value.id,
    speaker: 'user',
    text: '（用户跳过本题）',
    timestamp: Date.now()
  })
  caption.value = '已跳过，进入下一题'
  avatarState.value = 'thinking'
  setTimeout(() => {
    // 跳过等价于「无追问的作答收口」：按状态机允许路径到 FOLLOW_UP_DECISION
    const t1 = interviewSession.transition('TRANSCRIBING')
    if (t1 == null) {
      skipping = false
      return
    }
    interviewSession.transition('FOLLOW_UP_DECISION')
    mainDone.value = mainDone.value + 1
    if (mainDone.value >= 7 && extendedMax.value === 0) {
      caption.value = '已跳过本题，可生成报告或再来一题'
      continueOfferVisible.value = true
      skipping = false
      return
    }
    const ev = interviewSession.transition('NEXT_QUESTION')
    skipping = false
    if (ev != null) ask()
  }, 500)
}

// 暂停/恢复：冻结倒计时与录音入口，异常恢复语义（文档 02 §2.2）
function togglePause() {
  if (paused.value) {
    paused.value = false
    caption.value = '继续面试'
    avatarState.value = 'listening'
    return
  }
  if (recording.value) {
    uni.showToast({ title: '请先停止录音', icon: 'none' })
    return
  }
  paused.value = true
  avatarState.value = 'idle'
  caption.value = '已暂停，点击继续'
}

// 退出（放弃）：返回上一页，不生成报告；已作答内容保留为草稿（与「结束」语义区分）
function confirmExit() {
  const answered = interviewSession.getQuestions().length
  uni.showModal({
    title: '退出面试',
    content:
      answered > 0
        ? '退出将不生成报告，已作答内容会保留为草稿。想拿到报告请点右上角「结束」。确认退出？'
        : '将返回上一页，确认退出？',
    confirmText: '退出',
    cancelText: '继续作答',
    confirmColor: DANGER,
    success: (r: any) => {
      if (r.confirm) {
        trackEvent('interview_abandon', { reason: 'user_exit', answeredCount: answered })
        interviewSession.saveSnapshot()
        uni.navigateBack()
      }
    }
  })
}

// 结束（收口）：按已作答内容生成报告——用户答够即可主动收尾，不必等题池耗尽
function confirmFinish() {
  const answered = interviewSession.getQuestions().length
  if (answered === 0) {
    uni.showToast({ title: '还没有作答，先完成至少一道题', icon: 'none' })
    return
  }
  if (recording.value) {
    uni.showToast({ title: '请先停止录音', icon: 'none' })
    return
  }
  uni.showModal({
    title: '结束面试',
    content: '将按已作答的 ' + answered + ' 道题生成报告，结束后不可继续作答。确认结束？',
    confirmText: '结束并生成报告',
    cancelText: '继续作答',
    success: (r: any) => {
      if (r.confirm) {
        trackEvent('interview_finish_early', { answeredCount: answered })
        goSummary()
      }
    }
  })
}
</script>

