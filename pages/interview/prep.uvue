<template>
  <scroll-view class="h-screen bg-bg-light" scroll-y="true">
    <view class="p-4">
      <!-- 顶部说明 -->
      <view class="mb-4 mt-1">
        <text class="text-xl font-bold text-ink">定制你的模拟面试</text>
        <text class="text-sm text-ink-soft mt-1">
          选择方向与等级，题目会按你的简历与能力水平动态匹配
        </text>
      </view>

      <!-- 岗位方向选择 -->
      <view class="mb-3">
        <ml-card>
          <view class="flex-row items-center">
            <ml-icon name="target" :size="14" color="#5B6CFF"></ml-icon>
            <text class="text-sm font-semibold text-ink ml-1.5">面试方向</text>
          </view>
          <view class="flex-row flex-wrap mt-3">
            <view
              v-for="p in positionOptions"
              :key="p.id"
              class="h-9 pl-3.5 pr-3 rounded-lg flex-row items-center mr-2 mb-2"
              :class="
                positionId === p.id ? 'bg-smart' : p.available ? 'bg-line' : 'bg-line opacity-60'
              "
              :hover-class="p.available ? 'chip-pressed' : 'none'"
              :hover-start-time="0"
              @click="selectPosition(p)"
            >
              <text
                class="text-sm"
                :class="
                  positionId === p.id ? 'text-white' : p.available ? 'text-ink' : 'text-ink-soft'
                "
              >
                {{ p.name }}
              </text>
              <ml-icon v-if="positionId === p.id" name="check" :size="13" color="#FFFFFF"></ml-icon>
              <text v-if="!p.available" class="text-xs text-mist ml-1">敬请期待</text>
            </view>
          </view>
        </ml-card>
      </view>

      <!-- 经验等级选择 -->
      <view class="mb-3">
        <ml-card>
          <view class="flex-row items-center">
            <ml-icon name="trending-up" :size="14" color="#5B6CFF"></ml-icon>
            <text class="text-sm font-semibold text-ink ml-1.5">经验年限</text>
            <text class="text-xs text-ink-soft ml-2">决定题目难度区间</text>
          </view>
          <view class="flex-row flex-wrap mt-3">
            <view
              v-for="e in experienceOptions"
              :key="e.id"
              class="px-3.5 h-9 rounded-lg flex-row items-center mr-2 mb-2"
              :class="experienceLevel === e.id ? 'bg-smart' : 'bg-line'"
              hover-class="chip-pressed"
              :hover-start-time="0"
              @click="experienceLevel = e.id"
            >
              <text class="text-sm" :class="experienceLevel === e.id ? 'text-white' : 'text-ink'">
                {{ e.label }}
              </text>
            </view>
          </view>
        </ml-card>
      </view>

      <!-- 面试时长 -->
      <view class="mb-3">
        <ml-card>
          <view class="flex-row items-center">
            <ml-icon name="clock" :size="14" color="#5B6CFF"></ml-icon>
            <text class="text-sm font-semibold text-ink ml-1.5">面试时长</text>
          </view>
          <view class="flex-row mt-3">
            <view
              class="flex-1 h-11 rounded-lg flex-col items-center justify-center mr-2"
              :class="mode === 'quick' ? 'bg-smart' : 'bg-line'"
              hover-class="chip-pressed"
              :hover-start-time="0"
              @click="mode = 'quick'"
            >
              <text class="text-sm" :class="mode === 'quick' ? 'text-white' : 'text-ink'">
                快练
              </text>
              <text class="text-xs" :class="mode === 'quick' ? 'text-white' : 'text-ink-soft'">
                5 分钟
              </text>
            </view>
            <view
              class="flex-1 h-11 rounded-lg flex-col items-center justify-center mr-2"
              :class="mode === 'standard' ? 'bg-smart' : 'bg-line'"
              hover-class="chip-pressed"
              :hover-start-time="0"
              @click="mode = 'standard'"
            >
              <text class="text-sm" :class="mode === 'standard' ? 'text-white' : 'text-ink'">
                标准
              </text>
              <text class="text-xs" :class="mode === 'standard' ? 'text-white' : 'text-ink-soft'">
                20 分钟
              </text>
            </view>
            <view
              class="flex-1 h-11 rounded-lg flex-col items-center justify-center"
              :class="mode === 'deep' ? 'bg-smart' : 'bg-line'"
              hover-class="chip-pressed"
              :hover-start-time="0"
              @click="mode = 'deep'"
            >
              <text class="text-sm" :class="mode === 'deep' ? 'text-white' : 'text-ink'">
                深度
              </text>
              <text class="text-xs" :class="mode === 'deep' ? 'text-white' : 'text-ink-soft'">
                40 分钟
              </text>
            </view>
          </view>
        </ml-card>
      </view>

      <!-- 设备检测 -->
      <ml-card>
        <view class="flex-row items-center">
          <ml-icon name="shield-check" :size="14" color="#5B6CFF"></ml-icon>
          <text class="text-sm font-semibold text-ink ml-1.5">设备检测</text>
        </view>
        <view
          class="flex-row justify-between items-center h-11 mt-1"
          v-for="c in checks"
          :key="c.key"
        >
          <text class="text-sm text-ink">{{ c.name }}</text>
          <text
            class="text-xs"
            :class="c.ok ? 'text-reliable' : c.checking ? 'text-mist' : 'text-warn'"
          >
            {{ c.ok ? '已通过' : c.checking ? '检测中…' : '待检测' }}
          </text>
        </view>
        <text v-if="checkError.length > 0" class="text-xs text-danger mt-1">{{ checkError }}</text>
        <view class="mt-2">
          <ml-button
            :text="deviceOk ? '进入面试' : checking ? '检测中…' : '开始检测'"
            :type="deviceOk ? 'primary' : 'secondary'"
            block
            :disabled="checking || !canStart"
            @click="onPrimary"
          ></ml-button>
        </view>
      </ml-card>

      <view class="h-6"></view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow, onLoad } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import { userStore } from '../../store/user-profile.uts'
import { POSITION_OPTIONS, EXPERIENCE_OPTIONS } from '../../data/position-options.uts'
import {
  PositionId,
  PositionOption,
  ExperienceLevel,
  InterviewMode
} from '../../types/interview.uts'
import { devicePlugin } from '../../utssdk/interviewer-device/index.uts'

type CheckKey = 'mic' | 'net' | 'record'

type CheckItem = {
  key: CheckKey
  name: string
  ok: boolean
  checking: boolean
}

const positionOptions = POSITION_OPTIONS
const experienceOptions = EXPERIENCE_OPTIONS

// 默认读取用户上次选择
const positionId = ref<PositionId>(userStore.profile.positionId)
const experienceLevel = ref<ExperienceLevel>(userStore.profile.experienceLevel)
const mode = ref<InterviewMode>('standard')
const checking = ref(false)
const checkError = ref('')

const initialChecks: CheckItem[] = [
  { key: 'net', name: '网络', ok: false, checking: false } as CheckItem,
  { key: 'record', name: '录音授权', ok: false, checking: false } as CheckItem,
  { key: 'mic', name: '麦克风', ok: false, checking: false } as CheckItem
]
const checks = ref(initialChecks)

const deviceOk = computed(() => {
  const list: CheckItem[] = checks.value
  return list.every((c: CheckItem) => c.ok)
})

// 当前选中方向必须可用（题库就绪）才能开始
const canStart = computed((): boolean => {
  for (let i = 0; i < positionOptions.length; i++) {
    if (positionOptions[i].id === positionId.value) return positionOptions[i].available
  }
  return false
})

onShow(() => {
  // 从用户 profile 恢复默认选择
  positionId.value = userStore.profile.positionId
  experienceLevel.value = userStore.profile.experienceLevel
  // P2-12：插件快速预检（只读，不弹窗）——已授权/联网时直接点亮对应项
  quickPrelight()
  // P2-12：网络断连监听（面试前断网即时提示，给出解决路径）
  devicePlugin.onNetworkChange((online: boolean) => {
    if (!online) {
      checkError.value = '网络已断开，请检查网络连接'
      setCheck('net', false, false)
    } else if (checkError.value.indexOf('网络已断开') >= 0) {
      checkError.value = ''
      setCheck('net', true, false)
    }
  })
})

// P2-12：进入页面即做只读预检（不弹权限窗），已满足的项直接置绿
function quickPrelight() {
  devicePlugin.checkPermission().then((p) => {
    if (p.network) setCheck('net', true, false)
    if (p.record) setCheck('record', true, false)
  })
}

// 支持外部传入模式（首页快练/标准/深度直达）；无传参时使用档案默认偏好
onLoad((q: OnLoadOption) => {
  const m = q != null && q['mode'] != null ? (q['mode'] as string) : ''
  if (m === 'quick' || m === 'standard' || m === 'deep') {
    mode.value = m as InterviewMode
  } else {
    mode.value = userStore.profile.defaultMode
  }
})

function selectPosition(p: PositionOption) {
  if (!p.available) {
    uni.showToast({ title: p.name + '题库建设中，敬请期待', icon: 'none' })
    return
  }
  positionId.value = p.id
}

function setCheck(key: CheckKey, ok: boolean, isChecking: boolean) {
  const next: CheckItem[] = []
  for (let i = 0; i < checks.value.length; i++) {
    const c = checks.value[i]
    if (c.key === key) {
      next.push({ key: c.key, name: c.name, ok: ok, checking: isChecking } as CheckItem)
    } else {
      next.push(c)
    }
  }
  checks.value = next
}

// 1) 网络检测：用 uni.getNetworkType
function checkNet(): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    setCheck('net', false, true)
    uni.getNetworkType({
      success: (r: any) => {
        const t = r.networkType as string
        const ok = t !== 'none'
        setCheck('net', ok, false)
        resolve(ok)
      },
      fail: () => {
        setCheck('net', false, false)
        resolve(false)
      }
    })
  })
}

// 2) 录音授权：uni.authorize + uni.getSetting
function checkRecordAuth(): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    setCheck('record', false, true)
    // #ifdef MP-WEIXIN || APP-PLUS || APP
    uni.getSetting({
      success: (r: any) => {
        const authSetting = r.authSetting
        const scopeRecord = authSetting != null ? authSetting['scope.record'] : null
        if (scopeRecord === false) {
          // 曾经被拒：引导用户手动开启
          uni.showModal({
            title: '需要录音权限',
            content: '请在设置中开启麦克风授权，否则无法进行面试。',
            confirmText: '去设置',
            success: (m: any) => {
              if (m.confirm) {
                uni.openSetting({
                  success: (s: any) => {
                    const ok =
                      s.authSetting != null && s.authSetting['scope.record'] === true
                    setCheck('record', ok, false)
                    resolve(ok)
                  }
                })
              } else {
                setCheck('record', false, false)
                resolve(false)
              }
            }
          })
          return
        }
        if (scopeRecord === true) {
          setCheck('record', true, false)
          resolve(true)
          return
        }
        // 未申请过：主动请求授权
        uni.authorize({
          scope: 'scope.record',
          success: () => {
            setCheck('record', true, false)
            resolve(true)
          },
          fail: () => {
            setCheck('record', false, false)
            resolve(false)
          }
        })
      },
      fail: () => {
        // H5 等不支持授权 API 的环境：直接放行（H5 录音走浏览器媒体设备）
        setCheck('record', true, false)
        resolve(true)
      }
    })
    // #endif
    // #ifndef MP-WEIXIN || APP-PLUS || APP
    setCheck('record', true, false)
    resolve(true)
    // #endif
  })
}

// 3) 麦克风可用性：尝试启动一次短录音（1s）验证
function checkMic(): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    setCheck('mic', false, true)
    try {
      // #ifdef MP-WEIXIN || APP-PLUS || APP
      const rm = uni.getRecorderManager()
      let done = false
      const finish = (ok: boolean) => {
        if (done) return
        done = true
        setCheck('mic', ok, false)
        resolve(ok)
      }
      rm.onStart(() => {
        setTimeout(() => {
          try {
            rm.stop()
          } catch {
            finish(false)
          }
        }, 800)
      })
      rm.onStop(() => {
        finish(true)
      })
      rm.onError(() => {
        finish(false)
      })
      rm.start({ format: 'mp3', duration: 2000 })
      // #endif
      // #ifndef MP-WEIXIN || APP-PLUS || APP
      setCheck('mic', true, false)
      resolve(true)
      // #endif
    } catch {
      setCheck('mic', false, false)
      resolve(false)
    }
  })
}

async function runCheck() {
  if (checking.value) return
  checking.value = true
  checkError.value = ''
  // 重置所有状态为未通过
  const reset: CheckItem[] = []
  for (let i = 0; i < initialChecks.length; i++) {
    reset.push({
      key: initialChecks[i].key,
      name: initialChecks[i].name,
      ok: false,
      checking: false
    } as CheckItem)
  }
  checks.value = reset

  const netOk = await checkNet()
  const authOk = await checkRecordAuth()
  // 仅在网络+授权都通过时再探测麦克风（避免两次弹权限）
  const micOk = netOk && authOk ? await checkMic() : false

  checking.value = false
  if (!netOk) checkError.value = '网络不可用，请连接网络后重试'
  else if (!authOk) checkError.value = '未获得录音授权，无法开始面试'
  else if (!micOk) checkError.value = '麦克风不可用，请检查设备或权限'
}

function start() {
  if (!deviceOk.value || !canStart.value) return
  // 持久化用户的方向/等级选择，下次进入默认选中
  userStore.setProfile({
    uid: null,
    nickname: null,
    plan: null,
    positionId: positionId.value,
    experienceLevel: experienceLevel.value,
    defaultMode: null,
    token: null
  })
  userStore.persist()
  // 将方向、等级、时长一同传给房间页
  const url =
    '/pages/interview/room?mode=' +
    mode.value +
    '&positionId=' +
    positionId.value +
    '&experienceLevel=' +
    experienceLevel.value
  uni.navigateTo({ url: url })
}

function onPrimary() {
  if (deviceOk.value) start()
  else runCheck()
}
</script>

<style>
.chip-pressed {
  opacity: 0.8;
}
</style>
