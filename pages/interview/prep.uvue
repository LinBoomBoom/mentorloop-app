<template>
  <view class="h-screen bg-bg-light">
    <scroll-view class="h-screen" scroll-y="true">
      <view class="p-4">
        <!-- 顶部说明 -->
        <view class="mb-4 mt-1">
          <text class="text-[22px] font-bold text-ink">定制你的模拟面试</text>
          <text class="text-sm text-ink-soft mt-1">
            选择方向与等级，题目会按你的简历与能力水平动态匹配
          </text>
        </view>

        <!-- 岗位方向选择 -->
        <view class="mb-3">
          <ml-card>
            <view class="flex-row items-center">
              <ml-icon name="target" :size="14" :color="SMART"></ml-icon>
              <text class="text-sm font-semibold text-ink ml-1.5">面试方向</text>
            </view>
            <view class="flex-row flex-wrap mt-3">
              <ml-chip
                v-for="p in positionOptions"
                :key="p.id"
                class="mr-2 mb-2"
                :label="p.name"
                :selected="positionId === p.id"
                :disabled="!p.available"
                :hint="p.available ? '' : '敬请期待'"
                @tap="selectPosition(p)"
              ></ml-chip>
            </view>
          </ml-card>
        </view>

        <!-- 经验等级选择 -->
        <view class="mb-3">
          <ml-card>
            <view class="flex-row items-center">
              <ml-icon name="trending-up" :size="14" :color="SMART"></ml-icon>
              <text class="text-sm font-semibold text-ink ml-1.5">经验年限</text>
              <text class="text-xs text-ink-soft ml-2">决定题目难度区间</text>
            </view>
            <view class="flex-row flex-wrap mt-3">
              <ml-chip
                v-for="e in experienceOptions"
                :key="e.id"
                class="mr-2 mb-2"
                :label="e.label"
                :selected="experienceLevel === e.id"
                @tap="experienceLevel = e.id"
              ></ml-chip>
            </view>
          </ml-card>
        </view>

        <!-- 设备检测 -->
        <ml-card>
          <view class="flex-row items-center">
            <ml-icon name="shield-check" :size="14" :color="SMART"></ml-icon>
            <text class="text-sm font-semibold text-ink ml-1.5">设备检测</text>
          </view>
          <view
            class="flex-row justify-between items-center h-11 mt-1"
            v-for="c in checks"
            :key="c.key"
          >
            <text class="text-sm text-ink">{{ c.name }}</text>
            <text
              class="text-xs"
              :class="c.ok ? 'text-reliable' : c.checking ? 'text-ink-soft' : 'text-warn'"
            >
              {{ c.ok ? '已通过' : c.checking ? '检测中…' : '待检测' }}
            </text>
          </view>
          <text v-if="checkError.length > 0" class="text-xs text-danger mt-1">{{
            checkError
          }}</text>
          <view class="mt-2">
            <ml-button
              :text="
                !loggedIn
                  ? '登录后进入面试'
                  : deviceOk
                    ? '进入面试'
                    : checking
                      ? '检测中…'
                      : '开始检测'
              "
              :type="deviceOk && loggedIn ? 'primary' : 'secondary'"
              block
              :disabled="checking || !canStart || !loggedIn"
              @tap="onPrimary"
            ></ml-button>
          </view>
        </ml-card>

        <view class="h-6"></view>
      </view>
    </scroll-view>

    <!-- 登录兜底层：openid 静默登录即可面试；仅在静默登录失败时出现 -->
    <ml-login-sheet v-if="showLogin" @success="onLoginSuccess" @exit="onLoginExit"></ml-login-sheet>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlChip from '../../components/ml-chip.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlLoginSheet from '../../components/ml-login-sheet.uvue'
import { userStore } from '../../store/user-profile.uts'
import { loginByWechat, applyAuth } from '../../api/auth.uts'
import { POSITION_OPTIONS, EXPERIENCE_OPTIONS, PositionOption } from '../../data/position-options.uts'
import { PositionId, ExperienceLevel } from '../../types/interview.uts'
import { devicePlugin } from '../../utssdk/interviewer-device/index.uts'
import { themeValue } from '../../styles/theme.uts'

const SMART = themeValue('smart', '#5B6CFF')

type CheckKey = 'mic' | 'net' | 'record' | 'speaker'

type CheckItem = {
  key: CheckKey
  name: string
  ok: boolean
  checking: boolean
}

// 麦克风探测结果：ok=采集成功；path=落盘文件路径（空串表示无可回放音频）
type MicProbe = {
  ok: boolean
  path: string
}

const positionOptions = POSITION_OPTIONS
const experienceOptions = EXPERIENCE_OPTIONS

// 默认读取用户上次选择
const positionId = ref<PositionId>(userStore.profile.positionId)
const experienceLevel = ref<ExperienceLevel>(userStore.profile.experienceLevel)
const checking = ref(false)
const checkError = ref('')

// 登录门控（2026-10-23 PO 口径）：openid 静默登录即可面试；
// 手机号改为购买会员时再绑定，不再作为进入面试的前置条件。
const loggedIn = ref(userStore.isLoggedIn())
const showLogin = ref(false)

const initialChecks: CheckItem[] = [
  { key: 'net', name: '网络', ok: false, checking: false } as CheckItem,
  { key: 'record', name: '录音授权', ok: false, checking: false } as CheckItem,
  { key: 'mic', name: '麦克风', ok: false, checking: false } as CheckItem,
  { key: 'speaker', name: '扬声器', ok: false, checking: false } as CheckItem
]
const checks = ref(initialChecks)

const deviceOk = computed(() => {
  const list: CheckItem[] = checks.value
  return list.every((c: CheckItem) => c.ok)
})

// 当前选中方向必须可用（题库就绪）才能开始
const canStart = computed((): boolean => {
  for (let i = 0; i < positionOptions.length; i++) {
    if (positionOptions[i].id === positionId.value) return positionOptions[i].available
  }
  return false
})

onShow(() => {
  // 从用户 profile 恢复默认选择
  positionId.value = userStore.profile.positionId
  experienceLevel.value = userStore.profile.experienceLevel
  // 登录门控：已登录（openid）即放行；未登录先静默登录一次，失败才弹兜底层
  loggedIn.value = userStore.isLoggedIn()
  if (!loggedIn.value) ensureLogin()
  // P2-12：插件快速预检（只读，不弹窗）——已授权/联网时直接点亮对应项
  quickPrelight()
  // P2-12：网络断连监听（面试前断网即时提示，给出解决路径）
  devicePlugin.onNetworkChange((online: boolean) => {
    if (!online) {
      checkError.value = '网络已断开，请检查网络连接'
      setCheck('net', false, false)
    } else if (checkError.value.indexOf('网络已断开') >= 0) {
      checkError.value = ''
      setCheck('net', true, false)
    }
  })
})

// 静默登录（openid）：成功即放行；失败才落到登录层兜底
function ensureLogin() {
  // #ifdef MP-WEIXIN
  uni.login({
    provider: 'weixin',
    success: (res: any) => {
      const code = res.code as string
      if (code == null || code.length === 0) {
        showLogin.value = true
        return
      }
      loginByWechat(code)
        .then((r) => {
          applyAuth(r, '')
          loggedIn.value = true
          showLogin.value = false
        })
        .catch(() => {
          console.warn('[prep] silent login failed')
          showLogin.value = true
        })
    },
    fail: () => {
      showLogin.value = true
    }
  })
  // #endif
  // #ifndef MP-WEIXIN
  // App/H5：无微信静默登录，直接走登录页/登录层
  showLogin.value = true
  // #endif
}

// 登录层回调：成功放行；「暂不登录」退出本页返回上一页（不放行面试）
function onLoginSuccess() {
  loggedIn.value = userStore.isLoggedIn()
  showLogin.value = false
  uni.showToast({ title: '登录成功', icon: 'none' })
}

function onLoginExit() {
  showLogin.value = false
  uni.navigateBack()
}

// P2-12：进入页面即做只读预检（不弹权限窗），已满足的项直接置绿
function quickPrelight() {
  devicePlugin.checkPermission().then((p) => {
    if (p.network) setCheck('net', true, false)
    if (p.record) setCheck('record', true, false)
  })
}

function selectPosition(p: PositionOption) {
  if (!p.available) {
    uni.showToast({ title: p.name + '题库建设中，敬请期待', icon: 'none' })
    return
  }
  positionId.value = p.id
}

function setCheck(key: CheckKey, ok: boolean, isChecking: boolean) {
  const next: CheckItem[] = []
  for (let i = 0; i < checks.value.length; i++) {
    const c = checks.value[i]
    if (c.key === key) {
      next.push({ key: c.key, name: c.name, ok: ok, checking: isChecking } as CheckItem)
    } else {
      next.push(c)
    }
  }
  checks.value = next
}

// 1) 网络检测：用 uni.getNetworkType
function checkNet(): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    setCheck('net', false, true)
    uni.getNetworkType({
      success: (r: any) => {
        const t = r.networkType as string
        const ok = t !== 'none'
        setCheck('net', ok, false)
        resolve(ok)
      },
      fail: () => {
        setCheck('net', false, false)
        resolve(false)
      }
    })
  })
}

// 2) 录音授权：uni.authorize + uni.getSetting
function checkRecordAuth(): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    setCheck('record', false, true)
    // #ifdef MP-WEIXIN || APP-PLUS || APP
    uni.getSetting({
      success: (r: any) => {
        const authSetting = r.authSetting
        const scopeRecord = authSetting != null ? authSetting['scope.record'] : null
        if (scopeRecord === false) {
          // 曾经被拒：引导用户手动开启
          uni.showModal({
            title: '需要录音权限',
            content: '请在设置中开启麦克风授权，否则无法进行面试。',
            confirmText: '去设置',
            success: (m: any) => {
              if (m.confirm) {
                uni.openSetting({
                  success: (s: any) => {
                    const ok =
                      s.authSetting != null && s.authSetting['scope.record'] === true
                    setCheck('record', ok, false)
                    resolve(ok)
                  }
                })
              } else {
                setCheck('record', false, false)
                resolve(false)
              }
            }
          })
          return
        }
        if (scopeRecord === true) {
          setCheck('record', true, false)
          resolve(true)
          return
        }
        // 未申请过：主动请求授权
        uni.authorize({
          scope: 'scope.record',
          success: () => {
            setCheck('record', true, false)
            resolve(true)
          },
          fail: () => {
            setCheck('record', false, false)
            resolve(false)
          }
        })
      },
      fail: () => {
        // H5 等不支持授权 API 的环境：直接放行（H5 录音走浏览器媒体设备）
        setCheck('record', true, false)
        resolve(true)
      }
    })
    // #endif
    // #ifndef MP-WEIXIN || APP-PLUS || APP
    setCheck('record', true, false)
    resolve(true)
    // #endif
  })
}

// 3) 麦克风：录 1.2s 并校验真实落盘（不是「onStop 被触发」就算通过）
// RecorderManager 是全局单例：结束必须注销本次注册的监听，
// 否则残留的 onStart 会在稍后房间录音时再次触发并提前 stop()，把作答掐断。
function checkMic(): Promise<MicProbe> {
  return new Promise<MicProbe>((resolve) => {
    setCheck('mic', false, true)
    // #ifdef MP-WEIXIN || APP-PLUS || APP
    let cleanup: () => void = () => {}
    try {
      const rm: any = uni.getRecorderManager()
      let settled = false
      let stopTimer: number = 0
      let guardTimer: number = 0
      cleanup = () => {
        if (stopTimer > 0) {
          clearTimeout(stopTimer)
          stopTimer = 0
        }
        if (guardTimer > 0) {
          clearTimeout(guardTimer)
          guardTimer = 0
        }
        try {
          rm.offStart(onStart)
        } catch {
          // 低版本基础库无 off*：注销失败不影响本次检测
        }
        try {
          rm.offStop(onStop)
        } catch {
          // 同上
        }
        try {
          rm.offError(onError)
        } catch {
          // 同上
        }
      }
      const finish = (ok: boolean, path: string) => {
        if (settled) return
        settled = true
        cleanup()
        setCheck('mic', ok, false)
        resolve({ ok: ok, path: path } as MicProbe)
      }
      const onStart = () => {
        // 只求落盘、不求内容：1.2s 后主动停止
        stopTimer = setTimeout(() => {
          try {
            rm.stop()
          } catch {
            finish(false, '')
          }
        }, 1200)
      }
      const onStop = (res: any) => {
        const path = res != null && res.tempFilePath != null ? (res.tempFilePath as string) : ''
        if (path.length === 0) {
          finish(false, '')
          return
        }
        devicePlugin
          .audioFileSize(path)
          .then((size: number) => {
            if (size === 0) {
              finish(false, '')
              return
            }
            console.log('[prep] 麦克风采集成功，字节数=' + size)
            finish(true, path)
          })
          .catch(() => {
            finish(true, path)
          })
      }
      const onError = (e: any) => {
        const msg = e != null && e.errMsg != null ? String(e.errMsg) : 'unknown'
        console.warn('[prep] 麦克风检测失败', msg)
        finish(false, '')
      }
      guardTimer = setTimeout(() => {
        finish(false, '')
      }, 6000)
      rm.onStart(onStart)
      rm.onStop(onStop)
      rm.onError(onError)
      rm.start({ format: 'mp3', duration: 3000 })
    } catch {
      cleanup()
      setCheck('mic', false, false)
      resolve({ ok: false, path: '' } as MicProbe)
    }
    // #endif
    // #ifndef MP-WEIXIN || APP-PLUS || APP
    setCheck('mic', true, false)
    resolve({ ok: true, path: '' } as MicProbe)
    // #endif
  })
}

// 4) 扬声器：回放刚录的音频，播完才算通过（覆盖「发不出声」）
function checkSpeaker(path: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    setCheck('speaker', false, true)
    // #ifdef MP-WEIXIN || APP-PLUS || APP
    let audio: any = null
    const release = () => {
      if (audio == null) return
      try {
        audio.stop()
      } catch {
        // 已停止/已销毁：忽略
      }
      try {
        audio.destroy()
      } catch {
        // 已销毁：忽略
      }
      audio = null
    }
    try {
      devicePlugin.configureAudioPlayback()
      audio = uni.createInnerAudioContext()
      let settled = false
      let guardTimer: number = 0
      const finish = (ok: boolean) => {
        if (settled) return
        settled = true
        if (guardTimer > 0) {
          clearTimeout(guardTimer)
          guardTimer = 0
        }
        release()
        setCheck('speaker', ok, false)
        resolve(ok)
      }
      guardTimer = setTimeout(() => {
        finish(false)
      }, 8000)
      audio.onEnded(() => {
        finish(true)
      })
      audio.onError((e: any) => {
        const msg = e != null && e.errMsg != null ? String(e.errMsg) : 'unknown'
        console.warn('[prep] 扬声器回放失败', msg)
        finish(false)
      })
      audio.src = path
      audio.play()
    } catch {
      release()
      setCheck('speaker', false, false)
      resolve(false)
    }
    // #endif
    // #ifndef MP-WEIXIN || APP-PLUS || APP
    setCheck('speaker', true, false)
    resolve(true)
    // #endif
  })
}

async function runCheck() {
  if (checking.value) return
  checking.value = true
  checkError.value = ''
  // 重置所有状态为未通过
  const reset: CheckItem[] = []
  for (let i = 0; i < initialChecks.length; i++) {
    reset.push({
      key: initialChecks[i].key,
      name: initialChecks[i].name,
      ok: false,
      checking: false
    } as CheckItem)
  }
  checks.value = reset

  const netOk = await checkNet()
  const authOk = await checkRecordAuth()
  // 仅在网络+授权都通过时再探测麦克风（避免两次弹权限）
  let probe: MicProbe = { ok: false, path: '' } as MicProbe
  let speakerOk = false
  if (netOk && authOk) {
    probe = await checkMic()
    if (probe.ok && probe.path.length > 0) {
      speakerOk = await checkSpeaker(probe.path)
    } else if (probe.ok) {
      // 非 MP/App 平台无文件级探测能力：沿用该平台既有放行口径
      speakerOk = true
      setCheck('speaker', true, false)
    } else {
      setCheck('speaker', false, false)
    }
  } else {
    setCheck('mic', false, false)
    setCheck('speaker', false, false)
  }

  checking.value = false
  if (!netOk) checkError.value = '网络不可用，请连接网络后重试'
  else if (!authOk) checkError.value = '未获得录音授权，无法开始面试'
  else if (!probe.ok) checkError.value = '麦克风不可用，请检查设备或权限'
  else if (!speakerOk) checkError.value = '回放没有出声，请调高音量；iPhone 请关闭静音开关后重试'
}

function start() {
  if (!deviceOk.value || !canStart.value) return
  // 持久化用户的方向/等级选择，下次进入默认选中
  userStore.setProfile({
    uid: null,
    nickname: null,
    plan: null,
    positionId: positionId.value,
    experienceLevel: experienceLevel.value,
    defaultMode: null,
    onboarded: null,
    token: null
  })
  userStore.persist()
  // 将方向、等级传给房间页（时长语义 v2：无固定时长，题池封顶 + 用户自主结束，固定 standard 预算）
  const url =
    '/pages/interview/room?mode=standard' +
    '&positionId=' +
    positionId.value +
    '&experienceLevel=' +
    experienceLevel.value
  uni.navigateTo({ url: url })
}

function onPrimary() {
  if (deviceOk.value) start()
  else runCheck()
}
</script>
