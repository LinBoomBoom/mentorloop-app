<template>
  <view class="p-4 bg-bg-light h-screen">
    <!-- 页头 -->
    <view class="mb-4 mt-1">
      <text class="text-xl font-bold text-ink">面试完成</text>
      <text class="text-sm text-ink-soft mt-1">确认本场数据，生成结构化面试报告</text>
    </view>

    <!-- 本场数据卡 -->
    <ml-card>
      <view class="flex-row items-center">
        <view
          class="w-12 h-12 rounded-full bg-chip-reliable flex-row items-center justify-center mr-3"
        >
          <ml-icon name="check-circle" :size="24" color="#1FB6A6"></ml-icon>
        </view>
        <view class="flex-col flex-1">
          <text class="text-2xl font-bold text-ink">{{ count }} 道题</text>
          <text class="text-xs text-ink-soft mt-0.5">追问 {{ followupTotal }} 次</text>
        </view>
      </view>

      <!-- 覆盖能力域 -->
      <view class="mt-4 rounded-lg p-3 bg-bg-muted">
        <text class="text-xs text-ink-soft">覆盖能力域</text>
        <text class="text-sm text-ink mt-1">{{ domainsText }}</text>
      </view>
    </ml-card>

    <!-- 生成状态 -->
    <view v-if="generating" class="mt-3">
      <ml-card>
        <view class="flex-row items-center">
          <ml-icon name="refresh-cw" :size="16" color="#5B6CFF"></ml-icon>
          <text class="text-sm text-ink ml-2">正在调用评分引擎生成报告…</text>
        </view>
      </ml-card>
    </view>

    <view class="mt-4">
      <ml-button
        :text="generating ? '生成中…' : '生成面试报告'"
        :type="generating ? 'secondary' : 'primary'"
        block
        :disabled="generating"
        @click="genReport"
      ></ml-button>
    </view>

    <text class="text-xs text-ink-soft mt-3 text-center">
      报告包含：总体判断 · 六维评分 · 风险提示 · 训练计划
    </text>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import { interviewSession } from '../../store/interview-session.uts'
import { reportHistory } from '../../store/report-history.uts'
import { quotaStore } from '../../store/quota.uts'
import { scoreInterview } from '../../engine/scorer.uts'
import { trackEvent } from '../../api/tracking.uts'

const count = ref(0)
const generating = ref(false)

// 覆盖能力域：去重拼接
const domainsText = computed((): string => {
  const qs = interviewSession.getQuestions()
  const seen: string[] = []
  for (let i = 0; i < qs.length; i++) {
    const d = qs[i].abilityDomain
    if (!seen.includes(d)) seen.push(d)
  }
  return seen.length > 0 ? seen.join('、') : '无'
})

// 追问次数：来自 transcript 中同 questionId 面试官发语句数 - 题目数
const followupTotal = computed((): number => {
  const ts = interviewSession.getTranscript()
  let interviewerMsgs = 0
  for (let i = 0; i < ts.length; i++) {
    if (ts[i].speaker === 'interviewer') interviewerMsgs += 1
  }
  const q = interviewSession.getQuestions().length
  const f = interviewerMsgs - q
  return f > 0 ? f : 0
})

onLoad(() => {
  count.value = interviewSession.getQuestions().length
})

function genReport() {
  if (generating.value) return
  generating.value = true
  // 收束状态机
  interviewSession.transition('WRAP_UP')
  interviewSession.transition('REPORT_GENERATING')
  interviewSession.transition('COMPLETED')

  // 用规则评分器现场打分
  const qs = interviewSession.getQuestions()
  const ts = interviewSession.getTranscript()
  const report = scoreInterview(qs, ts)
  reportHistory.push(interviewSession.sessionId, report)
  // 北极星：完成一次正式模拟面试
  trackEvent('interview_complete', { questionCount: qs.length, followupCount: followupTotal.value })
  // 额度扣减：完成一场面试后消耗（会员不扣）
  quotaStore.consumeInterview()

  // 清掉会话快照（已转为报告）
  interviewSession.clearSnapshot()

  setTimeout(() => {
    generating.value = false
    uni.redirectTo({ url: '/pages/report/report' })
  }, 500)
}
</script>
