<template>
  <scroll-view class="h-screen bg-bg-light" scroll-y="true">
    <view class="px-4 pt-3 pb-6">
      <!-- 空状态 -->
      <view v-if="records.length === 0">
        <ml-card>
          <ml-empty
            icon="chart-column"
            icon-color="#1FB6A6"
            icon-bg="#E6F7F4"
            title="还没有成长记录"
            desc="完成第一次模拟面试后，这里会展示你的能力画像与变化趋势"
          >
            <ml-button text="开始第一次面试" type="primary" block @click="goStart"></ml-button>
          </ml-empty>
        </ml-card>
      </view>

      <template v-else>
        <!-- 统计行 -->
        <view class="bg-surface rounded-2xl border border-line shadow-card px-2 py-3.5 flex-row">
          <view class="flex-1 flex-col items-center">
            <text class="text-lg font-bold text-ink">{{ records.length }}</text>
            <text class="text-[11px] text-ink-soft mt-0.5">累计面试</text>
          </view>
          <view class="w-px h-9 bg-line"></view>
          <view class="flex-1 flex-col items-center">
            <text class="text-lg font-bold text-smart">{{ avgLevel }}</text>
            <text class="text-[11px] text-ink-soft mt-0.5">平均等级</text>
          </view>
          <view class="w-px h-9 bg-line"></view>
          <view class="flex-1 flex-col items-center">
            <text class="text-lg font-bold text-reliable">{{ strongest }}</text>
            <text class="text-[11px] text-ink-soft mt-0.5">最强维度</text>
          </view>
        </view>

        <!-- 能力趋势 -->
        <view class="mt-5">
          <ml-section-header
            title="能力趋势"
            caption="最近 {{ chartItems.length }} 场综合得分"
          ></ml-section-header>
          <ml-card>
            <view class="flex-row items-end h-36 px-1">
              <view
                v-for="(c, i) in chartItems"
                :key="c.key"
                class="flex-1 flex-col items-center justify-end h-full"
                @click="showIdx = c.index"
              >
                <text
                  class="text-[11px] mb-1"
                  :class="i === chartItems.length - 1 ? 'text-smart font-semibold' : 'text-mist'"
                >
                  {{ c.score }}
                </text>
                <view
                  class="w-7 rounded-t-lg pressable"
                  :style="barStyle(c.score, i === chartItems.length - 1, c.index === showIdx)"
                ></view>
              </view>
            </view>
            <view class="h-px bg-line mt-2"></view>
            <view class="flex-row px-1 mt-1.5">
              <view v-for="c in chartItems" :key="'x' + c.key" class="flex-1 flex-col items-center">
                <text
                  class="text-[10px]"
                  :class="c.index === showIdx ? 'text-smart font-semibold' : 'text-mist'"
                >
                  {{ c.label }}
                </text>
              </view>
            </view>
          </ml-card>
        </view>

        <!-- 最近场次 -->
        <view class="mt-5">
          <ml-section-header title="最近场次" caption="点选查看该场维度画像"></ml-section-header>
          <scroll-view scroll-x="true" class="whitespace-nowrap">
            <view class="flex-row">
              <view
                v-for="(r, i) in records"
                :key="r.sessionId + '_' + i"
                class="flex-col items-center mr-2.5 pressable"
                @click="showIdx = i"
              >
                <view
                  class="w-[104px] rounded-xl border px-2.5 py-2.5"
                  :style="sessionCardStyle(i === showIdx)"
                >
                  <view class="flex-row items-center justify-between">
                    <text class="text-[11px] text-ink-soft">第 {{ records.length - i }} 场</text>
                    <ml-tag
                      :label="avgLevelOf(r.report)"
                      :bg="i === showIdx ? '#EEF1FF' : '#F1F5F9'"
                      :color="i === showIdx ? '#5B6CFF' : '#5B6472'"
                    ></ml-tag>
                  </view>
                  <text
                    class="text-[13px] font-semibold mt-1.5"
                    :class="i === showIdx ? 'text-smart' : 'text-ink'"
                  >
                    {{ formatDate(r.at) }}
                  </text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- 维度画像 -->
        <view class="mt-5">
          <ml-section-header
            title="维度画像"
            :caption="'第 ' + (records.length - showIdx) + ' 场 · 六维能力评估'"
          ></ml-section-header>
          <ml-card>
            <view
              v-for="(d, i) in activeDimensions"
              :key="d.dimension"
              :class="i < activeDimensions.length - 1 ? 'mb-4' : ''"
            >
              <view class="flex-row items-center justify-between">
                <view class="flex-row items-center flex-1">
                  <view
                    class="w-7 h-7 rounded-lg flex-row items-center justify-center mr-2"
                    :style="{ backgroundColor: dimTint(d.dimension) }"
                  >
                    <ml-icon
                      :name="dimIcon(d.dimension)"
                      :size="14"
                      :color="dimColor(d.dimension)"
                    ></ml-icon>
                  </view>
                  <text class="text-[13px] font-medium text-ink">{{ dimLabel(d.dimension) }}</text>
                </view>
                <view class="flex-row items-center">
                  <text class="text-[11px] text-mist mr-1.5">
                    权重 {{ weightOf(d.dimension) }}%
                  </text>
                  <ml-tag
                    :label="d.level"
                    :bg="levelBg(d.level)"
                    :color="levelColor(d.level)"
                  ></ml-tag>
                </view>
              </view>
              <view class="mt-2 ml-9">
                <ml-progress
                  :percent="levelToScore(d.level)"
                  :color="levelColor(d.level)"
                  :show-value="false"
                ></ml-progress>
                <text class="text-[11px] mt-1" :class="diffTone(d.dimension)">
                  {{ diffText(d.dimension) }}
                </text>
              </view>
            </view>
          </ml-card>
        </view>

        <!-- 报告入口 -->
        <view class="mt-5">
          <ml-button text="查看最近完整报告" type="primary" block @click="goReport"></ml-button>
        </view>
      </template>

      <!-- 训练记录（薄弱项定向训练 + 错因追溯，与面试报告独立展示） -->
      <view class="mt-6">
        <ml-section-header
          title="训练记录"
          caption="薄弱项定向训练 · 错因可对照报告追溯"
        ></ml-section-header>
        <template v-if="trainings.length > 0">
          <view v-for="t in trainings" :key="'tr_' + t.id + '_' + t.completedAt" class="mb-2">
            <ml-card>
              <view class="flex-row items-center justify-between">
                <view class="flex-col flex-1">
                  <view class="flex-row items-center">
                    <text class="text-sm text-ink flex-1">{{ t.title }}</text>
                    <view v-if="t.domain.length > 0" class="ml-2">
                      <ml-tag
                        :label="'定向·' + dimLabel(t.domain)"
                        bg="#EEF1FF"
                        color="#5B6CFF"
                      ></ml-tag>
                    </view>
                  </view>
                  <text class="text-[11px] text-ink-soft mt-1">
                    {{ formatDate(t.completedAt) }} · 完成 {{ t.questions }} 题{{
                      t.skipped > 0 ? ' · 跳过 ' + t.skipped + ' 题' : ''
                    }}
                  </text>
                </view>
                <view class="ml-2" v-if="t.reasons.length > 0">
                  <ml-tag
                    :label="'错因 ' + t.reasons.join(' / ')"
                    bg="#FFF3E0"
                    color="#E08A00"
                  ></ml-tag>
                </view>
                <view class="ml-2" v-else>
                  <ml-tag label="表现良好" bg="#E6F7F4" color="#1FB6A6"></ml-tag>
                </view>
              </view>
            </ml-card>
          </view>
        </template>
        <ml-card v-else>
          <view class="flex-row items-center">
            <ml-icon name="dumbbell" :size="14" color="#AEB9CC"></ml-icon>
            <text class="text-xs text-ink-soft ml-2"
              >暂无训练记录，从报告薄弱项开始一次定向训练</text
            >
          </view>
        </ml-card>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlTag from '../../components/ml-tag.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlSectionHeader from '../../components/ml-section-header.uvue'
import mlEmpty from '../../components/ml-empty.uvue'
import mlProgress from '../../components/ml-progress.uvue'
import { reportHistory, ReportRecord } from '../../store/report-history.uts'
import { trainingHistory, TrainingItem } from '../../store/training-history.uts'
import { useMock } from '../../api/env.uts'
import { DimensionScore, DIMENSION_LABEL, DIMENSION_WEIGHT, ScoreLevel } from '../../types/scoring.uts'

const records = ref<ReportRecord[]>([])
const showIdx = ref(0)
const trainings = ref<TrainingItem[]>([])

onShow(() => {
  reportHistory.load()
  const all = reportHistory.recent(6)
  records.value = all
  if (showIdx.value >= all.length) showIdx.value = 0
  trainingHistory.load()
  trainings.value = trainingHistory.recent(5)
  // 真后端：异步同步云端报告历史（跨设备），先展示本地再刷新
  if (!useMock()) {
    reportHistory.fetchFromServer().then(() => {
      const sync = reportHistory.recent(6)
      records.value = sync
      if (showIdx.value >= sync.length) showIdx.value = 0
    })
  }
})

const activeDimensions = computed((): DimensionScore[] => {
  if (records.value.length === 0) return []
  const i = showIdx.value < records.value.length ? showIdx.value : 0
  return records.value[i].report.dimensions
})

const avgLevel = computed((): string => {
  if (records.value.length === 0) return '--'
  return avgLevelOf(records.value[0].report)
})

// 最强维度：取最近一场等级最高的维度
const strongest = computed((): string => {
  if (records.value.length === 0) return '--'
  const dims = records.value[0].report.dimensions
  const map: { [key: string]: number } = { A: 4, B: 3, C: 2, D: 1 }
  let best = -1
  let bestKey = ''
  for (let i = 0; i < dims.length; i++) {
    const v = map[dims[i].level]
    if (v != null && v > best) {
      best = v
      bestKey = dims[i].dimension
    }
  }
  return bestKey.length > 0 ? dimLabel(bestKey) : '--'
})

type ChartItem = { key: string; index: number; score: number; label: string }

// 趋势图：时间正序（最早→最新），最新一场高亮
const chartItems = computed((): ChartItem[] => {
  const out: ChartItem[] = []
  const n = records.value.length
  for (let i = n - 1; i >= 0; i--) {
    const r = records.value[i]
    out.push({
      key: r.sessionId + '_' + i,
      index: i,
      score: scoreOf(r.report),
      label: '第' + (n - i) + '场'
    } as ChartItem)
  }
  return out
})

function scoreOf(r: typeof records.value[0]['report']): number {
  const map: { [key: string]: number } = { A: 90, B: 75, C: 60, D: 45 }
  let total = 0
  let cnt = 0
  for (let i = 0; i < r.dimensions.length; i++) {
    const v = map[r.dimensions[i].level]
    if (v != null) {
      total += v
      cnt += 1
    }
  }
  return cnt > 0 ? Math.round(total / cnt) : 0
}

function barStyle(score: number, isLatest: boolean, isSelected: boolean): { [key: string]: string } {
  const h = Math.round((score / 100) * 120)
  const bg = isLatest ? '#5B6CFF' : isSelected ? '#8FA0FF' : '#D9E0F2'
  const s: { [key: string]: string } = {
    height: h + 'px',
    backgroundColor: bg
  }
  if (isSelected) {
    s['border'] = '1px solid #5B6CFF'
  }
  return s
}

function sessionCardStyle(active: boolean): { [key: string]: string } {
  if (active) {
    return { backgroundColor: '#FFFFFF', borderColor: '#5B6CFF' }
  }
  return { backgroundColor: '#F7F9FC', borderColor: '#E3E8F0' }
}

function avgLevelOf(r: typeof records.value[0]['report']): string {
  const map: { [key: string]: number } = { A: 4, B: 3, C: 2, D: 1 }
  let total = 0
  let cnt = 0
  for (let i = 0; i < r.dimensions.length; i++) {
    const v = map[r.dimensions[i].level]
    if (v != null) {
      total += v
      cnt += 1
    }
  }
  if (cnt === 0) return '--'
  const avg = total / cnt
  if (avg >= 3.5) return 'A'
  if (avg >= 2.5) return 'B'
  if (avg >= 1.5) return 'C'
  return 'D'
}

function dimLabel(k: string): string {
  const v = DIMENSION_LABEL[k]
  return v != null && v.length > 0 ? v : k
}

function weightOf(k: string): number {
  const w = DIMENSION_WEIGHT[k]
  return w != null ? Math.round(w * 100) : 0
}

function dimIcon(k: string): string {
  const map: { [key: string]: string } = {
    knowledge: 'book-open',
    engineering: 'briefcase',
    analysis: 'brain',
    communication: 'message-square',
    learning: 'graduation-cap',
    motivation: 'compass'
  }
  const v = map[k]
  return v != null ? v : 'target'
}

function dimColor(k: string): string {
  const map: { [key: string]: string } = {
    knowledge: '#5B6CFF',
    engineering: '#1FB6A6',
    analysis: '#E08A00',
    communication: '#7C5CFF',
    learning: '#0EA5B7',
    motivation: '#E0654A'
  }
  const v = map[k]
  return v != null ? v : '#5B6CFF'
}

function dimTint(k: string): string {
  const map: { [key: string]: string } = {
    knowledge: '#EEF1FF',
    engineering: '#E6F7F4',
    analysis: '#FFF3E0',
    communication: '#F0EBFF',
    learning: '#E0F5F8',
    motivation: '#FDEBE6'
  }
  const v = map[k]
  return v != null ? v : '#EEF1FF'
}

function levelToScore(l: string): number {
  if (l === 'A') return 90
  if (l === 'B') return 75
  if (l === 'C') return 60
  return 45
}

function levelBg(l: ScoreLevel): string {
  if (l === 'A') return '#E6F7F4'
  if (l === 'B') return '#EEF1FF'
  return '#FFF3E0'
}

function levelColor(l: ScoreLevel): string {
  if (l === 'A') return '#1FB6A6'
  if (l === 'B') return '#5B6CFF'
  return '#E08A00'
}

function diffTone(dim: string): string {
  const t = diffOf(dim)
  if (t.indexOf('提升') >= 0) return 'text-reliable'
  if (t.indexOf('下降') >= 0) return 'text-danger'
  return 'text-ink-soft'
}

// 维度对比：当前场次 vs 更早一场
function diffText(dim: string): string {
  return diffOf(dim)
}

function diffOf(dim: string): string {
  if (records.value.length < 2) return '暂无对比数据'
  const curIdx = showIdx.value < records.value.length ? showIdx.value : 0
  const prevIdx = curIdx + 1
  if (prevIdx >= records.value.length) return '已对比到最早一场'
  const cur = records.value[curIdx].report
  const prev = records.value[prevIdx].report
  const map: { [key: string]: number } = { A: 4, B: 3, C: 2, D: 1 }
  const getLvl = (r: typeof cur): number => {
    for (let i = 0; i < r.dimensions.length; i++) {
      if (r.dimensions[i].dimension === dim) return map[r.dimensions[i].level]
    }
    return 0
  }
  const c = getLvl(cur)
  const p = getLvl(prev)
  if (c > p) return '对比上一场：提升 ' + (c - p) + ' 级'
  if (c < p) return '对比上一场：下降 ' + (p - c) + ' 级'
  return '对比上一场：持平'
}

function formatDate(ts: number): string {
  const d = new Date(ts)
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return pad(d.getMonth() + 1) + '-' + pad(d.getDate())
}

function goStart() {
  uni.switchTab({ url: '/pages/index/index' })
}

function goReport() {
  uni.navigateTo({ url: '/pages/report/report' })
}
</script>

<style>
.pressable {
  /* 按压态由 hover-class 控制 */
}
</style>
