<template>
  <!-- 简历解析记录回放：独立页面只读展示，不覆盖「简历优化」页的当前解析与改写状态 -->
  <scroll-view class="h-screen bg-bg-light" scroll-y="true">
    <view class="px-4 pt-4 pb-8">
      <!-- 加载中 -->
      <view v-if="loading" class="flex-col items-center py-16">
        <ml-icon name="refresh-cw" :size="22" :color="SMART"></ml-icon>
        <text class="text-sm text-ink-soft mt-2">正在载入这条记录…</text>
      </view>

      <!-- 载入失败 -->
      <view v-else-if="failed" class="flex-col items-center py-16">
        <ml-icon name="circle-alert" :size="22" :color="WARN"></ml-icon>
        <text class="text-sm text-ink-soft mt-2">{{ failedText }}</text>
        <view class="mt-4 flex-row">
          <ml-button text="重试" type="primary" @tap="load"></ml-button>
          <view class="w-2"></view>
          <ml-button text="返回" type="secondary" @tap="goBack"></ml-button>
        </view>
      </view>

      <template v-else-if="data != null">
        <!-- 记录摘要 -->
        <ml-card>
          <view class="flex-row items-center">
            <view
              class="w-10 h-10 rounded-control bg-chip-smart flex-row items-center justify-center"
            >
              <ml-icon name="file-text" :size="18" :color="SMART"></ml-icon>
            </view>
            <view class="flex-col flex-1 ml-3">
              <text class="text-sm font-semibold text-ink truncate block">{{ data.fileName }}</text>
              <text class="text-xs text-ink-soft mt-0.5">{{ summaryText }}</text>
            </view>
          </view>
          <view v-if="data.mode === 'preview'" class="mt-3 rounded-control p-3 bg-bg-muted">
            <text class="text-xs text-ink-soft leading-4"
              >这是一次免费预览记录：只包含结构与风险项，不含逐条 AI 批注。</text
            >
          </view>
          <view class="flex-row flex-wrap mt-3">
            <ml-tag
              :label="data.contact ? '联系方式已填' : '联系方式缺失'"
              :bg="data.contact ? CHIP_RELIABLE : CHIP_DANGER"
              :color="data.contact ? RELIABLE : DANGER"
            ></ml-tag>
            <view class="w-1.5"></view>
            <ml-tag
              :label="'项目经历 ' + data.projects + ' 段'"
              :bg="CHIP_SMART"
              :color="SMART"
            ></ml-tag>
            <view class="w-1.5"></view>
            <ml-tag
              :label="data.quantified ? '成果已量化' : '成果未量化'"
              :bg="data.quantified ? CHIP_RELIABLE : CHIP_WARN"
              :color="data.quantified ? RELIABLE : WARN"
            ></ml-tag>
          </view>
        </ml-card>

        <!-- 技术栈 -->
        <view v-if="data.techStack.length > 0" class="mt-4">
          <ml-section-header title="技术栈" caption="解析时识别到的关键技术"></ml-section-header>
          <ml-card>
            <view class="flex-row flex-wrap">
              <ml-tag
                v-for="(t, i) in data.techStack"
                :key="'t' + i"
                class="mr-1.5 mb-1.5"
                :label="t"
                :bg="BG_MUTED"
                :color="INK_SOFT"
              ></ml-tag>
            </view>
          </ml-card>
        </view>

        <!-- 待补充 -->
        <view v-if="data.gaps.length > 0" class="mt-4">
          <ml-section-header title="待补充" caption="影响投递通过率的信息缺口"></ml-section-header>
          <ml-card>
            <text
              v-for="(g, i) in data.gaps"
              :key="'g' + i"
              class="text-xs text-ink-soft mt-1.5 leading-5"
            >
              · {{ g }}
            </text>
          </ml-card>
        </view>

        <!-- 格式风险 -->
        <view v-if="data.formatRisks.length > 0" class="mt-4">
          <ml-section-header title="格式风险" caption="排版与可读性问题"></ml-section-header>
          <ml-card>
            <text
              v-for="(r, i) in data.formatRisks"
              :key="'r' + i"
              class="text-xs text-ink-soft mt-1.5 leading-5"
            >
              · {{ r }}
            </text>
          </ml-card>
        </view>

        <!-- 免费诊断（locked 回放：不展示未授权改写） -->
        <view v-if="data.mode === 'preview' && data.previewIssues.length > 0" class="mt-4">
          <ml-section-header
            title="免费诊断"
            :caption="'共 ' + data.previewIssues.length + ' 条 · 只读回放'"
          ></ml-section-header>
          <view v-for="s in data.previewIssues" :key="s.issueId" class="mb-2.5">
            <ml-card>
              <view class="flex-row items-center mb-2">
                <ml-tag :label="severityLabel(s.severity)" :bg="CHIP_WARN" :color="WARN"></ml-tag>
                <view class="w-1.5"></view>
                <ml-tag v-if="s.locked" label="锁定" :bg="BG_MUTED" :color="INK_SOFT"></ml-tag>
              </view>
              <view class="rounded-control p-3 bg-bg-muted">
                <view class="flex-row items-center">
                  <ml-icon name="quote" :size="12" :color="MIST"></ml-icon>
                  <text class="text-xs text-ink-soft ml-1">原文</text>
                </view>
                <text class="text-xs text-ink-soft mt-1.5 leading-5">{{ s.original }}</text>
              </view>
              <view v-if="!s.locked" class="mt-3 rounded-control p-3 bg-chip-reliable">
                <view class="flex-row items-center">
                  <ml-icon name="wand-2" :size="12" :color="RELIABLE"></ml-icon>
                  <text class="text-xs font-semibold text-reliable ml-1">建议稿</text>
                </view>
                <text class="text-sm text-ink mt-1.5 leading-5">{{ s.suggested }}</text>
              </view>
              <view v-else class="mt-3 rounded-control p-3 bg-bg-muted flex-row items-center">
                <ml-icon name="lock" :size="13" :color="MIST"></ml-icon>
                <text class="text-xs text-ink-soft ml-1.5">解锁完整评审后查看改写</text>
              </view>
              <text class="text-xs text-ink-soft mt-2.5 leading-5">{{ s.reason }}</text>
            </ml-card>
          </view>
        </view>

        <!-- 逐条批注 -->
        <view v-if="data.issues.length > 0" class="mt-4">
          <ml-section-header
            title="AI 逐条批注"
            :caption="'共 ' + data.issues.length + ' 条 · 只读回放'"
          ></ml-section-header>
          <view v-for="s in data.issues" :key="s.issueId" class="mb-2.5">
            <ml-card>
              <view v-if="severityLabel(s.severity).length > 0" class="flex-row items-center mb-2">
                <ml-tag :label="severityLabel(s.severity)" :bg="CHIP_WARN" :color="WARN"></ml-tag>
              </view>
              <view class="rounded-control p-3 bg-bg-muted">
                <view class="flex-row items-center">
                  <ml-icon name="quote" :size="12" :color="MIST"></ml-icon>
                  <text class="text-xs text-ink-soft ml-1">原文</text>
                </view>
                <text class="text-xs text-ink-soft mt-1.5 leading-5">{{ s.original }}</text>
              </view>
              <view class="mt-3 rounded-control p-3 bg-chip-reliable">
                <view class="flex-row items-center">
                  <ml-icon name="wand-2" :size="12" :color="RELIABLE"></ml-icon>
                  <text class="text-xs font-semibold text-reliable ml-1">建议稿</text>
                </view>
                <text class="text-sm text-ink mt-1.5 leading-5">{{ s.suggested }}</text>
              </view>
              <text class="text-xs text-ink-soft mt-2.5 leading-5">{{ s.reason }}</text>
              <view class="mt-2" v-if="s.needsUserEvidence">
                <ml-tag label="需补充真实证据" :bg="CHIP_WARN" :color="WARN"></ml-tag>
              </view>
            </ml-card>
          </view>
        </view>

        <!-- 回到优化页：回放不提供编辑，编辑请回主页面 -->
        <view class="mt-5">
          <ml-button text="返回简历优化" type="secondary" block @tap="goBack"></ml-button>
        </view>
      </template>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlTag from '../../components/ml-tag.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlSectionHeader from '../../components/ml-section-header.uvue'
import { fetchResumeDetail } from '../../api/resume.uts'
import {
  ResumeParseResponse,
  ResumeIssueSeverity
} from '../../types/resume.uts'
import { themeValue } from '../../styles/theme.uts'

const SMART = themeValue('smart', '#5856D6')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const WARN = themeValue('warn', '#E08A00')
const DANGER = themeValue('danger', '#DC2626')
const BG_MUTED = themeValue('bgMuted', '#E9E9EF')
const INK_SOFT = themeValue('inkSoft', '#6E6E73')
const MIST = themeValue('mist', '#AEAEB2')
const CHIP_SMART = themeValue('chipSmart', '#EFEEFC')
const CHIP_RELIABLE = themeValue('chipReliable', '#E6F7F4')
const CHIP_WARN = themeValue('chipWarn', '#FFF3E0')
const CHIP_DANGER = themeValue('chipDanger', '#FFEBEA')

const resumeId = ref('')
const data = ref<ResumeParseResponse | null>(null)
const loading = ref(true)
const failed = ref(false)
const failedText = ref('记录不存在或已被删除')

const summaryText = computed((): string => {
  const d = data.value
  if (d == null) return ''
  const kind = d.mode === 'full' ? '深度评审' : '免费预览'
  const count = d.mode === 'full' ? d.issues.length : d.previewIssues.length
  return d.pages + ' 页 · ' + kind + ' · ' + count + ' 条' + (d.mode === 'full' ? '批注' : '诊断')
})

function severityLabel(s: ResumeIssueSeverity): string {
  if (s === 'high') return '高优先级'
  if (s === 'medium') return '中优先级'
  if (s === 'low') return '低优先级'
  return ''
}

function goBack() {
  uni.navigateBack()
}

async function load() {
  if (resumeId.value.length === 0) {
    loading.value = false
    failed.value = true
    failedText.value = '缺少记录标识'
    return
  }
  loading.value = true
  failed.value = false
  try {
    const r = await fetchResumeDetail(resumeId.value)
    if (r == null) {
      failed.value = true
      failedText.value = '记录不存在或已被删除'
      return
    }
    data.value = r
  } catch (e: any) {
    console.warn('[resume-detail] load failed', e)
    failed.value = true
    failedText.value = '载入失败，请检查网络后重试'
  } finally {
    loading.value = false
  }
}

onLoad((options: any) => {
  resumeId.value = options != null && options.resumeId != null ? String(options.resumeId) : ''
  uni.setNavigationBarTitle({ title: '解析记录' })
  load()
})
</script>
