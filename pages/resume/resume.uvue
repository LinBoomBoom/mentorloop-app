<template>
  <scroll-view class="h-screen bg-bg-light" scroll-y="true">
    <!-- 品牌头部带（MASTER.md §A1 品牌锚点，静态无 blur） -->
    <view class="ml-brand-band px-5 pt-4 pb-9 flex-row items-center justify-between">
      <view class="flex-col">
        <text class="text-[22px] font-bold text-white">简历优化</text>
        <text class="text-xs text-mist mt-1">AI 解析 · 改写建议 · 投递版本</text>
      </view>
      <ml-icon name="file-text" :size="22" :color="RELIABLE_LIGHT"></ml-icon>
    </view>
    <view class="px-4 pb-6 -mt-5">
      <!-- 步骤流：上传 → 解析 → 建议 -->
      <ml-card>
        <view class="flex-row items-center">
          <template v-for="(s, i) in steps" :key="s">
            <view class="flex-col items-center">
              <view
                class="w-6 h-6 rounded-full flex-row items-center justify-center"
                :style="stepStyle(i)"
              >
                <ml-icon v-if="i < currentStep" name="check" :size="12" :color="SURFACE"></ml-icon>
                <text v-else class="text-xs font-semibold" :style="{ color: stepTextColor(i) }">
                  {{ i + 1 }}
                </text>
              </view>
              <text class="text-xs mt-1" :class="i <= currentStep ? 'text-ink' : 'text-ink-soft'">
                {{ s }}
              </text>
            </view>
            <view
              v-if="i < steps.length - 1"
              class="flex-1 h-px mx-2 mb-4"
              :style="{ backgroundColor: i < currentStep ? RELIABLE : LINE }"
            ></view>
          </template>
        </view>
      </ml-card>

      <!-- 恢复上次草稿（重进页面仍在） -->
      <view v-if="draftReady" class="mt-3">
        <ml-card>
          <view class="flex-row items-center justify-between">
            <view class="flex-col flex-1">
              <text class="text-sm text-ink truncate block">{{ draftFileName }}</text>
              <text class="text-xs text-ink-soft mt-0.5">{{ draftHint }}</text>
            </view>
            <view class="ml-2">
              <ml-button text="恢复草稿" type="primary" @tap="restoreDraft"></ml-button>
            </view>
          </view>
        </ml-card>
      </view>

      <!-- 上传区 -->
      <view class="mt-3">
        <view
          class="bg-surface rounded-card border-2 border-dashed pressable relative overflow-hidden"
          :style="{ borderColor: fileName.length > 0 ? SMART : LINE }"
          hover-class="pressed-card"
          :hover-start-time="0"
          @click="pick"
        >
          <view class="flex-col items-center py-8">
            <view class="w-14 h-14 rounded-full bg-chip-smart flex-row items-center justify-center">
              <ml-icon
                :name="parsing ? 'refresh-cw' : 'cloud-upload'"
                :size="26"
                :color="SMART"
              ></ml-icon>
            </view>
            <text class="text-base font-semibold text-ink mt-3">
              {{ parsing ? 'AI 解析中…' : fileName.length > 0 ? '重新上传简历' : '点击上传简历' }}
            </text>
            <text class="text-xs text-ink-soft mt-1">支持 PDF / DOCX，最大 10MB</text>

            <!-- 已选文件 -->
            <view v-if="fileName.length > 0" class="flex-row justify-center mt-3 px-6">
              <ml-tag
                class="max-w-[85%]"
                icon="file-check"
                :label="fileName"
                :bg="CHIP_SMART"
                :color="SMART"
                truncate
              ></ml-tag>
            </view>

            <!-- 操作区：stop 阻断冒泡，避免内层按钮同时触发外层「选择文件」造成双弹窗 -->
            <view v-if="!parsing" class="mt-4" @click.stop>
              <ml-button
                :text="fileName.length > 0 ? '重新选择' : '选择文件'"
                type="primary"
                :disabled="parsing"
                @tap="pick"
              ></ml-button>
              <!-- 小程序无系统文件浏览器：唯一文档入口是「从微信聊天中选择」，
                   必须明说来源，否则会被误认为在分享给好友（2026-10-21 用户反馈） -->
              <text class="text-xs text-ink-soft mt-2 text-center"
                >从微信聊天中选择；可先发给「文件传输助手」</text
              >
            </view>
            <view v-else class="mt-4 flex-row items-center">
              <ml-icon name="refresh-cw" :size="14" :color="SMART"></ml-icon>
              <text class="text-xs text-ink-soft ml-1.5">正在解析文件内容，请稍候…</text>
            </view>
          </view>
        </view>

        <!-- 隐私说明 -->
        <view class="flex-row items-start justify-center mt-2.5 px-1">
          <ml-icon name="lock" :size="11" :color="MIST"></ml-icon>
          <text class="text-xs text-ink-soft ml-1 flex-1 leading-4"
            >简历仅用于本次分析；AI 评审脱敏调用，记录可随时删除</text
          >
        </view>

        <!-- 额度与付费入口 -->
        <view class="flex-row items-center justify-between mt-2.5">
          <text class="text-xs text-ink-soft">{{ quotaText }}</text>
          <ml-chip
            v-if="quota != null && !quota.canFull"
            variant="action"
            tone="smart"
            icon="sparkles"
            label="开通会员"
            @tap="goPaywall"
          ></ml-chip>
        </view>

        <!-- 解析历史（服务端记录，仅本人可见） -->
        <view v-if="history.length > 0" class="mt-5">
          <ml-section-header title="解析历史" caption="仅本人可见 · 点击回看"></ml-section-header>
          <ml-card :padded="false">
            <view
              v-for="(h, i) in history"
              :key="h.resumeId"
              class="flex-row items-center px-4 py-3"
              :class="i < history.length - 1 ? 'border-b border-line' : ''"
            >
              <view class="flex-col flex-1 overflow-hidden" @click="openHistory(h)">
                <text class="text-sm text-ink truncate block">{{ h.fileName }}</text>
                <text class="text-xs text-ink-soft mt-0.5">{{ historySubtitle(h) }}</text>
              </view>
              <ml-chip
                variant="action"
                tone="soft"
                icon="trash-2"
                label="删除"
                @tap="removeHistory(h)"
              ></ml-chip>
            </view>
          </ml-card>
        </view>
      </view>

      <!-- 解析结果 -->
      <view v-if="parsed != null" class="mt-5">
        <ml-section-header title="解析结果" caption="结构化提取关键信息"></ml-section-header>
        <ml-card>
          <!-- 状态标签组 -->
          <view class="flex-row flex-wrap">
            <ml-tag
              :label="parsed.contact ? '联系方式已填' : '联系方式缺失'"
              :bg="parsed.contact ? CHIP_RELIABLE : CHIP_DANGER"
              :color="parsed.contact ? RELIABLE : DANGER"
            ></ml-tag>
            <view class="w-1.5"></view>
            <ml-tag
              :label="'项目经历 ' + parsed.projects + ' 段'"
              :bg="CHIP_SMART"
              :color="SMART"
            ></ml-tag>
            <view class="w-1.5"></view>
            <ml-tag
              :label="parsed.quantified ? '成果已量化' : '成果未量化'"
              :bg="parsed.quantified ? CHIP_RELIABLE : CHIP_WARN"
              :color="parsed.quantified ? RELIABLE : WARN"
            ></ml-tag>
          </view>

          <!-- 技术栈 -->
          <template v-if="parsed.techStack.length > 0">
            <view class="flex-row items-center mt-4">
              <ml-icon name="layers" :size="13" :color="SMART"></ml-icon>
              <text class="text-xs font-semibold text-ink ml-1">技术栈</text>
            </view>
            <view class="flex-row flex-wrap mt-2">
              <ml-tag
                v-for="(t, i) in parsed.techStack"
                :key="'t' + i"
                class="mr-1.5 mb-1.5"
                :label="t"
                :bg="BG_MUTED"
                :color="INK_SOFT"
              ></ml-tag>
            </view>
          </template>

          <!-- 待补充 -->
          <view v-if="parsed.gaps.length > 0" class="mt-3">
            <view class="flex-row items-center">
              <ml-icon name="circle-help" :size="13" :color="WARN"></ml-icon>
              <text class="text-xs font-semibold text-warn ml-1">待补充</text>
            </view>
            <text
              v-for="(g, i) in parsed.gaps"
              :key="'g' + i"
              class="text-xs text-ink-soft mt-1.5 leading-5"
            >
              · {{ g }}
            </text>
          </view>

          <!-- 格式风险 -->
          <view v-if="parsed.formatRisks.length > 0" class="mt-3">
            <view class="flex-row items-center">
              <ml-icon name="triangle-alert" :size="13" :color="DANGER"></ml-icon>
              <text class="text-xs font-semibold text-danger ml-1">格式风险</text>
            </view>
            <text
              v-for="(r, i) in parsed.formatRisks"
              :key="'r' + i"
              class="text-xs text-ink-soft mt-1.5 leading-5"
            >
              · {{ r }}
            </text>
          </view>
          <!-- 免费预览解锁提示 -->
          <view v-if="parsed.mode === 'preview'" class="mt-3 rounded-control p-3 bg-bg-muted">
            <text class="text-sm font-semibold text-ink">当前为免费预览</text>
            <text class="text-xs text-ink-soft mt-1 leading-5"
              >已提取结构与风险项；开通会员或单次包可解锁逐条 AI 批注与改写建议。</text
            >
            <view class="mt-3">
              <ml-button text="解锁深度评审" type="primary" block @tap="goPaywall"></ml-button>
            </view>
          </view>
        </ml-card>
      </view>

      <!-- 改写建议 -->
      <view v-if="suggestions.length > 0" class="mt-5">
        <ml-section-header
          title="AI 逐条批注"
          caption="每条均锚定原文，采用后写入草稿"
          action-text="全部采用"
          @action="adoptAll"
        ></ml-section-header>
        <view class="mb-2.5" v-for="(s, i) in suggestions" :key="i">
          <ml-card>
            <!-- 严重度 -->
            <view v-if="issueSeverityLabel(i).length > 0" class="flex-row items-center mb-2">
              <ml-tag :label="issueSeverityLabel(i)" :bg="CHIP_WARN" :color="WARN"></ml-tag>
            </view>
            <!-- 原句 -->
            <view class="rounded-control p-3 bg-bg-muted">
              <view class="flex-row items-center">
                <ml-icon name="quote" :size="12" :color="MIST"></ml-icon>
                <text class="text-xs text-ink-soft ml-1">原文</text>
              </view>
              <text class="text-xs text-ink-soft mt-1.5 leading-5">{{ s.original }}</text>
            </view>
            <!-- 建议稿 -->
            <view class="mt-3 rounded-control p-3 bg-chip-reliable">
              <view class="flex-row items-center">
                <ml-icon name="wand-2" :size="12" :color="RELIABLE"></ml-icon>
                <text class="text-xs font-semibold text-reliable ml-1">建议稿</text>
              </view>
              <text class="text-sm text-ink mt-1.5 leading-5">{{ s.suggested }}</text>
            </view>
            <!-- 原因 -->
            <text class="text-xs text-ink-soft mt-2.5 leading-5">{{ s.reason }}</text>
            <view class="mt-2" v-if="s.needsUserEvidence">
              <ml-tag label="需补充真实证据" :bg="CHIP_WARN" :color="WARN"></ml-tag>
            </view>
            <!-- 操作 -->
            <view class="flex-row mt-3">
              <ml-chip
                variant="action"
                :tone="isAdopted(i) ? 'soft' : 'smart'"
                :icon="isAdopted(i) ? 'check-check' : 'check'"
                :label="isAdopted(i) ? '已采用' : '采用'"
                @tap="toggleAdopt(i)"
              ></ml-chip>
              <view class="w-2"></view>
              <ml-chip
                variant="action"
                tone="soft"
                icon="x"
                label="忽略"
                @tap="dismissOne(i)"
              ></ml-chip>
            </view>
          </ml-card>
        </view>
      </view>

      <!-- 完成操作 -->
      <view v-if="suggestions.length > 0" class="mt-4">
        <ml-button
          :text="'保存 ' + adoptedCount + ' 条改写'"
          type="primary"
          block
          :disabled="adoptedCount === 0"
          @tap="saveAll"
        ></ml-button>
        <view class="h-2"></view>
        <ml-button text="放弃全部修改" type="ghost" block @tap="resetAll"></ml-button>
      </view>

      <!-- 多版本导出（文档 2.4：生成不同投递版本） -->
      <view v-if="parsed != null" class="mt-5">
        <ml-section-header
          title="投递版本"
          caption="按目标岗位生成不同侧重版本"
        ></ml-section-header>
        <ml-card :padded="false">
          <view
            v-for="(v, i) in resumeVersions"
            :key="'v_' + v.id"
            class="flex-row items-center px-4 py-3"
            :class="i < resumeVersions.length - 1 ? 'border-b border-line' : ''"
          >
            <view
              class="w-9 h-9 rounded-control flex-row items-center justify-center mr-3"
              :style="{ backgroundColor: v.tint }"
            >
              <ml-icon name="file-text" :size="16" :color="v.color"></ml-icon>
            </view>
            <view class="flex-col flex-1">
              <text class="text-sm text-ink">{{ v.name }}</text>
              <text class="text-xs text-ink-soft mt-0.5">{{ v.desc }}</text>
            </view>
            <ml-chip
              variant="action"
              tone="outline"
              icon="share"
              label="导出"
              @tap="exportVersion(v)"
            ></ml-chip>
          </view>
        </ml-card>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlChip from '../../components/ml-chip.uvue'
import mlTag from '../../components/ml-tag.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlSectionHeader from '../../components/ml-section-header.uvue'
import {
  parseResume,
  fetchResumeHistory,
  fetchResumeDetail,
  deleteResumeRecord,
  fetchResumeQuota,
  uploadResumeFile
} from '../../api/resume.uts'
import {
  ResumeParseResult,
  ResumeParseResponse,
  ResumeQuota,
  ResumeHistoryItem,
  ResumeSuggestion
} from '../../types/resume.uts'
import {
  resumeDraft,
  buildResumeContent,
  ResumeDraftRecord,
  ResumeVersionExport
} from '../../store/resume-draft.uts'
import { trackEvent } from '../../api/tracking.uts'
import { userStore, positionDisplay } from '../../store/user-profile.uts'
import { themeValue } from '../../styles/theme.uts'

const SMART = themeValue('smart', '#5B6CFF')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const WARN = themeValue('warn', '#E08A00')
const DANGER = themeValue('danger', '#DC2626')
const BG_MUTED = themeValue('bgMuted', '#F1F5F9')
const SURFACE = themeValue('surface', '#FFFFFF')
const INK_SOFT = themeValue('inkSoft', '#5B6472')
const LINE = themeValue('line', '#E3E8F0')
const MIST = themeValue('mist', '#AEB9CC')
const CHIP_SMART = themeValue('chipSmart', '#EEF1FF')
const CHIP_RELIABLE = themeValue('chipReliable', '#E6F7F4')
const CHIP_WARN = themeValue('chipWarn', '#FFF3E0')
const CHIP_DANGER = themeValue('chipDanger', '#FEECEC')
const RELIABLE_LIGHT = themeValue('reliableLight', '#5CE8D8')

const steps: string[] = ['上传简历', 'AI 解析', '优化建议']

type ResumeVersion = {
  id: string
  name: string
  desc: string
  color: string
  tint: string
}

// 投递版本（文档 2.4：按目标岗位动态生成不同侧重版本）
const resumeVersions = computed((): ResumeVersion[] => {
  const pos = positionDisplay(userStore.profile)
  return [
    {
      id: 'standard',
      name: '标准版',
      desc: '均衡呈现经历与技能，适合' + pos + '相关岗位',
      color: SMART,
      tint: CHIP_SMART
    } as ResumeVersion,
    {
      id: 'tech',
      name: '技术深挖版',
      desc: '突出技术栈与工程实现细节，面向' + pos + '技术侧',
      color: RELIABLE,
      tint: CHIP_RELIABLE
    } as ResumeVersion,
    {
      id: 'project',
      name: '项目突出版',
      desc: '前置核心项目与量化成果，匹配' + pos + '岗位 JD',
      color: WARN,
      tint: CHIP_WARN
    } as ResumeVersion
  ]
})

const fileName = ref('')
const parsing = ref(false)
const parsed = ref<ResumeParseResult | null>(null)
const suggestions = ref<ResumeSuggestion[]>([])
const adopted = ref<boolean[]>([])
// 服务端额度 + 历史记录（付费门控与回看）
const quota = ref<ResumeQuota | null>(null)
const history = ref<ResumeHistoryItem[]>([])
const loadingHistory = ref(false)

const quotaText = computed((): string => {
  const q = quota.value
  if (q == null) return ''
  if (q.memberMonthlyLeft > 0) return '会员本月剩余 ' + q.memberMonthlyLeft + ' 次深度评审'
  if (q.singleLeft > 0) return '单次包剩余 ' + q.singleLeft + ' 次深度评审'
  return '今日免费预览剩余 ' + q.freePreviewLeftToday + ' 次'
})

// 步骤：0 上传；解析完成 1；建议生成 2
const currentStep = computed((): number => {
  if (suggestions.value.length > 0) return 2
  if (parsed.value != null) return 1
  return 0
})

const adoptedCount = computed((): number => {
  let n = 0
  for (let i = 0; i < adopted.value.length; i++) {
    if (adopted.value[i]) n += 1
  }
  return n
})

function stepStyle(i: number): { [key: string]: string } {
  if (i < currentStep.value) return { backgroundColor: RELIABLE }
  if (i === currentStep.value) return { backgroundColor: SMART }
  return { backgroundColor: BG_MUTED, border: '1px solid ' + LINE }
}

function stepTextColor(i: number): string {
  return i <= currentStep.value ? SURFACE : MIST
}

function isAdopted(i: number): boolean {
  return i < adopted.value.length ? adopted.value[i] : false
}

function toggleAdopt(i: number) {
  const next = adopted.value.slice()
  while (next.length <= i) next.push(false)
  next[i] = !next[i]
  adopted.value = next
}

function dismissOne(i: number) {
  toggleAdopt(i)
}

function adoptAll() {
  const next: boolean[] = []
  for (let i = 0; i < suggestions.value.length; i++) next.push(true)
  adopted.value = next
}

function resetAll() {
  fileName.value = ''
  parsed.value = null
  suggestions.value = []
  adopted.value = []
}

// ---------- 解析结果 / 历史 / 额度 ----------

function issuesToSuggestions(r: ResumeParseResult): ResumeSuggestion[] {
  const out: ResumeSuggestion[] = []
  for (let i = 0; i < r.issues.length; i++) {
    const it = r.issues[i]
    out.push({
      original: it.original,
      suggested: it.suggested,
      reason: it.reason,
      needsUserEvidence: it.needsUserEvidence
    } as ResumeSuggestion)
  }
  return out
}

// 把服务端出参落到页面状态（parsed 只保留结果字段，额度单独存）
function applyParse(r: ResumeParseResponse) {
  parsed.value = {
    resumeId: r.resumeId,
    fileName: r.fileName,
    fileType: r.fileType,
    pages: r.pages,
    contact: r.contact,
    projects: r.projects,
    techStack: r.techStack,
    quantified: r.quantified,
    gaps: r.gaps,
    formatRisks: r.formatRisks,
    issues: r.issues,
    mode: r.mode,
    cached: r.cached
  } as ResumeParseResult
  quota.value = r.quota
  const sugg = issuesToSuggestions(r)
  suggestions.value = sugg
  const init: boolean[] = []
  for (let i = 0; i < sugg.length; i++) init.push(false)
  adopted.value = init
}

function issueSeverityLabel(i: number): string {
  const p = parsed.value
  if (p == null || i >= p.issues.length) return ''
  const s = p.issues[i].severity
  if (s === 'high') return '高优先级'
  if (s === 'medium') return '中优先级'
  return '低优先级'
}

function fmtDate(ts: number): string {
  const d = new Date(ts)
  const m = d.getMonth() + 1
  const day = d.getDate()
  return (
    String(d.getFullYear()) +
    '-' +
    (m < 10 ? '0' + m : String(m)) +
    '-' +
    (day < 10 ? '0' + day : String(day))
  )
}

function historySubtitle(h: ResumeHistoryItem): string {
  const kind = h.mode === 'full' ? '深度评审' : '免费预览'
  return fmtDate(h.createdAt) + ' · ' + kind + ' · ' + h.issuesTotal + ' 条建议'
}

async function loadHistory() {
  if (loadingHistory.value) return
  loadingHistory.value = true
  try {
    history.value = await fetchResumeHistory(20)
  } catch (e: any) {
    console.warn('[resume] history failed', e)
  } finally {
    loadingHistory.value = false
  }
}

async function loadQuota() {
  try {
    quota.value = await fetchResumeQuota()
  } catch (e: any) {
    console.warn('[resume] quota failed', e)
  }
}

function loadAccountData() {
  loadQuota()
  loadHistory()
}

function goPaywall() {
  uni.navigateTo({ url: '/pages/membership/paywall?from=resume' })
}

async function openHistory(h: ResumeHistoryItem) {
  try {
    const r = await fetchResumeDetail(h.resumeId)
    if (r == null) {
      uni.showToast({ title: '记录不存在', icon: 'none' })
      return
    }
    fileName.value = r.fileName
    applyParse(r)
    trackEvent('resume_history_open', { resumeId: h.resumeId })
    uni.showToast({ title: '已载入历史记录', icon: 'none' })
  } catch (e: any) {
    console.warn('[resume] detail failed', e)
    uni.showToast({ title: '载入失败，请重试', icon: 'none' })
  }
}

async function doRemoveHistory(h: ResumeHistoryItem) {
  try {
    await deleteResumeRecord(h.resumeId)
    if (parsed.value != null && parsed.value.resumeId === h.resumeId) resetAll()
    await loadHistory()
    trackEvent('resume_history_delete', { resumeId: h.resumeId })
    uni.showToast({ title: '已删除', icon: 'none' })
  } catch {
    uni.showToast({ title: '删除失败，请重试', icon: 'none' })
  }
}

function removeHistory(h: ResumeHistoryItem) {
  uni.showModal({
    title: '删除解析记录',
    content: '删除后不可恢复，并会清理云端简历文件。',
    confirmText: '删除',
    confirmColor: DANGER,
    success: (res: any) => {
      if (res.confirm) doRemoveHistory(h)
    }
  })
}

// ---------- 草稿持久化与投递版本（文档 02 §2.4） ----------

// 组装当前页面状态为草稿记录
function buildRecord(): ResumeDraftRecord {
  const last = resumeDraft.latest()
  const versions = last != null && last.fileId === fileName.value ? last.versions.slice() : []
  return {
    fileId: fileName.value,
    fileName: fileName.value,
    position: positionDisplay(userStore.profile),
    parse: parsed.value as ResumeParseResult,
    suggestions: suggestions.value.slice(),
    adopted: adopted.value.slice(),
    versions: versions,
    savedAt: Date.now()
  } as ResumeDraftRecord
}

// 确保当前草稿已写入（导出版本前调用）
function ensureSaved() {
  if (parsed.value == null || fileName.value.length === 0) return
  resumeDraft.load()
  resumeDraft.save(buildRecord())
}

function saveAll() {
  if (parsed.value == null || fileName.value.length === 0) {
    uni.showToast({ title: '暂无内容可保存', icon: 'none' })
    return
  }
  ensureSaved()
  trackEvent('resume_draft_saved', { adopted: adoptedCount.value })
  uni.showToast({ title: '已保存 ' + adoptedCount.value + ' 条改写（本地草稿）', icon: 'none' })
}

// 把生成的版本内容写入本地文件（尽力而为）；失败静默，交付由复制全文兜底。
// App 端本地文件写入需原生层（uts 插件），当前仅 MP 端落地；App 交付由复制全文兜底。
function writeVersionFile(vid: string, content: string) {
  // #ifdef MP-WEIXIN
  try {
    // @ts-expect-error getFileSystemManager 为小程序端 API
    const fsm = uni.getFileSystemManager()
    const fname = 'resume-' + vid + '-' + Date.now() + '.txt'
    const dir = uni.env != null && uni.env.USER_DATA_PATH != null ? uni.env.USER_DATA_PATH : ''
    fsm.writeFile({
      filePath: dir + '/' + fname,
      data: content,
      encoding: 'utf8',
      success: function () {},
      fail: function () {}
    })
  } catch {
    // 忽略，交由复制兜底
  }
  // #endif
}

// 复制全文到剪贴板（通用保底：导出总有一个真实动作落定）
function copyToClipboard(content: string, versionName: string) {
  uni.setClipboardData({
    data: content,
    success: () => {
      uni.showToast({ title: '已生成「' + versionName + '」并复制全文', icon: 'none' })
    },
    fail: () => {
      uni.showToast({ title: '已生成「' + versionName + '」到本地草稿', icon: 'none' })
    }
  })
}

function exportVersion(v: ResumeVersion) {
  if (parsed.value == null || suggestions.value.length === 0) {
    uni.showToast({ title: '请先完成解析与改写建议', icon: 'none' })
    return
  }
  if (adoptedCount.value === 0) {
    uni.showToast({ title: '请先采用至少一条改写建议', icon: 'none' })
    return
  }
  trackEvent('resume_export', { versionId: v.id, versionName: v.name })
  // 按目标岗位 + 采用标记生成真实内容
  const content = buildResumeContent(
    fileName.value,
    positionDisplay(userStore.profile),
    suggestions.value,
    adopted.value,
    v.name
  )
  // 持久化版本（草稿库可追溯）
  ensureSaved()
  resumeDraft.load()
  const ex: ResumeVersionExport = {
    versionId: v.id,
    name: v.name,
    content: content,
    exportedAt: Date.now()
  } as ResumeVersionExport
  resumeDraft.addVersion(fileName.value, ex)
  // 交付：写文件（尽力而为）+ 复制全文（保底）
  writeVersionFile(v.id, content)
  copyToClipboard(content, v.name)
}

// ---------- 恢复上次草稿 ----------

const draftReady = ref(false)
const draftFileName = ref('')
const draftHint = ref('')

function refreshDraftHint() {
  resumeDraft.load()
  const last = resumeDraft.latest()
  if (last != null && suggestions.value.length === 0 && parsed.value == null) {
    draftFileName.value = last.fileName
    const adoptedN = adoptedCountOf(last)
    draftHint.value =
      last.fileName +
      ' · ' +
      (adoptedN > 0 ? '已采用 ' + adoptedN + ' 条改写' : '未采用改写') +
      ' · ' +
      last.versions.length +
      ' 个导出版本'
    draftReady.value = true
  } else {
    draftReady.value = false
  }
}

function adoptedCountOf(r: ResumeDraftRecord): number {
  let n = 0
  for (let i = 0; i < r.adopted.length; i++) {
    if (r.adopted[i]) n += 1
  }
  return n
}

function restoreDraft() {
  const last = resumeDraft.latest()
  if (last == null) return
  fileName.value = last.fileName
  parsed.value = last.parse
  suggestions.value = last.suggestions.slice()
  adopted.value = last.adopted.slice()
  draftReady.value = false
  trackEvent('resume_draft_restored', { fileName: last.fileName })
  uni.showToast({ title: '已恢复草稿', icon: 'none' })
}

onShow(() => {
  refreshDraftHint()
  loadAccountData()
})

function pick() {
  // #ifdef H5
  // H5 降级：toast 提示 + mock 解析（完整 input 方案需 web-view 容器配合）
  uni.showToast({ title: 'H5 端使用演示数据', icon: 'none' })
  doParse('h5-demo', 'demo-resume.pdf')
  // #endif

  // #ifndef H5
  pickNative()
  // #endif
}

// 从相册/相机选图片：当前仅支持 PDF/DOCX，图片入口暂不提供（OCR 另立卡）
// #ifndef H5
function pickNative() {
  // #ifdef MP-WEIXIN
  // 微信小程序：聊天会话选文件（仅 PDF/DOCX）
  // @ts-expect-error chooseMessageFile 是小程序端特有 API
  uni.chooseMessageFile({
    count: 1,
    type: 'file',
    extension: ['pdf', 'docx'],
    success(res: any) {
      const files = res.tempFiles as any[]
      if (files == null || files.length === 0) return
      const f = files[0]
      doParse(f.path as string, f.name as string)
    },
    fail() {
      uni.showToast({ title: '未选择文件', icon: 'none' })
    }
  })
  // #endif

  // #ifdef APP-PLUS || APP
  // App 端：系统文件选择器
  // @ts-expect-error chooseFile 为 App 端 API
  uni.chooseFile({
    count: 1,
    extension: ['pdf', 'docx'],
    success(res: any) {
      const paths = res.tempFilePaths as string[]
      if (paths == null || paths.length === 0) return
      const names = res.tempFiles as any[]
      const name = names != null && names.length > 0 ? (names[0].name as string) : paths[0]
      doParse(paths[0], name)
    },
    fail() {
      uni.showToast({ title: '未选择文件', icon: 'none' })
    }
  })
  // #endif
}
// #endif

async function doParse(path: string, name: string) {
  fileName.value = name
  parsing.value = true
  parsed.value = null
  suggestions.value = []
  adopted.value = []
  // 埋点：上传简历（fileType 取扩展名）
  const dot = name.lastIndexOf('.')
  const ext = dot >= 0 ? name.substring(dot + 1) : 'bin'
  trackEvent('resume_upload', { fileType: ext.length > 0 ? ext : 'unknown' })
  try {
    // 小程序端：先把文件真实上传到云存储（wx.cloud.uploadFile，无需域名），
    // 再把 cloud:// fileID 交给服务端；否则服务端拿到的只是客户端本地临时路径，永远读不到。
    const fileUrl = await uploadResumeFile(path, ext)
    const r = await parseResume(
      fileUrl,
      name,
      positionDisplay(userStore.profile)
    )
    applyParse(r)
    loadHistory()
  } catch (e: any) {
    const msg = e != null && e.message != null ? String(e.message) : ''
    if (msg.indexOf('会员') >= 0 || msg.indexOf('单次包') >= 0 || msg.indexOf('预览') >= 0) {
      uni.showModal({
        title: '需要开通',
        content: msg,
        confirmText: '查看权益',
        cancelText: '稍后',
        success: (res: any) => {
          if (res.confirm) goPaywall()
        }
      })
    } else if (msg.indexOf('仅支持') >= 0 || msg.indexOf('可复制文本') >= 0) {
      uni.showToast({ title: msg, icon: 'none', duration: 3000 })
    } else {
      uni.showToast({ title: msg.length > 0 ? msg : '解析失败，请重试', icon: 'none' })
    }
  } finally {
    parsing.value = false
  }
}
</script>
