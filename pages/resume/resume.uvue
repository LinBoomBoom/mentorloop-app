<template>
  <scroll-view class="h-screen bg-bg-light" scroll-y="true">
    <view class="px-4 pt-3 pb-6">
      <!-- 步骤流：上传 → 解析 → 建议 -->
      <view class="bg-surface rounded-2xl border border-line px-4 py-3.5 flex-row items-center">
        <template v-for="(s, i) in steps" :key="s">
          <view class="flex-col items-center">
            <view
              class="w-6 h-6 rounded-full flex-row items-center justify-center"
              :style="stepStyle(i)"
            >
              <ml-icon v-if="i < currentStep" name="check" :size="12" color="#FFFFFF"></ml-icon>
              <text v-else class="text-xs font-semibold" :style="{ color: stepTextColor(i) }">
                {{ i + 1 }}
              </text>
            </view>
            <text class="text-[11px] mt-1" :class="i <= currentStep ? 'text-ink' : 'text-mist'">
              {{ s }}
            </text>
          </view>
          <view
            v-if="i < steps.length - 1"
            class="flex-1 h-px mx-2 mb-4"
            :style="{ backgroundColor: i < currentStep ? '#1FB6A6' : '#E3E8F0' }"
          ></view>
        </template>
      </view>

      <!-- 恢复上次草稿（重进页面仍在） -->
      <view v-if="draftReady" class="mt-3">
        <ml-card>
          <view class="flex-row items-center justify-between">
            <view class="flex-col flex-1">
              <text class="text-sm text-ink">{{ draftFileName }}</text>
              <text class="text-[11px] text-ink-soft mt-0.5">{{ draftHint }}</text>
            </view>
            <view class="ml-2">
              <ml-button text="恢复草稿" type="primary" @click="restoreDraft"></ml-button>
            </view>
          </view>
        </ml-card>
      </view>

      <!-- 上传区 -->
      <view class="mt-3">
        <view
          class="bg-surface rounded-2xl border-2 border-dashed pressable relative overflow-hidden"
          :style="{ borderColor: fileName.length > 0 ? '#5B6CFF' : '#E3E8F0' }"
          hover-class="card-pressed"
          :hover-start-time="0"
          @click="pick"
        >
          <view class="flex-col items-center py-8">
            <view class="w-14 h-14 rounded-full bg-chip-smart flex-row items-center justify-center">
              <ml-icon
                :name="parsing ? 'loader-circle' : 'cloud-upload'"
                :size="26"
                color="#5B6CFF"
              ></ml-icon>
            </view>
            <text class="text-[15px] font-semibold text-ink mt-3">
              {{ parsing ? 'AI 解析中…' : fileName.length > 0 ? '重新上传简历' : '点击上传简历' }}
            </text>
            <text class="text-xs text-ink-soft mt-1">支持 PDF / Word / 图片，最大 10MB</text>

            <!-- 已选文件 -->
            <view
              v-if="fileName.length > 0"
              class="flex-row items-center mt-3 h-8 px-3 rounded-full bg-chip-smart"
            >
              <ml-icon name="file-check" :size="13" color="#5B6CFF"></ml-icon>
              <text class="text-xs text-smart ml-1">{{ fileName }}</text>
            </view>

            <view v-if="!parsing" class="mt-4">
              <ml-button
                :text="fileName.length > 0 ? '重新选择' : '选择文件'"
                type="primary"
                :disabled="parsing"
                @tap="pick"
              ></ml-button>
            </view>
            <view v-else class="mt-4 flex-row items-center">
              <ml-progress
                class="w-40"
                :percent="60"
                :show-value="false"
                color="#5B6CFF"
              ></ml-progress>
            </view>
          </view>
        </view>

        <!-- 隐私说明 -->
        <view class="flex-row items-center justify-center mt-2.5">
          <ml-icon name="lock" :size="11" color="#AEB9CC"></ml-icon>
          <text class="text-[11px] text-mist ml-1">简历仅用于本次分析，不会上传至第三方</text>
        </view>
      </view>

      <!-- 解析结果 -->
      <view v-if="parsed != null" class="mt-5">
        <ml-section-header title="解析结果" caption="结构化提取关键信息"></ml-section-header>
        <ml-card>
          <!-- 状态标签组 -->
          <view class="flex-row flex-wrap">
            <ml-tag
              :label="parsed.contact ? '联系方式已填' : '联系方式缺失'"
              :bg="parsed.contact ? '#E6F7F4' : '#FEECEC'"
              :color="parsed.contact ? '#1FB6A6' : '#DC2626'"
            ></ml-tag>
            <view class="w-1.5"></view>
            <ml-tag
              label="'项目经历 ' + parsed.projects + ' 段'"
              bg="#EEF1FF"
              color="#5B6CFF"
            ></ml-tag>
            <view class="w-1.5"></view>
            <ml-tag
              :label="parsed.quantified ? '成果已量化' : '成果未量化'"
              :bg="parsed.quantified ? '#E6F7F4' : '#FFF3E0'"
              :color="parsed.quantified ? '#1FB6A6' : '#E08A00'"
            ></ml-tag>
          </view>

          <!-- 技术栈 -->
          <template v-if="parsed.techStack.length > 0">
            <view class="flex-row items-center mt-4">
              <ml-icon name="layers" :size="13" color="#5B6CFF"></ml-icon>
              <text class="text-xs font-semibold text-ink ml-1">技术栈</text>
            </view>
            <view class="flex-row flex-wrap mt-2">
              <view
                v-for="(t, i) in parsed.techStack"
                :key="'t' + i"
                class="h-7 px-2.5 rounded-lg bg-bg-muted flex-row items-center mr-1.5 mb-1.5"
              >
                <text class="text-xs text-ink-soft">{{ t }}</text>
              </view>
            </view>
          </template>

          <!-- 待补充 -->
          <view v-if="parsed.gaps.length > 0" class="mt-3">
            <view class="flex-row items-center">
              <ml-icon name="circle-help" :size="13" color="#E08A00"></ml-icon>
              <text class="text-xs font-semibold text-warn ml-1">待补充</text>
            </view>
            <text
              v-for="(g, i) in parsed.gaps"
              :key="'g' + i"
              class="text-xs text-ink-soft mt-1.5 leading-5"
            >
              · {{ g }}
            </text>
          </view>

          <!-- 格式风险 -->
          <view v-if="parsed.formatRisks.length > 0" class="mt-3">
            <view class="flex-row items-center">
              <ml-icon name="triangle-alert" :size="13" color="#DC2626"></ml-icon>
              <text class="text-xs font-semibold text-danger ml-1">格式风险</text>
            </view>
            <text
              v-for="(r, i) in parsed.formatRisks"
              :key="'r' + i"
              class="text-xs text-ink-soft mt-1.5 leading-5"
            >
              · {{ r }}
            </text>
          </view>
        </ml-card>
      </view>

      <!-- 改写建议 -->
      <view v-if="suggestions.length > 0" class="mt-5">
        <ml-section-header
          title="改写建议"
          caption="均为建议稿，确认后才保存"
          action-text="全部采用"
          @action="adoptAll"
        ></ml-section-header>
        <view class="mb-2.5" v-for="(s, i) in suggestions" :key="i">
          <ml-card>
            <!-- 原句 -->
            <view class="rounded-xl p-3 bg-bg-muted">
              <view class="flex-row items-center">
                <ml-icon name="quote" :size="12" color="#AEB9CC"></ml-icon>
                <text class="text-[11px] text-mist ml-1">原文</text>
              </view>
              <text class="text-xs text-ink-soft mt-1.5 leading-5">{{ s.original }}</text>
            </view>
            <!-- 建议稿 -->
            <view class="mt-3 rounded-xl p-3 bg-chip-reliable">
              <view class="flex-row items-center">
                <ml-icon name="wand-2" :size="12" color="#1FB6A6"></ml-icon>
                <text class="text-[11px] font-semibold text-reliable ml-1">建议稿</text>
              </view>
              <text class="text-[13px] text-ink mt-1.5 leading-5">{{ s.suggested }}</text>
            </view>
            <!-- 原因 -->
            <text class="text-xs text-ink-soft mt-2.5 leading-5">{{ s.reason }}</text>
            <view class="mt-2" v-if="s.needsUserEvidence">
              <ml-tag label="需补充真实证据" bg="#FFF3E0" color="#E08A00"></ml-tag>
            </view>
            <!-- 操作 -->
            <view class="flex-row mt-3">
              <view
                class="h-8 px-3.5 rounded-full flex-row items-center justify-center pressable"
                :class="isAdopted(i) ? 'bg-line' : 'bg-smart'"
                hover-class="card-pressed"
                :hover-start-time="0"
                @click="toggleAdopt(i)"
              >
                <ml-icon
                  :name="isAdopted(i) ? 'check-check' : 'check'"
                  :size="13"
                  :color="isAdopted(i) ? '#5B6472' : '#FFFFFF'"
                ></ml-icon>
                <text class="text-xs ml-1" :class="isAdopted(i) ? 'text-ink-soft' : 'text-white'">
                  {{ isAdopted(i) ? '已采用' : '采用' }}
                </text>
              </view>
              <view class="w-2"></view>
              <view
                class="h-8 px-3.5 rounded-full border border-line flex-row items-center justify-center"
                hover-class="card-pressed"
                :hover-start-time="0"
                @click="dismissOne(i)"
              >
                <ml-icon name="x" :size="13" color="#5B6472"></ml-icon>
                <text class="text-xs text-ink-soft ml-1">忽略</text>
              </view>
            </view>
          </ml-card>
        </view>
      </view>

      <!-- 完成操作 -->
      <view v-if="suggestions.length > 0" class="mt-4">
        <ml-button
          :text="'保存 ' + adoptedCount + ' 条改写'"
          type="primary"
          block
          :disabled="adoptedCount === 0"
          @click="saveAll"
        ></ml-button>
        <view class="h-2"></view>
        <ml-button text="放弃全部修改" type="ghost" block @click="resetAll"></ml-button>
      </view>

      <!-- 多版本导出（文档 2.4：生成不同投递版本） -->
      <view v-if="parsed != null" class="mt-5">
        <ml-section-header
          title="投递版本"
          caption="按目标岗位生成不同侧重版本"
        ></ml-section-header>
        <ml-card :padded="false">
          <view
            v-for="(v, i) in resumeVersions"
            :key="'v_' + v.id"
            class="flex-row items-center px-4 py-3"
            :class="i < resumeVersions.length - 1 ? 'border-b border-line' : ''"
          >
            <view
              class="w-9 h-9 rounded-lg flex-row items-center justify-center mr-3"
              :style="{ backgroundColor: v.tint }"
            >
              <ml-icon name="file-text" :size="16" :color="v.color"></ml-icon>
            </view>
            <view class="flex-col flex-1">
              <text class="text-sm text-ink">{{ v.name }}</text>
              <text class="text-[11px] text-ink-soft mt-0.5">{{ v.desc }}</text>
            </view>
            <view
              class="h-7 px-3 rounded-full border border-line flex-row items-center pressable"
              hover-class="card-pressed"
              :hover-start-time="0"
              @click="exportVersion(v)"
            >
              <ml-icon name="share" :size="12" color="#5B6CFF"></ml-icon>
              <text class="text-xs text-smart ml-1">导出</text>
            </view>
          </view>
        </ml-card>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlTag from '../../components/ml-tag.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlSectionHeader from '../../components/ml-section-header.uvue'
import mlProgress from '../../components/ml-progress.uvue'
import { parseResume, optimizeResume } from '../../api/resume.uts'
import { ResumeParseResult, ResumeSuggestion } from '../../types/resume.uts'
import {
  resumeDraft,
  buildResumeContent,
  ResumeDraftRecord,
  ResumeVersionExport
} from '../../store/resume-draft.uts'
import { trackEvent } from '../../api/tracking.uts'
import { userStore, positionDisplay } from '../../store/user-profile.uts'

const steps: string[] = ['上传简历', 'AI 解析', '优化建议']

type ResumeVersion = {
  id: string
  name: string
  desc: string
  color: string
  tint: string
}

// 投递版本（文档 2.4：按目标岗位动态生成不同侧重版本）
const resumeVersions = computed((): ResumeVersion[] => {
  const pos = positionDisplay(userStore.profile)
  return [
    {
      id: 'standard',
      name: '标准版',
      desc: '均衡呈现经历与技能，适合' + pos + '相关岗位',
      color: '#5B6CFF',
      tint: '#EEF1FF'
    } as ResumeVersion,
    {
      id: 'tech',
      name: '技术深挖版',
      desc: '突出技术栈与工程实现细节，面向' + pos + '技术侧',
      color: '#1FB6A6',
      tint: '#E6F7F4'
    } as ResumeVersion,
    {
      id: 'project',
      name: '项目突出版',
      desc: '前置核心项目与量化成果，匹配' + pos + '岗位 JD',
      color: '#E08A00',
      tint: '#FFF3E0'
    } as ResumeVersion
  ]
})

const fileName = ref('')
const parsing = ref(false)
const parsed = ref<ResumeParseResult | null>(null)
const suggestions = ref<ResumeSuggestion[]>([])
const adopted = ref<boolean[]>([])

// 步骤：0 上传；解析完成 1；建议生成 2
const currentStep = computed((): number => {
  if (suggestions.value.length > 0) return 2
  if (parsed.value != null) return 1
  return 0
})

const adoptedCount = computed((): number => {
  let n = 0
  for (let i = 0; i < adopted.value.length; i++) {
    if (adopted.value[i]) n += 1
  }
  return n
})

function stepStyle(i: number): { [key: string]: string } {
  if (i < currentStep.value) return { backgroundColor: '#1FB6A6' }
  if (i === currentStep.value) return { backgroundColor: '#5B6CFF' }
  return { backgroundColor: '#F1F5F9', border: '1px solid #E3E8F0' }
}

function stepTextColor(i: number): string {
  return i <= currentStep.value ? '#FFFFFF' : '#AEB9CC'
}

function isAdopted(i: number): boolean {
  return i < adopted.value.length ? adopted.value[i] : false
}

function toggleAdopt(i: number) {
  const next = adopted.value.slice()
  while (next.length <= i) next.push(false)
  next[i] = !next[i]
  adopted.value = next
}

function dismissOne(i: number) {
  toggleAdopt(i)
}

function adoptAll() {
  const next: boolean[] = []
  for (let i = 0; i < suggestions.value.length; i++) next.push(true)
  adopted.value = next
}

function resetAll() {
  fileName.value = ''
  parsed.value = null
  suggestions.value = []
  adopted.value = []
}

// ---------- 草稿持久化与投递版本（文档 02 §2.4） ----------

// 组装当前页面状态为草稿记录
function buildRecord(): ResumeDraftRecord {
  const last = resumeDraft.latest()
  const versions = last != null && last.fileId === fileName.value ? last.versions.slice() : []
  return {
    fileId: fileName.value,
    fileName: fileName.value,
    position: positionDisplay(userStore.profile),
    parse: parsed.value as ResumeParseResult,
    suggestions: suggestions.value.slice(),
    adopted: adopted.value.slice(),
    versions: versions,
    savedAt: Date.now()
  } as ResumeDraftRecord
}

// 确保当前草稿已写入（导出版本前调用）
function ensureSaved() {
  if (parsed.value == null || fileName.value.length === 0) return
  resumeDraft.load()
  resumeDraft.save(buildRecord())
}

function saveAll() {
  if (parsed.value == null || fileName.value.length === 0) {
    uni.showToast({ title: '暂无内容可保存', icon: 'none' })
    return
  }
  ensureSaved()
  trackEvent('resume_draft_saved', { adopted: adoptedCount.value })
  uni.showToast({ title: '已保存 ' + adoptedCount.value + ' 条改写（本地草稿）', icon: 'none' })
}

// 把生成的版本内容写入本地文件（尽力而为）；失败静默，交付由复制全文兜底
function writeVersionFile(vid: string, content: string) {
  // #ifdef APP-PLUS || APP
  try {
    const g = globalThis as any
    const plus = g.plus
    if (plus != null && plus.io != null) {
      const fname = 'resume-' + vid + '-' + Date.now() + '.txt'
      plus.io.resolveLocalFileSystemURL(
        '_doc',
        (dir: any) => {
          dir.getFile(
            fname,
            { create: true },
            (fileEntry: any) => {
              fileEntry.createWriter(
                (writer: any) => {
                  writer.onerror = function () {}
                  writer.write(content)
                },
                function () {}
              )
            },
            function () {}
          )
        },
        function () {}
      )
    }
  } catch {
    // 忽略写文件失败，交由复制兜底
  }
  // #endif
  // #ifdef MP-WEIXIN
  try {
    // @ts-expect-error getFileSystemManager 为小程序端 API
    const fsm = uni.getFileSystemManager()
    const fname = 'resume-' + vid + '-' + Date.now() + '.txt'
    const dir = uni.env != null && uni.env.USER_DATA_PATH != null ? uni.env.USER_DATA_PATH : ''
    fsm.writeFile({
      filePath: dir + '/' + fname,
      data: content,
      encoding: 'utf8',
      success: function () {},
      fail: function () {}
    })
  } catch {
    // 忽略，交由复制兜底
  }
  // #endif
}

// 复制全文到剪贴板（通用保底：导出总有一个真实动作落定）
function copyToClipboard(content: string, versionName: string) {
  uni.setClipboardData({
    data: content,
    success: () => {
      uni.showToast({ title: '已生成「' + versionName + '」并复制全文', icon: 'none' })
    },
    fail: () => {
      uni.showToast({ title: '已生成「' + versionName + '」到本地草稿', icon: 'none' })
    }
  })
}

function exportVersion(v: ResumeVersion) {
  if (parsed.value == null || suggestions.value.length === 0) {
    uni.showToast({ title: '请先完成解析与改写建议', icon: 'none' })
    return
  }
  if (adoptedCount.value === 0) {
    uni.showToast({ title: '请先采用至少一条改写建议', icon: 'none' })
    return
  }
  trackEvent('resume_export', { versionId: v.id, versionName: v.name })
  // 按目标岗位 + 采用标记生成真实内容
  const content = buildResumeContent(
    fileName.value,
    positionDisplay(userStore.profile),
    suggestions.value,
    adopted.value,
    v.name
  )
  // 持久化版本（草稿库可追溯）
  ensureSaved()
  resumeDraft.load()
  const ex: ResumeVersionExport = {
    versionId: v.id,
    name: v.name,
    content: content,
    exportedAt: Date.now()
  } as ResumeVersionExport
  resumeDraft.addVersion(fileName.value, ex)
  // 交付：写文件（尽力而为）+ 复制全文（保底）
  writeVersionFile(v.id, content)
  copyToClipboard(content, v.name)
}

// ---------- 恢复上次草稿 ----------

const draftReady = ref(false)
const draftFileName = ref('')
const draftHint = ref('')

function refreshDraftHint() {
  resumeDraft.load()
  const last = resumeDraft.latest()
  if (last != null && suggestions.value.length === 0 && parsed.value == null) {
    draftFileName.value = last.fileName
    const adoptedN = adoptedCountOf(last)
    draftHint.value =
      last.fileName +
      ' · ' +
      (adoptedN > 0 ? '已采用 ' + adoptedN + ' 条改写' : '未采用改写') +
      ' · ' +
      last.versions.length +
      ' 个导出版本'
    draftReady.value = true
  } else {
    draftReady.value = false
  }
}

function adoptedCountOf(r: ResumeDraftRecord): number {
  let n = 0
  for (let i = 0; i < r.adopted.length; i++) {
    if (r.adopted[i]) n += 1
  }
  return n
}

function restoreDraft() {
  const last = resumeDraft.latest()
  if (last == null) return
  fileName.value = last.fileName
  parsed.value = last.parse
  suggestions.value = last.suggestions.slice()
  adopted.value = last.adopted.slice()
  draftReady.value = false
  trackEvent('resume_draft_restored', { fileName: last.fileName })
  uni.showToast({ title: '已恢复草稿', icon: 'none' })
}

onShow(() => {
  refreshDraftHint()
})

function pick() {
  // #ifdef H5
  // H5 降级：toast 提示 + mock 解析（完整 input 方案需 web-view 容器配合）
  uni.showToast({ title: 'H5 端使用演示数据', icon: 'none' })
  doParse('h5-demo', 'demo-resume.pdf')
  // #endif

  // #ifndef H5
  pickNative()
  // #endif
}

// #ifndef H5
function pickNative() {
  // #ifdef MP-WEIXIN
  // 微信小程序：聊天会话选文件
  // @ts-expect-error chooseMessageFile 是小程序端特有 API
  uni.chooseMessageFile({
    count: 1,
    type: 'file',
    extension: ['pdf', 'doc', 'docx', 'jpg', 'jpeg', 'png'],
    success(res: any) {
      const files = res.tempFiles as any[]
      if (files == null || files.length === 0) return
      const f = files[0]
      doParse(f.path as string, f.name as string)
    },
    fail() {
      uni.showToast({ title: '未选择文件', icon: 'none' })
    }
  })
  // #endif

  // #ifdef APP-PLUS || APP
  // App 端：系统文件选择器
  // @ts-expect-error chooseFile 为 App 端 API
  uni.chooseFile({
    count: 1,
    extension: ['pdf', 'doc', 'docx', 'jpg', 'jpeg', 'png'],
    success(res: any) {
      const paths = res.tempFilePaths as string[]
      if (paths == null || paths.length === 0) return
      const names = res.tempFiles as any[]
      const name = names != null && names.length > 0 ? (names[0].name as string) : paths[0]
      doParse(paths[0], name)
    },
    fail() {
      uni.showToast({ title: '未选择文件', icon: 'none' })
    }
  })
  // #endif
}
// #endif

async function doParse(path: string, name: string) {
  fileName.value = name
  parsing.value = true
  parsed.value = null
  suggestions.value = []
  adopted.value = []
  // 埋点：上传简历（fileType 取扩展名）
  const dot = name.lastIndexOf('.')
  trackEvent('resume_upload', { fileType: dot >= 0 ? name.substring(dot + 1) : 'unknown' })
  try {
    const r = await parseResume(path)
    parsed.value = r
    const sugg = await optimizeResume('简历项目经历', positionDisplay(userStore.profile))
    suggestions.value = sugg
    const init: boolean[] = []
    for (let i = 0; i < sugg.length; i++) init.push(false)
    adopted.value = init
  } catch {
    uni.showToast({ title: '解析失败，请重试', icon: 'none' })
  } finally {
    parsing.value = false
  }
}
</script>

<style>
.card-pressed {
  opacity: 0.85;
}
</style>
