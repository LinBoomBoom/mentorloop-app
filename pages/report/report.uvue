<template>
  <scroll-view class="h-screen bg-bg-light" scroll-y="true">
    <!-- 加载态：异步取报告期间不误报「暂无报告」 -->
    <view v-if="loading" class="p-4 pt-6">
      <ml-card>
        <view class="flex-row items-center">
          <ml-icon name="refresh-cw" :size="16" :color="SMART"></ml-icon>
          <text class="text-sm text-ink-soft ml-2">报告加载中…</text>
        </view>
      </ml-card>
    </view>

    <view v-else-if="!hasReport" class="p-4 pt-6">
      <ml-card>
        <ml-empty
          icon="file-text"
          :icon-color="SMART"
          :icon-bg="CHIP_SMART"
          title="暂无报告"
          desc="完成一次模拟面试后，这里会展示总体判断、六维评分与训练计划"
        >
          <ml-button text="回首页开始面试" type="primary" block @click="goHome"></ml-button>
        </ml-empty>
      </ml-card>
    </view>

    <template v-else>
      <view class="p-4">
        <!-- 复盘域分段（IA-1 D-IA2）：本场报告 / 成长趋势同层，不再跳二级页 -->
        <view
          class="flex-row rounded-control p-1 mb-3 border"
          :style="{ backgroundColor: BG_MUTED, borderColor: LINE }"
        >
          <view
            class="flex-1 h-9 flex-row items-center justify-center rounded-chip"
            :style="segItemStyle(seg === 'report')"
            hover-class="pressed-chip"
            :hover-start-time="0"
            @click="seg = 'report'"
          >
            <text
              class="text-xs font-medium"
              :style="{ color: seg === 'report' ? SURFACE : INK_SOFT }"
            >
              本场报告
            </text>
          </view>
          <view
            class="flex-1 h-9 flex-row items-center justify-center rounded-chip"
            :style="segItemStyle(seg === 'growth')"
            hover-class="pressed-chip"
            :hover-start-time="0"
            @click="seg = 'growth'"
          >
            <text
              class="text-xs font-medium"
              :style="{ color: seg === 'growth' ? SURFACE : INK_SOFT }"
            >
              成长趋势
            </text>
          </view>
        </view>

        <template v-if="seg === 'report'">
          <!-- 历史报告选择（报告升为一级 tab 后的列表入口） -->
          <scroll-view v-if="records.length > 1" scroll-x="true" class="whitespace-nowrap mb-3">
            <view class="flex-row">
              <view
                v-for="r0 in records"
                :key="r0.sessionId"
                class="mr-2"
                hover-class="pressed-chip"
                :hover-start-time="0"
                @click="selectSession(r0.sessionId)"
              >
                <view
                  class="h-11 px-3.5 rounded-chip flex-row items-center border"
                  :style="chipStyle(r0.sessionId)"
                >
                  <text
                    class="text-xs font-mono"
                    :style="{ color: r0.sessionId === activeSid ? SURFACE : INK_SOFT }"
                  >
                    {{ fmtDate(r0.at) }}
                  </text>
                </view>
              </view>
            </view>
          </scroll-view>

          <!-- 总体判断（深色品牌卡，去装饰；综合等级 + 置信度） -->
          <view class="bg-navy rounded-card p-5">
            <view class="flex-row items-center">
              <ml-icon name="sparkles" :size="14" :color="MIST"></ml-icon>
              <text class="text-xs text-mist ml-1.5">总体判断</text>
            </view>
            <view class="flex-row items-center mt-2">
              <text class="text-lg font-semibold text-white flex-1 leading-6">
                {{ report.overall }}
              </text>
              <view
                class="w-12 h-12 rounded-control flex-col items-center justify-center ml-3"
                :style="{
                  backgroundColor: 'rgba(255,255,255,0.08)',
                  border: '1px solid rgba(255,255,255,0.14)'
                }"
              >
                <text class="text-lg font-bold font-mono" :style="{ color: overallLevelColor }">
                  {{ overallLevel }}
                </text>
                <text class="text-xs text-mist">综合</text>
              </view>
            </view>
            <text class="text-xs text-mist mt-2">{{ overallConfidenceText }}</text>
            <view class="flex-row mt-4">
              <view
                class="flex-1 rounded-control p-3 mr-2.5"
                :style="{ backgroundColor: 'rgba(255,255,255,0.1)' }"
              >
                <view class="flex-row items-center">
                  <ml-icon name="award" :size="12" :color="RELIABLE_LIGHT"></ml-icon>
                  <text class="text-xs text-mist ml-1">最强项</text>
                </view>
                <text class="text-sm text-white mt-1.5">{{ report.strongest }}</text>
              </view>
              <view
                class="flex-1 rounded-control p-3"
                :style="{ backgroundColor: 'rgba(255,255,255,0.08)' }"
              >
                <view class="flex-row items-center">
                  <ml-icon name="target" :size="12" :color="WARN_LIGHT"></ml-icon>
                  <text class="text-xs text-mist ml-1">最该提升</text>
                </view>
                <text class="text-sm text-white mt-1.5">{{ report.topPriority }}</text>
              </view>
            </view>
          </view>

          <!-- 能力维度（证据卡：点击展开完整证据 + 优秀回答示例） -->
          <view class="mt-5">
            <ml-section-header
              title="能力维度"
              caption="点击卡片展开证据"
              action-text="成长趋势"
              @action="showGrowth"
            ></ml-section-header>
          </view>
          <view class="mb-2.5" v-for="d in report.dimensions" :key="d.dimension">
            <ml-card pressable @tap="toggleEvidence(d.dimension)">
              <view class="flex-row items-center justify-between">
                <text class="text-base font-semibold text-ink">{{ dimLabel(d.dimension) }}</text>
                <view class="flex-row items-center">
                  <text class="text-xs font-mono text-ink-soft mr-2">{{
                    confText(d.dimension)
                  }}</text>
                  <ml-tag
                    :label="d.level"
                    :bg="levelTint(d.level)"
                    :color="levelColor(d.level)"
                  ></ml-tag>
                  <ml-icon
                    class="ml-1.5"
                    :name="isExpanded(d.dimension) ? 'chevron-up' : 'chevron-down'"
                    :size="14"
                    :color="MIST"
                  ></ml-icon>
                </view>
              </view>
              <!-- 等级条 -->
              <view class="mt-2.5 h-1.5 rounded-full bg-line">
                <view
                  class="h-1.5 rounded-full"
                  :style="{
                    width: levelPercent(d.level) + '%',
                    backgroundColor: levelColor(d.level)
                  }"
                ></view>
              </view>
              <text class="text-xs text-ink-soft mt-2 leading-5">证据：{{ d.evidence }}</text>
              <text v-if="isLowConf(d.dimension)" class="text-xs text-warn mt-1">
                低置信度：证据不足，仅供参考
              </text>
              <text v-if="!isExpanded(d.dimension)" class="text-xs text-smart mt-1">
                点击展开：对照锚点与参考答法
              </text>

              <!-- 展开区：证据对照（你的回答 ↔ 待补证据）+ 参考答法 + 建议加练 -->
              <template v-if="isExpanded(d.dimension)">
                <view class="mt-3">
                  <text class="text-xs font-mono text-ink-soft">你的回答摘录</text>
                  <view class="mt-1.5 rounded-control p-3 bg-bg-muted" :style="quoteStyle">
                    <text class="text-xs text-ink leading-5">{{ d.evidence }}</text>
                  </view>
                </view>
                <view v-if="d.missingEvidence.length > 0" class="mt-2.5">
                  <text class="text-xs font-mono text-ink-soft">待补证据</text>
                  <view class="mt-1.5 rounded-control p-3 bg-chip-warn" :style="gapStyle">
                    <text class="text-xs text-ink leading-5">{{ d.missingEvidence }}</text>
                  </view>
                </view>
                <view class="mt-2.5">
                  <text class="text-xs font-mono text-ink-soft">参考答法</text>
                  <view class="mt-1.5 rounded-control p-3 bg-chip-reliable" :style="refStyle">
                    <text class="text-xs text-ink leading-5">{{ exampleFor(d.dimension) }}</text>
                  </view>
                </view>
                <view v-if="d.suggestQuestions.length > 0" class="mt-2.5">
                  <text class="text-xs font-semibold text-ink">建议加练</text>
                  <text
                    v-for="(sq, i) in d.suggestQuestions"
                    :key="'sq' + i"
                    class="text-xs text-ink-soft mt-1 leading-5"
                  >
                    · {{ sq }}
                  </text>
                </view>
              </template>
            </ml-card>
          </view>

          <!-- 风险提示 -->
          <view v-if="report.riskQuestions.length > 0">
            <view class="mt-5">
              <ml-section-header
                title="风险提示"
                caption="面试官视角的红旗信号"
              ></ml-section-header>
            </view>
            <view class="mb-2" v-for="(r, i) in report.riskQuestions" :key="i">
              <ml-card>
                <view class="flex-row items-center">
                  <ml-icon name="circle-help" :size="15" :color="WARN"></ml-icon>
                  <text class="text-sm text-ink ml-2 flex-1">{{ r }}</text>
                </view>
              </ml-card>
            </view>
          </view>

          <!-- 训练计划 -->
          <view class="mt-5">
            <ml-section-header
              title="建议训练计划"
              caption="出自本次评估报告 · 点击直达训练"
            ></ml-section-header>
          </view>
          <view class="mb-2" v-for="t in report.trainingPlan" :key="t.id">
            <ml-card pressable @tap="startPlanTask(t)">
              <view class="flex-row items-center">
                <view
                  class="w-9 h-9 rounded-control flex-row items-center justify-center mr-3"
                  :class="t.priority === 1 ? 'bg-chip-warn' : 'bg-chip-smart'"
                >
                  <ml-icon name="zap" :size="16" :color="t.priority === 1 ? WARN : SMART"></ml-icon>
                </view>
                <view class="flex-col flex-1">
                  <text class="text-sm text-ink">{{ t.title }}</text>
                  <view class="flex-row items-center mt-0.5">
                    <text class="text-xs font-mono text-ink-soft">{{ t.durationMin }}</text>
                    <text class="text-xs text-ink-soft ml-1">分钟 · 优先级</text>
                    <text class="text-xs font-mono text-ink-soft ml-1">{{ t.priority }}</text>
                  </view>
                </view>
                <ml-icon name="chevron-right" :size="16" :color="MIST"></ml-icon>
              </view>
            </ml-card>
          </view>

          <!-- 底部操作 -->
          <view class="mt-4 mb-6 flex-row">
            <view class="flex-1 mr-2">
              <ml-button text="再次模拟" type="primary" block @click="again"></ml-button>
            </view>
            <view class="flex-1 ml-2">
              <ml-button text="返回首页" type="secondary" block @click="goHome"></ml-button>
            </view>
          </view>
        </template>

        <!-- 成长趋势（IA-1：原 pages/growth 二级页并入复盘域，组件承载） -->
        <template v-else>
          <ml-growth-panel :reload-token="growthTick"></ml-growth-panel>
        </template>
      </view>
    </template>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import mlCard from '../../components/ml-card.uvue'
import mlTag from '../../components/ml-tag.uvue'
import mlButton from '../../components/ml-button.uvue'
import mlIcon from '../../components/ml-icon.uvue'
import mlEmpty from '../../components/ml-empty.uvue'
import mlSectionHeader from '../../components/ml-section-header.uvue'
import mlGrowthPanel from '../../components/ml-growth-panel.uvue'
import { reportHistory, ReportRecord } from '../../store/report-history.uts'
import { quotaStore } from '../../store/quota.uts'
import { domainOfTaskId } from '../../store/training-history.uts'
import { reportSegmentIntent } from '../../store/report-segment.uts'
import { getReport } from '../../api/report.uts'
import { trackEvent } from '../../api/tracking.uts'
import {
  InterviewReport,
  DimensionScore,
  TrainingTask,
  DIMENSION_LABEL
} from '../../types/scoring.uts'
import { themeValue } from '../../styles/theme.uts'
import {
  averageLevel,
  levelColor,
  levelColorOnDark,
  levelPercent,
  levelTint
} from '../../styles/score-display.uts'
import { confidenceBand } from '../../engine/rubric.uts'

const SMART = themeValue('smart', '#5B6CFF')
const RELIABLE = themeValue('reliable', '#1FB6A6')
const WARN = themeValue('warn', '#E08A00')
const SURFACE = themeValue('surface', '#FFFFFF')
const BG_MUTED = themeValue('bgMuted', '#F1F5F9')
const INK_SOFT = themeValue('inkSoft', '#5B6472')
const LINE = themeValue('line', '#E3E8F0')
const MIST = themeValue('mist', '#AEB9CC')
const CHIP_SMART = themeValue('chipSmart', '#EEF1FF')
const RELIABLE_LIGHT = themeValue('reliableLight', '#5CE8D8')
const WARN_LIGHT = themeValue('warnLight', '#F5C97B')

// 证据对照卡左侧强调边（diff 语义：你的回答 / 待补证据 / 参考答法）
const quoteStyle = { borderLeftWidth: '2px', borderLeftStyle: 'solid', borderLeftColor: SMART }
const gapStyle = { borderLeftWidth: '2px', borderLeftStyle: 'solid', borderLeftColor: WARN }
const refStyle = { borderLeftWidth: '2px', borderLeftStyle: 'solid', borderLeftColor: RELIABLE }

const emptyReport: InterviewReport = {
  overall: '',
  strongest: '',
  topPriority: '',
  dimensions: [] as DimensionScore[],
  riskQuestions: [] as string[],
  trainingPlan: [] as TrainingTask
} as InterviewReport

const report = ref(emptyReport)
const hasReport = ref(false)

// 报告升为一级 tab：加载态 + 历史列表 + 当前选中会话
const loading = ref(true)
const records = ref<ReportRecord[]>([])
const activeSid = ref('')

// 复盘域分段（IA-1 D-IA2）：默认本场报告；growthTick 供成长面板在 onShow 时重载
const seg = ref('report')
const growthTick = ref(0)

function segItemStyle(active: boolean): { [key: string]: string } {
  if (active) return { backgroundColor: SMART }
  return { backgroundColor: 'transparent' }
}

function showGrowth() {
  seg.value = 'growth'
}

// 综合等级徽章（U7：等级映射与刻度单一来源 styles/score-display.uts）
const overallLevel = computed((): string => averageLevel(reportLevels(report.value.dimensions)))

// 维度等级 → 等级序列（供 averageLevel 消费）
function reportLevels(dims: DimensionScore[]): string[] {
  const out: string[] = []
  for (let i = 0; i < dims.length; i++) out.push(dims[i].level)
  return out
}

// 深色面上的等级色（U7：单一来源 styles/score-display.uts）
const overallLevelColor = computed((): string => levelColorOnDark(overallLevel.value))

// 综合置信度（D-i3：消费模型既有 confidence 字段，低置信度不伪装精确）
const overallConfidenceText = computed((): string => {
  const dims = report.value.dimensions
  if (dims.length === 0) return ''
  let total = 0
  for (let i = 0; i < dims.length; i++) total += dims[i].confidence
  const band = confidenceBand(total / dims.length)
  if (band === 'high') return '综合置信度 高'
  if (band === 'medium') return '综合置信度 中'
  return '综合置信度 低 · 证据不足，仅供参考'
})

// 单维度置信度（档位阈值单一来源 engine/rubric.uts confidenceBand）
function confidenceOf(key: string): number {
  const dims = report.value.dimensions
  for (let i = 0; i < dims.length; i++) {
    if (dims[i].dimension === key) return dims[i].confidence
  }
  return 0
}

function confText(key: string): string {
  const band = confidenceBand(confidenceOf(key))
  if (band === 'high') return '高置信'
  if (band === 'medium') return '中置信'
  return '低置信'
}

function isLowConf(key: string): boolean {
  return confidenceBand(confidenceOf(key)) === 'low'
}

// 证据卡展开状态（记录已展开的维度 key）
const expandedKeys = ref<string[]>([])

function isExpanded(key: string): boolean {
  return expandedKeys.value.includes(key)
}

// 展开/收起证据卡；展开时上报 report_evidence_expand（文档 03 关键交互）
function toggleEvidence(key: string) {
  const next = expandedKeys.value.slice()
  const idx = next.indexOf(key)
  if (idx >= 0) {
    next.splice(idx, 1)
  } else {
    next.push(key)
    trackEvent('report_evidence_expand', { dimension: key })
  }
  expandedKeys.value = next
}

// 优秀回答示例（文档 02 §2.5）：按维度给出结构化示范
const DIM_EXAMPLES: { [key: string]: string } = {
  knowledge:
    '「HashMap 在 JDK 8 后改成数组 + 链表 + 红黑树。链表长度超过 8 且数组长度 ≥ 64 时转红黑树，查询从 O(n) 降到 O(logn)。我在业务里用它做本地缓存时，还会关注扩容因子 0.75 带来的 rehash 开销。」',
  engineering:
    '「订单超时关单我用了延迟消息方案：下单发 15 分钟延迟消息，消费时先查状态再关单，避免定时任务扫全表。上线后关单及时率从 92% 提到 99.8%，DB 扫描 QPS 从 120 降到 0。」',
  analysis:
    '「缓存和 DB 一致性问题，我先看业务容忍度：库存类强一致就走 DB 乐观锁；商品详情类用先更 DB 再删缓存，加上 500ms 延迟双删兜底。两种方案我都压测过，P99 分别是 3ms 和 12ms。」',
  communication:
    '「我按『结论 → 依据 → 指标』三段式表达：先说方案选了什么，再讲为什么放弃备选，最后给上线后的量化结果，让面试官 30 秒内抓住重点。」',
  learning:
    '「那次线上事故后我做了复盘：根因是连接池没配超时。我把复盘写成团队 wiki，并加了上线前配置巡检脚本，之后同类问题零复发。」',
  motivation:
    '「我看重贵司业务里高并发场景的复杂度，这正是我想深耕的方向；我过往的订单系统经验可以直接复用到你们的交易链路上。」'
}

function exampleFor(key: string): string {
  // 优先使用 LLM 生成的优秀示例（P1.2）；未生成时回退本地结构化示例
  const dims = report.value.dimensions
  for (let i = 0; i < dims.length; i++) {
    const d = dims[i]
    if (d.dimension === key && d.exampleAnswer != null && d.exampleAnswer.length > 0) {
      return d.exampleAnswer
    }
  }
  const v = DIM_EXAMPLES[key]
  return v != null ? v : '参考结构：结论 → 依据 → 量化指标 → 边界条件。'
}

onShow(async () => {
  // 分段面板重载信号：分段停留在成长趋势时，回到本 tab 也能看到最新场次
  growthTick.value += 1
  // 跨 tab 落点：首页数据条带「成长趋势」意图时，进入即切到该分段（消费一次即清空）
  const segIntent = reportSegmentIntent.consume()
  if (segIntent.length > 0) seg.value = segIntent
  reportHistory.load()
  const all = reportHistory.all()
  records.value = all
  if (all.length === 0) {
    loading.value = false
    hasReport.value = false
    return
  }
  // 保持当前选中；失效则回退最近一场
  let sid = activeSid.value
  if (sid.length === 0 || !hasSession(sid)) sid = all[0].sessionId
  activeSid.value = sid
  await loadReport(sid)
})

function hasSession(sid: string): boolean {
  const all = records.value
  for (let i = 0; i < all.length; i++) {
    if (all[i].sessionId === sid) return true
  }
  return false
}

function findLocal(sid: string): ReportRecord | null {
  const all = records.value
  for (let i = 0; i < all.length; i++) {
    if (all[i].sessionId === sid) return all[i]
  }
  return null
}

// 加载指定会话报告（报告权威源 = 服务端；mock 由 api 层内部短路到本地 history）
async function loadReport(sid: string) {
  loading.value = true
  try {
    const r = await getReport(sid)
    report.value = r
    hasReport.value = r.overall.length > 0
    // 北极星：报告查看率
    if (hasReport.value) trackEvent('report_view', { interviewId: sid })
  } catch {
    // 服务端不可达：本地有记录则兜底展示（summary 已可能写入本地兜底报告），避免死锁
    const local = findLocal(sid)
    if (local != null) {
      report.value = local.report
      hasReport.value = local.report.overall.length > 0
    } else {
      hasReport.value = false
    }
  }
  loading.value = false
}

function selectSession(sid: string) {
  if (sid === activeSid.value) return
  activeSid.value = sid
  loadReport(sid)
}

function chipStyle(sid: string): { [key: string]: string } {
  if (sid === activeSid.value) {
    return { backgroundColor: SMART, borderColor: SMART }
  }
  return { backgroundColor: SURFACE, borderColor: LINE }
}

function fmtDate(ts: number): string {
  const d = new Date(ts)
  const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
  return pad(d.getMonth() + 1) + '-' + pad(d.getDate())
}

function dimLabel(k: string): string {
  const v = DIMENSION_LABEL[k]
  return v != null && v.length > 0 ? v : k
}

// 训练计划 → 直达训练房间（source=report 定向薄弱项维度；额度在房间内统一扣减）
function startPlanTask(t: TrainingTask) {
  trackEvent('training_start_from_report', { taskId: t.id, priority: t.priority })
  const id = t.id
  const domain = domainOfTaskId(id)
  const url =
    '/pages/training/room?taskId=' +
    encodeURIComponent(id) +
    '&title=' +
    encodeURIComponent(t.title) +
    '&durationMin=' +
    t.durationMin +
    '&source=report&domain=' +
    domain
  uni.navigateTo({ url: url })
}

// 再次模拟：与首页同规则做额度门控（prep 页无门控，直跳会绕过付费墙），然后进入面试准备页
function again() {
  quotaStore.restore()
  if (!quotaStore.canStartInterview()) {
    trackEvent('quota_exceeded', { scene: 'interview' })
    uni.showModal({
      title: '免费额度已用完',
      content: '开通会员可无限次模拟面试，或购买单次包继续练习',
      confirmText: '去开通',
      cancelText: '暂不需要',
      success: (r: any) => {
        if (r.confirm) {
          uni.navigateTo({ url: '/pages/membership/paywall?from=gating' })
        }
      }
    })
    return
  }
  uni.reLaunch({ url: '/pages/interview/prep?mode=standard' })
}

function goHome() {
  uni.reLaunch({ url: '/pages/index/index' })
}
</script>
