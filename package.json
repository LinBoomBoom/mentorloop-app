{
  "name": "mentorloop",
  "version": "1.0.0",
  "private": true,
  "description": "MentorLoop · 学面一体智能导师（uni-app x 蒸汽模式 + Tailwind CSS 4）",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:mp-weixin": "uni build -p mp-weixin --watch",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:app-android": "uni build -p app-android --watch",
    "build:app-android": "uni build -p app-android",
    "dev:app-ios": "uni build -p app-ios --watch",
    "build:app-ios": "uni build -p app-ios",
    "dev:app-harmony": "uni build -p app-harmony --watch",
    "build:app-harmony": "uni build -p app-harmony",
    "dev:h5": "uni build -p h5 --watch",
    "build:h5": "uni build -p h5",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "pnpm audit --audit-level high",
    "prepare": "husky || true",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.50.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "esbuild": "^0.25.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "5.2.8",
    "vitest": "^3.0.0",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0",
    "weapp-tailwindcss": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,ts,uts,mjs,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{vue,uvue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
