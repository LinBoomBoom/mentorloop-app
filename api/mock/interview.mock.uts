// 面试 mock（无后端时的会话壳）
// 2026-10-22 决策：本地静态题库不再参与运行时出题。mock 模式不再伪造题目，
// 出题一律明确报错，联调请将 api/env.uts 的 API_ENV 切到 'dev' / 'prod' 连接线上题库。
import {
  QuestionItem,
  InterviewMode,
  SessionRef,
  AnswerAck,
  PositionBlueprint
} from '../../types/interview.uts'

export function mockCreateSession(_position: string): Promise<SessionRef> {
  return Promise.resolve({ sessionId: 'mock-' + Date.now() } as SessionRef)
}

export function mockNextQuestion(
  _sessionId: string,
  _mode: InterviewMode,
  _blueprint: PositionBlueprint
): Promise<QuestionItem> {
  return Promise.reject(new Error('本地静态题库已下线，请将 API_ENV 切换为 dev/prod 连接线上题库'))
}

export function mockSubmitAnswer(
  _sessionId: string,
  _questionId: string,
  _text: string
): Promise<AnswerAck> {
  return Promise.resolve({ ok: true } as AnswerAck)
}
