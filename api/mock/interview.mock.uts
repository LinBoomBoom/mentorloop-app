// 面试 mock 数据（无后端时本地跑通流程）
// 选题已接入题目选择器 v2（engine/question-selector.uts），按会话记录已答题目，
// 并根据 blueprint.positionId / experienceLevel 做岗位过滤与难度过滤。
import {
  QuestionItem,
  InterviewMode,
  SessionRef,
  AnswerAck,
  PositionBlueprint
} from '../../types/interview.uts'
import { selectNext, getModeBudget, SelectorInput } from '../../engine/question-selector.uts'

export function mockCreateSession(_position: string): Promise<SessionRef> {
  return Promise.resolve({ sessionId: 'mock-' + Date.now() } as SessionRef)
}

// 每个会话的已答题目记录（mock 层内部状态）
type SessionAskedMap = { [key: string]: QuestionItem[] }
const sessionAsked: SessionAskedMap = {}

// 默认简历关键词（mock 阶段固定给一个"订单系统"，简历解析接入后由外部传入）
const DEFAULT_RESUME_TOPICS: string[] = ['订单系统', '性能优化', '架构设计']

export function mockNextQuestion(
  sessionId: string,
  mode: InterviewMode,
  blueprint: PositionBlueprint
): Promise<QuestionItem> {
  let asked: QuestionItem[] = sessionAsked[sessionId]
  if (asked == null) asked = []
  const budget = getModeBudget(mode)
  // mock 下按已答题数估算剩余时间（单题约 150 秒）
  const remainSeconds = budget.totalSeconds - asked.length * 150
  const input: SelectorInput = {
    blueprint: blueprint,
    mode: mode,
    asked: asked,
    remainSeconds: remainSeconds,
    resumeRiskTopics: DEFAULT_RESUME_TOPICS
  } as SelectorInput
  const out = selectNext(input)
  if (out == null) {
    return Promise.reject(new Error('面试题目已收束'))
  }
  asked.push(out.question)
  sessionAsked[sessionId] = asked
  return Promise.resolve(out.question)
}

export function mockSubmitAnswer(
  _sessionId: string,
  _questionId: string,
  _text: string
): Promise<AnswerAck> {
  return Promise.resolve({ ok: true } as AnswerAck)
}
