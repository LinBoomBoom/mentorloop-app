// 报告 mock（mock 模式下从本地 reportHistory 取最新/指定 sessionId 的报告）
// 若尚无报告（用户从未完成面试），返回一份空报告供页面显示空状态。
import { InterviewReport, DimensionScore, TrainingTask } from '../../types/scoring.uts'
import { reportHistory } from '../../store/report-history.uts'

const EMPTY: InterviewReport = {
  overall: '',
  strongest: '',
  topPriority: '',
  dimensions: [] as DimensionScore[],
  riskQuestions: [] as string[],
  trainingPlan: [] as TrainingTask[]
} as InterviewReport

export function mockGetReport(sessionId: string): Promise<InterviewReport> {
  // 加载 history（确保跨页面可见；summary 页已经 push，这里再 load 一次是幂等的）
  reportHistory.load()

  if (sessionId === 'latest' || sessionId === 'mock') {
    const latest = reportHistory.latest()
    if (latest != null) return Promise.resolve(latest.report)
    return Promise.resolve(EMPTY)
  }

  const all = reportHistory.all()
  for (let i = 0; i < all.length; i++) {
    if (all[i].sessionId === sessionId) return Promise.resolve(all[i].report)
  }
  return Promise.resolve(EMPTY)
}
