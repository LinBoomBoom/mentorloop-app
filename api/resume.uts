// 简历解析 / 优化接口（来源文档 02 §2.4）
import { post, get, del, useMock } from './client.uts'
import { CLOUD_ENV_ID } from './env.uts'
import { userStore } from '../store/user-profile.uts'
import { quotaStore } from '../store/quota.uts'
import { mockParseResume, mockOptimizeResume } from './mock/resume.mock.uts'
import {
  ResumeAnnotateResult,
  ResumeHistoryItem,
  ResumeParseResponse,
  ResumeQuota,
  ResumeSuggestion
} from '../types/resume.uts'

// MP-WEIXIN：把本地选中的简历文件真实上传到微信云存储，返回可直接交付服务端的 fileID
// 为什么走 wx.cloud.uploadFile 而不是 uni.uploadFile：后者受「上传合法域名」白名单约束，
// 而云托管默认公网域名不能配到小程序后台（个人主体也无备案域名）；
// wx.cloud 走私有链路，仅凭环境 ID 即可，无需任何域名配置（官方社区明确口径）。
export async function uploadResumeFile(filePath: string, ext: string): Promise<string> {
  if (useMock()) {
    // Mock 环境：不真实上传，返回本地路径占位
    return filePath
  }
  const g = globalThis as any
  if (g.wx == null || g.wx.cloud == null || g.wx.cloud.uploadFile == null) {
    // 非小程序平台（App/H5）：沿用原有本地路径语义
    return filePath
  }
  // 路径必须带 uid 段：服务端凭此做属主校验；无 uid 时不上云，走本地路径语义
  const uid = userStore.profile.uid
  if (uid.length === 0) {
    return filePath
  }
  const cloudPath =
    'resumes/' +
    uid +
    '/' +
    Date.now().toString() +
    '-' +
    Math.floor(Math.random() * 100000) +
    '.' +
    ext
  return new Promise<string>((resolve, reject) => {
    g.wx.cloud.uploadFile({
      cloudPath: cloudPath,
      filePath: filePath,
      config: { env: CLOUD_ENV_ID },
      success: (res: any) => {
        const id = res != null && res.fileID != null ? String(res.fileID) : ''
        if (id.length === 0) {
          reject(new Error('RESUME_UPLOAD_NO_FILEID'))
        } else {
          resolve(id)
        }
      },
      fail: (e: any) => {
        reject(new Error(e != null && e.errMsg != null ? String(e.errMsg) : 'RESUME_UPLOAD_FAILED'))
      }
    } as any)
  })
}

export async function parseResume(
  fileUrl: string,
  fileName: string,
  position: string
): Promise<ResumeParseResponse> {
  if (useMock()) return await mockParseResume(fileUrl, fileName, position)
  const r = await post('/resume/parse', {
    fileUrl: fileUrl,
    fileName: fileName,
    position: position
  })
  return r.data as ResumeParseResponse
}

// 历史列表 / 详情 / 删除 / 额度（服务端权威账本）
export async function fetchResumeHistory(limit: number = 20): Promise<ResumeHistoryItem[]> {
  if (useMock()) return [] as ResumeHistoryItem[]
  const r = await get('/resume/history', { limit: limit })
  const d = r.data as any
  const items = d != null && d.items != null ? (d.items as ResumeHistoryItem[]) : []
  return items
}

export async function fetchResumeDetail(resumeId: string): Promise<ResumeParseResponse | null> {
  if (useMock()) return await mockParseResume('mock', 'demo-resume.pdf', '')
  const r = await get('/resume/detail', { resumeId: resumeId })
  return r.data != null ? (r.data as ResumeParseResponse) : null
}

export async function deleteResumeRecord(resumeId: string): Promise<void> {
  if (useMock()) return
  await del('/resume/detail?resumeId=' + encodeURIComponent(resumeId))
}

export async function fetchResumeQuota(): Promise<ResumeQuota> {
  if (useMock()) {
    const member = quotaStore.isMember()
    const single = quotaStore.state.resumeCreditsLeft
    const memberLeft = member ? 5 : 0
    return {
      memberMonthlyTotal: 5,
      memberMonthlyLeft: memberLeft,
      singleLeft: single,
      freePreviewLeftToday: 3,
      canFull: memberLeft > 0 || single > 0
    } as ResumeQuota
  }
  const r = await get('/resume/quota', null)
  return r.data as ResumeQuota
}

export async function optimizeResume(text: string, position: string): Promise<ResumeSuggestion[]> {
  if (useMock()) return await mockOptimizeResume(text, position)
  const r = await post('/resume/optimize', { text: text, position: position })
  return r.data as ResumeSuggestion[]
}

// 批注版 PDF 导出（批次 2）：仅完整评审可导出；服务端生成并返回 cloud:// fileID
export async function annotateResume(resumeId: string): Promise<ResumeAnnotateResult> {
  if (useMock()) {
    return {
      fileID: 'mock://annotated-' + resumeId + '.pdf',
      expiresAt: Date.now() + 24 * 3600 * 1000,
      issueCount: 2,
      pages: 2
    } as ResumeAnnotateResult
  }
  const r = await post('/resume/annotate', { resumeId: resumeId })
  return r.data as ResumeAnnotateResult
}

// 打开/保存已生成的批注 PDF：MP 走 wx.cloud 下载后 openDocument；其它端尽力而为
export function openAnnotatedPdf(fileID: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    const g = globalThis as any
    if (fileID.indexOf('cloud://') === 0 && g.wx != null && g.wx.cloud != null) {
      g.wx.cloud.downloadFile({
        fileID: fileID,
        success: (res: any) => {
          const path = res != null && res.tempFilePath != null ? String(res.tempFilePath) : ''
          if (path.length === 0) {
            resolve(false)
            return
          }
          g.wx.openDocument({
            filePath: path,
            fileType: 'pdf',
            showMenu: true,
            success: () => resolve(true),
            fail: () => resolve(false)
          })
        },
        fail: () => resolve(false)
      } as any)
      return
    }
    // 非小程序端：交给平台打开（App 由系统接管；失败由调用方提示）
    uni.openDocument({
      filePath: fileID,
      fileType: 'pdf',
      showMenu: true,
      success: () => resolve(true),
      fail: () => resolve(false)
    })
  })
}
