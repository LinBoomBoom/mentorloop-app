// 会员与支付 API（M2「支付与会员」；文档 01 §6 商业模式）
// Mock 优先：BASE_URL 为空时本地发放权益（store/quota.uts）；接真后端走微信支付。
// 契约（待后端双签）：
//   POST /membership/order        创建订单 → { orderId, payParams }
//   GET  /membership/quota        查询权益与余量 → QuotaState
//   POST /membership/order/notify 服务端回调（客户端不直接调用）

import { requestSilent, makeOptions, get, useMock } from './client.uts'
import { quotaStore } from '../store/quota.uts'
import { SkuId } from '../data/membership.uts'
import { trackEvent } from './tracking.uts'
import { loginByWechat } from './auth.uts'
import { userStore, UserProfilePatch } from '../store/user-profile.uts'
import {
  describeVirtualPayError,
  isSessionExpiredCode,
  isDuplicateOrderCode,
  isWechatVersionAtLeast
} from './virtual-pay.uts'

export type PayParams = {
  // 微信小程序：wx.requestPayment 参数；App：uni.requestPayment（微信 App 支付）参数
  provider: string // 'wxpay'
  orderId: string
  prepayId: string
  nonceStr: string
  timeStamp: string
  sign: string
}

export type OrderResult = {
  orderId: string
  payParams: PayParams | null // Mock 环境为 null（直接发放）
}

// 未绑定手机号（服务端业务码 40902）：调用方应打开绑定半屏层，而不是走「重登重试」
export const PHONE_REQUIRED = 'PHONE_REQUIRED'

// 服务端下单（静默：错误由调用方统一提示，避免与页内 toast 重复）
async function createRemoteOrder(skuId: SkuId, platform: string): Promise<any> {
  const res = await requestSilent(
    '/membership/order',
    makeOptions('POST', { skuId: skuId, platform: platform })
  )
  const data = res.data
  if (data == null) throw new Error('订单创建失败')
  return data
}

// 创建订单并发起支付。成功后本地发放权益（Mock）或等待服务端回调（真后端）。
export async function purchase(
  skuId: SkuId,
  skuKind: 'member' | 'single' | 'resume'
): Promise<OrderResult> {
  if (useMock()) {
    // Mock：模拟 800ms 支付延迟后直接发放
    await new Promise<void>((resolve) => {
      setTimeout(() => {
        resolve()
      }, 800)
    })
    quotaStore.grant(skuKind, skuId)
    trackEvent('payment_success', { sku: skuId, amount: 0, mock: true })
    return { orderId: 'mock_' + Date.now().toString(), payParams: null } as OrderResult
  }

  // 端侧分流（契约 §3，必填）：MP 端 mp-weixin，其余 app；服务端按此选择 PAY_MODE / MP_PAY_MODE
  let platform = 'app'
  // #ifdef MP-WEIXIN
  platform = 'mp-weixin'
  // #endif

  // 最多两次：首次 + 「会话过期 / 单号重复」时重试一次（契约 §5.2）
  let attempt = 0
  while (attempt < 2) {
    let data: any = null
    try {
      data = await createRemoteOrder(skuId, platform)
    } catch (e: any) {
      // 服务端 409 分两种：40902 未绑定手机号（打开绑定层）；其余为 session_key 缺失/过期（重登后重试一次）
      const sc = e != null && e.statusCode != null ? Number(e.statusCode) : 0
      const bizCode = e != null && e.code != null ? Number(e.code) : 0
      if (bizCode === 40902) throw new Error(PHONE_REQUIRED)
      if (sc === 409 && attempt === 0) {
        await refreshWechatSession()
        attempt++
        continue
      }
      throw e
    }

    if (data.payParams == null) {
      // 服务端 mock 支付已发放权益：本地不再 grant，直接对账同步账本
      trackEvent('payment_success', { sku: skuId, orderId: data.orderId, mock: true })
      await fetchQuota()
      return { orderId: data.orderId, payParams: null } as OrderResult
    }

    const p: any = data.payParams
    if (p.provider === 'virtual') {
      // ok 标志让「非 MP 端」与「本端拉起成功」共用一个可读分支，避免条件编译产生不可达代码
      let virtualOk = false
      // #ifdef MP-WEIXIN
      try {
        await requestVirtualPay(p)
        virtualOk = true
      } catch (e: any) {
        const code = e != null && e.errCode != null ? Number(e.errCode) : 0
        const msg = e != null && e.message != null ? String(e.message) : '支付未完成'
        if ((isSessionExpiredCode(code) || isDuplicateOrderCode(code)) && attempt === 0) {
          if (isSessionExpiredCode(code)) await refreshWechatSession()
          attempt++
          continue
        }
        throw new Error(msg)
      }
      // #endif
      if (!virtualOk) throw new Error('虚拟支付仅支持微信小程序端')
      await fetchQuota()
      trackEvent('payment_success', { sku: skuId, orderId: data.orderId })
      return { orderId: data.orderId, payParams: null } as OrderResult
    }

    await requestWxPay(data.payParams as PayParams)
    // 服务端回调可能滞后，用服务端账本兜底对账
    await fetchQuota()
    trackEvent('payment_success', { sku: skuId, orderId: data.orderId })
    return { orderId: data.orderId, payParams: data.payParams } as OrderResult
  }
  throw new Error('支付未完成，请重试')
}

// 微信会话刷新（仅 MP）：wx.login 取 code → /auth/wechat 换新 token（同时刷新服务端 session_key）
// 服务端在带 token 时会把微信身份绑定到当前账号（uid 不变）；若仍返回了不同 uid
// （该微信已属于另一个账号），同步 uid/昵称，避免 token 与本地画像错位。
async function refreshWechatSession(): Promise<void> {
  // #ifdef MP-WEIXIN
  const code = await new Promise<string>((resolve, reject) => {
    uni.login({
      provider: 'weixin',
      success: (res: any) => {
        const c = res != null && res.code != null ? String(res.code) : ''
        resolve(c)
      },
      fail: () => {
        reject(new Error('微信登录失败，请重试'))
      }
    })
  })
  if (code.length === 0) throw new Error('微信登录失败，请重试')
  const r = await loginByWechat(code)
  const patch: UserProfilePatch = {
    uid: r.uid,
    nickname: r.nickname,
    token: r.token
  } as UserProfilePatch
  userStore.setProfile(patch)
  userStore.persist()
  // #endif
}

// 拉起虚拟支付（仅 MP）：基础库 ≥ 2.19.2（canIUse 判定）；iOS 需微信 ≥ 8.0.68
// #ifdef MP-WEIXIN
function requestVirtualPay(p: any): Promise<void> {
  return new Promise<void>((resolve, reject) => {
    const g = globalThis as any
    const wxApi = g.wx
    if (wxApi == null) {
      reject(new Error('微信能力不可用，请升级微信后重试'))
      return
    }
    if (wxApi.canIUse == null || !wxApi.canIUse('requestVirtualPayment')) {
      reject(new Error('当前微信版本不支持虚拟支付，请升级微信后重试'))
      return
    }
    if (wxApi.getSystemInfoSync != null) {
      const sys = wxApi.getSystemInfoSync()
      if (sys != null && sys.platform === 'ios') {
        const ver = sys.version != null ? String(sys.version) : ''
        if (!isWechatVersionAtLeast(ver, '8.0.68')) {
          reject(new Error('请将微信更新至 8.0.68 及以上版本后再支付'))
          return
        }
      }
    }
    wxApi.requestVirtualPayment({
      mode: p.mode,
      signData: p.signData,
      paySig: p.paySig,
      signature: p.signature,
      success: () => {
        resolve()
      },
      fail: (err: any) => {
        const code = err != null && err.errCode != null ? Number(err.errCode) : 0
        const rawMsg = err != null && err.errMsg != null ? String(err.errMsg) : ''
        // 保留原始 errMsg：-15005/-15006 等签名类错误需从工具/真机日志定位
        console.warn('[virtual-pay] fail errCode=' + code + ' errMsg=' + rawMsg)
        const msg = describeVirtualPayError(code)
        const e: any = { message: msg, errCode: code }
        reject(e as any)
      }
    })
  })
}
// #endif

// 拉起微信支付（小程序 + App 微信支付统一封装）
function requestWxPay(p: PayParams): Promise<void> {
  return new Promise<void>((resolve, reject) => {
    uni.requestPayment({
      provider: 'wxpay',
      orderInfo: p.prepayId,
      timeStamp: p.timeStamp,
      nonceStr: p.nonceStr,
      package: 'prepay_id=' + p.prepayId,
      signType: 'RSA',
      paySign: p.sign,
      success: () => {
        resolve()
      },
      fail: (err: any) => {
        const msg = err != null && err.errMsg != null ? String(err.errMsg) : '支付未完成'
        reject(new Error(msg))
      }
    } as any)
  })
}

// 查询权益与余量（真后端以服务端为准；Mock 返回本地账本）
export async function fetchQuota(): Promise<void> {
  if (useMock()) return
  const res = await get('/membership/quota')
  const data = res.data as {
    freeInterviewsLeft: number
    singleCreditsLeft: number
    memberUntil: number
  } | null
  if (data != null) {
    quotaStore.state.freeInterviewsLeft = data.freeInterviewsLeft
    quotaStore.state.singleCreditsLeft = data.singleCreditsLeft
    quotaStore.state.memberUntil = data.memberUntil
    quotaStore.persist()
  }
}
