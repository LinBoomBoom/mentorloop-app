// 语音感知层统一入口（M1 真实感知层）
// 职责：TTS 播放（面试官念题）、录音管理（作答采集）、ASR 转写、能力探测
// 平台策略：
//   - MP-WEIXIN：微信同声传译插件（WechatSI）做 TTS + 实时语音识别；RecorderManager 录音
//   - APP（Android/iOS）：RecorderManager 录音 + 云端 ASR 通道（api/asr.uts）；
//     TTS 原生层待补（uts 插件，走 utssdk 边界），当前降级字幕模式（uni-app x 已移除 plus）
//   - H5：无原生录音/播放能力，降级为文字作答（不报错）
// 约束（文档 04）：音频帧不进响应式状态；转写仅显示稳定文本；失败不静默丢答案。

export type SpeechCapability = {
  tts: boolean // 是否支持 TTS 播放
  asr: boolean // 是否支持语音识别
  record: boolean // 是否支持录音
  platform: string // mp-weixin | app | h5
}

export type TtsHandle = {
  stop: () => void
}

// ---------------- 能力探测 ----------------

let cachedCapability: SpeechCapability | null = null

export function speechCapability(): SpeechCapability {
  if (cachedCapability != null) return cachedCapability
  let platform = 'h5'
  let tts = false
  let asr = false
  let record = false
  // #ifdef MP-WEIXIN
  platform = 'mp-weixin'
  tts = true
  asr = true
  record = true
  // #endif
  // #ifdef APP-PLUS || APP
  platform = 'app'
  tts = true
  asr = true
  record = true
  // #endif
  cachedCapability = { tts: tts, asr: asr, record: record, platform: platform } as SpeechCapability
  return cachedCapability
}

// ---------------- TTS 播放（面试官念题） ----------------

// 播放状态回调（驱动面试官语音状态）
let ttsStateCb: ((state: 'start' | 'end') => void) | null = null

export function onTtsState(cb: (state: 'start' | 'end') => void) {
  ttsStateCb = cb
}

function emitTtsState(state: 'start' | 'end') {
  const cb = ttsStateCb
  if (cb != null) cb(state)
}

// 静默降级：无 TTS 引擎时按文本长度估算播报时长后结束（字幕承担全部信息，不阻塞流程）
function speakSilent(text: string): TtsHandle {
  console.warn('[speech] TTS 引擎未就绪，降级为字幕模式，长度', text.length)
  emitTtsState('start')
  const estimateMs = Math.min(12000, 1000 + text.length * 150)
  setTimeout(() => {
    emitTtsState('end')
  }, estimateMs)
  const handle: TtsHandle = {
    stop: () => {}
  } as TtsHandle
  return handle
}

// 播放 TTS；返回句柄（可 stop）。
// onUnavailable：本次未能真实出声（合成失败/超时/播放错误/平台不支持）时回调一次。
// 房间页据此明示「语音播报暂不可用」，不允许静默降级（2026-10-23 真机反馈）。
export function speak(text: string, onUnavailable?: () => void): TtsHandle {
  let handle: TtsHandle | null = null
  // #ifdef MP-WEIXIN
  handle = speakWeixin(text, onUnavailable)
  // #endif
  // #ifndef MP-WEIXIN || APP-PLUS || APP
  handle = speakSilent(text)
  if (onUnavailable != null) onUnavailable()
  // #endif
  if (handle == null) {
    if (onUnavailable != null) onUnavailable()
    return speakSilent(text)
  }
  return handle
}

// #ifdef MP-WEIXIN
// 微信同声传译插件（实时 ASR 用；manifest 未声明时 requirePlugin 抛错 → 返回 null 走降级）
let pluginTranslator: any = null
let pluginRequireTried = false

function getWechatSI(): any {
  if (pluginTranslator != null) return pluginTranslator
  if (pluginRequireTried) return null
  pluginRequireTried = true
  try {
    const g = globalThis as any
    const requirePluginFn = g.requirePlugin
    if (requirePluginFn == null) {
      console.warn('[speech] requirePlugin 不可用，实时识别降级')
      return null
    }
    pluginTranslator = requirePluginFn('wechatSI')
    return pluginTranslator
  } catch {
    console.warn('[speech] wechatSI 插件未声明，实时识别降级')
    return null
  }
}

// 微信端 TTS：服务端腾讯云合成 → 云存储 fileID → 云 SDK 下载为本地临时文件 → InnerAudioContext 播放
// 不直接用 cloud:// 或临时链接播放：iOS 真机上前者报 audioInstance is not set，
// 后者拉流报 INNERERRCODE:-1001 请求超时（2026-10-23 真机）；本地文件播放已验证可用。
// 任一步失败 → 回退 speakSilent（只字幕），面试流程不阻塞、不弹错误
// 必须大于服务端 TTS 预算（server/src/services/tts.ts TTS_TIMEOUT_MS = 20s），
// 否则客户端会先放弃、服务端随后才合成完 → 必然无声（2026-10-23 排查）
const TTS_REQUEST_TIMEOUT_MS = 22000

// 合成音频下载预算（云 SDK 私有链路，通常 1~2s）
const AUDIO_DOWNLOAD_TIMEOUT_MS = 15000

function downloadAudio(fileID: string): Promise<string> {
  if (fileID.indexOf('cloud://') !== 0) return Promise.resolve(fileID)
  return new Promise<string>((resolve) => {
    const g = globalThis as any
    if (g.wx == null || g.wx.cloud == null || g.wx.cloud.downloadFile == null) {
      console.warn('[speech] cloud.downloadFile 不可用，无法取回合成音频')
      resolve('')
      return
    }
    let settled = false
    const timer = setTimeout(() => {
      if (settled) return
      settled = true
      console.warn('[speech] 下载合成音频超时')
      resolve('')
    }, AUDIO_DOWNLOAD_TIMEOUT_MS)
    const settle = (path: string) => {
      if (settled) return
      settled = true
      clearTimeout(timer)
      resolve(path)
    }
    try {
      g.wx.cloud.downloadFile({
        fileID: fileID,
        config: { env: CLOUD_ENV_ID },
        success: (res: any) => {
          const p = res != null && res.tempFilePath != null ? String(res.tempFilePath) : ''
          if (p.length > 0) {
            console.log('[speech] 合成音频已下载到本地')
            settle(p)
          } else {
            console.warn('[speech] 下载结果无临时路径')
            settle('')
          }
        },
        fail: (e: any) => {
          console.warn('[speech] 下载合成音频失败', e)
          settle('')
        }
      } as any)
    } catch {
      settle('')
    }
  })
}

function speakWeixin(text: string, onUnavailable?: () => void): TtsHandle {
  // iOS 静音键默认会让小程序音频完全无声：播放前先关掉 obeyMuteSwitch
  devicePlugin.configureAudioPlayback()
  let stopped = false
  let audio: any = null
  let fallback: TtsHandle | null = null
  // 本次是否已告知调用方「没能真实出声」：一次播报只回调一次
  let unavailableNotified = false
  const notifyUnavailable = () => {
    if (unavailableNotified) return
    unavailableNotified = true
    if (onUnavailable != null) onUnavailable()
  }
  // 本次合成的云对象：播放结束/失败/主动停止时回收，避免云存储堆积
  let currentFileID = ''
  const ackCurrent = () => {
    const id = currentFileID
    currentFileID = ''
    if (id.length > 0) ackTts(id)
  }
  const timer = setTimeout(() => {
    // 合成超时：降级为字幕，并明确告知调用方（不再静默）
    if (!stopped && audio == null && fallback == null) {
      notifyUnavailable()
      fallback = speakSilent(text)
    }
  }, TTS_REQUEST_TIMEOUT_MS)

  const destroyAudio = () => {
    if (audio == null) return
    try {
      audio.stop()
      audio.destroy()
    } catch {
      // 忽略销毁异常
    }
    audio = null
  }

  requestTts(text)
    .then((r) => {
      if (stopped) {
        // 已停止（换题/退出）后才合成完成：直接回收对象，不播放
        if (r.fileID.length > 0) ackTts(r.fileID)
        return
      }
      if (r.fileID.length === 0) {
        // 服务端明确降级（缺密钥/写存储失败）：回退字幕模式，并明示不可用
        // provider=stub 说明云端 TTS_PROVIDER 未配置；provider=tencent 则查密钥与云存储
        console.warn('[speech] TTS 降级，provider=' + r.provider + ' chars=' + r.chars)
        notifyUnavailable()
        fallback = speakSilent(text)
        return
      }
      // 合成已完成：后续是换链接与播放，不应再按「合成超时」降级
      clearTimeout(timer)
      currentFileID = r.fileID
      if (fallback != null) {
        // 已因超时降级，放弃本次播放并回收
        ackCurrent()
        return
      }
      downloadAudio(r.fileID).then((src) => {
        if (stopped || fallback != null) {
          ackCurrent()
          return
        }
        if (src.length === 0) {
          // 取不回音频：明示无声并结束本次播报，不尝试不可达的远端播放
          notifyUnavailable()
          emitTtsState('end')
          ackCurrent()
          return
        }
        audio = uni.createInnerAudioContext()
        audio.src = src
        audio.onPlay(() => {
          if (!stopped) emitTtsState('start')
        })
        audio.onEnded(() => {
          if (!stopped) emitTtsState('end')
          destroyAudio()
          ackCurrent()
        })
        audio.onError((err: any) => {
          // 播放失败不阻塞面试：字幕已展示题目，但要明确告知无声
          const msg = err != null && err.errMsg != null ? String(err.errMsg) : 'unknown'
          console.warn('[speech] TTS 播放失败', msg)
          notifyUnavailable()
          if (!stopped) emitTtsState('end')
          destroyAudio()
          ackCurrent()
        })
        audio.play()
      })
    })
    .catch((e: any) => {
      if (stopped || fallback != null) return
      const msg = e != null && e.message != null ? String(e.message) : 'unknown'
      console.warn('[speech] TTS 请求失败，回退字幕模式', msg)
      notifyUnavailable()
      fallback = speakSilent(text)
    })

  const handle: TtsHandle = {
    stop: () => {
      if (stopped) return
      stopped = true
      clearTimeout(timer)
      if (fallback != null) {
        fallback.stop()
        ackCurrent()
        return
      }
      destroyAudio()
      ackCurrent()
      emitTtsState('end')
    }
  } as TtsHandle
  return handle
}
// #endif

// App 端 TTS：uni-app x 已移除 plus API，原生层待以 uts 插件补齐（utssdk 边界）；
// 未补齐前经 speak() 的 null 兜底降级为 speakSilent（字幕承担全部信息）。

// ---------------- 录音管理（作答采集） ----------------

export type RecordResult = {
  ok: boolean
  audioPath: string
  errMsg: string
}

export type RecordCallbacks = {
  onStart: () => void
  onStop: (result: RecordResult) => void
  onError: (errMsg: string) => void
}

// P2-9：Android 原生录音增强（降噪/音频焦点/中断恢复）。
// 经 audioPlugin.init() 成功后走原生路径；失败/非 Android 回退 uni.getRecorderManager。
import { audioPlugin, AudioRecordConfig } from '../utssdk/interviewer-audio/index.uts'
// P2-10：实时音频通道（WS 传输/断线重连/缓冲），App 端流式识别依托该通道。
import { realtimePlugin, RealtimeConfig } from '../utssdk/interviewer-realtime/index.uts'
import { BASE_URL, useMock } from './client.uts'
import { CLOUD_ENV_ID } from './env.uts'
import { userStore } from '../store/user-profile.uts'
// 注意：必须静态导入。uni-app x 的 mp-weixin 编译不支持动态 import()——
// `import('./tts.uts')` 会被编译成字符串字面量 `"./tts.js".then(...)`，
// 运行即抛 TypeError，TTS 整条链路失效（2026-10-20 真机无声根因）。
import { requestTts, ackTts } from './tts.uts'
// 播放策略（iOS 静音键）与录音文件自检复用设备插件，避免各页面各写一份
import { devicePlugin } from '../utssdk/interviewer-device/index.uts'

// 录音器封装：单例 RecorderManager，回调式 API
export class SpeechRecorder {
  private recorder: any = null
  private ready = false
  private cb: RecordCallbacks | null = null
  private recording = false
  private enhanced = false

  isReady(): boolean {
    return this.ready
  }

  isRecording(): boolean {
    return this.recording
  }

  // 初始化（平台不支持时 ready=false，调用方走文字降级）
  init(cb: RecordCallbacks) {
    this.cb = cb
    let inited = false
    // #ifdef MP-WEIXIN || APP-PLUS || APP
    try {
      this.recorder = uni.getRecorderManager()
      this.recorder.onStart(() => {
        this.recording = true
        const c = this.cb
        if (c != null) c.onStart()
      })
      this.recorder.onStop((res: any) => {
        this.recording = false
        const filePath = res != null && res.tempFilePath != null ? (res.tempFilePath as string) : ''
        const c = this.cb
        if (c != null) {
          c.onStop({ ok: filePath.length > 0, audioPath: filePath, errMsg: '' } as RecordResult)
        }
      })
      this.recorder.onError((err: any) => {
        this.recording = false
        const msg = err != null && err.errMsg != null ? String(err.errMsg) : '录音失败'
        const c = this.cb
        if (c != null) c.onError(msg)
      })
      inited = true
    } catch {
      inited = false
    }
    // P2-9：Android 原生增强初始化（异步就绪；失败不影响既有 RecorderManager 路径）
    // #ifdef APP-PLUS || APP
    audioPlugin
      .init()
      .then((ok: boolean) => {
        this.enhanced = ok
        if (ok) {
          // 中断事件由原生层自动暂停/恢复，此处仅记录（UI 提示归设备诊断/状态层）
          audioPlugin.setInterruptListener((_e) => {
            console.warn('[speech] 音频焦点中断事件', _e)
          })
        }
      })
      .catch((_e: any) => {
        this.enhanced = false
      })
    // #endif
    // #endif
    this.ready = inited
  }

  start() {
    if (!this.ready || this.recording) return
    // #ifdef APP-PLUS || APP
    if (this.enhanced) {
      const cfg = {
        format: 'm4a',
        sampleRate: 16000,
        channels: 1,
        encodeBitRate: 48000,
        enableNoiseSuppression: true
      } as AudioRecordConfig
      const ok = audioPlugin.startRecord(cfg)
      if (ok) {
        this.recording = true
        const c = this.cb
        if (c != null) c.onStart()
      } else {
        const c = this.cb
        if (c != null) c.onError('录音启动失败')
      }
      return
    }
    // #endif
    try {
      // 16k 单声道 mp3：云端 ASR 通用格式。
      // duration 55s：微信 ASR 硬限 60s / 1MB，留 5s 余量；到点平台自动 stop（onStop 统一收口）。
      // App 原生增强路径无 duration 参数，由房间页计时兜底自动停止。
      this.recorder.start({
        format: 'mp3',
        sampleRate: 16000,
        numberOfChannels: 1,
        encodeBitRate: 48000,
        duration: 55000
      })
    } catch {
      const c = this.cb
      if (c != null) c.onError('录音启动失败')
    }
  }

  stop() {
    if (!this.ready || !this.recording) return
    // #ifdef APP-PLUS || APP
    if (this.enhanced) {
      this.recording = false
      audioPlugin
        .stopRecord()
        .then((path: string) => {
          const c = this.cb
          if (c != null) {
            c.onStop({ ok: path.length > 0, audioPath: path, errMsg: '' } as RecordResult)
          }
        })
        .catch((_e: any) => {
          const c = this.cb
          if (c != null) c.onError('录音停止失败')
        })
      return
    }
    // #endif
    try {
      this.recorder.stop()
    } catch {
      this.recording = false
      const c = this.cb
      if (c != null) c.onError('录音停止失败')
    }
  }
}

// ---------------- ASR 转写 ----------------

export type AsrResult = {
  ok: boolean
  text: string
  errMsg: string
}

// 录音文件 → 文本。微信端用实时识别（见 startRealtimeAsr），App 端走云端通道（api/asr.uts）。
// 失败时返回 ok=false，调用方提示用户改用文字作答（不静默丢答案）。
export async function transcribe(audioPath: string): Promise<AsrResult> {
  let result: AsrResult = { ok: false, text: '', errMsg: '当前平台不支持语音识别' } as AsrResult
  // #ifdef MP-WEIXIN
  result = { ok: false, text: '', errMsg: '请使用实时识别' } as AsrResult
  // #endif
  // #ifdef APP-PLUS || APP
  result = await transcribeCloud(audioPath)
  // #endif
  return result
}

// #ifdef APP-PLUS || APP
async function transcribeCloud(audioPath: string): Promise<AsrResult> {
  try {
    const mod = await import('./asr.uts')
    const r = await mod.uploadAsr(audioPath)
    return { ok: true, text: r.text, errMsg: '' } as AsrResult
  } catch (e: any) {
    const msg = e != null && e.message != null ? String(e.message) : '转写服务不可用'
    return { ok: false, text: '', errMsg: msg } as AsrResult
  }
}
// #endif

// ---------------- 微信端实时语音识别（流式） ----------------

export type RealtimeAsrSession = {
  stop: () => void
}

// 微信端实时语音识别：边录边转，稳定文本回调 onText(stable=true)
// 仅 MP-WEIXIN 有效；其他平台返回 null（调用方走录音+文件转写或文字降级）
export function startRealtimeAsr(
  onText: (text: string, stable: boolean) => void
): RealtimeAsrSession | null {
  let session: RealtimeAsrSession | null = null
  // #ifdef MP-WEIXIN
  session = startRealtimeAsrWeixin(onText)
  // #endif
  // #ifdef APP-PLUS || APP
  session = startRealtimeAsrApp(onText)
  // #endif
  // #ifndef MP-WEIXIN || APP-PLUS || APP
  console.warn('[speech] 实时识别仅微信/App 端可用')
  // #endif
  return session
}

// #ifdef APP-PLUS || APP
// App 端流式识别：依托 realtime 通道（WS 传输 + 断线重连 + 缓冲）。
// 未配置/连接失败时返回可用的 session（内部降级），稳定文本为空即降级标记。
function startRealtimeAsrApp(
  onText: (text: string, stable: boolean) => void
): RealtimeAsrSession | null {
  // 懒配置：真后端模式从网关地址推导 ws 端点（未能配置则返回 null 走既有降级）
  if (!realtimePlugin.isConfigured() && !useMock() && BASE_URL.length > 0) {
    let wsUrl = BASE_URL
    if (wsUrl.indexOf('https://') === 0) {
      wsUrl = 'wss://' + wsUrl.substring(8)
    } else if (wsUrl.indexOf('http://') === 0) {
      wsUrl = 'ws://' + wsUrl.substring(7)
    }
    const cfg = {
      wsUrl: wsUrl + '/ws/realtime',
      token: userStore.profile.token,
      maxRetries: 3,
      reconnectBaseMs: 1200
    } as RealtimeConfig
    realtimePlugin.configure(cfg)
  }
  if (!realtimePlugin.isConfigured()) {
    console.warn('[speech] 实时通道未配置，App 端走录音文件转写')
    return null
  }
  let stopped = false
  realtimePlugin.onTranscript((text: string, stable: boolean) => {
    if (!stopped) onText(text, stable)
  })
  realtimePlugin.connect().then((ok: boolean) => {
    if (ok) {
      realtimePlugin.startStream('app-realtime')
    } else {
      onText('', true)
    }
  })
  const session: RealtimeAsrSession = {
    stop: () => {
      if (stopped) return
      stopped = true
      realtimePlugin.stopStream()
    }
  } as RealtimeAsrSession
  return session
}
// #endif

// #ifdef MP-WEIXIN
function startRealtimeAsrWeixin(
  onText: (text: string, stable: boolean) => void
): RealtimeAsrSession | null {
  const si = getWechatSI()
  if (si == null) return null
  try {
    const manager = si.createSpeechRecognizer != null ? si.createSpeechRecognizer() : si
    let stopped = false
    manager.onStart(() => {})
    manager.onRecognize((res: any) => {
      if (stopped) return
      const t = res != null && res.result != null ? String(res.result) : ''
      if (t.length > 0) onText(t, false)
    })
    manager.onStop((res: any) => {
      if (stopped) return
      const t = res != null && res.result != null ? String(res.result) : ''
      if (t.length > 0) onText(t, true)
    })
    manager.onerror(() => {
      if (stopped) return
      onText('', true)
    })
    manager.start({ lang: 'zh_CN' })
    const session: RealtimeAsrSession = {
      stop: () => {
        stopped = true
        try {
          manager.stop()
        } catch {
          // 忽略停止异常
        }
      }
    } as RealtimeAsrSession
    return session
  } catch {
    return null
  }
}
// #endif
