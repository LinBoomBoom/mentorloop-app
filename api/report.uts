// 评分与报告接口（来源文档 02 §3.4 / §2.5）
import { request, useMock, makeOptions } from './client.uts'
import { mockGetReport } from './mock/report.mock.uts'
import { InterviewReport } from '../types/scoring.uts'

export async function getReport(sessionId: string): Promise<InterviewReport> {
  if (useMock()) return await mockGetReport(sessionId)
  const r = await request('/report?sessionId=' + sessionId, makeOptions('GET', null))
  return r.data as InterviewReport
}
