// 面试会话编排接口（来源文档 04 服务端：会话编排 / 题目与追问）
import { request, useMock, makeOptions } from './client.uts'
import { mockCreateSession, mockNextQuestion, mockSubmitAnswer } from './mock/interview.mock.uts'
import {
  QuestionItem,
  InterviewMode,
  PositionBlueprint,
  SessionRef,
  AnswerAck
} from '../types/interview.uts'

export async function createSession(position: string): Promise<SessionRef> {
  if (useMock()) return await mockCreateSession(position)
  const r = await request('/interview/session', makeOptions('POST', { position: position }))
  return r.data as SessionRef
}

export async function nextQuestion(
  sessionId: string,
  mode: InterviewMode,
  blueprint: PositionBlueprint
): Promise<QuestionItem> {
  if (useMock()) return await mockNextQuestion(sessionId, mode)
  const r = await request('/interview/next?sessionId=' + sessionId, makeOptions('GET', null))
  return r.data as QuestionItem
}

export async function submitAnswer(
  sessionId: string,
  questionId: string,
  text: string
): Promise<AnswerAck> {
  if (useMock()) return await mockSubmitAnswer(sessionId, questionId, text)
  const r = await request(
    '/interview/answer',
    makeOptions('POST', { sessionId: sessionId, questionId: questionId, text: text })
  )
  return r.data as AnswerAck
}
