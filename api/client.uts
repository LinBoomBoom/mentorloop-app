// 统一请求客户端（双通道：MP-WEIXIN 走 wx.cloud.callContainer 云链路，其余 uni.request）
// Mock 优先：useMock() 为 true 时各 api 模块走 mock，不进此文件。
// 能力：token 注入、超时、统一业务码/HTTP 错误处理、401 自动登出、GET 参数序列化、失败事件入队（供补传）。

import { userStore } from '../store/user-profile.uts'
import { API_BASE_URL, CLOUD_ENV_ID, CLOUD_SERVICE_NAME, useMock } from './env.uts'

// 网关地址与 Mock 判定统一取自 api/env.uts（单一切换点）
export const BASE_URL: string = API_BASE_URL
export { useMock }
// 30s：云托管实例缩容到零后冷启动可能超过 15s，给首启请求留余量
export const REQUEST_TIMEOUT: number = 30000

export type RequestOptions = {
  method: 'GET' | 'POST' | 'PUT' | 'DELETE'
  data: any | null
  header: { [key: string]: string } | null
}

export type ApiResult = {
  code: number
  data: any
  message: string
}

// GET 参数序列化（处理空值 & encode）
function serializeQuery(params: { [key: string]: any } | null): string {
  if (params == null) return ''
  const parts: string[] = []
  const keys = Object.keys(params)
  for (let i = 0; i < keys.length; i++) {
    const k = keys[i]
    const v = params[k]
    if (v == null) continue
    parts.push(encodeURIComponent(k) + '=' + encodeURIComponent(String(v)))
  }
  if (parts.length === 0) return ''
  return '?' + parts.join('&')
}

// 统一构造请求头：Content-Type + Authorization
function buildHeaders(custom: { [key: string]: string } | null): { [key: string]: string } {
  const h: { [key: string]: string } = {
    'Content-Type': 'application/json'
  }
  const token = userStore.profile.token
  if (token.length > 0) {
    h['Authorization'] = 'Bearer ' + token
  }
  if (custom != null) {
    const keys = Object.keys(custom)
    for (let i = 0; i < keys.length; i++) {
      h[keys[i]] = custom[keys[i]]
    }
  }
  return h
}

// 401/业务未登录：清态并跳登录
function handleUnauthorized() {
  userStore.logout()
  uni.showToast({ title: '登录已过期，请重新登录', icon: 'none' })
  // #ifdef APP
  setTimeout(() => {
    uni.navigateTo({ url: '/pages/login/login' })
  }, 800)
  // #endif
}

// 双通道共享的响应映射（冻结 §4.1：callContainer 与 uni.request 行为一致）
// silent=true 时不弹任何 toast（埋点等后台任务用），错误仍通过 reject 传递
function handleResponse(
  res: any,
  resolve: (r: ApiResult) => void,
  reject: (e: Error) => void,
  silent: boolean
) {
  const statusCode = res.statusCode as number

  // HTTP 401 → 清态
  if (statusCode === 401) {
    handleUnauthorized()
    reject(new Error('UNAUTHORIZED'))
    return
  }
  if (statusCode < 200 || statusCode >= 300) {
    const msg = '网络异常（' + statusCode + '）'
    if (!silent) uni.showToast({ title: msg, icon: 'none' })
    reject(new Error(msg))
    return
  }

  const body = res.data as ApiResult | null
  if (body == null) {
    const msg = '响应为空'
    if (!silent) uni.showToast({ title: msg, icon: 'none' })
    reject(new Error(msg))
    return
  }

  // 业务码：0/200 成功；其余按业务错误处理
  if (body.code === 0 || body.code === 200) {
    resolve(body)
    return
  }
  // 业务 401（网关可能以 body 返回）
  if (body.code === 401 || body.code === 40001) {
    handleUnauthorized()
    reject(new Error('UNAUTHORIZED'))
    return
  }
  const msg = body.message.length > 0 ? body.message : '请求失败（' + body.code + '）'
  if (!silent) uni.showToast({ title: msg, icon: 'none' })
  reject(new Error(msg))
}

// 双通道共享的失败处理（silent=true 时静默：埋点失败只入队，不打扰用户）
function handleFail(err: any, reject: (e: Error) => void, silent: boolean) {
  const errMsg = err != null && err.errMsg != null ? String(err.errMsg) : '网络不可用'
  if (!silent) {
    // 超时 / 网络断开时提示（不把事件丢失，后续可从 pendingEvents 重放）
    uni.showToast({ title: '网络连接失败，答案已本地保存', icon: 'none' })
  }
  reject(new Error(errMsg))
}

// 云链路：wx.cloud.callContainer（仅 MP-WEIXIN 非 mock）
// path 无 /api 前缀（服务端 Fastify 根路径）；callContainer 私有链路自动注入
// X-WX-OPENID 等请求头（冻结 §2.2），无需客户端传 openid。
// #ifdef MP-WEIXIN
function requestCloud(
  path: string,
  options: RequestOptions,
  query: { [key: string]: any } | null,
  silent: boolean
): Promise<ApiResult> {
  return new Promise<ApiResult>((resolve, reject) => {
    const g = globalThis as any
    const wxApi = g.wx
    if (wxApi == null || wxApi.cloud == null || wxApi.cloud.callContainer == null) {
      const msg = '微信云能力不可用，请升级微信后重试'
      if (!silent) uni.showToast({ title: msg, icon: 'none' })
      reject(new Error(msg))
      return
    }
    wxApi.cloud.callContainer({
      config: { env: CLOUD_ENV_ID },
      name: CLOUD_SERVICE_NAME,
      path: path + serializeQuery(query),
      method: options.method,
      data: options.data,
      header: buildHeaders(options.header),
      timeout: REQUEST_TIMEOUT,
      success: (res: any) => {
        handleResponse(res, resolve, reject, silent)
      },
      fail: (err: any) => {
        handleFail(err, reject, silent)
      }
    })
  })
}
// #endif

// HTTP 链路：uni.request（App/H5；MP-WEIXIN mock 联调可临时切回）
function requestHttp(
  path: string,
  options: RequestOptions,
  query: { [key: string]: any } | null,
  silent: boolean
): Promise<ApiResult> {
  return new Promise<ApiResult>((resolve, reject) => {
    const url = BASE_URL + path + serializeQuery(query)
    const header = buildHeaders(options.header)

    uni.request({
      url: url,
      method: options.method as any,
      data: options.data,
      header: header,
      timeout: REQUEST_TIMEOUT,
      success: (res: any) => {
        handleResponse(res, resolve, reject, silent)
      },
      fail: (err: any) => {
        handleFail(err, reject, silent)
      }
    })
  })
}

export function request(
  path: string,
  options: RequestOptions,
  query: { [key: string]: any } | null = null
): Promise<ApiResult> {
  // #ifdef MP-WEIXIN
  if (!useMock()) {
    return requestCloud(path, options, query, false)
  }
  // #endif
  return requestHttp(path, options, query, false)
}

// 静默请求：不弹任何 toast（埋点等后台任务用），错误仍 reject
export function requestSilent(
  path: string,
  options: RequestOptions,
  query: { [key: string]: any } | null = null
): Promise<ApiResult> {
  // #ifdef MP-WEIXIN
  if (!useMock()) {
    return requestCloud(path, options, query, true)
  }
  // #endif
  return requestHttp(path, options, query, true)
}

// 微信云能力初始化（App.uvue onLaunch 首位调用；非 MP-WEIXIN 空实现）
export function initCloud(): void {
  // #ifdef MP-WEIXIN
  const g = globalThis as any
  if (g.wx != null && g.wx.cloud != null && g.wx.cloud.init != null) {
    try {
      g.wx.cloud.init({ env: CLOUD_ENV_ID, traceUser: false })
      console.log('[client] wx.cloud.init ok, env =', CLOUD_ENV_ID)
    } catch (e) {
      console.warn('[client] wx.cloud.init failed', e)
    }
  }
  // #endif
}

export function makeOptions(
  method: 'GET' | 'POST' | 'PUT' | 'DELETE',
  data: any | null,
  header: { [key: string]: string } | null = null
): RequestOptions {
  return { method: method, data: data, header: header } as RequestOptions
}

// 便捷方法：GET/POST/DELETE
export function get(path: string, query: { [key: string]: any } | null = null): Promise<ApiResult> {
  return request(path, makeOptions('GET', null), query)
}

export function post(path: string, data: any): Promise<ApiResult> {
  return request(path, makeOptions('POST', data))
}

export function del(path: string): Promise<ApiResult> {
  return request(path, makeOptions('DELETE', null))
}
