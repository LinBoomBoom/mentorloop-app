// 环境开关（P1.1：Mock ↔ 真后端单一切换点）
// 本地联调真后端：API_ENV 改为 'dev'，并填 API_BASE_URL（本地服务地址）。
// 回退 Mock：API_ENV 拨回 'mock' 即可全链路恢复。
//
// 上云对齐（冻结 §2.1）：API_ENV 按条件编译拨值——
// - MP-WEIXIN：'prod'，走 wx.cloud.callContainer 直连云托管（CLOUD_ENV_ID）
// - App / H5：'mock' 维持现状（BASE_URL 通道保留为公网兜底）
export type ApiEnv = 'mock' | 'dev' | 'prod'

// 条件编译拨值（契约 §2.1）：单声明 + MP-WEIXIN 赋值覆盖，避免重复声明触发 no-redeclare
export let API_ENV: ApiEnv = 'mock'
// #ifdef MP-WEIXIN
API_ENV = 'prod'
// #endif

// 微信云托管环境 ID（callContainer 目标环境，与桌面端内容后端同环境不同服务）
export const CLOUD_ENV_ID: string = 'prod-d6gaa83ds8accb61b'

// dev/prod 时填网关地址（本地联调示例：'http://127.0.0.1:8787'）
export const API_BASE_URL: string = ''

export function useMock(): boolean {
  return API_ENV === 'mock'
}

// 协议链接（LC 合规：备案后回填真实 URL；留空则客户端降级为 toast 提示）
export const AGREEMENT_URL: string = ''
export const PRIVACY_URL: string = ''
