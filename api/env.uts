// 环境开关（P1.1：Mock ↔ 真后端单一切换点）
// 本地联调真后端：API_ENV 改为 'dev'，并填 API_BASE_URL（本地服务地址）。
// 回退 Mock：API_ENV 拨回 'mock' 即可全链路恢复。
//
// 上云对齐（冻结 §2.1）：API_ENV 按条件编译拨值——
// - MP-WEIXIN：'prod'，走 wx.cloud.callContainer 直连云托管（CLOUD_ENV_ID）
// - App / H5：'mock' 维持现状（BASE_URL 通道保留为公网兜底）
// 注意（2026-10-22）：本地静态题库已下线，mock 不再提供面试/训练题目；
// 需要出题的联调请把 API_ENV 切到 'dev' / 'prod' 并连接服务端内容库。
export type ApiEnv = 'mock' | 'dev' | 'prod'

// 条件编译拨值（契约 §2.1）：单声明 + MP-WEIXIN 赋值覆盖，避免重复声明触发 no-redeclare
export let API_ENV: ApiEnv = 'mock'
// #ifdef MP-WEIXIN
API_ENV = 'prod'
// #endif

// 微信云托管环境 ID（callContainer 目标环境，与桌面端内容后端同环境不同服务）
export const CLOUD_ENV_ID: string = 'prod-d6gaa83ds8accb61b'

// 云托管服务名（requestCloud 注入 X-WX-SERVICE 请求头做路由）。环境内多服务
// （mentorloop-api / express 模板）时缺头会路由到错误服务 → 全部 404，必须显式指定
export const CLOUD_SERVICE_NAME: string = 'mentorloop-mp-api'

// dev/prod 时填网关地址（本地联调示例：'http://127.0.0.1:8787'）
// 注意（2026-10-12）：
// - MP-WEIXIN 真模式：普通 JSON 请求走 callContainer 私有链路，不依赖本地址
// - 文件上传（client.upload → uni.uploadFile）受云托管请求包 100KB 硬限不支持，
//   必须走公网域名：云托管绑定公网域名后在此回填；为空时 upload() 显式报错（不静默失败）
export const API_BASE_URL: string = ''

// 启动自检（App.uvue onLaunch 经 initCloud 调用）：非 mock 且 BASE_URL 为空时显式曝光，
// 避免「请求静默失败」的高排查成本（App/H5 全量请求与 MP 文件上传受影响）
export function warnIfBaseUrlMissing(): void {
  if (!useMock() && API_BASE_URL.length === 0) {
    console.error('[env] API_BASE_URL 未回填：真模式下 App/H5 全部请求与 MP 文件上传将失败')
  }
}

export function useMock(): boolean {
  return API_ENV === 'mock'
}

// 协议链接（LC 合规：备案后回填真实 HTTPS URL）。
// 留空时客户端打开应用内全文页 pages/legal/legal（用户协议 / 隐私政策 / 会员服务协议），
// 不再降级为「即将上线」；回填后自动改走 pages/mine/webview 外链。
export const AGREEMENT_URL: string = ''
export const PRIVACY_URL: string = ''
