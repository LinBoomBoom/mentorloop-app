<template>
  <view
    class="flex-row items-center justify-center rounded-control"
    :class="[sizeClass, bgClass, block ? 'w-full' : '', disabledClass]"
    :hover-class="disabled ? 'none' : 'pressed-card'"
    :hover-start-time="0"
    :hover-stay-time="80"
    @click.stop="onClick"
  >
    <text class="font-semibold" :class="[sizeTextClass, textColorClass]">{{ text }}</text>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'

const props = defineProps({
  text: { type: String, default: '' },
  // primary | secondary | ghost | danger | link（文字链） | tonal（浅色调底）
  type: { type: String, default: 'primary' },
  // sm=40px 行内操作 / md=48px 默认 / lg=56px 页面主 CTA
  size: { type: String, default: 'md' },
  block: { type: Boolean, default: false },
  disabled: { type: Boolean, default: false }
})

const emit = defineEmits(['tap'])

const sizeClass = computed((): string => {
  if (props.size === 'sm') return 'h-10 px-4'
  if (props.size === 'lg') return 'h-14 px-6'
  return 'h-12 px-5'
})

const sizeTextClass = computed((): string => {
  return props.size === 'sm' ? 'text-sm' : 'text-base'
})

// secondary 为白底描边（MASTER.md A1 语义层），不再用灰实底
// 注：描边用 line-strong —— line 在浅色面上几乎不可见（2026-10-16 真机反馈）
const bgClass = computed((): string => {
  if (props.disabled) {
    if (props.type === 'primary') return 'bg-smart'
    if (props.type === 'danger') return 'bg-danger'
    if (props.type === 'link') return 'bg-transparent'
    if (props.type === 'tonal') return 'bg-bg-muted'
    if (props.type === 'ghost') return 'bg-transparent border border-line-strong'
    return 'bg-bg-muted border border-line-strong'
  }
  if (props.type === 'secondary') return 'bg-surface border border-line-strong'
  if (props.type === 'ghost') return 'bg-transparent border border-smart'
  if (props.type === 'danger') return 'bg-danger'
  if (props.type === 'link') return 'bg-transparent'
  if (props.type === 'tonal') return 'bg-chip-smart'
  return 'bg-smart'
})

const textColorClass = computed((): string => {
  if (props.disabled) {
    // 浅底变体的禁用态用灰字（配灰底/灰边），实底变体保持白字再叠透明度
    if (props.type === 'primary' || props.type === 'danger') return 'text-white'
    return 'text-ink-soft'
  }
  if (props.type === 'secondary') return 'text-ink'
  if (props.type === 'ghost' || props.type === 'link' || props.type === 'tonal')
    return 'text-smart'
  return 'text-white'
})

// 禁用态：实底变体压暗即可；浅底变体已换成灰底灰字，再叠透明度会「看不见按钮」
const disabledClass = computed((): string => {
  if (!props.disabled) return ''
  return props.type === 'primary' || props.type === 'danger' ? 'opacity-50' : ''
})

// 根节点必须 @click.stop：与 ml-card 同因，避免原生 tap 冒泡叠加自定义 tap 造成父级触发两次
function onClick() {
  if (props.disabled) return
  emit('tap')
}
</script>
