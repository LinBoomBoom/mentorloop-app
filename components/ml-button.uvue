<template>
  <view
    class="flex-row items-center justify-center rounded-control"
    :class="[sizeClass, bgClass, block ? 'w-full' : '', disabled ? 'opacity-50' : '']"
    :hover-class="disabled ? 'none' : 'pressed-card'"
    :hover-start-time="0"
    :hover-stay-time="80"
    @click="onClick"
  >
    <text class="font-semibold" :class="[sizeTextClass, textColorClass]">{{ text }}</text>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'

const props = defineProps({
  text: { type: String, default: '' },
  type: { type: String, default: 'primary' }, // primary | secondary | ghost | danger
  // sm=40px 行内操作 / md=48px 默认 / lg=56px 页面主 CTA
  size: { type: String, default: 'md' },
  block: { type: Boolean, default: false },
  disabled: { type: Boolean, default: false }
})

const emit = defineEmits(['tap'])

const sizeClass = computed((): string => {
  if (props.size === 'sm') return 'h-10 px-4'
  if (props.size === 'lg') return 'h-14 px-6'
  return 'h-12 px-5'
})

const sizeTextClass = computed((): string => {
  return props.size === 'sm' ? 'text-sm' : 'text-base'
})

// secondary 为白底描边（MASTER.md A1 语义层），不再用灰实底
const bgClass = computed((): string => {
  if (props.type === 'secondary') return 'bg-surface border border-line'
  if (props.type === 'ghost') return 'bg-transparent border border-smart'
  if (props.type === 'danger') return 'bg-danger'
  return 'bg-smart'
})

const textColorClass = computed((): string => {
  if (props.type === 'secondary') return 'text-ink'
  if (props.type === 'ghost') return 'text-smart'
  return 'text-white'
})

function onClick() {
  if (props.disabled) return
  emit('tap')
}
</script>
