<template>
  <text class="font-icon" :style="iconStyle">{{ glyph }}</text>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { StringMap, themeValue } from '../styles/theme.uts'

// Lucide 图标（PUA 码位，来源 design-system/mentorloop/fonts-reference/lucide.css）
// MP-WEIXIN：字体由 styles/icon-font.uts 运行时注入（构建管线丢弃 @font-face）
// 其余端：styles/icons.css 的 @font-face 注册（App 由 main.css #ifdef APP 引入）
// icons 数据库未命中匹配，图标家族为 fallback 选择（MASTER.md §A3-1）
const ICON_GLYPH: StringMap = {
  // 导航 / 基础
  home: '',
  user: '',
  settings: '',
  search: '',
  bell: '',
  info: '',
  x: '',
  minus: '',
  check: '',
  'check-check': '',
  'check-circle': '',
  'circle-check': '',
  'circle-alert': '',
  'chevron-right': '',
  'chevron-down': '',
  'chevron-up': '',
  'arrow-left': '',
  'arrow-right': '',
  'arrow-up-right': '',
  // 面试 / 语音
  mic: '',
  'mic-vocal': '',
  'audio-lines': '',
  keyboard: '',
  'volume-2': '',
  'phone-off': '',
  play: '',
  'circle-play': '',
  bot: '',
  timer: '',
  clock: '',
  history: '',
  'rotate-ccw': '',
  repeat: '',
  'refresh-cw': '',
  zap: '',
  sparkle: '',
  sparkles: '',
  // 训练 / 成长
  dumbbell: '',
  target: '',
  crosshair: '',
  trophy: '',
  medal: '',
  award: '',
  star: '',
  flame: '',
  flag: '',
  activity: '',
  gauge: '',
  'chart-column': '',
  'trending-up': '',
  'trending-down': '',
  brain: '',
  'heart-pulse': '',
  'graduation-cap': '',
  'book-marked': '',
  'notebook-pen': '',
  compass: '',
  layers: '',
  'layout-grid': '',
  list: '',
  'list-checks': '',
  // 岗位 / 简历
  briefcase: '',
  'message-square': '',
  'message-circle': '',
  'file-text': '',
  'file-check': '',
  'file-up': '',
  folder: '',
  upload: '',
  'cloud-upload': '',
  'scan-text': '',
  'wand-2': '',
  pencil: '',
  'pen-line': '',
  'square-pen': '',
  quote: '',
  // 状态 / 安全
  'shield-check': '',
  shield: '',
  lock: '',
  wifi: '',
  server: '',
  smartphone: '',
  'triangle-alert': '',
  'circle-help': '',
  lightbulb: '',
  crown: '',
  gem: '',
  'badge-check': '',
  palette: '',
  moon: '',
  'sliders-horizontal': '',
  share: '',
  'log-out': '',
  'trash-2': '',
  circle: '',
  square: '',
  calendar: '',
}

const props = defineProps({
  name: { type: String, default: '' },
  size: { type: Number, default: 16 },
  color: { type: String, default: themeValue('ink', '#1A2433') }
})

const glyph = computed((): string => {
  const v = ICON_GLYPH[props.name]
  return v != null ? v : ''
})

const iconStyle = computed(() => {
  // 禁用 StringMap（UTSType）：MP 端 normalizeStyle 无法枚举 UTSType 实例字段，
  // 会把内联样式序列化成空串，color/fontSize 全部失效（图标变黑）。
  // 普通对象字面量编译为 UTSJSONObject，走专门分支正常序列化。
  return {
    fontFamily: 'lucide',
    fontSize: props.size + 'px',
    lineHeight: props.size + 'px',
    color: props.color
  }
})
</script>

<style>
.font-icon {
  font-family: 'lucide';
}
</style>
