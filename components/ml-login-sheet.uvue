<template>
  <!-- 登录半屏层：
       小程序：个人主体无手机号授权/短信签名，改为用户主动勾选协议 + 微信登录
       App：保留手机号 + 验证码登录 -->
  <view class="fixed left-0 top-0 right-0 bottom-0 z-50">
    <!-- 遮罩：点击不放行（强制门控），仅提供「暂不登录」出口 -->
    <view class="absolute left-0 top-0 right-0 bottom-0 bg-navy-deep opacity-60"></view>

    <view class="absolute left-0 right-0 bottom-0 bg-surface rounded-t-2xl px-5 pt-4 pb-9">
      <!-- 标题行 -->
      <view class="flex-row items-center justify-between">
        <text class="text-lg font-bold text-ink">登录 {{ APP_NAME }}</text>
        <view
          class="w-11 h-11 rounded-full flex-row items-center justify-center"
          hover-class="pressed-chip"
          :hover-start-time="0"
          @click="onExit"
        >
          <ml-icon name="x" :size="18" :color="MIST"></ml-icon>
        </view>
      </view>
      <text class="text-xs text-ink-soft mt-1">
        <!-- #ifdef MP-WEIXIN -->
        使用微信账号登录，报告与训练记录将归属到你的账号
        <!-- #endif -->
        <!-- #ifndef MP-WEIXIN -->
        微信登录未成功时，可用手机号验证登录；报告与训练记录将归属到你的账号
        <!-- #endif -->
      </text>

      <!-- #ifdef MP-WEIXIN -->
      <view class="mt-4 rounded-control bg-bg-muted px-4 py-3 flex-row items-center">
        <ml-icon name="message-circle" :size="20" :color="SMART"></ml-icon>
        <view class="ml-3 flex-1">
          <text class="text-sm font-bold text-ink">微信登录</text>
          <text class="text-xs text-ink-soft mt-0.5">仅获取微信账号标识，不获取手机号</text>
        </view>
      </view>
      <!-- #endif -->

      <!-- #ifndef MP-WEIXIN -->
      <!-- 手机号 -->
      <text class="text-xs text-ink-soft mt-4">手机号</text>
      <view class="h-11 rounded-control bg-bg-muted px-3 flex-row items-center mt-1.5">
        <input
          class="flex-1 text-base text-ink"
          type="number"
          maxlength="11"
          placeholder="请输入 11 位手机号"
          :value="phone"
          :disabled="loading"
          @input="onPhoneInput"
        />
      </view>

      <!-- 验证码 -->
      <text class="text-xs text-ink-soft mt-3">验证码</text>
      <view class="flex-row items-center mt-1.5">
        <view class="flex-1 h-11 rounded-control bg-bg-muted px-3 flex-row items-center">
          <input
            class="flex-1 text-base text-ink"
            type="number"
            maxlength="6"
            placeholder="6 位验证码"
            :value="code"
            :disabled="loading"
            @input="onCodeInput"
          />
        </view>
        <view
          class="ml-2.5 h-11 px-3.5 rounded-control flex-row items-center justify-center"
          :class="canSend ? 'bg-chip-smart' : 'bg-bg-muted opacity-60'"
          hover-class="pressed-chip"
          :hover-start-time="0"
          @click="sendCode"
        >
          <text class="text-sm" :class="canSend ? 'text-smart' : 'text-ink-soft'">{{
            sendLabel
          }}</text>
        </view>
      </view>
      <!-- #endif -->

      <!-- 协议 -->
      <view class="flex-row items-center mt-4" @click="toggleAgree">
        <view
          class="w-[18px] h-[18px] rounded-chip flex-row items-center justify-center border"
          :class="agreed ? 'bg-smart border-smart' : 'bg-surface border-line-strong'"
        >
          <ml-icon v-if="agreed" name="check" :size="11" :color="SURFACE"></ml-icon>
        </view>
        <view class="flex-row items-center ml-2 flex-1">
          <text class="text-xs text-ink-soft">我已阅读并同意</text>
          <text class="text-xs text-smart" @click.stop="openAgreement">《用户协议》</text>
          <text class="text-xs text-ink-soft">与</text>
          <text class="text-xs text-smart" @click.stop="openPrivacy">《隐私政策》</text>
        </view>
      </view>

      <!-- 登录按钮 -->
      <view class="mt-4">
        <ml-button
          :text="loginLabel"
          type="primary"
          block
          :disabled="loading"
          @tap="doLogin"
        ></ml-button>
      </view>

      <!-- 出口：暂不登录（返回上一页，不放行面试） -->
      <view
        class="mt-2.5 h-10 flex-row items-center justify-center"
        hover-class="pressed-row"
        :hover-start-time="0"
        @click="onExit"
      >
        <text class="text-sm text-ink-soft">暂不登录，返回</text>
      </view>

      <text class="text-xs text-ink-soft mt-2.5 leading-4">
        <!-- #ifdef MP-WEIXIN -->
        登录即表示你同意上述协议；简历与录音数据保护详见隐私政策
        <!-- #endif -->
        <!-- #ifndef MP-WEIXIN -->
        手机号仅用于登录验证；简历与录音数据保护详见隐私政策
        <!-- #endif -->
      </text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, onUnmounted } from 'vue'
import mlButton from './ml-button.uvue'
import mlIcon from './ml-icon.uvue'
import { themeValue } from '../styles/theme.uts'
import { sendSmsCode, loginByPhone, loginByWechat, applyAuth } from '../api/auth.uts'
import { trackEvent } from '../api/tracking.uts'
import { AGREEMENT_URL, PRIVACY_URL } from '../api/env.uts'
import { APP_NAME } from '../data/app-meta.uts'

const MIST = themeValue('mist', '#AEAEB2')
const SURFACE = themeValue('surface', '#FFFFFF')
const SMART = themeValue('smart', '#5856D6')

const emit = defineEmits(['success', 'exit'])

const phone = ref('')
const code = ref('')
const agreed = ref(false)
const loading = ref(false)
const countdown = ref(0)
// 本会话是否已成功请求过验证码：服务端校验的是「已发码且未消费」的记录，
// 未发码直接登录必然失败（2026-10-22 真机：只填 123456 点登录 → 一直失败）
const codeSent = ref(false)
let timer = 0

const canSend = computed((): boolean => phone.value.length === 11 && countdown.value === 0)
const sendLabel = computed((): string =>
  countdown.value > 0 ? countdown.value + 's 后重发' : '获取验证码'
)
// 登录按钮文案：小程序为「微信登录」（用户主动授权），App 为「登录」
let loginText = '登录'
// #ifdef MP-WEIXIN
loginText = '微信登录'
// #endif
const loginLabel = computed((): string => (loading.value ? '登录中…' : loginText))

function onPhoneInput(e: UniInputEvent) {
  phone.value = e.detail.value
}

function onCodeInput(e: UniInputEvent) {
  code.value = e.detail.value
}

function toggleAgree() {
  agreed.value = !agreed.value
}

function openDoc(url: string, title: string, doc: string) {
  if (url.length === 0) {
    uni.navigateTo({ url: '/pages/legal/legal?doc=' + doc })
    return
  }
  uni.navigateTo({
    url: '/pages/mine/webview?url=' + encodeURIComponent(url) + '&title=' + encodeURIComponent(title)
  })
}

function openAgreement() {
  openDoc(AGREEMENT_URL, '用户协议', 'agreement')
}

function openPrivacy() {
  openDoc(PRIVACY_URL, '隐私政策', 'privacy')
}

function onExit() {
  if (loading.value) return
  emit('exit')
}

function sendCode() {
  if (!canSend.value || loading.value) return
  sendSmsCode(phone.value)
    .then((ok: boolean) => {
      if (!ok) {
        uni.showToast({ title: '发送失败，请稍后重试', icon: 'none' })
        return
      }
      codeSent.value = true
      uni.showToast({ title: '验证码已发送', icon: 'none' })
      startCountdown()
    })
    .catch(() => {
      uni.showToast({ title: '发送失败，请稍后重试', icon: 'none' })
    })
}

function startCountdown() {
  countdown.value = 60
  if (timer !== 0) clearInterval(timer)
  timer = setInterval(() => {
    countdown.value = countdown.value - 1
    if (countdown.value <= 0) clearInterval(timer)
  }, 1000)
}

// #ifdef MP-WEIXIN
// 用户主动点击后拉起微信登录；不再在启动时静默登录
function requestWechatCode(): Promise<string> {
  return new Promise((resolve, reject) => {
    uni.login({
      provider: 'weixin',
      success: (res: any) => {
        const code = res.code as string
        if (code == null || code.length === 0) {
          reject(new Error('NO_CODE'))
          return
        }
        resolve(code)
      },
      fail: () => reject(new Error('WX_LOGIN_FAILED'))
    })
  })
}
// #endif

async function doLogin() {
  if (loading.value) return
  if (!agreed.value) {
    uni.showToast({ title: '请先阅读并同意用户协议与隐私政策', icon: 'none' })
    return
  }
  // #ifndef MP-WEIXIN
  if (phone.value.length !== 11) {
    uni.showToast({ title: '请输入 11 位手机号', icon: 'none' })
    return
  }
  if (code.value.length !== 6) {
    uni.showToast({ title: '请输入 6 位验证码', icon: 'none' })
    return
  }
  // #endif
  loading.value = true
  try {
    // #ifdef MP-WEIXIN
    const wxCode = await requestWechatCode()
    const wxAuth = await loginByWechat(wxCode)
    applyAuth(wxAuth, '')
    trackEvent('auth_login_success', { channel: 'mp-wechat' })
    emit('success')
    // #endif
    // #ifndef MP-WEIXIN
    // 未点过「获取验证码」时先静默补发：服务端必须有未消费的验证码记录才允许登录
    if (!codeSent.value) {
      const sent = await sendSmsCode(phone.value, true)
      if (!sent) {
        uni.showToast({ title: '请先点击「获取验证码」后登录', icon: 'none' })
        return
      }
      codeSent.value = true
      startCountdown()
    }
    const r = await loginByPhone(phone.value, code.value)
    applyAuth(r, phone.value)
    trackEvent('auth_login_success', { channel: 'mp-phone' })
    emit('success')
    // #endif
  } catch (e: any) {
    console.warn('[login-sheet] failed', e)
    // #ifdef MP-WEIXIN
    uni.showToast({ title: '登录失败，请稍后重试', icon: 'none' })
    // #endif
    // #ifndef MP-WEIXIN
    uni.showToast({ title: '登录失败，请检查验证码', icon: 'none' })
    // #endif
  } finally {
    loading.value = false
  }
}

onUnmounted(() => {
  if (timer !== 0) clearInterval(timer)
})
</script>
