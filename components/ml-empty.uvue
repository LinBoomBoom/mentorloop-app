<template>
  <view class="flex-col items-center py-8">
    <view
      class="w-16 h-16 rounded-full flex-row items-center justify-center"
      :style="{ backgroundColor: iconBg }"
    >
      <ml-icon :name="icon" :size="28" :color="iconColor"></ml-icon>
    </view>
    <text class="text-base font-semibold text-ink mt-4">{{ title }}</text>
    <text v-if="desc.length > 0" class="text-xs text-ink-soft mt-1.5 text-center px-8 leading-5">
      {{ desc }}
    </text>
    <view v-if="hasAction" class="mt-5 w-full px-2">
      <slot></slot>
    </view>
  </view>
</template>

<script setup lang="uts">
import { useSlots } from 'vue'
import mlIcon from './ml-icon.uvue'

// 空状态：图标 + 标题 + 说明 + 可选操作区（slot）
defineProps({
  icon: { type: String, default: 'sparkles' },
  iconColor: { type: String, default: '#5B6CFF' },
  iconBg: { type: String, default: '#EEF1FF' },
  title: { type: String, default: '' },
  desc: { type: String, default: '' }
})

const slots = useSlots()
const hasAction = slots.default != null
</script>
