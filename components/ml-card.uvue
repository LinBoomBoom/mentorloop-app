<template>
  <view
    class="relative rounded-card p-4 border"
    :class="[
      selected ? 'bg-chip-smart border-smart' : 'bg-surface border-line',
      raised ? 'shadow-card' : '',
      padded ? '' : 'p-0'
    ]"
    :hover-class="pressable ? 'pressed-card' : 'none'"
    :hover-start-time="0"
    :hover-stay-time="80"
    @click.stop="onClick"
  >
    <slot></slot>
  </view>
</template>

<script setup lang="uts">
defineProps({
  // raised：带卡片阴影（默认 true）；flat 场景（嵌套/分隔区域）传 false
  raised: { type: Boolean, default: true },
  // pressable：是否显示按压反馈（可点击卡片传 true）
  pressable: { type: Boolean, default: false },
  // padded：默认内边距 p-4；自定义留白时传 false
  padded: { type: Boolean, default: true },
  // selected：可选中卡片选中态（paywall 套餐等）：chip-smart 底 + smart 描边
  selected: { type: Boolean, default: false }
})

const emit = defineEmits(['tap'])

// 根节点必须 @click.stop：小程序端 emit('tap') 与原生 tap 冒泡到组件节点会让父级 @tap 触发两次
// （2026-10-22 真机：退出登录确认弹窗弹两次）
function onClick() {
  emit('tap')
}
</script>
