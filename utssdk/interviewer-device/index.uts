// UTS 原生插件：interviewer-device
// 职责：权限、网络、前后台、诊断（文档 04）
// 真实实现为原生层；此处为契约与降级实现。
// 注意：UTS 不支持 interface，契约以类的公开方法为准。

export class DevicePlugin {
  checkPermission(): Promise<Record<string, boolean>> {
    return Promise.resolve({ record: true, network: true })
  }

  onNetworkChange(cb: (online: boolean) => void): void {
    console.warn('[device] onNetworkChange 未接入', cb)
  }

  onForeground(cb: (foreground: boolean) => void): void {
    console.warn('[device] onForeground 未接入', cb)
  }

  diagnose(): Promise<Record<string, string>> {
    return Promise.resolve({ mic: 'ok', net: 'ok' })
  }
}

export const devicePlugin: DevicePlugin = new DevicePlugin()
