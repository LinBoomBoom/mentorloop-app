// UTS 原生插件：interviewer-audio
// 职责：录音、降噪、音频焦点、中断恢复（文档 04）
// 真实实现：utssdk/app-android/index.uts + utssdk/app-ios/index.uts（原生层）
// 此处仅为「契约 + 默认降级实现」，供客户端 import 使用。

export interface AudioPlugin {
  startRecord(): void
  stopRecord(): Promise<string>            // 返回录音文件本地路径
  onAudioFrame(cb: (frame: Uint8Array) => void): void
  requestFocus(): Promise<boolean>         // 音频焦点申请
}

class AudioPluginStub implements AudioPlugin {
  startRecord(): void {
    console.warn('[audio] 原生插件未接入，使用降级实现')
  }
  stopRecord(): Promise<string> {
    return Promise.resolve('')
  }
  onAudioFrame(cb: (frame: Uint8Array) => void): void {}
  requestFocus(): Promise<boolean> {
    return Promise.resolve(true)
  }
}

export const audioPlugin: AudioPlugin = new AudioPluginStub()
