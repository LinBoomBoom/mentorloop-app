// 换一种说法（规则 v1）
// 把当前题目改写为一句澄清式复述，帮助「没听清 / 没理解题意」的用户继续作答。
// 约束（AI 角色把关）：
//   1. 只读取 knowledgePoint / purpose，绝不引用 expectedEvidence / misconceptions（防泄题）；
//   2. 不改变题目难度、知识点与提问目标（澄清 ≠ 降难度 / 给提示）；
//   3. 纯逻辑：无 UI、无网络、无 uni.*，与 server/src/rules/rephrase.ts 人工镜像（SOP 铁律）。

export type RephraseInput = {
  knowledgePoint: string
  purpose: string
}

export function rephraseQuestion(input: RephraseInput): string {
  const kp = input.knowledgePoint.trim()
  const purpose = input.purpose.trim()
  if (kp.length > 0 && purpose.length > 0) {
    return (
      '换个角度说：这道题想了解你在「' +
      kp +
      '」上的思路，' +
      purpose +
      '。可以结合项目经历，先给结论，再补充依据和结果。'
    )
  }
  if (kp.length > 0) {
    return '换个角度说：这道题聚焦「' + kp + '」，可以结合项目经历，说说你的做法、取舍和结果。'
  }
  return '换个角度说：可以先用一句话给出结论，再补充原因和具体例子。'
}
