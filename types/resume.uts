// 简历领域模型（来源文档 02 §2.4）

export interface ResumeParseResult {
  contact: boolean
  projects: number
  techStack: string[]
  quantified: boolean
  gaps: string[]
  formatRisks: string[]
}

export interface ResumeSuggestion {
  original: string
  suggested: string
  reason: string
  needsUserEvidence: boolean  // 可能虚构数据，提示用户补充真实证据
}
