// 简历领域模型（来源文档 02 §2.4；2026-10-24 免费预览 teaser 版）
// 契约：docs/contracts/2026-10-21-resume-ai-review.freeze.md
//       docs/contracts/2026-10-24-resume-preview-teaser.freeze.md

export type ResumeIssueSeverity = 'high' | 'medium' | 'low'
export type ResumeIssueCategory =
  'quantification' | 'ownership' | 'techMatch' | 'format' | 'language' | 'completeness'

export type ResumeIssue = {
  issueId: string
  severity: ResumeIssueSeverity
  category: ResumeIssueCategory
  page: number
  paragraph: number
  quote: string
  original: string
  suggested: string // 免费预览 locked 条目为空串（服务端不下发）
  reason: string
  needsUserEvidence: boolean
  locked: boolean // 免费预览：[0]=false，[1..]=true；完整评审恒 false
}

export type ResumeParseResult = {
  resumeId: string
  fileName: string
  fileType: 'pdf' | 'docx'
  pages: number
  contact: boolean
  projects: number
  techStack: string[]
  quantified: boolean
  gaps: string[]
  formatRisks: string[]
  issues: ResumeIssue[] // 付费完整评审批注；preview 恒为 []
  previewIssues: ResumeIssue[] // 免费预览诊断（1–3 条）；full 恒为 []
  mode: 'full' | 'preview'
  cached: boolean
}

export type ResumeQuota = {
  memberMonthlyTotal: number
  memberMonthlyLeft: number
  singleLeft: number
  freePreviewLeftToday: number
  canFull: boolean
}

// 服务端 parse/detail 出参：结果字段 + 最新额度
export type ResumeParseResponse = {
  resumeId: string
  fileName: string
  fileType: 'pdf' | 'docx'
  pages: number
  contact: boolean
  projects: number
  techStack: string[]
  quantified: boolean
  gaps: string[]
  formatRisks: string[]
  issues: ResumeIssue[]
  previewIssues: ResumeIssue[]
  mode: 'full' | 'preview'
  cached: boolean
  quota: ResumeQuota
}

export type ResumeHistoryItem = {
  resumeId: string
  fileName: string
  fileType: 'pdf' | 'docx'
  createdAt: number
  mode: 'full' | 'preview'
  issuesHigh: number
  issuesTotal: number
  projects: number
  quantified: boolean
}

// 批注版 PDF 导出出参（契约 2026-10-26-resume-annotated-pdf）
export type ResumeAnnotateResult = {
  fileID: string
  expiresAt: number
  issueCount: number
  pages: number
}

// 旧投递版本入口保留（/resume/optimize 出参零变更）
export type ResumeSuggestion = {
  original: string
  suggested: string
  reason: string
  needsUserEvidence: boolean // 可能虚构数据，提示用户补充真实证据
}
