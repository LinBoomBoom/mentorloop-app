// 面试领域模型（与后端契约对齐）
// 来源文档 02 / 04
// UTS 约束：对象类型必须用 type 命名（不支持 interface）；不支持 undefined

export type InterviewMode = 'quick' | 'standard' | 'deep' // 快练5min / 标准20 / 深度40
export type Difficulty = 'junior' | 'mid' | 'senior'

// 文档 04 状态机
export type InterviewStatus =
  | 'CREATED'
  | 'DEVICE_CHECK'
  | 'READY'
  | 'ASKING'
  | 'LISTENING'
  | 'TRANSCRIBING'
  | 'FOLLOW_UP_DECISION'
  | 'NEXT_QUESTION'
  | 'WRAP_UP'
  | 'REPORT_GENERATING'
  | 'COMPLETED'

export type PositionBlueprint = {
  position: string
  experienceRange: string
  companyType: string
  language: string
  target: string
}

export type QuestionItem = {
  id: string
  abilityDomain: string // 能力域
  subAbility: string
  content: string
  purpose: string // 提问目的
  difficulty: Difficulty
  expectedEvidence: string // 期望证据
}

export type TranscriptEntry = {
  questionId: string
  speaker: 'interviewer' | 'user'
  text: string
  timestamp: number
}

// 关键事件：带会话ID/题目ID/事件序号/幂等键（文档 04）
export type InterviewEvent = {
  sessionId: string
  questionId: string
  eventSeq: number
  status: InterviewStatus
  idempotencyKey: string
  at: number
}

// 接口返回体（UTS 不支持匿名对象字面量作为返回类型，需命名）
export type SessionRef = {
  sessionId: string
}

export type AnswerAck = {
  ok: boolean
}
