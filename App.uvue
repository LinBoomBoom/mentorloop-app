<script setup lang="uts">
// 蒸汽模式要求：<script setup> 组合式，不支持选项式 API / mixin
import { onLaunch, onShow, onHide } from '@dcloudio/uni-app'
import { userStore } from './store/user-profile.uts'
import { reportHistory } from './store/report-history.uts'
import { interviewSession } from './store/interview-session.uts'
import { loginByWechat, applyAuth } from './api/auth.uts'
import { trackEvent, flushTrackingQueue } from './api/tracking.uts'
import { initCloud } from './api/client.uts'

onLaunch(() => {
  console.log('[MentorLoop] app launch')

  // #ifdef MP-WEIXIN
  // 云托管链路：初始化 wx.cloud（callContainer 前置，静默登录/业务请求都走云链路）
  initCloud()
  // #endif

  // 启动时恢复会话（App 与小程序通用）
  userStore.restore()
  // 启动埋点 + 补传上次未发出的埋点
  trackEvent('app_launch')
  flushTrackingQueue()
  // 加载报告历史（成长页/首页最近报告使用）
  reportHistory.load()

  // 快照恢复：若上次异常退出留下未完成面试，提示继续
  const snap = interviewSession.restoreSnapshot()
  if (snap != null && snap.status !== 'COMPLETED') {
    setTimeout(() => {
      uni.showModal({
        title: '继续上次面试？',
        content: '检测到未完成的面试，是否回到面试房间继续？',
        confirmText: '继续',
        cancelText: '放弃',
        success: (r: any) => {
          if (r.confirm) {
            uni.navigateTo({ url: '/pages/interview/room' })
          } else {
            interviewSession.clearSnapshot()
          }
        }
      })
    }, 800)
  }

  // #ifdef MP-WEIXIN
  // 决策记录 D1：小程序端不开发登录页，直接用微信授权静默登录
  if (!userStore.isLoggedIn()) {
    uni.login({
      provider: 'weixin',
      success: (res: any) => {
        const code = res.code as string
        if (code == null || code.length === 0) return
        loginByWechat(code)
          .then((r) => {
            applyAuth(r)
          })
          .catch(() => {
            console.warn('[MentorLoop] wechat silent login failed')
          })
      }
    })
  }
  // #endif
})

onShow(() => {
  console.log('[MentorLoop] app show')
})

onHide(() => {
  console.log('[MentorLoop] app hide')
})
</script>

<style>
/* Tailwind CSS 4 入口（weapp-tailwindcss 的 cssEntries 需指向同一个文件） */
/* 小程序端不引入：uts 编译器会误解析 style 块中的 @import 字符串，报 Unterminated string；
   小程序端样式由 weapp-tailwindcss cssEntries 注入，无需此处 @import */
/* #ifdef APP */
@import './main.css';
/* #endif */
</style>
