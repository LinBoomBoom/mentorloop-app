<script setup lang="uts">
// 蒸汽模式要求：<script setup> 组合式，不支持选项式 API / mixin
import { onLaunch, onShow, onHide } from '@dcloudio/uni-app'
import { userStore } from './store/user-profile.uts'
import { reportHistory } from './store/report-history.uts'
import { interviewSession } from './store/interview-session.uts'
import { trackEvent, flushTrackingQueue } from './api/tracking.uts'
import { initCloud, useMock } from './api/client.uts'
import { installIconFont } from './styles/icon-font.uts'

onLaunch(() => {
  console.log('[MentorLoop] app launch')

  // #ifdef MP-WEIXIN
  // 云托管链路：初始化 wx.cloud（callContainer 前置，静默登录/业务请求都走云链路）
  initCloud()
  // 图标字体：构建管线丢弃 @font-face，MP 端需运行时注入 lucide 子集（否则全页图标空白）
  installIconFont()
  // #endif

  // 启动时恢复会话（App 与小程序通用）
  userStore.restore()
  // 真模式下丢弃 mock 时代遗留的假会话（假 token 打真服务器必 401），静默登录会重新建立
  if (userStore.isMockSession() && !useMock()) {
    userStore.logout()
  }
  // 启动埋点 + 补传上次未发出的埋点
  trackEvent('app_launch')
  flushTrackingQueue()
  // 加载报告历史（成长页/首页最近报告使用）
  reportHistory.load()

  // 快照恢复：若上次异常退出留下未完成面试，提示继续
  const snap = interviewSession.restoreSnapshot()
  if (snap != null && snap.status !== 'COMPLETED') {
    setTimeout(() => {
      uni.showModal({
        title: '继续上次面试？',
        content: '检测到未完成的面试，是否回到面试房间继续？',
        confirmText: '继续',
        cancelText: '放弃',
        success: (r: any) => {
          if (r.confirm) {
            // resume=1：房间复用快照 sessionId 与已答记录，不再新建一场
            uni.navigateTo({ url: '/pages/interview/room?resume=1' })
          } else {
            interviewSession.clearSnapshot()
          }
        }
      })
    }, 800)
  }

  // 小程序端不再自动静默登录：等用户主动点击登录并勾选协议后，再走微信授权
})

onShow(() => {
  console.log('[MentorLoop] app show')
})

onHide(() => {
  console.log('[MentorLoop] app hide')
})
</script>

<style>
/* Tailwind CSS 4 入口（weapp-tailwindcss 的 cssEntries 需指向同一个文件） */
/* 小程序端不引入：uts 编译器会误解析 style 块中的 @import 字符串，报 Unterminated string；
   小程序端样式由 weapp-tailwindcss cssEntries 注入，无需此处 @import */
/* #ifdef APP */
@import './main.css';
/* #endif */

/* 小程序端 Tailwind v4 边框兜底（必须写在这里：cssEntries 只产出「被用到的原子类」，
   main.css 里的普通规则不会进 MP 产物）。
   背景：`border-*` 只写 border-width，线型依赖 --tw-border-style；Tailwind v4 用 @property
   给它设初始值 solid，而小程序不支持 @property（产物里 0 处），工具链只在 border-dashed
   之类非常规值时才就地定义 → 普通 border 的 var() 取空 → border-style 无效 → 全站边框
   静默消失（2026-10-16 确认：协议复选框、岗位选中态、ml-button secondary/禁用态）。
   写在 page 上由子节点继承，border-dashed 等仍会就地覆盖。 */
page {
  --tw-border-style: solid;
}

/* 按压反馈三档（MASTER.md A3-5：opacity 0.7 / 0.85 / 0.8）。
   同为「cssEntries 只产出被用到的原子类」的受害者：main.css 里的 @utility pressed-*
   不进 MP 产物（实测产物 wxss 中 pressed-card/chip/row 均 0 处），而 wxml 的
   hover-class 用的是未哈希化的原名 → 在此以普通类重新声明，MP 端按压反馈才生效。
   APP/H5 端由 main.css 的 @utility 提供，两边取值必须保持一致。 */
.pressed-row {
  opacity: 0.7;
}
.pressed-card {
  opacity: 0.85;
}
.pressed-chip {
  opacity: 0.8;
}

/* 尊重系统「减少动态效果」（MASTER.md A3-7 无障碍要求）。
   MP 端不能用 `*`（wxss 不支持通配选择器），改列常见节点；
   平台若不支持该 media feature 则整块被忽略，无副作用。 */
@media (prefers-reduced-motion: reduce) {
  page,
  view,
  text,
  button,
  image,
  scroll-view {
    animation: none !important;
    transition: none !important;
  }
}
</style>
