# MentorLoop 服务端环境变量（复制为 .env 使用）
PORT=8787
# SQLite 文件路径；":memory:" 走内存库（测试用）。
# 云托管双驱动：注入下方 MYSQL_* 后 DB_PATH 失效，自动切 mysql2 连接池
#（schema 由 deploy/cloud/baseline-mp-mysql.sql 外部建库，服务端不做自举）
DB_PATH=./data/mentorloop.db
# JWT 签名密钥（生产务必替换并保密）
JWT_SECRET=dev-only-change-me
# 简历/上传文件暂存目录
UPLOAD_DIR=./data/uploads

# ---- 云 MySQL（双驱动；本地开发留空走 node:sqlite，云端在云托管控制台版本配置填写）----
# MYSQL_HOST=内网地址（云托管访问走内网域名/IP）
# MYSQL_PORT=3306
# MYSQL_USER=mentorloop
# MYSQL_PASSWORD=****（只进控制台版本配置，不进仓库）
# MYSQL_DATABASE=mentorloop_mp
# MYSQL_POOL_SIZE=10

# ---- 桌面端账号互通（桌面→MP 单向权益；为空=关闭，零跨库查询）----
# 桌面端库名（与 MYSQL_* 同一实例的 mentorloop 库）；连接账号需对其有 SELECT 权限
# DESKTOP_DB_NAME=mentorloop
# 同一变量亦作「内容库同步源」：内容库题目在该库 interview_questions（只读），
# 同步命令见 server/src/scripts/sync-content-questions.ts（同步后逐方向 count 校验）。
# 出题只读 MP 本库 questions 表，不依赖本变量；本变量仅在「同步」时使用。

# 内容库同步（批次 A）：cd server && npx tsx src/scripts/sync-content-questions.ts [--force]
# 本地无云 MySQL 时由 fixture 自举（server/src/data/content-fixture.json，仅开发/测试）。
# 云端自举：MYSQL_HOST 非空 且 本变量（DESKTOP_DB_NAME）非空 时，服务启动后会检查内容库——
# 目标表为空、或适配层版本（sync-content-questions.ts 的 ADAPTER_VERSION）与落库版本不一致时
# 全量重建；一致则跳过（重启零开销）。影响落库结果的适配层改动须同步 +1 ADAPTER_VERSION。
# （依赖本变量而非新增开关：云托管控制台的环境变量区只支持改已有值、不支持新增键。）

# Mock 短信验证码（本地开发：先调 /auth/sms-code 写入该码，再凭码登录）
# 安全（2026-10-11）：登录侧已删除"无记录也放行"兜底；云模式（MYSQL_HOST 非空）下
# 若本值仍为 123456，服务端启动时直接拒绝（assertCloudSafety）
MOCK_SMS_CODE=123456
# 短信验证码有效期（毫秒）
SMS_TTL_MS=300000
# 发码限流（内置，不可配置）：同手机号 60s 内 1 次、1 小时内 5 次；登录失败 15 分钟内 10 次

# ---- 微信登录（冻结 §2.2，2026-10-11 安全收紧）----
# 云托管 callContainer 私有链路自动注入 X-WX-OPENID 头：
# TRUST_WX_HEADERS=true 时服务端采信该头；缺省 false，服务端强制剥离所有 X-WX-* 头（防公网伪造）
# TRUST_WX_HEADERS=true
# body.code 真实换 openid（jscode2session）需同时配置 WX_APPID + WX_SECRET
# WX_APPID=wx83b5d63ecd739421
# WX_SECRET=小程序AppSecret（仅控制台/版本配置，不进仓库）
# 本地联调豁免：无 WX_SECRET 时用 'wx_'+code 作假 openid；云模式下开启会被启动守卫拒绝
# WX_MOCK_LOGIN=true

# ---- LLM（P1.2 报告解释与优秀示例；默认关闭，报告回退纯规则）----
# LLM_ENABLED=true
# LLM_BASE_URL=https://api.openai.com/v1   # 任意 OpenAI 兼容网关
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=30000

# ---- 支付（P1.3；默认 mock：下单即发放，零配置可跑）----
# PAY_MODE=mock                # mock | wx（wx 需以下 WX_* 齐全）
# WX_APPID=wx1234567890abcdef
# WX_MCHID=1900000001
# WX_MCH_SERIAL=商户证书序列号
# WX_API_V3_KEY=32字节APIv3密钥
# WX_MCH_PRIVATE_KEY=商户私钥PEM（可内联或多行，含 -----BEGIN PRIVATE KEY-----）
# WX_PLATFORM_PUBLIC_KEY=微信平台公钥PEM
# WX_NOTIFY_URL=https://api.mentorloop.com/membership/order/notify

# ---- ASR 云端转写（P2-13；默认 stub：明确降级不伪造转写，零配置可跑）----
# ASR_PROVIDER=stub            # stub | wx | aliyun
#   - wx：微信「语音上传+翻译」（免费，复用上方 WX_APPID/WX_SECRET，无新增密钥；
#         音频硬限 1MB，mp3 16k 单声道；识别结果随响应同步返回）
#   - aliyun：NLS FileTrans（需以下密钥 + 对象存储提供公网音频链接）
# ASR_TIMEOUT_MS=30000
# ASR_ALIYUN_ACCESS_KEY_ID=LTAI5t...
# ASR_ALIYUN_ACCESS_KEY_SECRET=xxxx
# ASR_ALIYUN_APPKEY=阿里云智能语音交互 Appkey
# ASR_ALIYUN_REGION=cn-shanghai