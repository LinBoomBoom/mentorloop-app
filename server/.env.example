# MentorLoop 服务端环境变量（复制为 .env 使用）
PORT=8787
# SQLite 文件路径；":memory:" 走内存库（测试用）
DB_PATH=./data/mentorloop.db
# JWT 签名密钥（生产务必替换并保密）
JWT_SECRET=dev-only-change-me
# 简历/上传文件暂存目录
UPLOAD_DIR=./data/uploads
# Mock 短信验证码（任何手机号都通过）
MOCK_SMS_CODE=123456
# 短信验证码有效期（毫秒）
SMS_TTL_MS=300000

# ---- LLM（P1.2 报告解释与优秀示例；默认关闭，报告回退纯规则）----
# LLM_ENABLED=true
# LLM_BASE_URL=https://api.openai.com/v1   # 任意 OpenAI 兼容网关
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=30000